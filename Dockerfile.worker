# syntax=docker/dockerfile:1
# ═══════════════════════════════════════════════════════════════════════════════════════════
# L'IMAGE DU WORKER (J2, décision 3 de la Direction, 29/10/2026) — le service Render `amd-worker`.
#
# Le MÊME code que le web, sans compilation Next : `tsx scripts/worker.ts` exécute la table des tâches
# de fond (dont les TRAVAUX longs, `travaux.balayage`) sous leurs baux. L'image porte en plus ce que le
# web n'a pas et dont les travaux ont besoin :
#   • LibreOffice headless (Writer, Impress, Calc — sans interface) : conversions fidèles Word/PowerPoint → PDF ;
#   • ffmpeg : images clés et son des vidéos ;
#   • Tesseract (français, arabe, anglais) : OCR local des pièces scannées.
#
# Deux étages : le premier installe les dépendances (`npm ci`, il lui faut de quoi compiler un module
# natif) et génère le client Prisma ; le second ne garde que l'exécution. Utilisateur non root (`node`).
# Construire : docker build -f Dockerfile.worker -t amd-worker .
# ═══════════════════════════════════════════════════════════════════════════════════════════

FROM node:22-bookworm-slim AS dependances
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json .npmrc ./
COPY prisma ./prisma
# `npm ci` : EXACTEMENT le verrou, comme le web. Les dépendances de développement restent : `tsx` exécute le worker.
RUN npm ci --no-audit --no-fund && npx prisma generate && npm cache clean --force

FROM node:22-bookworm-slim AS execution
ENV NODE_ENV=production \
    TACHES_DE_FOND=web \
    HOME=/home/node
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssl ca-certificates tini \
      libreoffice-writer-nogui libreoffice-impress-nogui libreoffice-calc-nogui fonts-dejavu-core fonts-liberation \
      ffmpeg \
      tesseract-ocr tesseract-ocr-fra tesseract-ocr-ara tesseract-ocr-eng \
 && apt-get purge -y --auto-remove \
 && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*
WORKDIR /app
COPY --from=dependances --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .
USER node
# `tini` relaie SIGTERM au worker (et `tsx` directement, pas `npx`, qui ne le relaie pas) : l'arrêt propre (25 s de grâce,
# `scripts/worker.ts`) fonctionne sous Render — mesuré : sortie 0 à l'arrêt.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node_modules/.bin/tsx", "scripts/worker.ts"]
