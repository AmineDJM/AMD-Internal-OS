{
  "name": "amd-internal-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "AMD Internal OS — lightweight internal ERP for Adventum Pharma",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:render": "NODE_OPTIONS=--max-old-space-size=3072 next lint && NODE_OPTIONS=--max-old-space-size=5120 tsc --noEmit -p tsconfig.build.json && TYPECHECK_SEPARE=1 NODE_OPTIONS=--max-old-space-size=3584 next build",
    "build:measure": "bash scripts/build-memory.sh",
    "bundle:plafond": "node scripts/mesure-bundle.mjs --plafond",
    "adam:doctor": "tsx scripts/adam-doctor.ts",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "lint": "next lint",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit",
    "test": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_internal_os}\" vitest run",
    "test:architecture": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_internal_os}\" vitest run src/modules src/platform/ia/frontieres.test.ts src/platform/couverture.test.ts src/platform/taille-fichiers.test.ts src/platform/domains.test.ts src/platform/boundary.test.ts src/platform/source.test.ts src/platform/imports-relatifs.test.ts src/lib/actions/contrat.test.ts src/lib/client-bundle-guard.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "storage:check": "tsx scripts/storage-status.ts",
    "blobs:migrate-r2": "tsx scripts/migrate-blobs-to-r2.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:reset": "prisma migrate reset --force",
    "graphify:refresh": "bash scripts/graphify-refresh.sh",
    "graphify:report": "cat graphify-out/GRAPH_REPORT.md",
    "graphify:query": "bash scripts/graphify-query.sh",
    "autotest": "tsx scripts/auto-test/run.ts",
    "autotest:live": "tsx scripts/auto-test/run.ts --live",
    "test:e2e": "playwright test",
    "adam:boundary": "tsx scripts/adam-boundary.ts",
    "office:bench": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/office-bench.ts",
    "office:sabotage": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/office-sabotage.ts",
    "evals:report": "tsx scripts/evals-report.ts",
    "sheets:bench": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/sheets-bench.ts",
    "factory:bench": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/factory-bench.ts",
    "audit:reachability": "tsx scripts/audit-runtime-reachability.ts",
    "actions:contrat": "tsx scripts/actions-contrat.ts",
    "capacites:classement": "tsx scripts/capacites-classement.ts",
    "qualite:mort": "tsx scripts/qualite.ts mort",
    "qualite:doublons": "tsx scripts/qualite.ts doublons",
    "factures:doublons": "tsx scripts/recenser-doublons-factures.ts",
    "adam:smoke:provider": "tsx scripts/smoke-provider.ts",
    "adam:smoke:deep": "tsx scripts/deep-smoke.ts",
    "fabric:bench": "tsx scripts/fabric-bench.ts",
    "adam:bench:seed": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/seed-adam-bench.ts",
    "adam:bench:reset": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/seed-adam-bench.ts -- --reset",
    "adam:bench": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/adam-live-bench.ts",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "adam:bench:defis": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" BENCH_SET=defis DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/adam-live-bench.ts",
    "autonomy:bench": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/autonomy-bench.ts",
    "bench:plan": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/plan-couverture.ts",
    "bench:latence": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/latence-ttuv.ts",
    "autonomy:bench:complet": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" AUTONOMY_MODE=complet DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/autonomy-bench.ts",
    "bench:ab": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/ab-temoin.ts",
    "bench:intentions": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/intentions-courtes.ts",
    "bench:chaine": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/chaine-humaine.ts",
    "bench:horizon": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/horizon-long.ts",
    "bench:live": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx --",
    "bench:bibliotheque": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/bibliotheque.ts",
    "bench:smoke": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/smoke-fournisseur.ts",
    "sonde:conversation": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/sonde-conversation.ts",
    "bench:site-web": "NODE_OPTIONS=\"--require ./scripts/proxy-dispatcher.cjs\" DATABASE_URL=\"${BENCH_DATABASE_URL:-postgresql://amd:amd@localhost:5432/amd_bench}\" tsx scripts/bench/site-web-liaison.ts"
  },
  "prisma": {
    "seed": "tsx prisma/bootstrap.ts"
  },
  "dependencies": {
    "@mastra/core": "1.79.0",
    "@prisma/client": "5.22.0",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^2.10.3",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "framer-motion": "^14.6.0",
    "imapflow": "^1.4.3",
    "jszip": "^3.10.1",
    "lucide-react": "0.446.0",
    "mailparser": "^3.9.12",
    "mammoth": "^1.12.0",
    "mupdf": "^1.28.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.2.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "pizzip": "^3.2.0",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "2.15.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "2.5.2",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "20.16.10",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "postcss": "8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.13",
    "tsx": "4.23.15",
    "typescript": "5.6.2",
    "undici": "^6.28.1",
    "vitest": "2.1.9"
  },
  "overrides": {
    "postcss": "$postcss",
    "image-size": "2.0.4"
  }
}
