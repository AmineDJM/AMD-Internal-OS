enum SponsoringStatus {
  RECEIVED
  IN_ANALYSIS
  ACCEPTED
  REFUSED
  AWAITING_DIRECTION
  PAID
  CLOSED
  // Circuit de validation (calqué congrès) + appel
  AWAITING_PRELIMINARY // attente validation préliminaire (Direction)
  PRELIMINARY_APPROVED // validée préliminairement → analyse chef de produit
  AWAITING_FINAL // analyse faite → attente validation définitive (Direction)
  APPROVED // validée définitivement → ordre de dépense émis
  APPEAL_PENDING // appel du délégué → nouvel avis du chef de produit (sans budget)
  AWAITING_FINAL_APPEAL // avis d'appel rendu → décision définitive (Direction)
  CANCELLED
  /// TENUE PRÉ-VALIDÉE par la Direction Marketing (§118.151) : l'événement aura lieu, et les
  /// postes se préparent — devis, BC, factures. L'argent n'est pas encore validé : il le sera
  /// poste par poste, puis à la validation finale qui CLÔTURE la demande (`CLOSED`).
  PRE_VALIDATED
  /// RENVOYÉE POUR CORRECTION (audit 360°, R02 — §118.186) : une étape du circuit a rendu la main au
  /// demandeur, motif à l'appui. Rien n'est refusé : il corrige puis RESOUMET, et la demande revient
  /// à l'étape qui l'a renvoyée. Ni « en attente de décision » (personne ne décide), ni « refusée ».
  RETURNED
}

/// LA NATURE D'UN SPONSORING (§118.151) — et donc le poste créé avec la demande.
/// DIRECT : l'argent va à l'association ; INDIRECT : la société prend en charge des prestations
