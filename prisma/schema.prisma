  businessUnit     BusinessUnit?     @relation("AdProCongressInternational", fields: [businessUnitId], references: [id], onDelete: SetNull)
  custom           Json? // admin-defined dynamic fields
  id               String            @id @default(cuid())
  /// Référentiel R2 : l'Organisation réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  organisationId   String?
  organisation     Organisation?     @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  companyId        String? // entité de rattachement (Adventum / Pharmagène / …)
  company          Company?          @relation(fields: [companyId], references: [id])
  name             String
  eventType        NationalEventType @default(CONGRESS) // type d'événement (congrès, séminaire, formation…)
  country          String?
  city             String?
  startDate        DateTime?
  endDate          DateTime?
  specialty        String?
  participants     String? // participants Adventum
  invitedDoctors   String?
  products         String?
  plannedBudget    Decimal?          @db.Decimal(14, 2)
  actualBudget     Decimal?          @db.Decimal(14, 2)
  status           CongressStatus    @default(CONSIDERED)
  hotel            String?
  flight           String?
  visa             String?
  registration     String?
  linkedSponsoring String?
  postEventReport  String?
  generatedLeads   String? // opportunités générées

  // ─── Demande de prise en charge (workflow) ───
  requesterId          String? // délégué / superviseur qui fait la demande
  requestStatus        CongressRequestStatus @default(AWAITING_PRELIMINARY)
  estimatedBudget      Decimal?              @db.Decimal(14, 2) // budget estimé par le demandeur
  invitedDoctorIds     String[]              @default([]) // médecins invités (depuis Promotion médicale)
  initiative           String? // « DEMANDEUR » (mon initiative) | « MEDECIN » (initiative du médecin) — Direction, 07/10
  participantIds       String[]              @default([]) // participants Adventum (users)
  productManagerId     String? // chef de produit assigné à l'analyse
  productManagerBudget Decimal?              @db.Decimal(14, 2) // budget proposé par le chef de produit
  productManagerNotes  String?
  preliminaryById      String?
  preliminaryAt        DateTime?
  preliminaryNote      String?
  finalById            String?
  finalAt              DateTime?
  finalNote            String?
  finalAmount          Decimal?              @db.Decimal(14, 2) // montant accordé par la Direction à la validation définitive
  rejectionReason      String?
  expenseOrderId       String? // ordre de dépense émis après validation définitive
  beneficiaries        Json? // personnes prises en charge : [{ id, name, role }] (pièces d'identité = Documents catégorie ID_DOCUMENT, stepKey = id)

  /// FICHES VOYAGEUR (Direction, 10/2026) — voir `src/lib/care-fiches.ts`. Le MODE dit où vivent les prix : sur chaque
  /// fiche (individuelle) ou par catégorie pour tout le groupe (de groupe).
  careMode                 CareMode @default(INDIVIDUAL)
  /// LE TAUX USD → DZD FIGÉ SUR LA DEMANDE : à l'international, tout sauf la billetterie se saisit en dollars et entre au
  /// budget à CE taux (240 par défaut, `TAUX_USD_DZD_DEFAUT`). Figé pour que le budget d'une demande ne bouge pas seul.
  usdDzdRate               Decimal? @db.Decimal(10, 4)
  /// « Initiative du médecin » : le ou les médecins de l'annuaire À L'ORIGINE de la demande — pas une prise en charge.
  initiativeDoctorIds      String[] @default([])
  /// Le sujet ouvert pour l'assistante de direction (réservations, puis BC) — `Dossier.id`.
  careReservationDossierId String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careBeneficiaries CareBeneficiary[]
  careQuotes        CareQuote[]
  careGroupPostes   CareGroupPoste[]

  /// Postes (consulting, traiteur, salle…) validés un par un — voir AdProItem.
  items AdProItem[]

  @@index([status])
  @@index([startDate])
  @@index([requestStatus])
  @@index([requesterId])
  @@index([companyId])
  @@index([organisationId])
}

model CongressNational {
  /// LA BUSINESS UNIT qui porte cette demande — c'est SON budget Ad&Pro qui est engagé.
  /// Sans elle, la dépense pesait sur un total commercial que personne ne pouvait
  /// répartir : « combien la gamme oncologie a-t-elle dépensé ? » n'avait pas de réponse.
  businessUnitId   String?
  businessUnit     BusinessUnit?  @relation("AdProCongressNational", fields: [businessUnitId], references: [id], onDelete: SetNull)
  custom           Json? // admin-defined dynamic fields
  id               String         @id @default(cuid())
  /// Référentiel R2 : l'Organisation réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  organisationId   String?
  organisation     Organisation?  @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  companyId        String? // entité de rattachement (Adventum / Pharmagène / …)
  company          Company?       @relation(fields: [companyId], references: [id])
  name             String
  country          String? // optionnel — un événement « national » peut se tenir hors d'Algérie
  city             String?
  hostInstitution  String? // hôpital / association
  date             DateTime?
  /// Fin de l'événement (décision du 04/10/2026) — `date` en est le début.
  endDate          DateTime?
  specialty        String?
  presentDoctors   String?
  promotedProducts String?
  budget           Decimal?       @db.Decimal(14, 2)
  hasBooth         Boolean        @default(false)
  hasSymposium     Boolean        @default(false)
  linkedSponsoring String?
  presentDelegates String?
  status           CongressStatus @default(CONSIDERED)
  finalReport      String?

  // ─── Demande de prise en charge (workflow) ───
  eventType            NationalEventType     @default(CONGRESS)
  requesterId          String?
  requestStatus        CongressRequestStatus @default(AWAITING_PRELIMINARY)
  estimatedBudget      Decimal?              @db.Decimal(14, 2)
  invitedDoctorIds     String[]              @default([])
  initiative           String? // « DEMANDEUR » (mon initiative) | « MEDECIN » (initiative du médecin) — Direction, 07/10
  participantIds       String[]              @default([])
  productManagerId     String?
  productManagerBudget Decimal?              @db.Decimal(14, 2)
  productManagerNotes  String?
  preliminaryById      String?
  preliminaryAt        DateTime?
  preliminaryNote      String?
  finalById            String?
  finalAt              DateTime?
  finalNote            String?
  finalAmount          Decimal?              @db.Decimal(14, 2) // montant accordé par la Direction à la validation définitive
  rejectionReason      String?
  expenseOrderId       String?
  beneficiaries        Json? // personnes prises en charge : [{ id, name, role }] (pièces d'identité = Documents catégorie ID_DOCUMENT, stepKey = id)

  /// FICHES VOYAGEUR (Direction, 10/2026) — mêmes champs qu'à l'international ; ici tout se saisit en DZD (`usdDzdRate` reste nul).
  careMode                 CareMode @default(INDIVIDUAL)
  usdDzdRate               Decimal? @db.Decimal(10, 4)
