/// RAPPEL personnel « en un clic » posé sur n'importe quel sujet (dossier réglementaire, demande du
/// secrétariat, e-mail, tâche, ou libre). À l'échéance (remindAt), un job planifié notifie le
/// propriétaire. link/entityType/entityId renvoient vers l'objet concerné.
model Reminder {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation("UserReminders", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  note        String?
  link        String?
  entityType  EntityType?
  entityId    String?
  remindAt    DateTime
  status      ReminderStatus @default(PENDING)
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, status])
  @@index([status, remindAt])
}

enum ReminderStatus {
  PENDING
  SENT
  DONE
  CANCELLED
}

/// Boîte mail personnelle d'un employé (Infomaniak), connectée à la plateforme.
/// Le mot de passe d'application est chiffré (AES-256-GCM) ; IMAP (lecture) + SMTP
/// (envoi) côté serveur uniquement. Un compte par utilisateur.
model MailAccount {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation("UserMailAccount", fields: [userId], references: [id], onDelete: Cascade)
  email       String // adresse e-mail (login IMAP/SMTP)
  displayName String? // nom affiché à l'envoi
  signature   String?   @db.Text // signature ajoutée en bas des nouveaux messages (webmail)
  imapHost    String    @default("mail.infomaniak.com")
  imapPort    Int       @default(993)
  smtpHost    String    @default("mail.infomaniak.com")
  smtpPort    Int       @default(465)
  passwordEnc String // mot de passe d'application, chiffré (jamais en clair)
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// ───────────────────────── Messagerie Microsoft 365 ─────────────────────────
/// Microsoft reste la SOURCE DE VÉRITÉ des e-mails. PostgreSQL ne garde que ce qui permet de
/// fonctionner : la connexion de la personne, ses jetons CHIFFRÉS, les jetons de synchronisation
/// incrémentale, et les liens vers l'ERP. Aucun corps de message, aucune pièce jointe.

/// La connexion d'UNE personne à SA boîte Exchange Online. Une par utilisateur — l'isolation est
/// structurelle : toute requête part de `userId`, jamais d'un identifiant reçu de l'extérieur.
model MailConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation("UserMailConnection", fields: [userId], references: [id], onDelete: Cascade)
  provider        String    @default("microsoft")
  /// Adresse de la boîte servie (minuscule) — sert à l'affichage et au contrôle du pilote.
  address         String
  displayName     String?
  /// Identifiant du compte chez Microsoft — permet de détecter un changement de compte.
  homeAccountId   String?
  /// Jetons chiffrés AES-256-GCM. Jamais rendus au navigateur, jamais journalisés.
  accessTokenEnc  String?   @db.Text
  refreshTokenEnc String?   @db.Text
  expiresAt       DateTime?
  /// Droits réellement accordés par Microsoft — un consentement partiel doit se voir.
  grantedScopes   String?   @db.Text
  /// Signature HTML ajoutée aux nouveaux messages.
  signature       String?   @db.Text
  /// `connected` | `needs-reconnect` — l'écran doit distinguer « en panne » de « à reconnecter ».
  status          String    @default("connected")
  lastError       String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  folders MailFolderState[]
  links   MailLink[]
}

/// État de synchronisation d'UN dossier : le jeton de delta et les compteurs. Pas les messages.
model MailFolderState {
  id            String         @id @default(cuid())
  connectionId  String
  connection    MailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  folderId      String
  displayName   String?
  wellKnown     String?
  /// Jeton de delta CHIFFRÉ : il vaut un droit de lecture sur le dossier chez Microsoft.
  deltaTokenEnc String?        @db.Text
  unread        Int            @default(0)
  total         Int            @default(0)
  lastSyncAt    DateTime?
  updatedAt     DateTime       @updatedAt

  @@unique([connectionId, folderId])
}

/// Ce qui relie un mail (ou une de ses pièces) à l'ERP : un fichier enregistré dans le Drive, un
/// message associé à un produit Regulatory… On garde l'identifiant Microsoft, jamais le contenu.
model MailLink {
  id            String         @id @default(cuid())
  connectionId  String
  connection    MailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messageId     String
  /// Pièce jointe concernée, quand le lien en vise une.
  attachmentId  String?
  /// Provenance conservée pour l'audit : qui a écrit, quand, et quel objet.
  senderAddress String?
  sentAt        DateTime?
  subject       String?
  /// Objet ERP associé (`REGULATORY_PRODUCT`, `DOSSIER`, `SUPPLIER`…) — vide si simple copie Drive.
  entityType    String?
  entityId      String?
  /// Nœud Drive créé par « Enregistrer dans Drive ».
  driveNodeId   String?
  createdById   String
  createdAt     DateTime       @default(now())

  @@index([connectionId, messageId])
  @@index([entityType, entityId])
}

// ───────────────────────────── Regulatory ─────────────────────────────

/// Entité juridique / société du groupe (Adventum Pharma, Pharmagène, …). Dimension
/// TRANSVERSE : chaque enregistrement clé (produit, appel d'offres, employé, dépense,
/// vente, stock…) peut être rattaché à une entité. Le sélecteur d'entité (barre
/// supérieure) filtre toutes les vues ; « Toutes les entités » englobe l'ensemble
/// (y compris les non rattachés). Entièrement DYNAMIQUE : on peut créer une 3ᵉ (ou Nᵉ)
/// entité, la renommer, changer sa couleur, la désactiver — sans toucher au code.
/// QUI A LE DROIT DE VOIR QUELLE ENTITÉ.
///
/// Le sélecteur d'entité de la barre supérieure n'était qu'une **préférence d'affichage** : il
/// proposait toutes les entités à tout le monde, et rien n'empêchait quelqu'un d'Adventum de
/// basculer sur Pharmagène. Pour un groupe multi-entités c'est un défaut d'étanchéité, pas un
/// confort d'affichage.
///
/// Une personne peut être salariée d'une entité et travailler pour plusieurs : l'appartenance
/// (`Employee.companyId`) et le DROIT D'ACCÈS sont deux choses distinctes.
///
/// `canEdit` sépare voir et modifier : on donne souvent la lecture sur une entité voisine sans
/// le droit d'y écrire.
model UserCompanyAccess {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  canEdit   Boolean @default(false)

  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model Company {
  id          String   @id @default(cuid())
  /// Référentiel R2 : l'Organisation réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  organisationId String?
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name        String   @unique // raison sociale (« Adventum Pharma »)
  shortName   String? // libellé court affiché dans les pastilles (« Adventum »)
  color       String? // couleur de la pastille (hex, ex. « #2563eb »)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regulatoryProducts          RegulatoryProduct[]
  legalDocuments              LegalDocument[]
  mailEntries                 MailEntry[]
  recruitments                RecruitmentRequest[]
  pchTenders                  PchTender[]
  employees                   Employee[]
  promoMaterials              PromoMaterial[]
  consultingContracts         ConsultingContract[]
  adProOtherRequests          AdProOtherRequest[]
  paymentRequests             PaymentRequest[]
  promoStockItems             PromoStockItem[]
  medicalDoctors              MedicalDoctor[]
  financeTransactions         FinanceTransaction[]
  treasuryAccounts            TreasuryAccount[]
  demandesActualisationSoldes DemandeActualisationSoldes[]
  payrollWires                PayrollWire[]
  medicalInfoDeclarations     MedicalInfoDeclaration[]
  stockSnapshots              StockSnapshot[]
  logisticsOrders             LogisticsOrder[]
  sales                       Sale[]
  businessUnits               BusinessUnit[]
  departments                 Department[]
  userAccess                  UserCompanyAccess[]
  // Cloisonnement transverse : chaque demande, enveloppe et ordre de dépense appartient à
  // une société du groupe. Nullable côté enfant — un objet non rattaché reste visible en
  // vue « Toutes les entités » plutôt que de disparaître.
  sponsoringRequests          SponsoringRequest[]
  congressNational            CongressNational[]
  congressInternational       CongressInternational[]
  events                      Event[]
  budgetEnvelopes             BudgetEnvelope[]
  expenseOrders               ExpenseOrder[]
  administrativeRequests      AdministrativeRequest[]
  supportRequests             SupportRequest[]
  dossiers                    Dossier[]
  fieldReports                FieldReport[]
  Training                    Training[]
  productRanges               ProductRange[]
  legalIdentity               CompanyLegalIdentity?
  letterheads                 OfficeLetterhead[]
  documentProfile             CompanyDocumentProfile?
  documentSequences           DocumentSequence[]
  documentReferences          DocumentReference[]
  legalFolders                LegalFolder[]
  mailEntryFolders            MailEntryFolder[]
  medicalDirectories          MedicalDirectory[]
  companyContacts             CompanyContact[]
  DirectoryEntry              DirectoryEntry[]
  products                    Product[]
  directives                  Directive[]
  adamRules                   AdamRule[]
  bdProjects                  BdProject[]                  @relation("BdProjectCompany")

  @@index([isActive])
  @@index([organisationId])
}

/// LA CARTE D'IDENTITÉ LÉGALE ET FISCALE D'UNE ENTITÉ.
///
/// Ces coordonnées — RC, NIF, NIS, article d'imposition, RIB, adresse du siège — sont demandées
/// dix fois par mois : sur un appel d'offres, une facture, un contrat, un dossier bancaire. Elles
/// vivaient dans un vieux document Word que chacun recopiait de mémoire, avec les fautes de
/// frappe que cela suppose sur un numéro à quinze chiffres. Elles sont ici, à leur place — dans
/// LEGAL, module des engagements de la société — et se copient d'un clic.
///
/// Un seul jeu par entité (relation 1-1) : deux « identités fiscales » d'une même société
/// seraient exactement le doute qu'on vient lever.
model CompanyLegalIdentity {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Dénomination EXACTE telle qu'elle figure au registre — souvent différente du nom d'usage.
  legalName    String?
  legalForm    String? // SARL, SPA, EURL…
  shareCapital String? // en toutes lettres et en chiffres, tel qu'aux statuts
  /// Registre de commerce, identifiants fiscaux algériens.
  rcNumber     String? // n° du registre de commerce
  nif          String? // numéro d'identification fiscale
  nis          String? // numéro d'identification statistique
  taxArticle   String? // article d'imposition
  /// Coordonnées.
  headOffice   String? // adresse du siège social
  phone        String?
  email        String?
  website      String?
  /// Banque.
  bankName     String?
  bankAgency   String?
  rib          String? // relevé d'identité bancaire (20 chiffres)
  iban         String?
  swift        String?
  /// Représentation légale.
  managerName  String?
  managerTitle String?
  notes        String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// UNE GAMME — le regroupement de produits d'une entité (« Cardiologie », « Hôpital », …).
///
/// L'entité dit DE QUI est le produit ; la gamme dit DE QUOI il relève. Les deux ensemble
/// forment l'arbre qu'on lit en Administration : entité → gammes → produits. Une gamme
/// appartient à une seule entité (la supprimer ne supprime jamais un produit : le produit
/// reste, simplement sans gamme).
model ProductRange {
  id          String  @id @default(cuid())
  name        String
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description String?
  color       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  products   RegulatoryProduct[]
  userAccess UserProductRange[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Deux gammes du même nom dans la même entité n'auraient aucun sens : on ne saurait pas
  /// laquelle on rattache. Le même nom dans DEUX entités, en revanche, est normal.
  @@unique([companyId, name])
  @@index([companyId])
}

/// LE RATTACHEMENT D'UNE PERSONNE À UNE GAMME — plus fin que l'entité.
///
/// Quelqu'un rattaché à une entité voit tout ce qui est de cette entité. Quelqu'un rattaché
/// à une ou plusieurs GAMMES (de la même entité ou de plusieurs) ne voit que les produits de
/// ces gammes-là. C'est ce qui permet à un chef de produit de ne voir que sa gamme sans lui
/// fermer la société entière.
model UserProductRange {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rangeId String
  range   ProductRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)

  grantedById String?
  createdAt   DateTime @default(now())

  @@unique([userId, rangeId])
  @@index([userId])
  @@index([rangeId])
}

model RegulatoryProduct {
  companyId              String? // entité (Adventum / Pharmagène / …)
  company                Company?            @relation(fields: [companyId], references: [id])
  custom                 Json? // admin-defined dynamic fields
  // Suivi du processus officiel ANPP (22 étapes) et de la checklist de présoumission.
  // Stockés en JSON (définition des étapes/documents en code) : { [clé]: { status/checked, date, note } }.
  workflow               Json?
  checklist              Json?
  id                     String              @id @default(cuid())
  reference              String              @unique // human readable ID, e.g. REG-2026-001
  dci                    String // DCI canonique : molécule unique OU association (« A + B + C »)
  molecules              Json? // liste structurée des molécules (association double/triple…)
  brandName              String? // nom commercial envisagé
  dosage                 String? // valeur du dosage (ex. « 500 »)
  dosageUnit             String? // unité du dosage (mg, g, UI, %, mg/ml…)
  pharmaceuticalForm     String? // forme galénique (menu déroulant)
  // Conditionnement (« B/30 », « Tube 30 G ») : à dosage et forme identiques, c'est LUI qui
  // distingue deux dossiers — une boîte de 28 et une boîte de 56 sont deux enregistrements.
  packaging              String?
  therapeuticClass       String?
  /// SEGMENTS THÉRAPEUTIQUES — Oncologie, Gynécologie, Cardiologie…
  /// Une LISTE et non un texte : un produit sert souvent plusieurs segments, et « Oncologie,
  /// Gynéco » écrit à la main ne se compte ni ne se filtre. La classe thérapeutique reste, en
  /// texte : elle dit la classe pharmacologique, pas le marché visé.
  therapeuticSegments    String[]            @default([])
  partnerLab             String? // fournisseur / laboratoire partenaire
  countryOfOrigin        String?
  category               RegulatoryCategory  @default(MEDICINE) // médicament vs dispositif médical
  channel                ProductChannel      @default(BOTH) // canal : Ville / Hôpital / les deux
  productType            ProductType         @default(IMPORTED) // (legacy) conservé, non affiché
  // Statut de fabrication courant : démarre en Importation, évolue via les variations.
  manufacturingStatus    ManufacturingStatus @default(IMPORTATION)
  status                 RegulatoryStatus    @default(PRE_SUBMISSION)
  priority               Priority            @default(MEDIUM)
  targetSubmissionDate   DateTime? // date cible de dépôt du dossier (fixée par la supervision)
  targetDate             DateTime? // date cible d'enregistrement (fixée après le dépôt)
  comments               String?
  // Décision d'enregistrement : détenteur de la DE, et variation d'enregistrement
  // vers la fabrication locale (packaging secondaire / primaire / full process).
  // Si une variation locale est déclarée, le fabricant est OBLIGATOIRE.
  deHolder               String? // détenteur de la décision d'enregistrement
  manufacturingVariation String? // NONE | SECONDARY_PACKAGING | PRIMARY_PACKAGING | FULL_PROCESS
  manufacturer           String? // fabricant (obligatoire si variation locale)
  variationDate          DateTime? // date d'effet de la variation

  /// VERROU — dossier invisible pour toute l'équipe, y compris la Direction. Seul le Super
  /// Admin le voit et peut le déverrouiller (cadenas du tableau). Sert aux portefeuilles
  /// encore confidentiels : le filtre est posé dans `scopeRegulatory`, pas dans l'écran, pour
  /// qu'un dossier verrouillé ne puisse pas ressortir par une autre porte (recherche, stocks,
  /// assistant, portail fournisseur…).
  isLocked Boolean @default(false)

  /// GAMME — le regroupement métier du produit à l'intérieur de son entité (« Cardiologie »,
  /// « Hôpital »…). Facultatif : beaucoup de dossiers n'en relèvent d'aucune, et l'imposer
  /// aurait obligé à inventer une gamme pour chaque produit importé.
  rangeId String?
  range   ProductRange? @relation(fields: [rangeId], references: [id], onDelete: SetNull)

  /// PROJET BD — le classement stratégique du dossier, nommé par la direction dans Business
  /// Development (sous-module « Projets »).
  ///
  /// On RÉUTILISE `BdProject` au lieu d'ouvrir un second registre de projets : deux listes de
  /// projets divergeraient au premier renommage, et la question « ce dossier appartient-il au
  /// projet Oncologie 2027 ? » n'aurait plus une seule réponse (§118.5).
  ///
  /// `SetNull` à la suppression : perdre le classement d'un dossier est réparable ; perdre le
  /// dossier avec le projet ne l'est pas.
  bdProjectId String?
  bdProject   BdProject? @relation("BdProjectDossiers", fields: [bdProjectId], references: [id], onDelete: SetNull)

  responsibleId String?
  responsible   User?   @relation("RegulatoryResponsible", fields: [responsibleId], references: [id])
  assistantId   String?
  assistant     User?   @relation("RegulatoryAssistant", fields: [assistantId], references: [id])
  // Row-level access: only these users (plus privileged roles) see the line.
  assignedUsers User[]  @relation("RegulatoryAssignedUsers")

  steps           RegulatoryStep[]
  variations      RegulatoryVariation[] // variations de fabrication (Importation → packaging local)
  dossierSteps    RegulatoryDossierStep[] // la FRISE du dossier : CTD initial → réserves → versions
  stockMovements  StockMovement[] // mouvements de stock PCH rattachés à ce produit
  stockSnapshots  StockSnapshot[] // états de stock datés (PCH / hôpital / annexes)
  stockCountLines StockCountRequestLine[] // lignes des demandes de stocks (établissement × produit)
  regRequests     RegulatoryRequest[] // demandes de l'information médicale (PRIM) sur ce dossier

  // ─── Vue fournisseur (portail externe) — pilotée par l'équipe Regulatory ───
  // Le fournisseur ne voit QUE ces champs externes, jamais le statut/les notes
  // internes, et uniquement si portalVisible = true.
  supplierId             String?
  supplier               Supplier?                 @relation(fields: [supplierId], references: [id])
  portalVisible          Boolean                   @default(false)
  externalStatus         ExternalRegulatoryStatus?
  externalComment        String?
  externalNextStep       String?
  externalActionExpected String?
  externalDeadline       DateTime?
  externalNotify         Boolean                   @default(false)
  externalUpdatedAt      DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// LE CATALOGUE DE RÉFÉRENCE : les autres modules rattachent LEUR produit à celui-ci plutôt que
  /// de retaper la molécule à leur façon. Le rattachement reste facultatif — beaucoup de produits
  /// à l'étude n'ont pas encore de dossier — et il est toujours confirmé par une personne.
  bdProducts       BdProduct[]    @relation("BdProductDossier")
  promoProducts    PromoProduct[] @relation("PromoProductDossier")
  /// LE PRODUIT CANONIQUE dont ce dossier est le profil réglementaire. NULLABLE : un dossier
  /// importé sans rapprochement sûr reste sans produit plutôt que rattaché au mauvais.
  productId        String?
  canonicalProduct Product?       @relation("ProductRegulatoryProfile", fields: [productId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productId])
  @@index([bdProjectId])
  @@index([priority])
  @@index([responsibleId])
  @@index([assistantId])
  @@index([dci])
  @@index([supplierId])
  @@index([isLocked])
  @@index([rangeId])
}

// Variation de fabrication : après la DE d'un produit, on peut demander une variation
// vers un packaging local (secondaire / primaire / full process). Chaîne possible dans le temps.
model RegulatoryVariation {
  id           String              @id @default(cuid())
  productId    String
  product      RegulatoryProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  toStatus     ManufacturingStatus // cible de la variation (SECONDARY / PRIMARY / FULL_PROCESS)
  status       VariationStatus     @default(EN_ATTENTE)
  depotDate    DateTime? // date de dépôt de la variation
  decisionDate DateTime? // date de la décision (obtenue / annulée)
  manufacturer String? // fabricant associé à la variation
  note         String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([productId])
}

// ─────────────────────────── Demandes de recrutement ───────────────────────────
// Un directeur formule le besoin, sa hiérarchie valide marche par marche jusqu'au PDG, les RH
// instruisent (et peuvent demander des précisions), puis le poste s'ouvre : CV reçus,
// présélection par le demandeur, choix du PDG, entretiens, et enfin l'intégration — sauf pour un
// consulting, qui reste un intervenant externe.

enum RecruitmentStage {
  CHAIN
  HR_REVIEW
  INFO_REQUESTED
  SOURCING
  ONBOARDING
  CLOSED
  REJECTED
  CANCELLED
  /// Renvoyée pour correction (audit 360°, lot C4d1, §118.192) : la balle est chez le demandeur, qui
  /// corrige et renvoie ; voir `returnedFrom`.
  RETURNED
}

enum RecruitmentApprovalState {
  PENDING
  APPROVED
  REJECTED
  /// Marche NON CONSULTÉE : le PDG a tranché depuis une marche supérieure. On ne l'inscrit pas
  /// « approuvée » — écrire qu'un N+1 a validé alors qu'il n'a rien vu serait un faux.
  SKIPPED
}

enum RecruitmentCandidateStatus {
  RECEIVED
  SHORTLISTED
  SELECTED
  INTERVIEWED
  HIRED
  DECLINED
}

model RecruitmentRequest {
  id           String      @id @default(cuid())
  reference    String      @unique // REC-2026-001
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  /// Le département POUR LEQUEL on recrute — pas celui du demandeur, qui peut recruter pour un
  /// sous-département dont il a la charge.
  departmentId String?
  department   Department? @relation("RecruitmentDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  requesterId  String
  requester    User        @relation("RecruitmentRequester", fields: [requesterId], references: [id])

  position      String
  headcount     Int          @default(1)
  contractType  ContractType
  /// Fourchette de rémunération mensuelle brute (DZD). Les deux bornes sont facultatives : un
  /// poste se pose souvent « à partir de », et forcer un maximum inventerait un plafond.
  salaryMin     Decimal?     @db.Decimal(12, 2)
  salaryMax     Decimal?     @db.Decimal(12, 2)
  startDate     DateTime?
  /// Terme du contrat — obligatoire pour un CDD, un stage ou un consulting, interdit sur un CDI.
  endDate       DateTime?
  missions      String?
  skills        String?
  justification String?

  stage        RecruitmentStage  @default(CHAIN)
  /// Décision finale des RH / de la direction, en clair, quand la demande se clôt.
  closingNote  String?
  closedAt     DateTime?
  /// LE RENVOI POUR CORRECTION (audit 360°, lot C4d1, R14 — §118.192). Qui a renvoyé, quand, pourquoi, et
  /// D'OÙ (`CHAIN` ou `HR_REVIEW`) : une correction qui ne touche rien de ce que les validateurs ont pesé
  /// revient là ; une correction matérielle fait repartir la chaîne. L'histoire va au fil de la demande.
  returnedFrom RecruitmentStage?
  returnedAt   DateTime?
  returnedById String?
  returnNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals       RecruitmentApproval[]
  infoRequests    RecruitmentInfoRequest[]
  candidates      RecruitmentCandidate[]
  /// L'offre publiée sur le site public, si les RH en ont préparé une (§118.158).
  jobPosting      JobPosting?
  /// LE N+1 DE LA FUTURE RECRUE et LES PERSONNES EN CHARGE DU SUIVI — décidés par le DG quand il valide (Direction, 07/10).
  futureManagerId String?
  futureManager   User?                    @relation("RecruitmentFutureManager", fields: [futureManagerId], references: [id], onDelete: SetNull)
  followers       RecruitmentFollower[]
  /// LES CANAUX DE DIFFUSION de l'offre (site, LinkedIn, Emploitic…) — choisis par les RH (Direction, 07/10).
  channelPosts    RecruitmentChannelPost[]

  @@index([stage])
  @@index([requesterId])
  @@index([departmentId])
  @@index([companyId, stage])
}

/// Une MARCHE de la chaîne hiérarchique, figée à la soumission.
///
/// Figée, parce qu'une réorganisation en cours de route changerait les validateurs d'une demande
/// déjà partie — et l'on ne saurait plus qui devait trancher quand elle a été déposée.
model RecruitmentApproval {
  id         String                   @id @default(cuid())
  requestId  String
  request    RecruitmentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order      Int
  approverId String
  approver   User                     @relation("RecruitmentApprover", fields: [approverId], references: [id])
  status     RecruitmentApprovalState @default(PENDING)
  reason     String?
  decidedAt  DateTime?
  createdAt  DateTime                 @default(now())

  @@unique([requestId, order])
  @@index([approverId, status])
}

/// Une PRÉCISION demandée par les RH, et la réponse du demandeur.
///
/// Ce va-et-vient est le cœur du travail RH, pas une exception : compétences attendues,
/// rémunération, tâches, dates, type de contrat. Il est donc historisé, question par question.
model RecruitmentInfoRequest {
  id           String             @id @default(cuid())
  requestId    String
  request      RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  askedById    String
  askedBy      User               @relation("RecruitmentInfoAsker", fields: [askedById], references: [id])
  question     String
  answer       String?
  answeredById String?
  answeredBy   User?              @relation("RecruitmentInfoAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([requestId, createdAt])
}

/// Un CV REÇU, et son parcours jusqu'à l'embauche.
///
/// Le pipeline vit ICI et non sur la demande : plusieurs candidats avancent en parallèle, à des
/// vitesses différentes. Une demande qui porterait un seul état « en entretien » ne saurait pas
/// dire de qui elle parle.
model RecruitmentCandidate {
  id        String                     @id @default(cuid())
  /// Référentiel R1 : la Personne réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  personneId String?
  personne  Personne?                  @relation(fields: [personneId], references: [id], onDelete: SetNull)
  requestId String
  request   RecruitmentRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fullName  String
  email     String?
  phone     String?
  /// D'où vient le CV (candidature spontanée, cabinet, cooptation…). Texte libre : les sources
  /// changent tout le temps et une liste fermée serait fausse dès le mois suivant.
  source    String?
  notes     String?
  status    RecruitmentCandidateStatus @default(RECEIVED)

  addedById       String?
  addedBy         User?     @relation("RecruitmentCandidateAdder", fields: [addedById], references: [id], onDelete: SetNull)
  shortlistedById String?
  shortlistedAt   DateTime?
  selectedById    String?
  selectedAt      DateTime?
  interviewAt     DateTime?
  interviewNote   String?
  decidedAt       DateTime?

  /// Fiche employé créée à l'intégration. Absente pour un consulting — un consultant externe
  /// n'entre pas dans l'effectif.
  employeeId      String?          @unique
  employee        Employee?        @relation("RecruitmentHire", fields: [employeeId], references: [id], onDelete: SetNull)
  /// La candidature du SITE PUBLIC dont ce candidat est issu, quand il vient de là (§118.159).
  siteCandidature SiteCandidature?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, status])
  @@index([personneId])
}

/// RELANCE DE MISE À JOUR — « où en sont vos dossiers ? », posé par la direction.
///
/// Une ligne PAR PERSONNE relancée, même quand la relance visait tout le monde d'un coup : c'est
/// ce qui permet d'afficher « dernière relance il y a 3 jours » en face de chacun, et donc de ne
/// pas harceler quelqu'un qu'on vient de relancer. Une seule ligne « relance groupée » n'aurait
/// pas répondu à cette question, qui est la seule qu'on pose à cet historique.
model RegulatoryUpdateReminder {
  id           String   @id @default(cuid())
  recipientId  String
  recipient    User     @relation("RegUpdateReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// Qui a relancé. Null si le compte a été supprimé depuis — la relance, elle, a bien eu lieu.
  senderId     String?
  sender       User?    @relation("RegUpdateReminderSender", fields: [senderId], references: [id], onDelete: SetNull)
  /// Dossiers à traiter que la personne portait AU MOMENT de la relance : relu des mois plus
  /// tard, « 12 dossiers » explique la relance mieux que le portefeuille d'aujourd'hui.
  dossierCount Int      @default(0)
  /// Parmi eux, ceux sans mouvement depuis le seuil de sommeil.
  staleCount   Int      @default(0)
  /// Vrai si la relance visait TOUT LE MONDE, faux si elle ne visait que cette personne.
  toEveryone   Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([createdAt])
}

/// LA NATURE D'UNE ÉTAPE DE LA FRISE. Le CTD initial est à part : c'est le point de départ,
/// il n'y en a qu'un, et on ne le supprime pas — une frise sans origine ne se lit plus.
enum RegulatoryDossierStepKind {
  CTD_INITIAL // le dépôt d'origine — toujours la première étape
  ANPP_RESERVES // réserves reçues de l'ANPP
  ANPP_RESPONSE // réponse du laboratoire aux réserves
  CTD_VERSION // une version redéposée du CTD (v2, v3…)
  DECISION // décision de l'agence (DE, refus, complément)
  OTHER // autre — le libellé fait alors tout le sens
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LA FRISE DU DOSSIER — l'histoire du CTD, dans l'ordre où elle s'est produite.
///
/// « Réserves & réponses » était une pile de PDF à plat : on voyait DES pièces, jamais le
/// CHEMIN. Or un dossier réglementaire est une suite de cycles — on dépose, l'agence répond,
/// on redépose une version, elle répond encore — et c'est cette suite que le service doit
/// pouvoir relire un an plus tard, quand personne ne se souvient de l'ordre.
///
/// Une étape porte SES pièces : elles se rattachent par `Document.stepKey` = l'id de l'étape,
/// exactement comme les pièces des étapes ANPP. Aucune table de pièces jointes n'est créée
/// pour l'occasion — il en existe déjà une, avec sa route protégée, sa réplication vers le
/// Drive, son renommage et sa corbeille.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model RegulatoryDossierStep {
  id          String                    @id @default(cuid())
  productId   String
  product     RegulatoryProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind        RegulatoryDossierStepKind
  /// Le nom que l'équipe donne à l'étape (« Réserves du 12/03 », « CTD v2 — module 3 revu »).
  label       String
  /// Numéro de version, pour une étape CTD_VERSION. Libre : v2, v3… ou tout autre numéro.
  version     Int?
  /// Rang dans la frise. Une insertion « juste après » décale les suivants — l'ordre AFFICHÉ
  /// est l'ordre RÉEL, et non une date de création qui ne dirait pas la même chose.
  order       Int
  /// Quand cela s'est passé (réception des réserves, dépôt de la version) — souvent différent
  /// du jour où on le saisit.
  occurredAt  DateTime?
  note        String?
  createdById String?
  createdBy   User?                     @relation("DossierStepAuthor", fields: [createdById], references: [id])
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([productId, order])
}

model RegulatoryStep {
  id          String             @id @default(cuid())
  productId   String
  product     RegulatoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        RegulatoryStepType
  order       Int
  status      StepStatus         @default(NOT_STARTED)
  plannedDate DateTime?
  actualDate  DateTime?
  responsible String?
  comment     String?
  missingDocs String? // pièces manquantes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, type])
  @@index([productId])
  @@index([status])
}

// ───────────────────────────── Sponsoring ─────────────────────────────

model SponsoringRequest {
  /// LA BUSINESS UNIT qui porte cette demande — c'est SON budget Ad&Pro qui est engagé.
  /// Sans elle, la dépense pesait sur un total commercial que personne ne pouvait
  /// répartir : « combien la gamme oncologie a-t-elle dépensé ? » n'avait pas de réponse.
  businessUnitId      String?
  businessUnit        BusinessUnit?     @relation("AdProSponsoringRequest", fields: [businessUnitId], references: [id], onDelete: SetNull)
  custom              Json? // admin-defined dynamic fields
  id                  String            @id @default(cuid())
  /// Référentiel R2 : l'Organisation réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  organisationId      String?
  organisation        Organisation?     @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  companyId           String? // entité de rattachement (Adventum / Pharmagène / …)
  company             Company?          @relation(fields: [companyId], references: [id])
  reference           String            @unique
  requestDate         DateTime          @default(now())
  requesterId         String?
  requester           User?             @relation(fields: [requesterId], references: [id])
  institution         String // institution / service / association
  doctor              String? // médecin concerné
  specialty           String?
  city                String?
  type                String // type de sponsoring
  description         String?
  amountRequested     Decimal?          @db.Decimal(12, 2)
  amountProposed      Decimal?          @db.Decimal(12, 2)
  amountGranted       Decimal?          @db.Decimal(12, 2)
  status              SponsoringStatus  @default(RECEIVED)
  strategicImportance Priority          @default(MEDIUM)
  product             String? // produit concerné
  expectedRoi         String?
  finalDecision       String? // commentaire final de la Direction (visible par le délégué)
  validatedBy         String?
  validationDate      DateTime?
  comments            String? // appréciation / recommandation du délégué
  /// Direct (à l'association) ou indirect (prise en charge) — décide le poste créé avec la demande (§118.151).
  nature              SponsoringNature?
  /// VALIDATION FINALE ET CLÔTURE (§118.151) — la Direction Marketing, une fois l'événement complété :
  /// chaque poste décidé et rangé dans un budget, le total accordé écrit dans `amountGranted`.
  closedAt            DateTime?
  closedById          String?
  closingNote         String?

  // Circuit de validation (règle du 27/10/2026, `lib/workflow/parcours.ts`) — PRÉVALIDATION :
  // N+1 (National Sales pour un délégué, sinon le Directeur des opérations) → Directeur des opérations
  // → Direction Marketing, qui prévalide la tenue (statut PRE_VALIDATED). Puis les POSTES, acceptés par la
  // Direction Marketing ; le DG valide le TOTAL au-dessus du seuil (`AdProPorteDg`) ; appel possible.
  // Les colonnes productManager* et final* sont celles des circuits antérieurs (historique conservé).
  preliminaryById      String?
  preliminaryAt        DateTime?
  preliminaryNote      String? // note interne de pré-validation (non visible par le délégué)
  productManagerId     String?
  productManagerBudget Decimal?  @db.Decimal(12, 2) // budget proposé par le chef de produit — CONFIDENTIEL
  productManagerNotes  String? // avis du chef de produit — CONFIDENTIEL (jamais montré au délégué)
  finalById            String?
  finalAt              DateTime?
  expenseOrderId       String? // ordre de dépense émis à la validation définitive
  appealById           String?
  appealAt             DateTime?
  appealReason         String? // motif de l'appel du délégué
  appealCount          Int       @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items AdProItem[]

  @@index([status])
  @@index([strategicImportance])
  @@index([requesterId])
  @@index([productManagerId])
  @@index([companyId])
  @@index([organisationId])
}

/// Nature d'un poste Ad & Pro. `PROMO_MATERIAL` est à part : ce poste ne se traite pas ici,
/// il POINTE vers un `PromoMaterial` qui suit son propre circuit (visa publicitaire,
/// conformité information médicale, agence, BAT).
enum AdProItemKind {
  STAND
  SYMPOSIUM
  PROMO_MATERIAL
  SERVICE
  TRAVEL
  CONSULTING
  CATERING
  VENUE
  /// Les QUATRE natures que la Direction a nommées (22/09/2026). Elles existaient dans les faits
  /// et se saisissaient en « Autre » ou en « Prestation » : un poste qu'on ne sait pas nommer se
  /// ventile mal, et le compte rendu de fin d'opération ne dit plus de quoi le montant est fait.
  ///
  /// `ACCOMMODATION` se distingue de `TRAVEL` (dont le libellé disait « Déplacement /
  /// hébergement » — une prose qui contredisait désormais le code) et `DINNER` de `CATERING` :
  /// un traiteur est un fournisseur de l'événement, un dîner est une prise en charge.
  ASSOCIATION_SUPPORT // Sponsoring association
  TICKETING // Prise en charge de la billetterie
  ACCOMMODATION // Prise en charge de l'hôtellerie
  DINNER // Prise en charge des dîners
  /// Le SPONSORING INDIRECT (§118.151) : la société ne verse rien à l'association, elle prend en
  /// charge des prestations ou des médecins. Pendant d'`ASSOCIATION_SUPPORT` (le sponsoring direct).
  INDIRECT_SUPPORT
  /// L'IMPRIMERIE (§118.175) — l'impression payée à un imprimeur pour l'occasion. Elle n'est pas
  /// le MATÉRIEL PROMOTIONNEL (visa, conformité, agence, BAT) : c'est l'une des natures qu'un
  /// sponsoring indirect prend en charge (« 400 000 d'imprimerie et 600 000 d'hôtellerie »).
  PRINTING
  /// LE MATÉRIEL DU STOCK (§118.167) : kakémonos, présentoirs, brochures, objets PRIS AU MAGASIN
  /// CENTRAL pour l'événement — réservés à l'accord du poste, confirmés après (remis, rendus,
  /// abîmés, perdus), le reste revenant au magasin. Il n'engage aucun argent : ni montant ni
  /// budget ne s'y exigent ; ses lignes sont dans `AdProStockLine`.
  STOCK_MATERIAL
  OTHER
}

/// CYCLE DE VALIDATION D'UN POSTE — chaque poste (consulting, traiteur, location de salle…) se
/// valide INDÉPENDAMMENT auprès de la Direction, qui accepte, refuse, ou demande à revoir le
/// budget — autant de fois qu'il le faut. `REVISION` renvoie la main au demandeur sans clore.
enum AdProItemStatus {
  DRAFT // en préparation : on décrit, on demande un devis, on joint les pièces
  PENDING // soumis à la Direction
  REVISION // budget à revoir — le demandeur corrige et resoumet
  APPROVED
  REJECTED
}

/// Un poste pèse-t-il SUR l'enveloppe déjà accordée, ou demande-t-il une RALLONGE ? La question
/// est posée à l'ajout : sans elle, un poste supplémentaire passerait pour un dépassement.
enum AdProItemBudgetKind {
  INCLUDED // déjà couvert par le budget accordé de l'opération
  ADDITIONAL // budget SUPPLÉMENTAIRE demandé en plus de l'enveloppe
}

/// ÉMISSION DU BON DE COMMANDE d'un poste accordé : demandée, visée par la Direction, puis
/// émise par les Finances (l'ordre de dépense naît à ce moment-là).
enum AdProItemOrderStage {
  NONE
  REQUESTED // demande d'émission déposée
  DIRECTION_OK // visa Direction obtenu — en attente des Finances
  ISSUED // paiement demandé : ordre de dépense émis (libellé « Paiement demandé (ordre émis) »)
  REFUSED
}

/// UN POSTE D'UNE OPÉRATION AD & PRO — de quoi est fait le montant.
///
/// Un sponsoring ou un congrès n'est presque jamais un simple chèque : il y a l'appui à
/// l'association ou les frais d'inscription, mais aussi le stand, le symposium, les brochures
/// produites pour l'occasion. Les modules ne portaient qu'un montant global : on ne savait ni de
/// quoi il était fait, ni à qui allait l'argent, et le matériel promotionnel produit pour
/// l'événement vivait sans aucun lien.
///
/// ⚠️ Un poste n'est PAS une demande : il ne déclenche aucun circuit de validation propre.
/// L'opération garde son circuit unique (prévalidation : N+1 → Directeur des opérations → Direction
/// Marketing, règle du 27/10/2026) et les postes en sont la ventilation : chacun est ACCEPTÉ par la
/// Direction Marketing (montant + budget), et le DG valide le TOTAL au-dessus du seuil (`AdProPorteDg`).
///
/// **Deux clés étrangères plutôt qu'un couple (type, id)** : une colonne polymorphe ne peut
/// pas porter de contrainte, donc supprimer un congrès laisserait ses postes orphelins. Ici la
/// suppression en cascade est garantie par la base. Ajouter les congrès internationaux ou les
/// événements se fera par une colonne de plus, pas par une refonte.
/// Exactement UN parent est renseigné (contrainte `AdProItem_one_parent`).
model AdProItem {
  id                      String                 @id @default(cuid())
  sponsoringId            String?
  sponsoring              SponsoringRequest?     @relation(fields: [sponsoringId], references: [id], onDelete: Cascade)
  congressNationalId      String?
  congressNational        CongressNational?      @relation(fields: [congressNationalId], references: [id], onDelete: Cascade)
  /// Les DEUX autres opérations Ad & Pro qui portent des postes : prises en charge
  /// internationales et événements. Une colonne de plus par module (jamais une colonne
  /// polymorphe) : la cascade reste garantie par la base.
  congressInternationalId String?
  congressInternational   CongressInternational? @relation(fields: [congressInternationalId], references: [id], onDelete: Cascade)
  eventId                 String?
  event                   Event?                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// LES DEMANDES « AUTRE » PORTENT AUSSI DES POSTES (Direction, 27/10/2026 : « les demandes autres suivent
  /// le même circuit ») : prévalidation, postes acceptés par la Direction Marketing, DG sur le total.
  otherRequestId          String?
  otherRequest            AdProOtherRequest?     @relation(fields: [otherRequestId], references: [id], onDelete: Cascade)
  /// Cinquième porteur de postes : une FORMATION organisée par les RH (location de salle,
  /// traiteur, intervenant…), validés un par un par la direction — exactement comme les
  /// postes d'un sponsoring.
  trainingId              String?
  training                Training?              @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  kind     AdProItemKind @default(OTHER)
  label    String
  notes    String?
  /// À QUI on paie ce poste : l'organisateur pour un stand, l'agence pour du matériel,
  /// l'association pour l'appui. C'est ce qui justifie un ordre de dépense par poste.
  supplier String?

  amountEstimated Decimal? @db.Decimal(14, 2) // estimation du demandeur
  amountGranted   Decimal? @db.Decimal(14, 2) // part de l'enveloppe affectée à ce poste

  /// Rattachement au circuit du matériel promotionnel (jamais recopié ici).
  promoMaterialId String?
  /// Ordre de dépense propre à ce poste — les bénéficiaires diffèrent, les pièces aussi.
  expenseOrderId  String?

  /// Ajouté APRÈS la décision définitive. Ne bloque rien — mais la ventilation dépasse alors
  /// l'enveloppe accordée, et l'écran doit le dire au lieu de le masquer.
  addedAfterDecision Boolean @default(false)

  /// ─── Validation propre au poste (Direction) ───
  status       AdProItemStatus     @default(DRAFT)
  budgetKind   AdProItemBudgetKind @default(INCLUDED)
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?

  /// Budget choisi APRÈS accord (catégorie d'enveloppe) — « comme d'habitude ».
  budgetCategoryId String?
  budgetCategory   BudgetCategoryLine? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)

  /// Demande administrative ouverte pour OBTENIR LE DEVIS (Bureau du secrétariat). Les devis
  /// déposés y sont joints, puis rattachés au poste pour la demande de validation.
  adminRequestId String?
  adminRequest   AdministrativeRequest? @relation("AdProItemQuoteRequest", fields: [adminRequestId], references: [id], onDelete: SetNull)

  /// ─── Émission du bon de commande (Direction puis Finances) ───
  orderStage         AdProItemOrderStage @default(NONE)
  orderRequestedAt   DateTime?
  orderRequestedById String?
  orderDirectionAt   DateTime?
  orderDirectionById String?
  /// LE MESSAGE DU DEMANDEUR, écrit au moment où il demande l'émission : contenu du bon de
  /// commande, références, coordonnées du fournisseur. C'est ce que l'assistante de direction
  /// lit pour l'ÉTABLIR, et ce que la Direction lit pour le viser. Il ne se réécrit jamais.
  orderNote          String?
  /// LA NOTE DE LA DIRECTION sur son visa ou son refus. Elle vivait dans `orderNote`, donc
  /// chaque visa EFFAÇAIT le message du demandeur — mesuré : trois écrivains, aucun lecteur,
  /// et la seule chose que le circuit devait transmettre disparaissait (§118.45).
  orderDecisionNote  String?
  /// L'EMPREINTE DU VISA (§118.187) : le montant et le prestataire que le centre a VUS en visant la
  /// demande de BC — ou ceux qui sont passés aux Finances sous le seuil. L'émission compare ce qui
  /// part à ce qui a été validé (`ad-pro/bc-poste.ts`) ; nulle sur un visa d'avant cette règle, et
  /// alors rien n'est comparé — on ne refuse pas ce qu'on ne sait pas lire.
  orderVisaAmount    Decimal?            @db.Decimal(14, 2)
  orderVisaSupplier  String?
  /// L'ASSISTANTE DE DIRECTION qui établit le bon de commande (§118.204). Choisie à la demande
  /// d'émission ; la demande de pièce lui part tout de suite sous le seuil, au visa du centre
  /// au-dessus. Nulle = aucune demande d'émission en cours.
  bcAssistantId      String?

  /// LA VALIDATION EN DEUX TEMPS (§118.204) — « d'abord la Direction des opérations, puis la
  /// Direction Marketing, qui sélectionne le budget ». Le premier temps se lit ICI, sur le poste
  /// encore `PENDING` ; le second est la décision (`status`, `decidedAt`). Nul = la Direction des
  /// opérations n'a pas encore validé.
  opsDecidedAt    DateTime?
  opsDecidedById  String?
  opsDecisionNote String?

  /// LA DÉPENSE DU POSTE AU BUDGET MARKETING (Direction, 10/2026 — « on sépare absolument une dépense engagée d'une
  /// dépense payée »). Une fois TOUS ses bons de commande signés, la Direction Marketing IMPUTE le poste à une catégorie
  /// d'une enveloppe marketing (`budgetCategoryId`) : la dépense devient ENGAGÉE. « Consommer » demande ensuite le
  /// paiement par le chemin du poste (centre de paiement, puis Finances) : consommée et payée se LISENT sur l'ordre de
  /// dépense, jamais recopiées ici. « Annuler » libère l'engagement. Règles pures : `lib/budget/depense-poste.ts`.
  depenseImputeeLe       DateTime?
  depenseImputeeParId    String?
  depenseAnnuleeLe       DateTime?
  depenseAnnuleeParId    String?
  depenseAnnulationMotif String?

  decisions  AdProItemDecision[]
  /// LES PIÈCES DU POSTE au registre Legal — devis / pro forma, bon de commande, facture (§118.204).
  pieces     AdProItemPiece[]
  /// Les articles du stock d'un poste « Matériel du stock » (§118.167).
  stockLines AdProStockLine[]

  /// Les lignes de devis VALIDÉES pour ce poste — ce que les bons de commande générés portent (§118.206).
  lignesDevisValidees AdProDevisLigne[] @relation("AdProDevisLigneValidee")

  /// LA RÉPARTITION D'UN SPONSORING INDIRECT (§118.175). L'imprimerie et l'hôtel sont deux
  /// fournisseurs : deux devis, deux BC, deux factures — donc deux postes, chacun avec sa chaîne.
  /// Les postes nés d'une même répartition portent le même identifiant (celui du premier, qui est
  /// le poste d'origine) : c'est ce qui permet à l'écran de les montrer ensemble, sous leur total.
  repartitionId        String?
  /// LE SUJET DE RÉSERVATION d'une billetterie, ouvert pour l'assistante de direction. Une
  /// seconde demande écrit dans le MÊME sujet au lieu d'en ouvrir un autre.
  reservationDossierId String?
  reservationDossier   Dossier?           @relation("AdProItemReservation", fields: [reservationDossierId], references: [id], onDelete: SetNull)
  /// Les voyageurs d'un poste « billetterie » (§118.175).
  voyageurs            AdProVoyageur[]
  /// Les fiches hôtellerie d'un poste « hôtellerie » — une par personne logée (Direction, 06/10).
  hebergements         AdProHebergement[]

  position           Int                      @default(0)
  createdById        String?
  updatedById        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  productAllocations AdProProductAllocation[]

  /// ─── L'INTÉGRATION DES DÉPENSES RÉELLES AD & PRO 2026 (Direction, 10/2026) ───
  /// Un poste HISTORIQUE est une dépense déjà réalisée et payée, reprise du fichier « Dépenses AP » : il ne passe par
  /// AUCUN circuit (ni validation, ni BC, ni centre de paiement, ni ordre de dépense) et compte au budget pour
  /// `montantPayeHistorique`, à la date `historiquePayeLe`, dans sa (sous-)catégorie `budgetCategoryId`. Le lot dit
  /// d'où il vient ; annuler le lot le retire (créé) ou le rend à son état d'avant (`historiqueAvant`, complété).
  historiqueLotId       String?
  historiqueLot         AdProIntegrationLot?    @relation("AdProItemHistorique", fields: [historiqueLotId], references: [id], onDelete: SetNull)
  /// La ligne du fichier (Feuil1) — la clé de rapprochement avec l'Excel.
  historiqueLigne       Int?
  montantPayeHistorique Decimal?                @db.Decimal(14, 2)
  historiquePayeLe      DateTime?
  /// L'état du poste AVANT qu'un lot ne le complète (budget, montants) — `null` pour un poste créé par le lot.
  historiqueAvant       Json?
  /// Deux porteurs de postes de plus, pour les seuls postes historiques : le DOSSIER DE MATÉRIEL PROMOTIONNEL (sa
  /// fabrication payée) et la DÉCLARATION D'INFORMATION MÉDICALE (le bon de versement du visa). La contrainte
  /// `AdProItem_one_parent` compte désormais sept parents.
  promoMaterialParentId String?
  promoMaterialParent   PromoMaterial?          @relation("AdProItemDossierPromo", fields: [promoMaterialParentId], references: [id], onDelete: Cascade)
  declarationInfoMedId  String?
  declarationInfoMed    MedicalInfoDeclaration? @relation("AdProItemDeclarationInfoMed", fields: [declarationInfoMedId], references: [id], onDelete: Cascade)

  @@index([historiqueLotId])
  @@index([promoMaterialParentId])
  @@index([declarationInfoMedId])
  @@index([sponsoringId])
  @@index([congressNationalId])
  @@index([congressInternationalId])
  @@index([eventId])
  @@index([otherRequestId])
  @@index([promoMaterialId])
  @@index([status])
  @@index([repartitionId])
  @@index([reservationDossierId])
  @@index([depenseImputeeLe])
}

/// UN VOYAGEUR D'UN POSTE « BILLETTERIE » (§118.175).
///
/// « On doit pouvoir sélectionner à chaque fois le nom de la personne, la date de départ, de
/// retour, téléverser le passeport — et donner de la flexibilité : on modifie les dates plus tard,
/// ou on n'a pas les informations à l'avance » (Direction, 01/10). D'où un nom OBLIGATOIRE et
/// tout le reste facultatif : on prend en charge un médecin avant de savoir quand il part.
///
/// Le PASSEPORT n'est pas une colonne : c'est un `Document` du poste (catégorie « pièce
/// d'identité ») dont `stepKey` est l'identifiant du voyageur — le téléversement, l'aperçu, les
/// droits et la corbeille sont ceux de toute pièce jointe d'un poste, jamais un second chemin.
model AdProVoyageur {
  id           String               @id @default(cuid())
  /// Référentiel R1 : la Personne réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  personneId   String?
  personne     Personne?            @relation(fields: [personneId], references: [id], onDelete: SetNull)
  itemId       String
  item         AdProItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Le NOM de famille. Un voyageur d'avant la séparation porte ici son nom COMPLET (`prenom` vide) :
  /// l'écran propose de le couper à la prochaine modification, rien n'est deviné en base.
  nom                String
  prenom             String?
  villeDepart        String?
  villeArrivee       String?
  dateDepart         DateTime?
  dateRetour         DateTime?
  notes              String?
  /// Les ÉTAPES d'un trajet à plusieurs destinations (`MULTI_DESTINATIONS`) : [{ de, vers, date }], dans
  /// l'ordre du voyage. Les champs ci-dessus en gardent la première étape et la dernière (lecteurs d'avant).
  segments           Json?
  /// Aller simple, aller-retour ou plusieurs destinations (§118.205). En aller simple, `dateRetour` est vidée.
  trajet             AdProTrajet          @default(ALLER_RETOUR)
  /// Le mode de transport — `null` : pas encore dit.
  transport          AdProTransport?
  position           Int                  @default(0)
  createdById        String?
  updatedById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  devis              AdProVoyageurDevis[]
  /// La demande de réservation de CETTE fiche chez l'assistante de direction — son état, jamais ses données.
  demandeReservation DemandeReservation?

  @@index([itemId])
  @@index([personneId])
}

enum AdProTrajet {
  ALLER_SIMPLE
  ALLER_RETOUR
  MULTI_DESTINATIONS
}

enum AdProTransport {
  AVION
  TRAIN
  BUS
  TAXI
}

/// LE DEVIS OU LA PRO FORMA D'UN VOYAGEUR (§118.205). La pièce est un devis DU POSTE
/// (`AdProItemPiece`, déposé par `ajouterDevisPoste`) : ce lien dit pour QUEL voyageur, sans second
/// circuit de pièces. Retirer le devis du poste emporte le lien (cascade). `retenuLe` : la proposition
/// validée par le demandeur — au plus une par voyageur (index partiel de la migration) ; les autres
/// sont écartées par construction.
model AdProVoyageurDevis {
  id          String         @id @default(cuid())
  voyageurId  String
  voyageur    AdProVoyageur  @relation(fields: [voyageurId], references: [id], onDelete: Cascade)
  pieceId     String         @unique
  piece       AdProItemPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  retenuLe    DateTime?
  retenuParId String?
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([voyageurId])
}

/// UNE FICHE HÔTELLERIE D'UN POSTE « HÔTELLERIE » (Direction, 06/10).
///
/// « Si c'est la prise en charge de l'hôtellerie, on fait une fiche hôtellerie pour chaque
/// personne. » Même forme que le voyageur : un nom OBLIGATOIRE, tout le reste facultatif (on loge
/// un médecin avant de connaître l'hôtel). Pas de devis par personne dans cette version : le devis
/// du poste suffit.
///
/// La PIÈCE D'IDENTITÉ n'est pas une colonne : c'est un `Document` du poste dont `stepKey` est
/// l'identifiant de la fiche — même chemin que le passeport d'un voyageur.
model AdProHebergement {
  id          String    @id @default(cuid())
  /// Référentiel R1 : la Personne réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  personneId  String?
  personne    Personne? @relation(fields: [personneId], references: [id], onDelete: SetNull)
  itemId      String
  item        AdProItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  nom         String
  prenom      String?
  hotel       String?
  ville       String?
  dateArrivee DateTime?
  dateDepart  DateTime?
  /// Libellé libre (Single, Double, Twin, Suite… — liste proposée par `ad-pro/hebergements.ts`).
  typeChambre        String?
  notes              String?
  position           Int                 @default(0)
  createdById        String?
  updatedById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  /// La demande de réservation de CETTE fiche chez l'assistante de direction — son état, jamais ses données.
  demandeReservation DemandeReservation?

  @@index([itemId])
  @@index([personneId])
}

/// L'ÉTAT D'UNE FICHE CHEZ L'ASSISTANTE DE DIRECTION (fiches de voyage, Direction 14/10/2026).
/// ENVOYEE → PRISE → DEVIS_RECU → RESERVEE ; branches MANQUE_SIGNALE (revient « à compléter » au demandeur),
/// MODIFIEE_APRES_ENVOI (« à renvoyer »), RETIREE. La machine d'états est `src/lib/reservation-fiche/etat.ts`.
enum EtatDemandeReservation {
  ENVOYEE
  PRISE
  DEVIS_RECU
  RESERVEE
  MANQUE_SIGNALE
  MODIFIEE_APRES_ENVOI
  RETIREE
}

enum NatureFicheReservation {
  BILLET
  HOTEL
}

/// LA DEMANDE DE RÉSERVATION D'UNE FICHE — une par fiche de billetterie ou d'hôtellerie, envoyée seule.
///
/// UNE SEULE VÉRITÉ : les données du voyage (nom, trajet, dates, passeport) restent sur la FICHE — voyageur
/// d'un poste Ad & Pro, fiche hôtellerie, ou poste billet / hôtel d'une prise en charge (`CareCell`). La
/// demande ne garde que l'ÉTAT : qui l'a prise, quand elle est partie, ses relances, l'EMPREINTE de la fiche
/// à l'envoi (ce qui permet de dire « modifiée après l'envoi » et de montrer ce qui a changé), et les pièces
/// du billet ou de la confirmation déposées par l'assistante. Le sujet DOS du poste reste le FIL.
///
/// Exactement une fiche (contrainte `DemandeReservation_une_fiche`). Toutes les écritures d'état sont
/// CONDITIONNELLES sur l'état lu (`updateMany`) : deux clics font un seul envoi, une seule prise.
model DemandeReservation {
  id                   String                 @id @default(cuid())
  nature               NatureFicheReservation
  voyageurId           String?                @unique
  voyageur             AdProVoyageur?         @relation(fields: [voyageurId], references: [id], onDelete: Cascade)
  hebergementId        String?                @unique
  hebergement          AdProHebergement?      @relation(fields: [hebergementId], references: [id], onDelete: Cascade)
  careCellId           String?                @unique
  careCell             CareCell?              @relation(fields: [careCellId], references: [id], onDelete: Cascade)
  /// Le POSTE Ad & Pro de la fiche, ou la PERSONNE d'une prise en charge — dénormalisés pour la file.
  itemId               String?
  careBeneficiaryId    String?
  /// L'OPÉRATION (sponsoring, prise en charge nationale / internationale, événement) et sa société.
  operationType        EntityType
  operationId          String
  companyId            String?
  /// Le SUJET (DOS) du poste ou de la prise en charge : le fil de discussion, où s'écrivent les événements.
  dossierId            String?
  etat                 EtatDemandeReservation @default(ENVOYEE)
  /// Qui a envoyé (le demandeur), quand — `premierEnvoiLe` ne bouge plus, `envoyeeLe` suit le dernier renvoi.
  demandeurId          String
  envoyeeLe            DateTime               @default(now())
  premierEnvoiLe       DateTime               @default(now())
  envois               Int                    @default(1)
  /// Les champs de la fiche au moment de l'envoi (`{ libellé: valeur }`). Nulle : reprise d'un envoi en bloc d'avant.
  empreinte            Json?
  priseParId           String?
  priseLe              DateTime?
  relances             Int                    @default(0)
  derniereRelanceLe    DateTime?
  manqueMotif          String?
  manqueLe             DateTime?
  manqueParId          String?
  modifieeLe           DateTime?
  /// Le devis de l'agence joint par l'assistante — par le circuit devis existant (demande de pièce du poste,
  /// ou devis de la prise en charge) : l'identifiant de ce qu'il a créé.
  devisRecuLe          DateTime?
  devisRef             String?
  reserveeLe           DateTime?
  reserveeParId        String?
  /// PNR du billet / n° de confirmation de l'hôtel.
  referenceReservation String?
  /// Le billet émis / la confirmation d'hôtel : `Document.id` (pièces de la fiche, `stepKey` = la fiche).
  pieceIds             String[]               @default([])
  retireeLe            DateTime?
  retraitMotif         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([etat])
  @@index([itemId])
  @@index([operationType, operationId])
  @@index([priseParId])
}

/// HISTORIQUE DES DÉCISIONS D'UN POSTE — « autant de fois qu'il le faut » : une demande de
/// révision n'écrase pas la précédente, elle s'ajoute. Sans cette trace, un poste accordé au
/// 3ᵉ tour ne dirait plus rien des deux refus qui l'ont précédé.
/// LE DEVIS OU LA PRO FORMA D'UN POSTE, LU ET STRUCTURÉ (§118.206) — « Luna doit directement, lors de
/// l'ingestion des devis à l'upload, les rendre mangeables et consommables par la plateforme ». La pièce
/// reste au registre Legal (`AdProItemPiece`, §118.204) ; ceci porte ce qu'on en a LU : le fournisseur,
/// la TVA, la taxe additionnelle, le total imprimé — et, dans `lignes`, les lignes que le demandeur valide
/// une à une. Une ligne lue est une PROPOSITION ; elle ne devient le prix de la société que validée par une
/// personne qui l'a comparée au papier (§118.152 i).
model AdProDevis {
  id              String            @id @default(cuid())
  legalDocumentId String            @unique
  legalDocument   LegalDocument     @relation("AdProDevisPiece", fields: [legalDocumentId], references: [id], onDelete: Cascade)
  /// Le fournisseur choisi dans l'ANNUAIRE (`CompanyContact`, sans clé étrangère : un contact supprimé laisse le nom du devis).
  supplierId      String?
  /// La TVA IMPRIMÉE sur le devis, en pour cent. `null` : le devis n'en porte pas — elle n'est JAMAIS devinée
  /// (pas de 19 par défaut) ; on la saisit depuis le papier, ou le bon de commande ne se génère pas.
  tvaRate         Decimal?          @db.Decimal(5, 2)
  /// Une taxe ADDITIONNELLE au HT, hors base de TVA (« Taxe Pub 2 % », §118.135).
  extraTaxLabel   String?
  extraTaxRate    Decimal?          @db.Decimal(5, 2)
  /// Le total HT imprimé sur le papier — pour CONTRÔLER les lignes, jamais pour calculer.
  announcedTotal  Decimal?          @db.Decimal(14, 2)
  /// L'IDENTITÉ DU FOURNISSEUR RECOPIÉE DU DEVIS (raison sociale, adresse, NIF, RC, RIB, téléphone, e-mail) quand il n'a
  /// pas de fiche dans l'annuaire : c'est elle que porte le bon de commande. Jamais devinée (étiquettes imprimées).
  fournisseurLu   Json?
  /// LE BROUILLON DU BON DE COMMANDE (« à vérifier par le demandeur », Direction 10/2026) : ce que le demandeur relit et corrige AVANT que le
  /// numéro NNN/DG/AAAA soit attribué et que le BC parte aux Finances. `null` : pas de brouillon. Forme : `lib/bons-de-commande/brouillon.ts`.
  bcBrouillon     Json?
  quoteDate       DateTime?
  /// La lecture (`LecturePiece`) dont viennent les lignes proposées, et d'où elles viennent, dit à la personne.
  lectureId       String?
  lectureNote     String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lignes          AdProDevisLigne[]
}

/// UNE LIGNE DE DEVIS DE POSTE — référence/désignation, unité, quantité, prix unitaire HT. `quantity` et
/// `unitPrice` peuvent être NULS : un chiffre illisible n'est pas deviné, la ligne attend d'être complétée
/// et ne se valide pas. `validatedItemId` : le poste pour lequel elle est VALIDÉE (au plus un : une ligne
/// ne se commande pas deux fois) ; `bcId` : le bon de commande qui la porte.
model AdProDevisLigne {
  id              String         @id @default(cuid())
  devisId         String
  devis           AdProDevis     @relation(fields: [devisId], references: [id], onDelete: Cascade)
  position        Int            @default(0)
  reference       String
  unit            String?
  quantity        Decimal?       @db.Decimal(14, 3)
  unitPrice       Decimal?       @db.Decimal(14, 2)
  /// Le rang de la ligne LUE dont elle vient (1-indexé) ; nul = saisie à la main.
  lue             Int?
  /// Ce qu'il faut vérifier sur le papier (chiffre illisible, remise lue…), dit à la personne.
  aVerifier       String?
  validatedItemId String?
  validatedItem   AdProItem?     @relation("AdProDevisLigneValidee", fields: [validatedItemId], references: [id], onDelete: SetNull)
  validatedAt     DateTime?
  validatedById   String?
  bcId            String?
  bc              LegalDocument? @relation("AdProDevisLigneBc", fields: [bcId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([devisId])
  @@index([validatedItemId])
  @@index([bcId])
}

/// LA NATURE D'UNE PIÈCE DE POSTE (§118.204) : la chaîne d'un achat, dans l'ordre où elle se lit.
enum AdProPieceNature {
  DEVIS // devis ou facture pro forma
  BON_DE_COMMANDE
  FACTURE
}

/// UNE PIÈCE DU REGISTRE LEGAL RATTACHÉE À UN POSTE (§118.204).
///
/// Un lien, jamais une copie : la pièce vit dans Legal (§17 — un seul registre), avec sa chaîne
/// (`chainFromId`), sa signature et son règlement. Un DEVIS peut couvrir plusieurs postes (« deux,
/// trois, quatre natures pour un seul et même devis ») : une ligne par poste couvert. Un bon de
/// commande et une facture appartiennent à UN poste.
model AdProItemPiece {
  id              String              @id @default(cuid())
  itemId          String
  item            AdProItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  legalDocumentId String
  legalDocument   LegalDocument       @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  nature          AdProPieceNature
  createdById     String?
  createdAt       DateTime            @default(now())
  /// Le voyageur pour qui ce devis a été déposé (billetterie, §118.205) — `null` pour tout autre devis.
  voyageur        AdProVoyageurDevis?

  @@unique([itemId, legalDocumentId])
  @@index([legalDocumentId])
}

model AdProItemDecision {
  id       String          @id @default(cuid())
  itemId   String
  item     AdProItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  decision AdProItemStatus // PENDING (soumission) | APPROVED | REJECTED | REVISION
  note     String?
  amount   Decimal?        @db.Decimal(14, 2) // montant en jeu au moment de la décision
  byId     String?
  by       User?           @relation("AdProItemDecider", fields: [byId], references: [id], onDelete: SetNull)
  at       DateTime        @default(now())

  @@index([itemId, at])
}

// ───────────────────────────── Budgets ─────────────────────────────

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// L'INTÉGRATION DES DÉPENSES RÉELLES AD & PRO 2026 (Direction, 10/2026 — maquette « adpro-integration » validée).
///
/// Un LOT = un fichier « Dépenses AP » intégré d'un bloc dans une enveloppe : chaque dépense rejoint sa demande Ad & Pro
/// (créée « Historique 2026 », ou existante complétée), avec ses postes payés, ses pièces attendues et son imputation.
/// Une fois le lot posé, le budget de l'enveloppe se calcule par la règle pure `budget/integration-regle.ts` (postes
/// historiques + ce qui naît après `integreLe`, jamais deux fois la même dépense). Un lot s'ANNULE d'un bloc
/// (`annuleLe`) : rien n'est effacé du livre de trésorerie, aucun ordre de dépense n'est créé ni touché.
/// Un seul lot actif par enveloppe (index partiel `AdProIntegrationLot_actif`, posé par la migration).
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model AdProIntegrationLot {
  id                String         @id @default(cuid())
  envelopeId        String
  envelope          BudgetEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  /// La version du module de décisions (`budget-marketing/integration-2026.ts`) appliquée.
  configVersion     String
  fichierNom        String
  /// SHA-256 du fichier lu — le même fichier se reconnaît.
  fichierSha256     String
  /// Le fichier, rangé comme pièce du lot (`Document` BUDGET), quand il a pu l'être.
  fichierDocumentId String?
  total             Decimal        @db.Decimal(14, 2)
  /// LA DATE D'INTÉGRATION — ce qui naît après compte au budget ; ce qui existait avant est remplacé par le fichier.
  integreLe         DateTime       @default(now())
  creeParId         String?
  annuleLe          DateTime?
  annuleParId       String?
  annulationMotif   String?
  /// Le budget de l'enveloppe AVANT le lot, par catégorie et sous-catégorie (consommé, engagé) — l'annulation se vérifie contre lui.
  instantaneAvant   Json
  /// Ce qui a été lu et décidé, ligne par ligne (le plan validé).
  lignes            Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  demandes       AdProIntegrationDemande[]
  decisions      AdProIntegrationDecision[]
  postes         AdProItem[]                @relation("AdProItemHistorique")
  rapprochements AdProRapprochement[]

  @@index([envelopeId])
  @@index([annuleLe])
}

/// LE RAPPROCHEMENT AD & PRO (Direction, 14/10/2026) — une décision HUMAINE sur une proposition du moteur
/// (`budget-marketing/rapprochement.ts`) : une DÉPENSE hors poste (écriture FIN-, ligne budgétaire, ordre) rattachée à une
/// demande / un poste du lot — elle en devient la preuve de paiement et ne compte plus deux fois (règle
/// `budget/integration-regle.ts`, lue par `queries/budget-integration.ts`) — ou signalée « pas Ad & Pro » ; une PIÈCE de la
/// plateforme rattachée à une pièce attendue d'une demande (lien, jamais une copie). Rien n'est rattaché sans cette ligne ;
/// annuler la remplit (`annuleLe`) et défait l'effet — le livre de trésorerie et les ordres ne sont jamais touchés.
model AdProRapprochement {
  id                String              @id @default(cuid())
  lotId             String
  lot               AdProIntegrationLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  /// DEPENSE · PIECE
  sens              String
  /// `TX:<écriture>` · `LIGNE:<ligne budgétaire>` · `ORDRE:<ordre>` · `DOC:<document>` · `DRIVE:<nœud>` · `MSG:<pièce jointe>`
  source            String
  sourceLibelle     String
  montant           Decimal?            @db.Decimal(14, 2)
  /// ACCEPTEE · REFUSEE · PAS_ADPRO
  decision          String
  demandeRowId      String?
  demandeType       String?
  demandeId         String?
  posteId           String?
  /// La pièce attendue couverte (`piecesAttendues[].cle`) — une PIÈCE seulement.
  pieceCle          String?
  /// CERTAINE · PROBABLE · POSSIBLE — la certitude de la proposition décidée.
  certitude         String?
  score             Int                 @default(0)
  justification     String              @default("")
  /// « Pas Ad & Pro » : l'enveloppe plausible proposée (rien n'est imputé).
  enveloppeSuggeree String?
  /// Une pièce rattachée : l'entrée posée dans `piecesRattachees` (pour l'annulation).
  lien              Json?
  decideParId       String?
  decideLe          DateTime            @default(now())
  annuleLe          DateTime?
  annuleParId       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([lotId, sens])
  @@index([source])
}

/// CE QUE LUNA A LU D'UNE PIÈCE POUR LE RAPPROCHEMENT — une ligne par EMPREINTE (SHA-256 des octets) : une pièce ne se lit
/// qu'une fois, quel que soit le nombre d'endroits où elle vit. La lecture elle-même passe par le lecteur de pièces
/// (`pieces-lues/service.ts`, cache `LecturePiece`) ; ici, le résumé utile au rapprochement. `NON_LUE` : format, taille ou
/// échec — la pièce se rapproche encore par son nom et ses métadonnées, et n'est pas relue en boucle.
model AdProRapprochementLecture {
  id          String   @id @default(cuid())
  empreinte   String   @unique
  /// LUE · NON_LUE
  etat        String
  raison      String?
  fournisseur String?
  montant     Decimal? @db.Decimal(14, 2)
  /// ISO `AAAA-MM-JJ`.
  date        String?
  numero      String?
  nature      String?
  references  String[] @default([])
  motsCles    String[] @default([])
  lectureId   String?
  version     Int      @default(1)
  luParId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// UNE DEMANDE AD & PRO TOUCHÉE PAR UN LOT — créée « Historique 2026 » (`mode = CREEE`) ou existante complétée
/// (`COMPLETEE`). Une colonne polymorphe (`demandeType`, `demandeId`) : les sept natures de demande n'ont pas de parent
/// commun, et l'annulation du lot passe par cette table (jamais par une recherche).
model AdProIntegrationDemande {
  id               String              @id @default(cuid())
  lotId            String
  lot              AdProIntegrationLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  /// La ligne principale du fichier (Feuil1), et toutes ses lignes (SAI : 21 + 22 ; ASARI : 25 + 24).
  ligne            Int
  lignes           Int[]               @default([])
  libelle          String
  /// SPONSORING · CONGRESS_NATIONAL · CONGRESS_INTERNATIONAL · EVENT · TRAINING · PROMO_MATERIAL · MEDICAL_INFO_DECLARATION
  demandeType      String
  demandeId        String
  /// CREEE (badge « Historique 2026 », aucun circuit) · COMPLETEE (demande existante, son circuit reste le sien).
  mode             String
  /// « Demandé par » affiché sur la demande (« Direction Marketing »).
  demandeurAffiche String?
  montant          Decimal             @db.Decimal(14, 2)
  /// Les pièces attendues : [{ cle, libelle }] — obligatoires mais NON bloquantes.
  piecesAttendues  Json                @default("[]")
  /// Les pièces déjà dans la plateforme RATTACHÉES (jamais redéposées) : [{ cle, documentId, nom, le, parId }].
  piecesRattachees Json                @default("[]")
  /// L'écriture de trésorerie existante qui a payé la dépense — LECTURE SEULE, jamais modifiée.
  ecritureId       String?
  /// L'état de la demande AVANT le complément (mode COMPLETEE) — ce que l'annulation rend.
  avant            Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([lotId, ligne])
  @@index([demandeType, demandeId])
}

/// « DANS LA PLATEFORME, ABSENTES DU FICHIER » — ce qui comptait au budget avant le lot et ne correspond à aucune ligne :
/// on décide, élément par élément, de le GARDER dans le budget ou de l'en SORTIR. Rien n'est effacé.
model AdProIntegrationDecision {
  id          String              @id @default(cuid())
  lotId       String
  lot         AdProIntegrationLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  /// La clé de la source (`TX:<id>`, `LIGNE:<id>`, `POSTE:<id>`, `ORDRE:<id>`) — `budget/integration-regle.ts`.
  cleSource   String
  /// GARDER · SORTIR
  decision    String
  libelle     String
  montant     Decimal             @db.Decimal(14, 2)
  decideParId String?
  decideLe    DateTime            @default(now())

  @@unique([lotId, cleSource])
}

model BudgetLine {
  custom          Json? // admin-defined dynamic fields
  id              String         @id @default(cuid())
  year            Int
  month           Int? // 1-12, null = annual line
  department      BudgetCategory
  label           String // ligne budgétaire
  initialBudget   Decimal        @default(0) @db.Decimal(14, 2)
  consumedBudget  Decimal        @default(0) @db.Decimal(14, 2)
  futureCommitted Decimal        @default(0) @db.Decimal(14, 2)
  status          BudgetStatus   @default(ON_TRACK)
  comments        String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([department])
  @@index([status])
}

// Enveloppe budgétaire : un budget TOTAL défini par la Direction pour une période,
// réparti en catégories (BudgetCategoryLine). La consommation est calculée à partir
// des dépenses réelles (FinanceTransaction OUT) attribuées à chaque catégorie.
model BudgetEnvelope {
  id              String                @id @default(cuid())
  companyId       String? // entité de rattachement (Adventum / Pharmagène / …)
  company         Company?              @relation(fields: [companyId], references: [id])
  name            String
  module          String? // (déprécié) module principal — conservé pour compatibilité
  // Une enveloppe peut couvrir UN ou PLUSIEURS modules.
  modules         String[]              @default([]) // SPONSORING, CONGRESS_*, EVENTS, PROMO_MATERIAL, MEDICAL…
  // Rôles (hors gestionnaires) autorisés à CONSULTER cette enveloppe — ex. la
  // Direction des opérations ne voit que les enveloppes que le Super Admin a
  // ouvertes. Vide = visible des seuls gestionnaires (Super Admin / délégués).
  accessRoles     String[]              @default([])
  // Utilisateurs nommément autorisés par le Super Admin à consulter cette enveloppe
  // (en plus des rôles ci-dessus). Permet d'ouvrir l'accès à des personnes précises.
  accessUserIds   String[]              @default([])
  // GESTION (niveau supérieur à la simple visualisation) : rôles / personnes autorisés
  // par l'admin à GÉRER le CONTENU de cette enveloppe précise (catégories, allocations,
  // lignes de dépense budgétaire) — sans être gestionnaire global. La modification de
  // l'enveloppe elle-même (montant, période, listes d'accès) reste réservée à l'admin.
  managerRoles    String[]              @default([])
  managerUserIds  String[]              @default([])
  periodStart     DateTime
  periodEnd       DateTime
  totalAmount     Decimal               @default(0) @db.Decimal(14, 2)
  notes           String?
  isActive        Boolean               @default(true)
  /// BUDGET MARKETING (Direction, 08/10) : « MARKETING » = enveloppe tenue par la Direction Marketing (Ad & Pro et
  /// les siennes), « GENERAL » sinon. Budgets les lit toutes ; Budget Marketing seulement les premières. Une seule
  /// ligne, jamais recopiée (`lib/budget-marketing/domaine.ts`). Depuis le 08/10 aussi « REGULATORY » (Budget
  /// Regulatory) et « OPERATIONS » (Budget Operations & Sales) — `lib/budget/domaines.ts`.
  domaine         String                @default("GENERAL")
  /// Rattachement facultatif à une Business Unit / un produit (ids sans contrainte : retirer la BU n'emporte pas l'enveloppe).
  businessUnitId  String?
  productId       String?
  categories      BudgetCategoryLine[]
  /// Les lots d'intégration des dépenses réelles (Ad & Pro 2026) posés sur cette enveloppe.
  lotsIntegration AdProIntegrationLot[]
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([isActive])
  @@index([periodStart])
  @@index([companyId])
  @@index([domaine])
}

// Catégorie créée par la Direction au sein d'une enveloppe, avec son allocation.
model BudgetCategoryLine {
  id               String                    @id @default(cuid())
  envelopeId       String
  envelope         BudgetEnvelope            @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name             String
  module           String? // module associé (SPONSORING, CONGRESS_*, REGULATORY…) — attribution auto des dépenses
  // Sous-catégorie : une catégorie peut être rattachée à une catégorie parente
  // (ex. « Table ronde » sous « Événement »). Créées à la main par la Direction.
  parentId         String?
  parent           BudgetCategoryLine?       @relation("BudgetSubCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children         BudgetCategoryLine[]      @relation("BudgetSubCategory")
  allocated        Decimal                   @default(0) @db.Decimal(14, 2)
  color            String?
  notes            String?
  /// BUDGETS DES PÔLES (08/10) : la clé STABLE d'une catégorie que le code reconnaît — « BV_25 » / « BV_75 » (Budget
  /// Regulatory : les bons de versement des dossiers d'enregistrement), « MASSE_SALARIALE_FDV » (Budget Operations :
  /// la paie de la force de vente). Nulle pour une catégorie libre. Le nom, lui, reste modifiable.
  cle              String?
  /// La Business Unit d'une sous-catégorie « Masse salariale de la force de vente » (id sans contrainte).
  businessUnitId   String?
  transactions     FinanceTransaction[]
  expenseLines     BudgetExpenseLine[]
  adProItems       AdProItem[]
  /// Les dossiers de matériel promotionnel imputés ici (point 21, 27/10).
  promoMaterials   PromoMaterial[]           @relation("PromoMaterialBudget")
  /// Dépenses des moyens généraux imputées ici — le ticket entier, puis article par article.
  deptExpenses     DepartmentBudgetExpense[] @relation("DeptExpenseBudget")
  deptExpenseLines DepartmentExpenseLine[]   @relation("DeptExpenseLineBudget")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([envelopeId])
  @@index([parentId])
  @@index([cle])
}

/// CAMPAGNE BUDGÉTAIRE (« Budgets 2027 », Direction 10/2026) — chaque pôle (un DÉPARTEMENT de l'organigramme) prépare
/// sa proposition, les valideurs l'examinent ligne par ligne, on arbitre, on valide, et les enveloppes de l'année se
/// créent d'elles-mêmes. Règles pures : `src/lib/budget-campagne/regles.ts`.
///
/// Statuts en texte (DRAFT | OPEN | REVIEW | ARBITRAGE | CLOSED) — la liste vit dans le module pur, comme `domaine`.
/// LE CADRAGE est PRIVÉ (Direction, 10/2026) : le DG, les valideurs et le Super Admin seuls le lisent ; les vues d'un
/// pôle ne le reçoivent jamais (filtré côté serveur, `vuePoleSansCadrage`).
model BudgetCampaign {
  id                    String           @id @default(cuid())
  year                  Int
  /// Entité de rattachement (id sans contrainte, comme `BudgetEnvelope.businessUnitId`) ; null = tout le groupe.
  companyId             String?
  title                 String
  opensAt               DateTime
  submitDeadline        DateTime
  validationDeadline    DateTime
  status                String           @default("DRAFT")
  /// Enveloppe globale du DG (facultative, PRIVÉE).
  cadrageTotal          Decimal?         @db.Decimal(16, 2)
  /// DG (un seul valideur) ou COMITE (une liste) — `validatorIds` porte les comptes dans les deux cas.
  validatorMode         String           @default("COMITE")
  validatorIds          String[]         @default([])
  /// ALL = tous les valideurs acceptent ; ANY = le premier avis tranche.
  validatorRule         String           @default("ALL")
  /// Budget rectificatif permis pour toute la campagne (réglé par le Super Admin seul ; défaut : non).
  allowRectificatif     Boolean          @default(false)
  /// Au-delà de cet écart (en %) avec le réalisé de l'année en cours, une justification est exigée.
  seuilJustificationPct Decimal          @default(5) @db.Decimal(6, 2)
  createdById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  proposals             BudgetProposal[]

  @@index([year])
  @@index([status])
}

/// LA PROPOSITION D'UN PÔLE pour une campagne. Statuts : EN_PREPARATION | SOUMIS | A_REVOIR | ACCEPTE |
/// ACCEPTE_AVEC_AJUSTEMENTS | REFUSE. Chaque soumission fige une version (`BudgetProposalVersion`).
model BudgetProposal {
  id                     String                  @id @default(cuid())
  campaignId             String
  campaign               BudgetCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Le pôle = un département de l'organigramme. Nul si le département a été supprimé depuis (`poleLabel` reste).
  departmentId           String?
  department             Department?             @relation("BudgetProposalDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  poleLabel              String
  /// MARKETING | REGULATORY | OPERATIONS | GENERAL — le domaine des enveloppes créées à la validation.
  domaine                String                  @default("GENERAL")
  /// Cadrage par pôle (facultatif, PRIVÉ comme le cadrage global).
  cadrage                Decimal?                @db.Decimal(16, 2)
  status                 String                  @default("EN_PREPARATION")
  currentVersion         Int                     @default(0)
  submittedById          String?
  submittedAt            DateTime?
  decidedAt              DateTime?
  /// RÉVISION APRÈS VALIDATION — autorisée par le Super Admin seul, proposition par proposition (auditée).
  revisionAutorisee      Boolean                 @default(false)
  revisionAutoriseeParId String?
  /// La version en cours est-elle un budget rectificatif ?
  estRectificatif        Boolean                 @default(false)
  rectificatifs          Int                     @default(0)
  /// L'enveloppe de l'année créée à la validation — UNE par proposition, jamais deux (idempotence).
  envelopeId             String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lines                  BudgetProposalLine[]
  versions               BudgetProposalVersion[]
  comments               BudgetProposalComment[]
  votes                  BudgetProposalVote[]

  @@unique([campaignId, departmentId])
  @@index([status])
}

/// Une version SOUMISE, figée : les lignes telles qu'envoyées, et le résumé des changements (Luna ou repli exact).
model BudgetProposalVersion {
  id            String         @id @default(cuid())
  proposalId    String
  proposal      BudgetProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version       Int
  lines         Json
  total         Decimal        @default(0) @db.Decimal(16, 2)
  rectificatif  Boolean        @default(false)
  submittedById String?
  submittedAt   DateTime       @default(now())
  summary       String?
  summaryByLuna Boolean        @default(false)

  @@unique([proposalId, version])
}

/// Une ligne de la proposition. Source : AUTO_PAIE | AUTO_RECRUTEMENT | AUTO_BV | AUTO_ADPRO | REALISE_2026 | SAISIE.
/// Décision du valideur (version en cours) : ACCEPTE | AJUSTE | QUESTION | REFUSE | null.
model BudgetProposalLine {
  id             String         @id @default(cuid())
  proposalId     String
  proposal       BudgetProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  key            String
  label          String
  /// Clé de catégorie reconnue (BV_25, BV_75, MASSE_SALARIALE_FDV) ou libre — reprise à la création de l'enveloppe.
  categoryKey    String?
  source         String         @default("SAISIE")
  realise2026    Decimal        @default(0) @db.Decimal(16, 2)
  propose        Decimal        @default(0) @db.Decimal(16, 2)
  ajuste         Decimal?       @db.Decimal(16, 2)
  decision       String?
  justification  String?
  /// Pièces jointes : [{ id, name }] (documents `entityType = BUDGET`, `stepKey = campagne:<ligne>`).
  attachments    Json           @default("[]")
  /// La catégorie d'enveloppe créée pour cette ligne — la clé de l'idempotence et du rectificatif.
  categoryLineId String?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([proposalId, key])
}

/// Le fil d'échanges d'une proposition, éventuellement sur une ligne.
model BudgetProposalComment {
  id         String         @id @default(cuid())
  proposalId String
  proposal   BudgetProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  lineId     String?
  authorId   String?
  /// Auteur « Luna » (résumé de versions) : `authorId` nul et ce drapeau levé.
  parLuna    Boolean        @default(false)
  body       String
  createdAt  DateTime       @default(now())

  @@index([proposalId, createdAt])
}

/// L'avis d'un valideur sur UNE version (ACCEPTE | REFUSE). Unique par version : un avis se change, ne se double pas.
model BudgetProposalVote {
  id         String         @id @default(cuid())
  proposalId String
  proposal   BudgetProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    Int
  userId     String
  decision   String
  comment    String?
  createdAt  DateTime       @default(now())

  @@unique([proposalId, version, userId])
}

// Ligne de dépense purement BUDGÉTAIRE, saisie depuis le module Budget (« + » : référence
// + montant). Elle CONSOMME une (sous-)catégorie mais ne touche NI la trésorerie NI les
// Finances : c'est un simple suivi de consommation. Le financier reste libre d'enregistrer
// (ou non) le mouvement réel côté Finances. Distincte des FinanceTransaction attribuées, qui
// sont, elles, de vrais mouvements de trésorerie que la Direction impute à une catégorie.
/// BUDGET D'UN DÉPARTEMENT, pour une année.
///
/// Deux natures de budget, DEUX responsables — c'est tout l'intérêt du modèle :
///   • `OPERATING` — le fonctionnement (hors employés), réglé par l'ADMINISTRATEUR ;
///   • `HR` — la masse salariale et le recrutement, réglés par les RESSOURCES HUMAINES.
///
/// Une ligne par département, année et nature : le RH ne peut pas toucher au fonctionnement,
/// l'administrateur ne peut pas toucher à la masse salariale, et l'un n'écrase jamais l'autre
/// puisqu'ils n'écrivent pas la même ligne.
/// AUTORISATIONS SUR LE BUDGET D'UN DÉPARTEMENT — réglées par le Super Admin.
///
/// Une ligne par département, plus UNE ligne générale (`departmentId = null`) qui s'applique à
/// tous. Les deux se CUMULENT : la règle générale ouvre largement, la règle du département
/// ajoute quelqu'un pour ce département seulement. Rien ne se soustrait — voir
/// `department-budget.ts` pour la règle exacte et pourquoi elle est additive.
///
/// Trois portées distinctes, parce que ce ne sont pas les mêmes personnes :
///   • `access*`    — VOIR le budget du département ;
///   • `operating*` — ÉDITER le fonctionnement (hors employés) ;
///   • `hr*`        — ÉDITER les employés et le recrutement.
model DepartmentBudgetAccess {
  id               String      @id @default(cuid())
  /// `null` = règle GÉNÉRALE, valable pour tous les départements. Unicité garantie par un
  /// index partiel (`WHERE "departmentId" IS NULL`) : en SQL, deux NULL ne s'égalent pas, un
  /// `@unique` ordinaire laisserait donc créer autant de règles générales qu'on veut.
  departmentId     String?     @unique
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  accessRoles      String[]    @default([])
  accessUserIds    String[]    @default([])
  operatingRoles   String[]    @default([])
  operatingUserIds String[]    @default([])
  hrRoles          String[]    @default([])
  hrUserIds        String[]    @default([])
  /// Budget MÉTIER : listes propres, parce qu'ouvrir les moyens généraux à quelqu'un ne doit
  /// pas lui ouvrir, par ricochet, le budget d'activité du département.
  activityRoles    String[]    @default([])
  activityUserIds  String[]    @default([])
  /// Qui a réglé ces accès en dernier — une autorisation sans auteur ne se discute pas.
  setById          String?
  setBy            User?       @relation("DepartmentBudgetAccessSetter", fields: [setById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model DepartmentBudget {
  id           String               @id @default(cuid())
  departmentId String
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year         Int
  kind         DepartmentBudgetKind
  amount       Decimal              @default(0) @db.Decimal(14, 2)
  notes        String?
  /// Qui a réglé ce montant en dernier — la responsabilité doit être lisible.
  setById      String?
  setBy        User?                @relation("DepartmentBudgetSetter", fields: [setById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([departmentId, year, kind])
  @@index([year, kind])
}

/// DEMANDE DE DOTATION OU DE RALLONGE sur un budget départemental.
///
/// Celui qui gère le budget ne se l'accorde pas à lui-même : il le DEMANDE, l'administration
/// tranche. C'est ce qui rend vérifiable la phrase « budget fixé par les RH, validé par
/// l'administration » — sans ce circuit, elle ne serait qu'un usage.
model DepartmentBudgetRequest {
  id            String                  @id @default(cuid())
  departmentId  String
  department    Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year          Int
  kind          DepartmentBudgetKind
  /// Montant demandé EN PLUS du budget courant. Une dotation initiale est une rallonge
  /// partant de zéro — même geste, même circuit.
  amount        Decimal                 @default(0) @db.Decimal(14, 2)
  reason        String?
  status        DeptBudgetRequestStatus @default(PENDING)
  requestedById String?
  requestedBy   User?                   @relation("DeptBudgetRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now())
  decidedById   String?
  decidedBy     User?                   @relation("DeptBudgetDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?

  @@index([departmentId, year])
  @@index([status])
}

/// FORMATION — deux origines, un seul objet.
///
/// Soit un salarié DEMANDE une formation (il chiffre, joint le devis, et la demande monte
/// N+1 → RH → DG comme un congé) ; soit les RH en ORGANISENT une et y invitent des personnes.
/// Les deux produisent la même chose — une formation à financer et à suivre — et les séparer
/// en deux modèles aurait dédoublé le budget, les pièces et l'historique.
enum TrainingOrigin {
  EMPLOYEE /// demandée par le salarié
  HR /// organisée par les ressources humaines
}

enum TrainingStatus {
  DRAFT /// en préparation (RH), pas encore soumise
  PENDING /// dans le circuit de validation
  APPROVED /// accordée
  REJECTED /// refusée
  CANCELLED /// retirée
  DONE /// formation réalisée
}

/// Participation à une formation organisée par les RH.
enum TrainingAttendance {
  MANDATORY /// convoqué — la présence n'est pas une option
  VOLUNTARY /// invité — il accepte ou décline
}

enum TrainingParticipantState {
  INVITED
  ACCEPTED
  DECLINED
}

model Training {
  id            String         @id @default(cuid())
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  reference     String         @unique /// FORM-AAAA-NNN
  title         String
  origin        TrainingOrigin @default(EMPLOYEE)
  status        TrainingStatus @default(PENDING)
  /// Organisme / formateur.
  provider      String?
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  location      String?
  /// Coût annoncé par le demandeur (le devis fait foi, la pièce jointe le porte).
  amount        Decimal        @default(0) @db.Decimal(14, 2)
  /// Montant réellement accordé par la direction — souvent différent du demandé.
  amountGranted Decimal?       @db.Decimal(14, 2)

  requesterId  String?
  requester    User?       @relation("TrainingRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// ─── Circuit à trois marches : N+1 → RH → DG (cf. approval-chain.ts) ───
  /// Une formation ORGANISÉE par les RH n'a pas de N+1 à consulter : elle entre à l'étape DG.
  stage              LeaveStage @default(MANAGER)
  managerId          String?
  managerDecidedById String?
  managerDecidedAt   DateTime?
  managerNote        String?
  hrDecidedById      String?
  hrDecidedAt        DateTime?
  hrNote             String?
  dgDecidedById      String?
  dgDecidedAt        DateTime?
  dgNote             String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants TrainingParticipant[]
  items        AdProItem[]

  @@index([status])
  @@index([requesterId])
  @@index([departmentId])
  @@index([companyId])
}

/// Une personne conviée à une formation organisée par les RH. Obligatoire ou volontaire —
/// et dans le second cas, elle répond : accepter une invitation qu'on ne pouvait pas refuser
/// n'aurait aucun sens, et le savoir change la logistique (nombre de couverts, salle).
model TrainingParticipant {
  id          String                   @id @default(cuid())
  trainingId  String
  training    Training                 @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId      String
  user        User                     @relation("TrainingParticipant", fields: [userId], references: [id], onDelete: Cascade)
  attendance  TrainingAttendance       @default(VOLUNTARY)
  state       TrainingParticipantState @default(INVITED)
  respondedAt DateTime?
  note        String?
  createdAt   DateTime                 @default(now())

  @@unique([trainingId, userId])
  @@index([userId, state])
}

/// CAISSE D'AVANCE — la trésorerie temporaire confiée à une personne.
///
/// Chaque mois, l'entreprise remet une somme à celle qui achète au quotidien (l'assistante de
/// direction). Elle marque « reçu » — sans cette confirmation, on ne sait pas si l'argent a
/// réellement changé de mains — puis chaque dépense en est DÉDUITE, justificatif à l'appui,
/// jusqu'à épuisement. Quand il ne reste plus rien, elle demande une rallonge.
///
/// Ce n'est pas un budget : c'est de l'argent physiquement détenu. Le budget dit ce qu'on a le
/// droit de dépenser, la caisse dit ce qu'on a en main — confondre les deux, c'est ne plus
/// savoir combien il reste dans le tiroir.
enum PettyCashStatus {
  ALLOTTED /// remise décidée, pas encore confirmée par le détenteur
  RECEIVED /// argent reçu — la caisse est ouverte, les dépenses s'y imputent
  CLOSED /// caisse soldée (épuisée ou clôturée)
}

/// LE RÉGLAGE MENSUEL de la caisse d'avance : combien, à qui, et quel jour du mois.
///
/// Sans ce réglage, la caisse dépendait d'un geste dont personne ne se souvenait à date fixe —
/// et l'on ne pouvait prévenir de rien, faute de savoir quand le rechargement était attendu.
/// C'est aussi ce qui rend possible le rappel aux ressources humaines **48 h avant**.
model PettyCashPlan {
  id                 String     @id @default(cuid())
  departmentId       String     @unique
  department         Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Somme remise chaque mois (réglée par les ressources humaines).
  monthlyAmount      Decimal    @default(0) @db.Decimal(14, 2)
  /// Jour du mois où la caisse est rechargée (1–28 : au-delà, février ferait exception).
  rechargeDay        Int        @default(1)
  /// La personne à qui la somme est remise (l'assistante de direction, en pratique).
  holderId           String?
  holder             User?      @relation("PettyCashPlanHolder", fields: [holderId], references: [id], onDelete: SetNull)
  isActive           Boolean    @default(true)
  /// Dernière période (« AAAA-MM ») pour laquelle le rappel des 48 h est parti — sans cette
  /// trace, le battement du planificateur enverrait la même alerte à chaque passage.
  lastReminderPeriod String?
  setById            String?
  setBy              User?      @relation("PettyCashPlanSetter", fields: [setById], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

/// DEMANDE DE RALLONGE sur une caisse épuisée — tranchée par les ressources humaines.
///
/// La rallonge n'était qu'une notification : rien à accorder, rien à refuser, aucune trace de
/// ce qui avait été décidé. Les RH accordent désormais **le montant qu'elles écrivent** — qui
/// est rarement celui demandé — refusent, et la décision reste lisible.
enum PettyCashTopUpStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED /// retirée par la détentrice avant la décision (décision du 04/10)
}

model PettyCashTopUpRequest {
  id              String               @id @default(cuid())
  allotmentId     String
  allotment       PettyCashAllotment   @relation(fields: [allotmentId], references: [id], onDelete: Cascade)
  amountRequested Decimal              @default(0) @db.Decimal(14, 2)
  reason          String?
  status          PettyCashTopUpStatus @default(PENDING)
  /// Montant réellement accordé — écrit par les RH, souvent différent du demandé.
  amountGranted   Decimal?             @db.Decimal(14, 2)
  requestedById   String?
  requestedBy     User?                @relation("PettyCashTopUpRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById     String?
  decidedBy       User?                @relation("PettyCashTopUpDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?
  /// L'ÉCRITURE DE TRÉSORERIE de la rallonge accordée (§118.148). Une rallonge sort de l'argent de
  /// la banque exactement comme la remise qu'elle complète : sans écriture, le livre ignorait un
  /// décaissement réel. Nul = refusée, ou accordée avant cette règle.
  transactionId   String?
  createdAt       DateTime             @default(now())

  @@index([allotmentId])
  @@index([status])
}

model PettyCashAllotment {
  id             String          @id @default(cuid())
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Mois concerné, « AAAA-MM ». Une caisse par mois et par détenteur : mélanger deux mois,
  /// c'est perdre la capacité de dire « il restait combien fin juillet ».
  period         String
  amount         Decimal         @default(0) @db.Decimal(14, 2)
  status         PettyCashStatus @default(ALLOTTED)
  /// Qui DÉTIENT la caisse (et confirme la réception).
  holderId       String?
  holder         User?           @relation("PettyCashHolder", fields: [holderId], references: [id], onDelete: SetNull)
  receivedAt     DateTime?
  note           String?
  /// L'ÉCRITURE DE TRÉSORERIE de la remise. Remettre une caisse d'avance SORT de l'argent de la
  /// banque : sans écriture, le livre ignore un décaissement réel et le rapprochement bancaire
  /// décroche. Posée au RÈGLEMENT de l'ordre de la remise (§118.176) — avant cette règle, à la
  /// remise elle-même. Nul sur une remise d'avant la première règle, signalée par le contrôle du
  /// livre ; nul aussi tant que l'ordre attend le centre ou les Finances : rien n'est encore parti.
  transactionId  String?
  /// L'ORDRE DE DÉPENSE de la remise (§118.176) — « la caisse qui est donnée mensuellement aux
  /// moyens généraux doit passer par le centre de paiement et attendre la validation ». Tant qu'il
  /// n'est pas réglé, la somme n'a pas quitté la banque : la détentrice ne peut pas confirmer
  /// l'avoir reçue. Nul = remise antérieure à la règle, qui se confirme comme avant.
  expenseOrderId String?         @unique
  expenseOrder   ExpenseOrder?   @relation("PettyCashAllotmentOrder", fields: [expenseOrderId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?           @relation("PettyCashCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  expenses DepartmentBudgetExpense[]
  topUps   PettyCashTopUpRequest[]

  @@index([departmentId, period])
  @@index([holderId, status])
}

/// DÉPENSE IMPUTÉE à un budget départemental — avec sa pièce justificative (Document lié par
/// `entityType = DEPARTMENT_EXPENSE`).
///
/// Sans elle, les moyens généraux affichaient un montant alloué et AUCUNE consommation : un
/// budget qu'on ne peut pas confronter à ses dépenses n'est pas un budget, c'est un vœu.
/// L'assistante de direction y classe ce qu'elle achève (fournitures, prestations) ; le
/// directeur y voit ce que son département consomme réellement.
model DepartmentBudgetExpense {
  id               String                 @id @default(cuid())
  departmentId     String
  department       Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year             Int
  kind             DepartmentBudgetKind   @default(OPERATING)
  label            String
  amount           Decimal                @default(0) @db.Decimal(14, 2)
  date             DateTime               @default(now())
  notes            String?
  /// Caisse d'avance sur laquelle cette dépense a été PAYÉE (argent physiquement sorti du
  /// tiroir). Nulle quand la dépense est réglée par virement ou par les Finances.
  pettyCashId      String?
  pettyCash        PettyCashAllotment?    @relation(fields: [pettyCashId], references: [id], onDelete: SetNull)
  /// Demande administrative dont cette dépense est issue (traçabilité de bout en bout).
  adminRequestId   String?
  adminRequest     AdministrativeRequest? @relation(fields: [adminRequestId], references: [id], onDelete: SetNull)
  /// CLASSEMENT BUDGÉTAIRE DU TICKET ENTIER — choisi par celui qui achète, sans qu'il ait
  /// accès au module Budget. Sert de destination au RESTE non classé article par article.
  budgetCategoryId String?
  budgetCategory   BudgetCategoryLine?    @relation("DeptExpenseBudget", fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?                  @relation("DeptExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())

  /// Le DÉTAIL du ticket : un même justificatif porte presque toujours plusieurs articles.
  lines DepartmentExpenseLine[]

  @@index([departmentId, year, kind])
  @@index([adminRequestId])
  @@index([pettyCashId])
  @@index([budgetCategoryId])
  @@index([date])
}

/// UN ARTICLE D'UN TICKET DE CAISSE / D'UNE FACTURE.
///
/// Une dépense n'était qu'un libellé et un montant : « courses 12 400 DZD ». On savait ce qui
/// était sorti de la caisse, jamais ce qui avait été acheté — donc ni ce qu'on consomme le
/// plus, ni à quel prix, ni si le total du ticket correspond à ce qu'on y a mis. Une pièce
/// justificative porte presque toujours PLUSIEURS articles : le modèle le dit maintenant.
///
/// Le `label` est FIGÉ à l'achat, en plus du lien vers le catalogue : un article renommé ou
/// retiré du catalogue ne doit pas réécrire l'histoire d'un ticket déjà classé — et un achat
/// hors catalogue (article acheté une fois) reste possible, `articleId` valant alors NULL.
model DepartmentExpenseLine {
  id               String                  @id @default(cuid())
  expenseId        String
  expense          DepartmentBudgetExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  articleId        String?
  article          OfficeSupplyArticle?    @relation(fields: [articleId], references: [id], onDelete: SetNull)
  /// Désignation au moment de l'achat (recopiée du catalogue, ou saisie libre).
  label            String
  quantity         Decimal                 @default(1) @db.Decimal(12, 3)
  /// Montant de la ligne (quantité × prix unitaire, ou saisi tel quel depuis le ticket).
  amount           Decimal                 @default(0) @db.Decimal(14, 2)
  /// CLASSEMENT BUDGÉTAIRE DE CET ARTICLE — un même ticket mélange papeterie, transport et
  /// entretien : chaque article rejoint sa propre case, indépendamment des autres.
  budgetCategoryId String?
  budgetCategory   BudgetCategoryLine?     @relation("DeptExpenseLineBudget", fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())

  @@index([expenseId])
  @@index([articleId])
  @@index([budgetCategoryId])
}

enum DepartmentBudgetKind {
  OPERATING /// MOYENS GÉNÉRAUX — fournitures, prestations, déplacements (directeur du département)
  HR /// MASSE SALARIALE — employés, charges et recrutement (ressources humaines, exclusivement)
  ACTIVITY /// BUDGET MÉTIER — l'activité propre du département (Ad & Pro au marketing, paiement des BV au Regulatory…)
  TRAINING /// BUDGET FORMATION — montée en compétence de l'équipe (RH, validé par l'administration)
}

/// Une dotation (montant initial) ou une RALLONGE demandée par celui qui gère un budget
/// départemental, et accordée — ou non — par l'administration. Les deux gestes sont le même :
/// une rallonge partant de zéro EST une dotation. Un seul circuit, une seule trace.
enum DeptBudgetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED /// retirée par son demandeur avant la décision (décision du 04/10)
}

model BudgetExpenseLine {
  id                  String             @id @default(cuid())
  categoryId          String
  category            BudgetCategoryLine @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reference           String // référence saisie (sert de libellé de la dépense)
  amount              Decimal            @default(0) @db.Decimal(14, 2)
  date                DateTime           @default(now())
  notes               String?
  /// BUDGET REGULATORY (08/10) : le dossier d'enregistrement (`RegulatoryProduct`) d'un BV saisi à la main — « payé le »
  /// est alors `date`. Id sans contrainte : retirer le dossier n'efface pas la dépense.
  regulatoryProductId String?
  createdById         String?
  createdAt           DateTime           @default(now())

  @@index([categoryId])
  @@index([date])
  @@index([regulatoryProductId])
}

// ───────────────────────────── Congresses ─────────────────────────────

model CongressInternational {
  /// LA BUSINESS UNIT qui porte cette demande — c'est SON budget Ad&Pro qui est engagé.
  /// Sans elle, la dépense pesait sur un total commercial que personne ne pouvait
