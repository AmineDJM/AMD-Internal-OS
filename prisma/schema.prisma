// ─────────────────────── Prise en charge : personnes, cases, devis ───────────────────────

/// Avis porté sur UNE personne. « Pas d'avis » est une réponse à part entière : forcer un
/// avis tranché sur quelqu'un qu'on ne connaît pas produit un faux signal.
enum CareOpinion {
  FAVORABLE
  UNFAVORABLE
  NONE
}

/// Où en est UNE personne. La décision est prise **par personne** : sur une même demande,
/// l'une est accordée et l'autre écartée sans qu'on ait à refuser l'ensemble.
enum CareBeneficiaryStatus {
  PROPOSED // proposée, en attente de la décision de la Direction
  APPROVED // accordée
  REJECTED // écartée
  WITHDRAWN // retirée par le demandeur avant décision
}

/// Nature d'une case sur la ligne d'une personne. Deux natures réellement différentes, même
/// si elles s'affichent côte à côte : l'une se COLLECTE, l'autre s'ACHÈTE.
enum CareCellKind {
  DOCUMENT // une pièce à fournir (passeport, visa, CV…)
  SERVICE // un élément à acheter (hôtel, transport, billet, restauration…)
}

enum CareServiceKind {
  HOTEL
  TRANSPORT
  TICKET
  CATERING
  REGISTRATION
  VISA_FEE
  /// Support produit pour CETTE personne (brochure, kit, présentoir). Ne se traite pas ici :
  /// la case POINTE vers un `PromoMaterial` qui suit son propre circuit.
  PROMO_MATERIAL
  OTHER
}

enum CareCellStatus {
  REQUESTED // demandée, rien reçu
  PROVIDED // document déposé, ou devis reçu
  SETTLED // pièce acceptée / devis accepté
  WAIVED // finalement inutile pour cette personne
}

/// Où vivent les prix d'une prise en charge (Direction, 10/2026).
enum CareMode {
  INDIVIDUAL // chaque fiche a ses postes et ses devis
  GROUP // un devis par catégorie couvre tout le monde ; les postes « par personne » s'appliquent à chacun
}

/// La devise SAISIE d'un montant. Le budget, lui, est toujours en DZD (`amountDzd`).
enum CareCurrency {
  DZD
  USD
}

/// UNE PERSONNE À PRENDRE EN CHARGE.
///
/// Remplace le tableau JSON `beneficiaries` : une personne porte désormais un avis, une
/// décision, et sa propre liste de cases. C'est la ligne du tableau.
///
/// Son identité vient soit de l'annuaire médecins, soit d'un profil libre saisi sur place —
/// on ne va pas créer une fiche médecin permanente pour un intervenant vu une seule fois.
///
/// Deux clés étrangères nullables (même raison que `AdProItem`) : une colonne polymorphe ne
/// pourrait pas porter de contrainte, et supprimer une demande laisserait ses personnes
/// orphelines. Contrainte `CareBeneficiary_one_parent` : exactement un parent.
model CareBeneficiary {
  id                      String                 @id @default(cuid())
  /// Référentiel R1 : la Personne réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  personneId              String?
  personne                Personne?              @relation(fields: [personneId], references: [id], onDelete: SetNull)
  congressNationalId      String?
  congressNational        CongressNational?      @relation(fields: [congressNationalId], references: [id], onDelete: Cascade)
  congressInternationalId String?
  congressInternational   CongressInternational? @relation(fields: [congressInternationalId], references: [id], onDelete: Cascade)

  /// Depuis l'annuaire (Promotion médicale). Exclusif avec le profil libre ci-dessous.
  doctorId    String?
  /// Profil libre : la personne n'est pas (ou pas encore) à l'annuaire.
  firstName   String?
  lastName    String?
  /// Poste / titre — « Professeur », « Chef de service »…
  jobTitle    String?
  institution String?

  /// L'avis du DEMANDEUR sur cette personne, avec sa justification.
  requesterOpinion CareOpinion @default(NONE)
  requesterNote    String?

  /// La décision de la Direction, personne par personne.
  status       CareBeneficiaryStatus @default(PROPOSED)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  position    Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cells CareCell[]

  @@index([congressNationalId])
  @@index([congressInternationalId])
  @@index([doctorId])
  @@index([personneId])
}

/// UNE CASE sur la ligne d'une personne — ce qu'il faut fournir ou acheter POUR ELLE.
///
/// Chaque personne a ses propres cases : l'une a besoin d'un visa et pas l'autre, l'une loge
/// à l'hôtel et l'autre chez elle. D'où des cases attachées à la personne, et non des colonnes
/// communes à tout le tableau.
model CareCell {
  id            String          @id @default(cuid())
  beneficiaryId String
  beneficiary   CareBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  kind        CareCellKind
  /// Renseigné pour une case SERVICE — sert au regroupement et aux libellés.
  serviceKind CareServiceKind?
  label       String
  notes       String?

  status CareCellStatus @default(REQUESTED)

  /// DOCUMENT : la pièce déposée (Document.id).
  documentId      String?
  /// Rattachement au circuit du matériel promotionnel — jamais recopié ici : le matériel a son
  /// propre parcours (visa publicitaire, conformité, agence, BAT) et cette case en montre
  /// seulement l'avancement.
  promoMaterialId String?
  /// SERVICE : le devis retenu et ce qu'il coûte.
  quoteId         String?
  /// Le montant en DZD — ce qui entre au budget. Pour un montant saisi en dollars, `amount × usdDzdRate` de la demande.
  amountDzd       Decimal? @db.Decimal(14, 2)
  expenseOrderId  String?

  /// LE POSTE D'UNE FICHE VOYAGEUR (Direction, 10/2026) — détails selon la nature (`src/lib/care-fiches.ts`).
  /// Billet : départ / retour ; hôtel : arrivée / départ ; autre poste : sa date (`dateStart`).
  dateStart DateTime?
  dateEnd   DateTime?
  trajet    AdProTrajet?
  transport AdProTransport?
  fromCity  String?
  toCity    String?
  /// Les étapes d'un trajet à plusieurs destinations : [{ de, vers, date }] (même forme que `AdProVoyageur.segments`).
  segments  Json?
  hotelName String?
  city      String?
  roomType  String?
  /// Le montant SAISI, dans sa devise (`currency`) ; `amountDzd` en est l'équivalent au budget.
  amount    Decimal?        @db.Decimal(14, 2)
  currency  CareCurrency    @default(DZD)

  /// LE BILLET ÉMIS / LA CONFIRMATION D'HÔTEL (Direction, 10/2026) — ce que lit le livret de séjour.
  /// Le fichier (e-billet, voucher) : `Document.id` de la demande, catégorie SUPPORTING_DOC, `stepKey` = cette case.
  issuedDocumentId String?
  /// Billet : la référence de réservation (PNR) ; hôtel : le n° de confirmation.
  bookingRef       String?
  /// Billet : le détail de CHAQUE trajet, aligné sur `etapesDuBillet` (aller, retour, ou chaque étape) :
  /// [{ numero, heureDepart, heureArrivee, reference }] — n° de vol/train, heures « HH:MM », PNR du trajet.
  legDetails       Json?
  /// Autre poste (repas, transport, accès…) : l'HEURE « HH:MM » (en plus de `dateStart`) et le lieu / l'adresse.
  timeStart        String?
  address          String?

  /// Qui a demandé cette case — le chef de produit peut en ajouter après coup.
  requestedById String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quoteLinks         CareQuoteCell[]
  /// La demande de réservation de ce billet / cet hôtel chez l'assistante de direction (son état seulement).
  demandeReservation DemandeReservation?

  @@index([beneficiaryId])
  @@index([quoteId])
  @@index([promoMaterialId])
}

enum CareQuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// UN DEVIS reçu par le secrétariat.
///
/// Un devis couvre **ce qu'il couvre réellement** : une agence de voyage chiffre le groupe
/// entier, pas une ligne par personne. Il est donc rattaché aux CASES qu'il couvre (relation
/// n-n), et accepté ou refusé **d'un bloc** — accepter la moitié d'un devis n'a pas de sens
/// commercial.
model CareQuote {
  id                      String                 @id @default(cuid())
  congressNationalId      String?
  congressNational        CongressNational?      @relation(fields: [congressNationalId], references: [id], onDelete: Cascade)
  congressInternationalId String?
  congressInternational   CongressInternational? @relation(fields: [congressInternationalId], references: [id], onDelete: Cascade)

  supplier   String
  reference  String?
  amountDzd  Decimal         @db.Decimal(14, 2)
  status     CareQuoteStatus @default(PENDING)
  /// Le PDF du devis (Document.id).
  documentId String?
  note       String?

  decidedById    String?
  decidedAt      DateTime?
  /// Ordre de dépense émis à l'acceptation.
  expenseOrderId String?

  /// Le montant SAISI dans sa devise ; `amountDzd` en est l'équivalent (taux figé de la demande).
  amount          Decimal?         @db.Decimal(14, 2)
  currency        CareCurrency     @default(DZD)
  /// La CATÉGORIE d'un devis (billetterie, hôtellerie…) — en mode « de groupe », un devis par catégorie couvre tout le monde.
  serviceKind     CareServiceKind?
  /// La proposition RETENUE par le demandeur (comme au sponsoring) — puis le BC demandé à l'assistante de direction.
  retainedAt      DateTime?
  retainedById    String?
  bcRequestedAt   DateTime?
  bcRequestedById String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cells CareQuoteCell[]

  @@index([congressNationalId])
  @@index([congressInternationalId])
  @@index([status])
}

/// Ce qu'un devis couvre : les cases concernées.
model CareQuoteCell {
  quoteId String
  quote   CareQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  cellId  String
  cell    CareCell  @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@id([quoteId, cellId])
  @@index([cellId])
}

/// UN POSTE DE GROUPE (Direction, 10/2026) — en prise en charge « de groupe », un coût qui s'applique à CHAQUE personne :
/// « repas 100 par personne ». Montant unitaire × personnes concernées ; une personne s'exclut une à une
/// (`excludedBeneficiaryIds`), sans toucher aux autres. Même parent exclusif que les personnes (contrainte `CareGroupPoste_one_parent`).
model CareGroupPoste {
  id                      String                 @id @default(cuid())
  congressNationalId      String?
  congressNational        CongressNational?      @relation(fields: [congressNationalId], references: [id], onDelete: Cascade)
  congressInternationalId String?
  congressInternational   CongressInternational? @relation(fields: [congressInternationalId], references: [id], onDelete: Cascade)

  serviceKind            CareServiceKind
  label                  String
  notes                  String?
  date                   DateTime?
  /// L'heure « HH:MM » et le lieu / l'adresse — le planning du livret de séjour.
  timeStart              String?
  address                String?
  /// Le montant PAR PERSONNE saisi, dans sa devise ; `unitAmountDzd` en est l'équivalent au budget.
  unitAmount             Decimal?        @db.Decimal(14, 2)
  currency               CareCurrency    @default(DZD)
  unitAmountDzd          Decimal?        @db.Decimal(14, 2)
  excludedBeneficiaryIds String[]        @default([])
  status                 CareCellStatus  @default(REQUESTED)

  position    Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([congressNationalId])
  @@index([congressInternationalId])
}

// ─────────────────────── Information médicale (déclaration réglementaire) ───────────────────────

/// Étape obligatoire qui s'intercale APRÈS la validation définitive de la Direction
/// (sponsoring / congrès) et AVANT l'envoi de l'ordre de dépense au comptable.
/// Le pharmacien responsable de l'information médicale déclare l'événement aux
/// autorités, peut exiger des pièces (de la Direction, du comptable, du délégué…),
/// puis valide — ce qui déclenche enfin l'ordre de dépense.
enum MedicalInfoStatus {
  AWAITING_REVIEW // validé par la Direction → en attente du pharmacien
  DOCS_REQUESTED // des pièces ont été demandées, en attente de dépôt
  READY // pièces reçues → prêt à valider
  AWAITING_DIRECTION // validé par le pharmacien → en attente de la validation finale de la Direction (pour le comptable)
  VALIDATED // validé par la Direction → ordre de dépense émis (comptable)
}

enum DocRequestStatus {
  PENDING
  FULFILLED
}

model MedicalInfoDeclaration {
  id                      String                  @id @default(cuid())
  companyId               String? // entité (Adventum / Pharmagène / …)
  company                 Company?                @relation(fields: [companyId], references: [id])
  reference               String                  @unique // DIM-2026-001
  sourceType              EntityType // SPONSORING | CONGRESS_INTERNATIONAL | CONGRESS_NATIONAL
  sourceId                String
  label                   String // institution / nom de l'événement
  beneficiary             String? // bénéficiaire (repris pour l'ordre de dépense)
  amount                  Decimal?                @db.Decimal(14, 2) // budget accordé par la Direction
  requesterId             String? // demandeur d'origine (repris pour l'ordre de dépense)
  status                  MedicalInfoStatus       @default(AWAITING_REVIEW)
  pharmacistId            String? // pharmacien en charge (assigné)
  pharmacist              User?                   @relation("MedicalInfoPharmacist", fields: [pharmacistId], references: [id])
  authorityRef            String? // référence / récépissé de déclaration aux autorités
  authorityNotes          String? // notes de déclaration
  pharmacistValidatedAt   DateTime? // validé par le pharmacien (PRIM) → passe à la Direction
  pharmacistValidatedById String?
  validatedAt             DateTime? // validation FINALE par la Direction → ordre de dépense au comptable
  validatedById           String?
  expenseOrderId          String? // ordre de dépense émis après validation du pharmacien
  budgetCategoryId        String? // (sous-)catégorie budgétaire choisie par la Direction à la validation définitive
  /// ── LE BON DE VERSEMENT, l'étape qui PRÉCÈDE la déclaration aux autorités ──────────────
  ///
  /// On ne déclare pas un événement aux autorités sans avoir versé la taxe : le PRIM demande le
  /// BV, le centre de paiement autorise, les Finances règlent, puis elles REMETTENT le bon à son
  /// bureau. C'est cette remise — un geste, pas un statut déduit — qui débloque la déclaration :
  /// « payé » ne veut pas dire « le PRIM a le papier en main », et c'est le papier qu'on dépose.
  ///
  /// ── DEUX TEMPS, ET NON UN SEUL ────────────────────────────────────────────────────────
  ///
  /// 1. LE BON EST D'ABORD ACCORDÉ. Le PRIM demande le versement (montant attendu, note,
  ///    pièces) et cette demande est VALIDÉE — N+1, puis chef de produit, puis le centre de
  ///    validations (Directeur Général, à défaut Super Admin). Tant que ces trois-là n'ont pas
  ///    signé, aucun argent n'est engagé : on ne fait pas autoriser un décaissement par le
  ///    centre de PAIEMENT pour découvrir ensuite que le principe même du versement était
  ///    contesté.
  /// 2. LA QUITTANCE EST ENSUITE PAYÉE. Le BV accordé, le PRIM demande le paiement de la
  ///    quittance (le montant réel, qui n'est pas toujours celui annoncé), et cette demande
  ///    emprunte le circuit COMMUN — centre de paiement, puis Finances.
  bvValidationId          String? // la demande de validation du BON (circuit à trois signatures)
  bvAmount                Decimal?                @db.Decimal(14, 2) // montant ANNONCÉ à la demande du bon
  bvNote                  String? // ce que le PRIM explique en demandant le bon
  bvRequestedAt           DateTime?
  bvRequestedById         String?
  /// La demande de paiement de la QUITTANCE : une `PaymentRequest` ordinaire (montant, note,
  /// pièces, fil), qui emprunte le circuit commun plutôt qu'un second circuit qui divergerait.
  bvRequestId             String? // la demande de paiement de la quittance
  bvDeliveredAt           DateTime? // remis au bureau du PRIM par les Finances
  bvDeliveredById         String?
  bvDeliveryNote          String?
  /// SANS BV — certains dossiers n'appellent aucun versement. Le dire est un geste TRACÉ, avec
  /// son motif : sans cette porte, un dossier sans taxe resterait bloqué pour toujours ; sans la
  /// trace, elle deviendrait le contournement ordinaire.
  bvSkippedAt             DateTime?
  bvSkippedById           String?
  bvSkipReason            String?
  archivedNodeId          String? // dossier « Dossier traité » créé dans le Drive du PRIM
  /// ── DEUX CIRCUITS, ET LA NATURE DÉCIDE ────────────────────────────────────────────────
  ///
  /// Le bon de versement ne concerne QUE le matériel promotionnel. Une prise en charge, un
  /// sponsoring, un événement n'appellent aucun versement : ils appellent une décision — faut-il
  /// les déclarer au ministère de l'Industrie pharmaceutique ? Le circuit se déduit de
  /// `sourceType` (et de `declarationKind` quand c'est le PRIM qui ouvre le dossier) ; voir
  /// `src/lib/medical-info/circuits.ts`. Aucun geste ne permet de faire changer un dossier de
  /// circuit : une case à cocher aurait laissé deux dossiers identiques suivre deux chemins.
  ///
  /// LA DÉCISION DE DÉCLARER — circuit ÉVÉNEMENT.
  declareIntent           String? // DECLARE | SKIP — la lecture que le pharmacien soumet
  declareValidationId     String? // la demande de validation de cette lecture
  declareNote             String? // ce qu'il explique en la soumettant
  declareRequestedAt      DateTime?
  declareRequestedById    String?
  /// LA REPRISE, et rien d'autre : les dossiers instruits AVANT que cette marche existe sont
  /// réputés décidés. Posé UNE FOIS par la migration ; l'application écrit la validation, jamais
  /// ce champ — deux écritures pour un même état finiraient par diverger.
  declareGrantedAt        DateTime?
  /// CE QUE LE PRIM OUVRE LUI-MÊME : MIP | AD_VISA | PAYMENT_SLIP. `null` = le dossier vient d'un
  /// événement ou du matériel promotionnel, et c'est sa source qui dit le circuit.
  declarationKind         String?
  /// LE PRODUIT CONCERNÉ (Direction, 10/2026) : repris de la source (sponsoring, congrès, événement, matériel promotionnel)
  /// à la création, corrigeable dans la déclaration. Nul = produit non précisé. Voir `medical-info/produits.ts`.
  productId               String?
  product                 Product?                @relation("MedicalInfoDeclarationProduit", fields: [productId], references: [id], onDelete: SetNull)
  createdById             String?
  slips                   MedicalInfoSlip[]
  requests                MedicalInfoDocRequest[]
  /// Les postes HISTORIQUES de la déclaration (intégration des dépenses réelles Ad & Pro 2026 — visa de publicité).
  postesHistoriques       AdProItem[]             @relation("AdProItemDeclarationInfoMed")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([sourceType, sourceId])
  @@index([status])
  @@index([pharmacistId])
  @@index([productId])
}

/// UN BON DE VERSEMENT — un par MATÉRIEL, dans le circuit du matériel promotionnel.
///
/// Il n'y en avait qu'un par dossier. Or un dossier en porte plusieurs : un présentoir, un jeu de
/// posters, une vidéo — chacun son support, chacun sa taxe, chacun sa quittance. On additionnait
/// donc les montants pour n'en demander qu'un, et l'on perdait ce que le guichet exige : le
/// versement se fait matériel par matériel.
///
/// DEUX TEMPS : une VALIDATION couvre le dépôt du lot entier (`MedicalInfoDeclaration.bvValidationId`),
/// puis chaque bon suit SA route — demande de paiement, centre, règlement, remise de la quittance.
/// Voir `src/lib/medical-info/slips.ts`.
model MedicalInfoSlip {
  id            String                 @id @default(cuid())
  declarationId String
  declaration   MedicalInfoDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  /// Le matériel concerné, nommé par le pharmacien (« présentoir comptoir », « affiches A2 »…).
  label         String
  /// Le montant ANNONCÉ du versement. Le montant RÉEL est celui de la demande de paiement.
  amount        Decimal?               @db.Decimal(14, 2)
  note          String?
  /// L'ordre d'affichage, tel que le pharmacien a listé ses matériels.
  position      Int                    @default(0)
  /// La demande de paiement de LA quittance de ce bon : une `PaymentRequest` ordinaire, qui
  /// emprunte le circuit commun plutôt qu'un second circuit qui divergerait.
  requestId     String?
  /// La remise au bureau du pharmacien — un GESTE des Finances, jamais un état déduit du
  /// règlement : « payé » ne veut pas dire « il a le papier », et c'est le papier qu'on dépose.
  deliveredAt   DateTime?
  deliveredById String?
  deliveryNote  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([declarationId])
  @@index([requestId])
}

model MedicalInfoDocRequest {
  id            String                 @id @default(cuid())
  declarationId String
  declaration   MedicalInfoDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  label         String // ce qui est demandé
  targetUserId  String? // à qui la pièce est demandée (Direction / comptable / délégué…)
  targetUser    User?                  @relation("MedicalInfoDocTarget", fields: [targetUserId], references: [id])
  status        DocRequestStatus       @default(PENDING)
  documentId    String? // Document déposé en réponse (model Document)
  note          String? // précision du déposant
  requestedById String?
  fulfilledAt   DateTime?
  createdAt     DateTime               @default(now())

  @@index([declarationId])
  @@index([targetUserId])
  @@index([status])
}

// ───────────────────────── Directives (Direction → équipes) ─────────────────────────

/// Instruction priorisée émise par la Direction vers une personne (targetUserId) ou
/// un rôle entier (targetRole), avec un espace d'échange (DirectiveMessage).
enum DirectiveStatus {
  OPEN // émise, non encore prise en compte
  ACKNOWLEDGED // accusé de réception par le destinataire
  IN_PROGRESS // en cours de traitement
  DONE // traitée
  ARCHIVED // archivée par la Direction
}

/// À QUI une directive s'adresse. Quatre portées qui ne se recouvrent pas : on choisit l'une.
enum DirectiveAudience {
  USERS // une ou plusieurs personnes nommées
  ROLE // tous les porteurs d'un rôle
  COMPANY // tous les salariés d'une entité du groupe
  ALL // tous les salariés
}

/// L'ÉTAT DE PUBLICATION — distinct du `status` (qui décrit le TRAITEMENT par le destinataire).
/// Une directive peut être « traitée » (status) et n'avoir jamais été publiée : les deux axes
/// répondent à deux questions différentes, et les confondre ferait partir des notes non validées.
enum DirectivePublication {
  DRAFT // brouillon de l'émetteur — n'a encore rien demandé
  PENDING_APPROVAL // soumise : attend le directeur général ou le Super Admin
  PUBLISHED // accordée et diffusée
  REJECTED // refusée par le valideur, avec son motif
}

model Directive {
  id            String            @id @default(cuid())
  reference     String            @unique // DIR-AAAA-NNN
  title         String
  body          String
  priority      Priority          @default(MEDIUM)
  status        DirectiveStatus   @default(OPEN)
  dueDate       DateTime?
  /// ─── À QUI ELLE S'ADRESSE ───
  ///
  /// Quatre portées, et une seule fait foi : `audience`. Une note de service ne s'adresse pas
  /// toujours à une personne — elle s'adresse souvent à TOUT LE MONDE, ou à toute une entité.
  audience      DirectiveAudience @default(USERS)
  /// Les personnes nommées (audience USERS) — la SOURCE DE VÉRITÉ, même à un seul destinataire.
  targetUserIds String[]          @default([])
  /// CACHE dénormalisé de `targetUserIds[0]`, tenu à jour à chaque écriture : il porte la
  /// relation (donc le nom affiché) et l'index historique. La source de vérité reste le tableau.
  targetUserId  String?
  targetUser    User?             @relation("DirectiveTarget", fields: [targetUserId], references: [id])
  targetRole    UserRole?
  /// Entité destinataire (audience COMPANY) : tous les salariés qui en relèvent.
  companyId     String?
  company       Company?          @relation(fields: [companyId], references: [id])
  fromId        String? // émetteur (Direction)
  from          User?             @relation("DirectiveAuthor", fields: [fromId], references: [id])

  /// ─── PUBLICATION : rien ne part sans l'accord de la direction générale ───
  ///
  /// Une note de service engage l'entreprise devant tous ses salariés. L'émetteur PROPOSE ;
  /// le directeur général (ou le Super Admin) PUBLIE. Tant que la publication n'est pas
  /// prononcée, la directive n'existe pour personne d'autre que son auteur et les valideurs :
  /// aucune notification, aucune pop-up, aucune ligne dans la liste des destinataires.
  publication  DirectivePublication @default(PENDING_APPROVAL)
  submittedAt  DateTime?
  approvedById String?
  approvedBy   User?                @relation("DirectiveApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  publishedAt  DateTime?
  decisionNote String?
  /// Diffusion en POP-UP plein écran (et non la seule cloche) : réservé à ce qui doit être lu
  /// tout de suite. Le choix est fait à l'émission et rejoué à l'identique en cas de relance.
  popup        Boolean              @default(false)
  /// RELANCE — combien de fois la directive a été envoyée, et quand pour la dernière fois.
  /// Une note non lue se renvoie ; le compteur évite de croire qu'on l'a envoyée une seule fois.
  sendCount    Int                  @default(0)
  lastSentAt   DateTime?

  acknowledgedAt   DateTime?
  acknowledgedById String?
  messages         DirectiveMessage[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([targetUserId])
  @@index([targetRole])
  @@index([priority])
  @@index([publication])
  @@index([companyId])
}

model DirectiveMessage {
  id          String    @id @default(cuid())
  directiveId String
  directive   Directive @relation(fields: [directiveId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation("DirectiveMsgAuthor", fields: [authorId], references: [id])
  body        String
  createdAt   DateTime  @default(now())

  @@index([directiveId])
}

// ─────────────────── Demandes de support (→ directeur médical / chef de produit) ───────────────────

/// Demande adressée à une fonction (directeur médical, chef de produit…) : question
/// médicale/scientifique, demande de support de visite, brochure, document/PDF. Le
/// destinataire répond dans un fil et peut joindre les pièces demandées (Document).
enum SupportCategory {
  QUESTION // question médicale / scientifique
  SUPPORT_MATERIAL // support / aide à la visite
  BROCHURE // brochure
  DOCUMENT // document / PDF
  OTHER
}

enum SupportStatus {
  OPEN // déposée, en attente de prise en charge
  IN_PROGRESS // prise en charge
  ANSWERED // répondue (pièces / réponse fournies)
  CLOSED // clôturée
}

model SupportRequest {
  id           String           @id @default(cuid())
  companyId    String? // entité de rattachement (Adventum / Pharmagène / …)
  company      Company?         @relation(fields: [companyId], references: [id])
  reference    String           @unique // SUP-AAAA-NNN
  subject      String
  body         String
  category     SupportCategory  @default(QUESTION)
  priority     Priority         @default(MEDIUM)
  product      String?
  status       SupportStatus    @default(OPEN)
  requesterId  String?
  requester    User?            @relation("SupportRequester", fields: [requesterId], references: [id])
  targetRole   UserRole? // fonction visée (directeur médical / chef de produit…)
  targetUserId String? // ou une personne précise
  targetUser   User?            @relation("SupportTarget", fields: [targetUserId], references: [id])
  assignedToId String? // répondant ayant pris en charge
  assignedTo   User?            @relation("SupportAssignee", fields: [assignedToId], references: [id])
  messages     SupportMessage[]
  /// LE MOMENT OÙ LA DEMANDE A ÉTÉ TRAITÉE : la première réponse du répondant, ou sa clôture. Posé UNE fois
  /// (jamais écrasé par une relance) — il alimente la brique KPI « demandes traitées » et son délai médian.
  /// Nul = pas encore traitée, ou antérieure à ce champ sans trace pour la dater (jamais estimée).
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([targetRole])
  @@index([assignedToId])
  @@index([companyId])
}

model SupportMessage {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?          @relation("SupportMsgAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime       @default(now())

  @@index([requestId])
}

// Demande de l'information médicale (PRIM) vers l'équipe Regulatory (question réglementaire,
// document, statut d'enregistrement, variation…), rattachable à un dossier produit, avec fil
// de discussion et statut. Le PRIM crée ; Regulatory prend en charge et répond.
enum RegRequestCategory {
  QUESTION // question réglementaire
  DOCUMENT // demande de document réglementaire
  STATUS_UPDATE // point sur le statut d'enregistrement
  VARIATION // variation / modification
  OTHER
}

enum RegRequestStatus {
  OPEN // ouverte (nouvelle)
  IN_PROGRESS // prise en charge par Regulatory
  ANSWERED // réponse apportée
  CLOSED // clôturée
}

model RegulatoryRequest {
  id           String             @id @default(cuid())
  reference    String             @unique // RRQ-AAAA-NNN
  subject      String
  body         String
  category     RegRequestCategory @default(QUESTION)
  priority     Priority           @default(MEDIUM)
  status       RegRequestStatus   @default(OPEN)
  // Dossier produit concerné (optionnel).
  productId    String?
  product      RegulatoryProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  requesterId  String? // le PRIM demandeur
  requester    User?              @relation("RegRequestRequester", fields: [requesterId], references: [id])
  assignedToId String? // répondant Regulatory ayant pris en charge
  assignedTo   User?              @relation("RegRequestAssignee", fields: [assignedToId], references: [id])

  messages  RegulatoryRequestMessage[]
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([assignedToId])
  @@index([productId])
}

model RegulatoryRequestMessage {
  id        String            @id @default(cuid())
  requestId String
  request   RegulatoryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?             @relation("RegRequestMsgAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime          @default(now())

  @@index([requestId])
}

/// Statut d'un dossier de suivi.
enum DossierStatus {
  OPEN // ouvert / à démarrer
  IN_PROGRESS // en cours
  ON_HOLD // en attente (d'un retour, d'une info…)
  DONE // abouti
  ARCHIVED // archivé
}

/// Dossier de suivi d'un sujet ad hoc : on délègue une recherche / analyse / tâche
/// (ex. « rechercher des prix d'hôtels », « analyse IQVIA ») et on suit TOUT au même
/// endroit : description, responsable + participants, statut, fil de discussion et
/// pièces (PPT/Excel/PDF/e-mails) via Document(entityType=DOSSIER). Créable manuellement
/// ou proposé par l'IA depuis un chat / e-mail.
model Dossier {
  id                String           @id @default(cuid())
  companyId         String? // entité de rattachement (Adventum / Pharmagène / …)
  company           Company?         @relation(fields: [companyId], references: [id])
  reference         String           @unique // DOS-AAAA-NNN
  title             String
  description       String?
  category          String? // Recherche, Hôtels, Billets, Analyse IQVIA, Veille…
  priority          Priority         @default(MEDIUM)
  status            DossierStatus    @default(OPEN)
  createdById       String?
  createdBy         User?            @relation("DossierCreator", fields: [createdById], references: [id])
  assignedToId      String? // responsable principal
  assignedTo        User?            @relation("DossierAssignee", fields: [assignedToId], references: [id])
  participantIds    String[]         @default([]) // collaborateurs additionnels (userIds)
  /// OBJET D'ORIGINE quand ce dossier est né d'une implication de tierce personne sur une
  /// demande Ad & Pro (congrès, événement) : c'est ce qui permet de faire remonter la
  /// conversation À L'ENDROIT de la demande, au lieu de la laisser dans un projet à part que le
  /// demandeur oublie d'ouvrir.
  sourceType        EntityType?
  sourceId          String?
  dueDate           DateTime?
  messages          DossierMessage[]
  /// Les postes « billetterie » dont c'est le sujet de réservation (§118.175).
  adProReservations AdProItem[]      @relation("AdProItemReservation")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([companyId])
  @@index([sourceType, sourceId])
}

model DossierMessage {
  id          String                     @id @default(cuid())
  dossierId   String
  dossier     Dossier                    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?                      @relation("DossierMsgAuthor", fields: [authorId], references: [id])
  body        String // peut être vide si le message ne porte qu'une pièce jointe
  mentionIds  String[]                   @default([]) // utilisateurs tagués (@) — doivent être participants
  attachments DossierMessageAttachment[]
  createdAt   DateTime                   @default(now())

  @@index([dossierId])
}

/// Pièce jointe d'un message du fil « Suivi & discussion » (chat) — stockée chiffrée via le
/// backend Drive (blob), comme la messagerie. Supprimée en cascade avec son message.
model DossierMessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   DossierMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  blobId    String
  name      String
  mime      String
  size      Int
  createdAt DateTime       @default(now())

  @@index([messageId])
}

// ───────────────────────────── Sales ─────────────────────────────

model Sale {
  custom             Json? // admin-defined dynamic fields
  id                 String         @id @default(cuid())
  companyId          String? // entité (Adventum / Pharmagène / …)
  company            Company?       @relation(fields: [companyId], references: [id])
  date               DateTime       @default(now())
  saleType           SaleType       @default(PRODUCT) // produit ou service
  product            String // désignation (produit ou service)
  serviceDescription String? // détail si c'est un service
  dci                String?
  dosage             String?
  pharmaceuticalForm String?
  client             String
  institution        String?
  isPch              Boolean        @default(false)
  quantity           Int            @default(0)
  unitPrice          Decimal        @default(0) @db.Decimal(12, 2)
  revenue            Decimal        @default(0) @db.Decimal(14, 2)
  estimatedMargin    Decimal?       @db.Decimal(14, 2)
  purchaseOrder      String?
  invoice            String?
  paymentStatus      PaymentStatus  @default(UNPAID)
  deliveryStatus     DeliveryStatus @default(PENDING)
  comment            String?

  salesUserId String?
  salesUser   User?   @relation(fields: [salesUserId], references: [id])

  createdById      String?
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// LE PRODUIT VENDU. Nullable : `saleType` peut valoir SERVICE, et `product` (texte) reste
  /// la désignation libre — une prestation n'a pas de produit canonique.
  productId        String?
  canonicalProduct Product?       @relation("SaleProduct", fields: [productId], references: [id], onDelete: SetNull)
  /// LA CHAÎNE PCH, quand la vente en relève : AO → ligne → commande. `isPch` disait DÉJÀ
  /// qu'une vente venait de la PCH sans jamais dire DE QUEL marché.
  tenderLineId     String?
  tenderLine       PchTenderLine? @relation("SaleTenderLine", fields: [tenderLineId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([product])
  @@index([client])
  @@index([salesUserId])
  @@index([productId])
  @@index([tenderLineId])
}

// ───────────────────────────── Logistics PCH ─────────────────────────────

model LogisticsOrder {
  custom             Json? // admin-defined dynamic fields
  id                 String          @id @default(cuid())
  companyId          String? // entité (Adventum / Pharmagène / …)
  company            Company?        @relation(fields: [companyId], references: [id])
  reference          String          @unique
  product            String
  dci                String?
  dosage             String?
  pharmaceuticalForm String?
  supplier           String?
  country            String?
  quantityOrdered    Int             @default(0)
  quantityReceived   Int             @default(0)
  quantityDelivered  Int             @default(0)
  orderDate          DateTime?
  estimatedDeparture DateTime?
  actualDeparture    DateTime?
  estimatedArrival   DateTime?
  actualArrival      DateTime?
  customsDate        DateTime?
  pchDeliveryDate    DateTime?
  status             LogisticsStatus @default(ORDERED)
  carrier            String?
  incoterm           String?
  invoiceNumber      String?
  blAwbNumber        String?
  orderValue         Decimal?        @db.Decimal(14, 2)
  currency           String          @default("EUR")
  exchangeRate       Decimal?        @db.Decimal(10, 4)
  comments           String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([estimatedArrival])
  @@index([supplier])
}

// ───────────────────────────── Medical promotion ─────────────────────────────

// Spécialité médicale (Cardiologie, Oncologie…) — liste de référence gérée par
// le manager Promotion médicale. Chaque médecin est rattaché à une spécialité et
// exerce dans un secteur (hôpital / libéral / les deux).
model MedicalSpecialty {
  id             String                   @id @default(cuid())
  name           String                   @unique
  color          String? // accent visuel
  notes          String?
  doctors        MedicalDoctor[]
  /// LES BUSINESS UNITS QUI LA VISENT (§118.183) — une spécialité visée ne se retire pas du référentiel.
  businessUnits  BusinessUnitSpecialty[]
  /// LES PRODUITS (dans une BU) QUI LA VISENT — un produit ne vise qu'une partie des spécialités de sa BU.
  produitsCibles PromoProductSpecialite[]
  createdById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([name])
}

model MedicalDoctor {
  custom                Json? // admin-defined dynamic fields
  id                    String                     @id @default(cuid())
  /// Référentiel R1 : la Personne réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  personneId            String?
  personne              Personne?                  @relation(fields: [personneId], references: [id], onDelete: SetNull)
  companyId             String? // entité (Adventum / Pharmagène / …)
  company               Company?                   @relation(fields: [companyId], references: [id])
  name                  String
  title                 DoctorTitle                @default(AUTRE) // grade : Professeur, etc.
  specialty             String? // libellé libre hérité (fallback si non rattaché)
  specialtyId           String?
  specialtyRef          MedicalSpecialty?          @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  /// Les demandes Ad & Pro qui désignent CE praticien (médecins concernés — Direction, 08/10).
  adProMedecins         AdProMedecin[]
  sector                MedicalSector              @default(LIBERAL)
  institution           String? // hôpital / clinique (libellé dénormalisé, hérité)
  institutionId         String?
  institutionRef        MedicalInstitution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  /// SON SERVICE dans l'établissement (§118.172) — toujours un service DE `institutionId` :
  /// l'action qui l'écrit le vérifie, et changer d'établissement le retire.
  serviceId             String?
  serviceRef            MedicalInstitutionService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  city                  String?
  region                String?
  /// Découpage administratif algérien — une des 58 wilayas, choisie dans une liste fermée pour
  /// que « Alger », « ALGER » et « alger » se comptent et se filtrent ensemble.
  wilaya                String?
  /// Code officiel de la wilaya (référentiel `Wilaya`), LU du texte saisi par `src/lib/lieux/normaliser.ts` — nul si
  /// ce texte est vide ou ambigu. Le texte reste la saisie (reprise « lieux-wilaya », double écriture V2-D).
  wilayaCode            String?
  wilayaRef             Wilaya?                    @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  address               String?
  postalCode            String?
  /// Nom / prénom séparés (annuaire). `name` reste le libellé d'affichage, recomposé à l'édition.
  lastName              String?
  firstName             String?
  phone                 String?
  email                 String?
  influenceLevel        InfluenceLevel             @default(MEDIUM) // hérité (remplacé par `influence`)
  prescriptionPotential Priority                   @default(MEDIUM) // hérité (remplacé par `potential`)
  // Segmentation à 5 niveaux (très haut → très bas) sur trois axes.
  influence             SegmentLevel               @default(MEDIUM) // influence (produit / spécialité)
  potential             SegmentLevel               @default(MEDIUM) // potentiel de prescription
  affinity              SegmentLevel               @default(MEDIUM) // affinité avec nous
  // Logique de segmentation produit : par spécialité (specialtyRef) et/ou par
  // produit(s) ciblé(s). `targetProducts` liste les produits suivis pour ce praticien.
  targetProducts        String?
  lastVisit             DateTime?
  nextVisit             DateTime?
  comments              String?

  /// L'ANNUAIRE auquel ce praticien appartient. Nul = l'annuaire général (historique).
  /// Une entreprise tient plusieurs listes — « Cardiologues Centre », « Prescripteurs Oncologie »,
  /// « Congrès 2026 » — et les mélanger rend chacune inutilisable.
  directoryId String?
  directory   MedicalDirectory? @relation(fields: [directoryId], references: [id], onDelete: SetNull)

  // Row-level access: a delegate only sees their own doctors.
  delegateId String?
  delegate   User?   @relation(fields: [delegateId], references: [id])

  visits                   MedicalVisit[]
  /// LE MATÉRIEL PROMOTIONNEL qu'il a reçu en visite (§118.166) — l'historique de sa fiche.
  promoRemises             PromoStockMovement[]     @relation("PromoRemiseMedecin")
  fieldReports             FieldReport[]
  /// Les couleurs posées sur ses cellules dans la feuille de l'annuaire (§118.133).
  cellStyles               DirectoryCellStyle[]
  /// SA PLACE DANS LES STRATÉGIES DE SEGMENTATION (statut stratégique par stratégie, jamais un A/B/C/D global).
  segmentationFiches       SegmentationFiche[]
  /// SON POTENTIEL TERRAIN, HISTORISÉ — une observation par relevé, jamais écrasée.
  segmentationObservations HcpObservation[]
  /// LES DÉROGATIONS POSÉES À LA MAIN sur son ciblage ou ses segments (valeur, auteur, motif, échéance).
  segmentationDerogations  SegmentationDerogation[]

  /// ARCHIVAGE RÉVERSIBLE (Direction, 06/10) : « supprimer » une ligne de l'annuaire l'archive — elle
  /// sort de la feuille, des comptes, de l'export et de la recherche, mais reste en base et se
  /// restaure depuis la vue « Archivés ». Nul = fiche active.
  archivedAt   DateTime?
  archivedById String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([archivedAt])
  @@index([delegateId])
  @@index([specialtyId])
  @@index([institutionId])
  @@index([serviceId])
  @@index([sector])
  @@index([region])
  @@index([city])
  @@index([directoryId])
  @@index([personneId])
  @@index([wilayaCode])
}

/// UN ANNUAIRE DE PRATICIENS — une liste nommée, pas LA liste.
/// Une entreprise en tient plusieurs (« Cardiologues Centre », « Prescripteurs Oncologie »,
/// « Congrès 2026 ») : les fondre en une seule rend chacune inutilisable, et un import destiné à
/// une campagne pollue l'annuaire de tout le monde.
/// Supprimer un annuaire NE SUPPRIME PAS ses praticiens : ils repassent dans l'annuaire général.
model MedicalDirectory {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Entité de rattachement. Nul = annuaire commun au groupe.
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors MedicalDoctor[]
  /// QUI PEUT OUVRIR CET ANNUAIRE. Liste VIDE = ouvert à tout le module — le cas normal, et le
  /// seul défaut sûr pour l'existant. Nommer quelqu'un FERME l'annuaire à tous les autres (hors
  /// vue globale) : même règle que les lecteurs désignés de Legal.
  access  MedicalDirectoryAccess[]
  /// SES COLONNES EN PLUS des colonnes communes. Vide = l'annuaire n'a que le tronc commun.
  columns MedicalDirectoryColumn[]

  @@index([companyId])
}

/// UNE COLONNE PROPRE À UN ANNUAIRE — ce que le tronc commun ne prévoit pas.
///
/// Un annuaire d'infectiologues veut « Dernier congrès » ; un fichier de pharmaciens veut
/// « Numéro d'officine ». Ajouter ces champs au tronc commun les imposerait à tous les
/// annuaires, et la grille finirait avec quarante colonnes vides pour tout le monde.
///
/// LA VALEUR VIT DANS `MedicalDoctor.custom` (JSON), pas dans une colonne SQL : on ne migre pas
/// la base parce qu'un délégué ajoute un champ. La `key` est FIGÉE à la création et sert de clé
/// dans ce JSON — renommer le libellé ne doit jamais perdre les valeurs déjà saisies.
model MedicalDirectoryColumn {
  id          String           @id @default(cuid())
  directoryId String
  directory   MedicalDirectory @relation(fields: [directoryId], references: [id], onDelete: Cascade)
  /// Clé technique STABLE dans `MedicalDoctor.custom`. Dérivée du libellé à la création, puis
  /// jamais modifiée : c'est ce qui rend le renommage sans danger.
  key         String
  label       String
  /// TEXT | NUMBER | DATE | CHOICE — le type dit comment la cellule se saisit et se valide.
  kind        String           @default("TEXT")
  /// Pour CHOICE seulement : les options, séparées par `|`.
  options     String?
  position    Int              @default(0)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([directoryId, key])
  @@index([directoryId])
}

/// UN ACCÈS DÉSIGNÉ à un annuaire de praticiens. Supprimer l'annuaire emporte ses accès.
model MedicalDirectoryAccess {
  id          String           @id @default(cuid())
  directoryId String
  directory   MedicalDirectory @relation(fields: [directoryId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("MedicalDirectoryAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?
  createdAt   DateTime         @default(now())

  @@unique([directoryId, userId])
  @@index([userId])
}

/// L'ANNUAIRE DE L'ENTREPRISE — tout ce qui n'est ni un praticien, ni un salarié.
/// Agence de voyage, livreur, agence marketing, imprimeur, hôtel, traiteur, transitaire : ces
/// numéros vivent dans les téléphones de trois personnes, et le jour où l'une est absente,
/// on cherche l'imprimeur sur Internet. La `kind` est libre — la réalité invente des métiers plus
/// vite qu'une liste fermée ne les prévoit.
model CompanyContact {
  id          String   @id @default(cuid())
  /// Référentiel R2 : l'Organisation réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  organisationId String?
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name        String
  /// Nature libre : « Agence de voyage », « Livreur », « Imprimeur », « Agence marketing »…
  kind        String?
  /// PRIVE (prestataires, l'annuaire « Partenaires ») · PUBLIC (ministères, PCH, ANPP, DSP… l'annuaire « Partenaires
  /// publics »). Même fiche, même écran : seule la porte change (Direction, 06/10).
  sphere      String   @default("PRIVE")
  contactName String? // la personne qu'on demande
  phone       String?
  phoneAlt    String?
  email       String?
  website     String?
  address     String?
  city        String?
  wilaya      String?
  /// Code officiel de la wilaya (référentiel `Wilaya`), LU du texte saisi par `src/lib/lieux/normaliser.ts` — nul si
  /// ce texte est vide ou ambigu. Le texte reste la saisie (reprise « lieux-wilaya », double écriture V2-D).
  wilayaCode            String?
  wilayaRef             Wilaya?                    @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  /// Identifiants utiles pour un dossier de paiement ou un contrat.
  rc          String?
  nif         String?
  rib         String?
  notes       String?
  isActive    Boolean  @default(true)
  /// Entité de rattachement. Nul = contact commun au groupe.
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Ses moyens de contact vérifiés (annuaire interne).
  directoryEntry DirectoryEntry? @relation("ContactDirectory")
  /// Les devis de matériel promotionnel où il est le fournisseur (§118.152).
  promoQuotes    PromoQuote[]    @relation("PromoQuoteSupplier")

  @@index([companyId])
  @@index([isActive])
  @@index([kind])
  @@index([organisationId])
  @@index([wilayaCode])
}

// Établissement médical (hôpital, clinique, cabinet, pharmacie…) — référentiel structuré.
enum InstitutionType {
  CHU // Centre hospitalo-universitaire
  EPH // Établissement public hospitalier
  EHS // Établissement hospitalier spécialisé
  CLINIQUE_PRIVEE
  POLYCLINIQUE
  CABINET // Cabinet médical
  CENTRE_SANTE
  PHARMACIE
  GROSSISTE // Grossiste répartiteur
  AUTRE
}

enum InstitutionSector {
  PUBLIC
  PRIVE
}

model MedicalInstitution {
  id          String            @id @default(cuid())
  /// Référentiel R2 : l'Organisation réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  organisationId String?
  organisation Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name        String
  type        InstitutionType   @default(AUTRE)
  sector      InstitutionSector @default(PUBLIC)
  wilaya      String?
  /// Code officiel de la wilaya (référentiel `Wilaya`), LU du texte saisi par `src/lib/lieux/normaliser.ts` — nul si
  /// ce texte est vide ou ambigu. Le texte reste la saisie (reprise « lieux-wilaya », double écriture V2-D).
  wilayaCode            String?
  wilayaRef             Wilaya?                    @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  city        String?
  region      String?
  address     String?
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean           @default(true)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  doctors        MedicalDoctor[]
  /// SES SERVICES (cardiologie, oncologie, pharmacie centrale…) — §118.172. Un praticien se
  /// rattache à l'un d'eux ; un secteur commercial couvre l'établissement entier ou certains.
  services       MedicalInstitutionService[]
  /// LES SECTEURS COMMERCIAUX qui couvrent cet établissement.
  sectors        SalesSectorInstitution[]
  /// Les couleurs posées sur ses cellules dans la feuille des établissements (§118.133).
  cellStyles     DirectoryCellStyle[]
  /// SON LIEU DE STOCK, quand des relevés le visent (§118.134) — au plus un.
  stockLocation  StockAnnex?
  /// LES DEMANDES DE STOCKS qui l'ont visé (DO → KAM).
  demandesStocks StockCountRequestHospital[]
  /// SA CONSOMMATION (Consumption Intelligence) — les lignes normalisées des fichiers importés.
  consommations  ConsommationLigne[]
  /// CE QUE LES DR DE LA PCH LUI ONT SERVI (Ventes PCH) — et ce qu'il a demandé sans l'obtenir.
  ventesPch      PchVenteLigne[]             @relation("PchVenteEtablissement")

  @@index([type])
  @@index([wilaya])
  @@index([name])
  @@index([organisationId])
  @@index([wilayaCode])
}

/// UN SERVICE D'UN ÉTABLISSEMENT — cardiologie, oncologie médicale, pharmacie centrale (§118.172).
///
/// Décision de la Direction (01/10) : « pour chaque établissement hospitalier, on doit pouvoir
/// renseigner les services qu'il a, ajouter ou supprimer ces services ». Un service n'existe
/// QU'À L'INTÉRIEUR de son établissement : la cardiologie du CHU Mustapha n'est pas celle d'Oran,
/// et un praticien « en cardiologie » sans hôpital ne désigne rien. D'où la cascade : supprimer
/// l'établissement emporte ses services ; supprimer un service laisse ses praticiens en place,
/// rattachés à l'établissement, sans service (`SetNull` côté praticien).
///
/// Le NOM est unique par établissement, sans égard à la casse ni aux espaces de bord : la
/// migration pose un index d'EXPRESSION (`lower(btrim(name))`), que Prisma ne sait pas écrire —
/// « Cardiologie » et « cardiologie  » seraient deux services pour la base et un seul pour
/// tout le monde.
model MedicalInstitutionService {
  id            String             @id @default(cuid())
  institutionId String
  institution   MedicalInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  /// Les praticiens rattachés à ce service.
  doctors  MedicalDoctor[]
  /// Les secteurs qui le couvrent NOMMÉMENT (un secteur « tous les services » n'en a pas besoin).
  secteurs SalesSectorInstitutionService[]

  @@index([institutionId])
}

/// LA COULEUR D'UNE CELLULE D'ANNUAIRE (§118.133).
///
/// Une feuille se colore comme dans Excel : « ces praticiens à revoir », « ces hôpitaux déjà
/// couverts ». La couleur est PARTAGÉE — elle fait partie de la feuille, comme dans un classeur
/// — et se pose sous le MÊME droit que la cellule qu'elle colore : un délégué ne colore que ses
/// praticiens (`canAccessEntity`), les établissements demandent le droit de modification du
/// module. Deux clés étrangères EXCLUSIVES, en cascade : une ligne supprimée emporte ses
/// couleurs sans nettoyage à penser. La couleur est une CLÉ de la palette fermée
/// (`lib/grille/couleurs.ts`), jamais un code libre — l'action serveur refuse le reste.
model DirectoryCellStyle {
  id            String              @id @default(cuid())
  doctorId      String?
  doctor        MedicalDoctor?      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  institutionId String?
  institution   MedicalInstitution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  /// La colonne — un champ de la feuille (`wilaya`, `phone`…) ou la clé d'une colonne sur mesure.
  field         String
  color         String
  setById       String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([doctorId, field])
  @@unique([institutionId, field])
  @@index([doctorId])
  @@index([institutionId])
}

model MedicalVisit {
  custom            Json? // admin-defined dynamic fields
  id                String         @id @default(cuid())
  date              DateTime
  doctorId          String?
  doctor            MedicalDoctor? @relation(fields: [doctorId], references: [id])
  delegateId        String?
  delegate          User?          @relation(fields: [delegateId], references: [id])
  region            String?
  objective         String?
  presentedProducts String?
  status            VisitStatus    @default(PLANNED)
  report            String? // compte rendu
  doctorFeedback    String?
  followUpActions   String?

  createdById        String?
  updatedById        String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  productLinks       MedicalVisitProduct[]
  /// LE PLAN DE TOURNÉE dont cette visite descend. NUL = visite hors plan, ce qui est
  /// exactement ce qu'une visite IMPRÉVUE veut dire — et c'est pourquoi le dénominateur de
  /// « visitées / planifiées » se lit sur cette colonne et nulle part ailleurs.
  tourPlanId         String?
  tourPlan           TourPlan?                      @relation(fields: [tourPlanId], references: [id], onDelete: SetNull)
  /// QUI L'A VOULUE : le plan, le terrain (imprévue), ou la Direction (« demain va voir Achour »).
  origin             VisitOrigin                    @default(PLAN)
  /// LES MESSAGES PRÉ-DÉFINIS retenus lors du rapport terrain.
  messageLinks       MedicalVisitMessage[]
  /// LES RAPPORTS VOCAUX qui documentent cette visite.
  fieldReports       FieldReport[]                  @relation("FieldReportVisit")
  /// LE MATÉRIEL REMIS (§118.166) : les mouvements de stock qui sortent du stock du délégué.
  promoRemises       PromoStockMovement[]           @relation("PromoRemiseVisite")
  /// LES SUPPORTS NUMÉRIQUES présentés pendant la visite — une utilisation, sans quantité.
  supportsNumeriques MedicalVisitSupportNumerique[]

  /// POURQUOI LA VISITE N'A PAS EU LIEU (§118.193 — audit 360°, M5 du KAM) : posé avec `POSTPONED` / `CANCELLED`
  /// par `direVisiteNonTenue`, dans la fenêtre de 48 h. Identifiant sans relation, comme les marques de renvoi.
  notHeldReason String?
  notHeldAt     DateTime?
  notHeldById   String?

  @@index([delegateId])
  @@index([doctorId])
  @@index([status])
  @@index([date])
}

/// UN SUPPORT NUMÉRIQUE PRÉSENTÉ EN VISITE (§118.166) — e-ADV, vidéo, e-flyer : il compte une
/// utilisation, sans rien retirer d'un stock qui n'a pas de quantité.
model MedicalVisitSupportNumerique {
  visitId   String
  visit     MedicalVisit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// Restrict : un support présenté porte une histoire — il s'archive, il ne s'efface pas.
  itemId    String
  item      PromoStockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())

  @@id([visitId, itemId])
  @@index([itemId])
}

model MedicalDelegatePlan {
  id               String   @id @default(cuid())
  delegateId       String?
  delegate         User?    @relation(fields: [delegateId], references: [id])
  weekStart        DateTime
  region           String?
  visitsTarget     Int      @default(0)
  keyDoctorsTarget Int      @default(0)
  productTarget    String?
  achievedVisits   Int      @default(0)
  managerComment   String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delegateId])
  @@index([weekStart])
}

// ───────────────────────────── Business development ─────────────────────────────

model BusinessDevelopmentOpportunity {
  custom              Json? // admin-defined dynamic fields
  id                  String    @id @default(cuid())
  name                String
  dci                 String?
  therapeuticClass    String?
  type                BDType    @default(GENERIC)
  targetMarket        String?
  estimatedMarketSize Decimal?  @db.Decimal(16, 2)
  estimatedPrice      Decimal?  @db.Decimal(12, 2)
  competitors         String?
  potentialSupplier   String?
  supplierCountry     String?
  supplierContact     String?
  status              BDStatus  @default(IDEA)
  priority            Priority  @default(MEDIUM)
  score               Int? // 0-100 opportunity scoring
  nextAction          String?
  nextActionDate      DateTime?
  comments            String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([ownerId])
}

// ─────────────── Business Development : Projet → Gamme → Produit ───────────────
// Tableau stratégique : un projet regroupe des gammes, chaque gamme des produits
// (DCI) porteurs des données marché / investissement / revenus. Modèle simple et
// granulaire (pas un CRM lourd) ; tout est saisi manuellement par l'équipe.

model BdProject {
  custom      Json? // champs dynamiques définis par l'admin
  id          String          @id @default(cuid())
  name        String
  status      BdProjectStatus @default(IDEA)
  description String?
  comment     String?

  ownerId   String?
  owner     User?               @relation("BdProjectOwner", fields: [ownerId], references: [id])
  /// L'ENTITÉ DU PROJET (§118.163) — la société du groupe à laquelle il appartient, et donc
  /// qui le voit dans une vue cloisonnée (`companyScopedWhere`). Obligatoire à la création ;
  /// nullable pour l'historique : un projet d'avant reste visible et se rattache depuis l'écran
  /// « Projets », où l'entité de ses dossiers est PROPOSÉE — jamais posée à la place de quelqu'un.
  companyId String?
  company   Company?            @relation("BdProjectCompany", fields: [companyId], references: [id], onDelete: SetNull)
  ranges    BdRange[]
  /// LES DOSSIERS RÉGLEMENTAIRES classés dans ce projet — le sous-module « Projets » les
  /// affiche, un tableau par projet.
  dossiers  RegulatoryProduct[] @relation("BdProjectDossiers")

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([companyId])
}

model BdRange {
  id        String  @id @default(cuid())
  name      String // Gamme (ex. Oncologie, Cardiologie)
  comment   String?
  sortOrder Int     @default(0)

  projectId String
  project   BdProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  products  BdProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model BdProduct {
  custom              Json?
  id                  String             @id @default(cuid())
  /// LE DOSSIER RÉGLEMENTAIRE CORRESPONDANT, quand quelqu'un l'a confirmé.
  /// Facultatif et JAMAIS deviné : un produit à l'étude n'a souvent pas encore de dossier, et
  /// rapprocher automatiquement sur ressemblance confondrait un jour un 500 mg et un 1 g.
  regulatoryProductId String?
  regulatoryProduct   RegulatoryProduct? @relation("BdProductDossier", fields: [regulatoryProductId], references: [id], onDelete: SetNull)
  dci                 String // DCI / produit
  brandName           String?
  dosage              String?
  form                String? // forme galénique
  sourcing            BdSourcing         @default(TO_STUDY)
  sortOrder           Int                @default(0)

  // Marché
  marketSizeDzd     Decimal? @db.Decimal(18, 2)
  marketSizeUsd     Decimal? @db.Decimal(18, 2)
  unitPrice         Decimal? @db.Decimal(14, 2)
  totalMarketVolume Decimal? @db.Decimal(18, 2)

  // Concurrence (texte libre : listes saisies manuellement)
  competitors      String?
  competitorShares String?
  competitorVolume String?
  competitorPrice  String?

  // Plan d'affaires sur 3 ans
  investmentY1 Decimal? @db.Decimal(18, 2)
  investmentY2 Decimal? @db.Decimal(18, 2)
  investmentY3 Decimal? @db.Decimal(18, 2)
  revenueY1    Decimal? @db.Decimal(18, 2)
  revenueY2    Decimal? @db.Decimal(18, 2)
  revenueY3    Decimal? @db.Decimal(18, 2)

  comment String?

  rangeId String
  range   BdRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)

  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// LE PRODUIT CANONIQUE. C'est ICI que le besoin se voit le mieux : un produit à l'étude
  /// n'a pas de dossier, et doit pourtant avoir une identité.
  productId        String?
  canonicalProduct Product? @relation("ProductBdProfile", fields: [productId], references: [id], onDelete: SetNull)

  @@index([rangeId])
  @@index([productId])
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

model Document {
  id              String           @id @default(cuid())
  /// Référentiel R5 : la Pièce (le fichier une fois pour toutes) que cette ligne montre — nul tant que non reprise (P2).
  pieceId         String?
  piece           Piece?           @relation(fields: [pieceId], references: [id], onDelete: SetNull)
  name            String
  category        DocumentCategory @default(OTHER)
  entityType      EntityType
  entityId        String
  stepKey         String? // étape ANPP rattachée (Regulatory) : clé d'étape du workflow
  fileKey         String? // storage object key (S3/R2/Supabase)
  mimeType        String?
  sizeBytes       Float? // Float : un fichier va jusqu'à 10 Go, ce qu'un entier 32 bits ne tient pas
  version         Int              @default(1)
  confidentiality Confidentiality  @default(INTERNAL)
  folder          String? // chemin du dossier d'origine quand on a déposé un DOSSIER (« Module 3/3.2.P »), sinon null
  uploadedById    String?
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id])

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  mailPieces MailEntryPiece[]

  @@index([entityType, entityId])
  @@index([category])
  @@index([uploadedById])
  @@index([pieceId])
}

model Comment {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  body       String
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id])
  createdAt  DateTime   @default(now())
  editedAt   DateTime? // dernière édition (auteur ou modérateur)

  @@index([entityType, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERIC)
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  // Affichage en pop-up plein écran (grande fenêtre centrée) jusqu'à accusé de réception.
  popup     Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Deux lectures, deux index — chacun SERT le tri, sans quoi le planificateur parcourt l'index
  // des dates à l'envers en filtrant, et pour une personne qui a peu de notifications (un compte
  // neuf) il lit TOUTE la table : 4,7 millions de lignes, 1,8 s, mesuré sur les deux.
  //   • « ses non lues, les plus récentes d'abord » (boîte de décision, centre d'actions) et leur
  //     compte (chaque page) : l'égalité sur la personne et sur « non lue », puis le tri. Remplace
  //     `[userId, isRead]`, dont c'est un préfixe.
  //   • « toutes ses notifications, les plus récentes d'abord » (page Notifications) : la
  //     personne, puis le tri — l'index précédent ne peut pas le donner, `isRead` s'intercale.
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// LE FIL D'UNE TÂCHE — l'échange entre celui qui demande et celui qui fait.
///
/// Une demande de tâche se précise presque toujours : « pour quelle heure ? », « je passe demain,
/// le bureau était fermé », « la facture est jointe ». Sans endroit pour l'écrire, cet échange
/// part en messagerie et se sépare de la tâche qu'il concerne — trois semaines plus tard, la
/// tâche dit « validée » et personne ne retrouve pourquoi elle a pris dix jours.
///
/// Tout le CERCLE de la tâche écrit ici (voir `canComment` dans `lib/tasks/request-flow.ts`) :
/// commenter n'est pas décider, et un lecteur nommé l'a été parce qu'il connaît le sujet.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  action     AuditAction
  module     String // human-readable module name
  entityType EntityType?
  entityId   String?
  field      String? // changed field (for UPDATE)
  oldValue   String?
  newValue   String?
  summary    String? // human readable description
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────── Dynamic access control ─────────────────────────

enum AccessScope {
  ALL // sees every row of the module
  ASSIGNED // sees only rows explicitly granted / owned
}

/// Per-user, per-module access override. When a row exists it fully replaces the
/// role default for that module, so an admin can grant/revoke a tab and tune
/// exactly which actions a user may perform.
/// UN SIÈGE NOMMÉ AU CENTRE DE PAIEMENT — une personne, désignée, et pas un rôle.
///
/// ── LE PROBLÈME QU'IL RÉSOUT ────────────────────────────────────────────────────────────────
///
/// Siéger au centre était une propriété du RÔLE : Super Admin ou Direction, et personne d'autre
/// (`sitsOnPaymentCentre`). Faire entrer une personne de plus n'avait donc qu'un seul chemin —
/// lui donner le rôle Direction, c'est-à-dire MANAGE sur tous les pôles, la vue globale sur les
/// validations de toute l'entreprise et My Chief of Staff. Pour quelqu'un qui doit autoriser des
/// paiements, c'est hors de proportion, et ce n'est pas ce qu'on voulait accorder.
///
/// Les deux gestes qui SEMBLAIENT surgicaux ne fonctionnaient pas et ne le disaient pas : cocher
/// le module `PAYMENT_CENTRE` dans la grille d'accès (l'écran du centre ne consulte pas ce
/// module) et poser « autre rôle = Direction » (la règle lit le rôle PRINCIPAL). Dans les deux
/// cas l'administrateur croyait avoir accordé l'accès, et la personne trouvait un écran vide.
///
/// ── CE QUE LE SIÈGE EST, ET CE QU'IL N'EST PAS ──────────────────────────────────────────────
///
/// Il donne EXACTEMENT une chose : siéger au centre de paiement — voir la file des autorisations
/// et trancher. Aucun autre module, aucune vue globale, aucun droit sur les Finances. Le cercle
/// s'élargit par des NOMS, un par un, et chaque nom porte celui qui l'a désigné.
///
/// ── POURQUOI IL PORTE SON MOTIF ET SON AUTEUR ───────────────────────────────────────────────
///
/// Désigner quelqu'un au centre, c'est lui donner le pouvoir d'engager l'argent de la société.
/// Un siège dont on ne sait ni qui l'a accordé, ni pourquoi, est un siège que personne n'ose
/// retirer — on ne sait pas ce qu'on déferait. Le motif n'est pas de la paperasse : c'est ce
/// qu'on relit le jour où l'on se demande si ce siège a encore une raison d'être.
model PaymentCentreSeat {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation("PaymentCentreSeatHolder", fields: [userId], references: [id], onDelete: Cascade)
  /// Qui a désigné. `SET NULL` : désactiver un compte n'efface pas la trace de ce qu'il a accordé.
  grantedById String?
  grantedBy   User?    @relation("PaymentCentreSeatGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime @default(now())
  /// Le motif, écrit par celui qui désigne — obligatoire à l'écran.
  note        String?

  @@index([grantedById])
}

model UserAccess {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      String // Module key (REGULATORY, SALES, …)
  canView     Boolean     @default(true)
  canCreate   Boolean     @default(false)
  canUpdate   Boolean     @default(false)
  canDelete   Boolean     @default(false)
  canValidate Boolean     @default(false)
  canExport   Boolean     @default(false)
  canUpload   Boolean     @default(false)
  scope       AccessScope @default(ASSIGNED)
  /// LES SECTIONS qu'un accès PERSONNALISÉ ouvre à l'intérieur du module — aujourd'hui les
  /// ANNUAIRES du module `DIRECTORIES` (« l'annuaire des établissements à part, partenaires… »,
  /// décision de la Direction 09/2026). Vide = aucune section en plus de ce que les modules de la
  /// personne lui ouvrent déjà. Les clés valides vivent dans `lib/annuaires/acces.ts` ; une clé
  /// inconnue est ignorée à la lecture, jamais interprétée.
  sections    String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

/// Explicit grant of a single row (line) to a user. Combined with UserAccess
/// scope = ASSIGNED, this lets the admin hand-pick which lines a user can see.
model RowGrant {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
}

// ───────────────────────── Sessions & activity ─────────────────────────

/// A revocable session. The JWT carries this row's `id`; server-side checks
/// reject revoked/expired sessions, giving the admin real token control.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?
  country    String?
  city       String?
  device     String?
  browser    String?
  os         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([revokedAt])
}

/// Fine-grained activity: page views, logins, and time-on-page (from a client
/// beacon), enriched with device, IP and geolocation.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       String // PAGE_VIEW | LOGIN | LOGOUT
  path       String?
  module     String?
  durationMs Int? // time spent on the page
  ipAddress  String?
  country    String?
  city       String?
  region     String?
  latitude   Float? // géoloc précise du navigateur (avec consentement)
  longitude  Float?
  accuracy   Float? // précision en mètres
  geoSource  String? // gps | ip
  device     String? // desktop | mobile | tablet (+ modèle si fourni)
  browser    String?
  os         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@index([path])
}

// ───────────────────────── Custom fields (dynamic columns) ─────────────────────────

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  /// Référence un document du Drive (jamais copié) — valeur stockée : { nodeId, name }.
  FILE
}

/// INSTANTANÉ d'un circuit de validation à chaque enregistrement du builder : l'historique
/// se liste et se RESTAURE (le rollback rejoue l'instantané par le même chemin validé).
model WorkflowDefinitionVersion {
  id        String   @id @default(cuid())
  category  String
  version   Int
  name      String
  snapshot  Json
  savedById String?
  createdAt DateTime @default(now())

  @@unique([category, version])
  @@index([category])
}

/// Admin-defined extra field for a module. Values are stored in each record's
/// `custom` JSON column keyed by `key`.
model CustomFieldDef {
  id         String          @id @default(cuid())
  entityType EntityType
  key        String // machine key used inside the record's `custom` JSON
  label      String
  type       CustomFieldType @default(TEXT)
  options    String? // comma-separated choices for SELECT
  order      Int             @default(0)
  required   Boolean         @default(false) // champ à remplir obligatoirement (hors Oui/Non)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
}

// ───────────────────────────── Finances ─────────────────────────────

enum FinanceDirection {
  IN // encaissement (recette, apport, prêt reçu)
  OUT // décaissement (dépense, salaire, remboursement)
}

enum FinanceCategory {
  RECETTE // recette / vente / encaissement client
  CCA // compte courant associé (apport)
  PRET // emprunt reçu
  REMBOURSEMENT // remboursement d'emprunt
  SALAIRE // charges de personnel / paie
  AVANCE // avance sur salaire
  LOYER
  VOYAGE // déplacements, missions
  EVENEMENT // table ronde, congrès, sponsoring payé
  BUREAUTIQUE // bureautique, mobilier, matériel
  FOURNISSEUR // achats fournisseurs / marchandises
  CHARGES // charges diverses (élec, eau, internet, assurance)
  IMPOT // impôts & taxes
  BANQUE // frais bancaires
  AUTRE
}

enum FinanceMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum FinanceStatus {
  PENDING // prévu / à régler
  SETTLED // réalisé (impacte la trésorerie)
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  VALIDATED
  PAID
}

/// General ledger entry — the simplified accounting book + treasury source.
model FinanceTransaction {
  custom       Json?
  id           String           @id @default(cuid())
  companyId    String? // entité (Adventum / Pharmagène / …)
  company      Company?         @relation(fields: [companyId], references: [id])
  reference    String           @unique // FIN-2026-001
  date         DateTime         @default(now())
  direction    FinanceDirection
  category     FinanceCategory
  label        String
  amount       Decimal          @db.Decimal(14, 2)
  method       FinanceMethod    @default(BANK_TRANSFER)
  account      String           @default("Banque") // Caisse, Banque, …
  counterparty String? // client / fournisseur / bénéficiaire
  invoiceRef   String?
  status       FinanceStatus    @default(SETTLED)
  notes        String?

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // Attribution d'une dépense à une catégorie budgétaire (enveloppe Direction).
  budgetCategoryId String?
  budgetCategory   BudgetCategoryLine? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)

  /// LE COMPTE D'OÙ PART (ou où arrive) L'ARGENT, figé à l'écriture (§118.176). Lu au moment où le
  /// flux s'écrit, il ne bouge plus quand on change ensuite de compte principal : sans lui, les
  /// soldes passés changeraient de compte à chaque réglage. Nul sur l'historique d'avant.
  treasuryAccountId String?
  treasuryAccount   TreasuryAccount? @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Règlement de facture dont ce mouvement est l'écriture (relation inverse).
  settledInvoice LegalDocument? @relation("LegalSettlement")

  @@index([date])
  @@index([direction])
  @@index([category])
  @@index([status])
  @@index([account])
  @@index([budgetCategoryId])
  @@index([treasuryAccountId])
}

/// UN PAPIER EN-TÊTE — le modèle Office qu'on ouvre au lieu d'une page blanche.
///
/// Un en-tête n'est pas une image qu'on colle : c'est un DOCUMENT déjà mis en page, avec ses
/// marges, son pied de page, sa police et ses mentions légales. On stocke donc un vrai
/// `.docx` / `.xlsx` / `.pptx`, et créer « avec en-tête » en recopie les octets — le résultat
/// s'ouvre dans l'éditeur exactement comme le modèle, sans conversion ni approximation.
///
/// L'assistante de direction les téléverse, les renomme et les supprime : c'est elle qui tient
/// la papeterie de la société.
model OfficeLetterhead {
  id        String   @id @default(cuid())
  name      String
  /// `word` | `cell` | `slide` — un en-tête Word ne s'ouvre pas dans un tableur.
  kind      String
  /// Entité concernée. Nul = commun à tout le groupe (rare, mais légitime).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  blobId    String
  mime      String
  size      Int
  isActive  Boolean  @default(true)

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind, isActive])
  @@index([companyId])
}

/// LE PROFIL DOCUMENTAIRE D'UNE SOCIÉTÉ — ce que la fabrique de documents applique d'elle-même
/// à chaque devis, bon de commande ou facture émis en son nom : préfixes de numérotation, TVA
/// par défaut, conditions de paiement, validité d'un devis, papier en-tête Word, signataire.
/// Un par société ; absent = les défauts de `src/lib/artifact/factory/commercial.ts`. Tenu par
/// ceux qui tiennent la papeterie (`canManageLetterheads`) : une erreur ici part sur toutes les
/// pièces suivantes.
model CompanyDocumentProfile {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  quotePrefix       String  @default("DEV")
  orderPrefix       String  @default("BC")
  invoicePrefix     String  @default("FA")
  /// Taux de TVA par défaut, en fraction (0.19 = 19 %).
  vatRate           Decimal @default(0.19) @db.Decimal(5, 4)
  paymentTerms      String?
  quoteValidityDays Int     @default(30)
  /// Mention libre de pied de page (« Toute réclamation sous 8 jours… »).
  footerNote        String?
  /// Le papier en-tête Word appliqué d'office. Nul = le premier en-tête Word actif de la société.
  letterheadId      String?
  signatoryName     String?
  signatoryTitle    String?
  /// Réglages complémentaires (marque, polices, mentions) — extensibles sans migration.
  settings          Json?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// LE COMPTEUR DE NUMÉROTATION des pièces émises : une ligne par société, nature et année,
/// incrémentée ATOMIQUEMENT (`INSERT … ON CONFLICT DO UPDATE … RETURNING`). Un numéro attribué
/// ne l'est jamais deux fois — même sous vingt-cinq émissions parallèles — et une pièce
/// supprimée ne libère pas son numéro : la numérotation d'une facture est continue par
/// construction, pas par discipline.
/// LE COMPTEUR D'UNE SÉRIE DE RÉFÉRENCES (audit 27/10, DONNEES-12 / ADPRO-08) — `cle` = « Modèle:PRÉFIXE-AAAA »
/// (`ExpenseOrder:OD-2026`). Avancé atomiquement par `lib/references/serie.ts` ; un numéro attribué ne revient jamais,
/// même après une suppression réversible (sinon la restauration échoue sur la référence reprise).
model SerieReference {
  cle       String   @id
  dernier   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DocumentSequence {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// `QUOTE` | `PURCHASE_ORDER` | `INVOICE` — la nature Legal de la pièce ; `REGISTRE_DG` — le compteur COMMUN des
  /// références NNN/DG/AAAA (tous types de documents d'une société, une ligne par année : `lib/references/registre.ts`).
  kind      String
  year      Int
  last      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([companyId, kind, year])
}

/// LE REGISTRE COMMUN DES RÉFÉRENCES NNN/DG/AAAA (Direction, 10/2026 : « tout document ou BC généré doit avoir la numérotation
/// NNN/DG/AAAA », « un compteur commun pour les références »). Une ligne par numéro ATTRIBUÉ — bon de commande, ordre de mission,
/// demande de devis… — par société et par année : l'unicité (`companyId`, `year`, `numero`) vaut pour TOUS les types, et une
/// ligne ne se supprime jamais (un document annulé ne rend pas son numéro). Le compteur est `DocumentSequence` (kind
/// `REGISTRE_DG`) ; la règle et ses gardes : `lib/references/registre.ts`.
model DocumentReference {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year        Int
  numero      Int
  /// La référence telle qu'elle est imprimée (« 040/DG/2026 »).
  reference   String
  /// `BON_DE_COMMANDE` | `ORDRE_MISSION` | `DEMANDE_DEVIS` | `DEVIS` | `FACTURE` | `AVOIR`.
  docType     String
  /// Ce que le document sert : `LEGAL_DOCUMENT`, `HR_REQUEST`, `AD_PRO_ITEM`, `PROMO_MATERIAL`… (nul tant qu'il naît).
  entityType  String?
  entityId    String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([companyId, year, numero])
  @@index([entityType, entityId])
}

/// TEACH ADAM — ce qu'une personne a ENSEIGNÉ à Adam (§119) : une règle structurée, bornée à un
/// périmètre (personne, département, société), datée, versionnée PAR LIGNES — modifier crée une
/// nouvelle ligne `version + 1` dont `supersedesId` pointe l'ancienne, qui passe en SUPERSEDED ;
/// supprimer met en DELETED. Rien n'est jamais effacé : « quelle était la règle en mars ? » a une
/// réponse, et « 100 % des règles récupérables » est une propriété de la table.
///
/// Une règle est une ATTESTATION (qui l'a dite, pour qui, depuis quand, d'où) — jamais une
/// observation d'Adam écrite toute seule (§12). Voir `src/lib/teach/model.ts`.
model AdamRule {
  id            String      @id @default(cuid())
  /// PREFERENCE | COMPANY_RULE | WORKFLOW | CONVENTION | DOCUMENT_STANDARD | VALIDATION_RULE | EXCEPTION | MAPPING | BUSINESS_DEFINITION
  kind          String
  /// PERSON | GROUP | COMPANY
  scope         String
  /// Qui l'a enseignée — le nom que portera l'audit.
  ownerId       String
  owner         User        @relation("AdamRulesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  /// PERSON : la personne pour qui elle vaut (l'enseignant lui-même, sauf délégation).
  subjectUserId String?
  subject       User?       @relation("AdamRulesSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Minuscules, sans accent : general, finance, legal, regulatory, documents, mail, missions, hr…
  domain        String      @default("general")
  title         String
  statement     String      @db.Text
  /// La part structurée qu'un programme peut appliquer : { cle, valeur, unite } | { de, vers } | { seuil } | { exceptionDe }.
  params        Json?
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  /// ACTIVE | DISABLED | SUPERSEDED | DELETED
  status        String      @default("ACTIVE")
  version       Int         @default(1)
  supersedesId  String?     @unique
  supersedes    AdamRule?   @relation("AdamRuleVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy  AdamRule?   @relation("AdamRuleVersions")
  /// { threadId, messageId, missionId, citation, mode: TAUGHT | PROPOSED }
  provenance    Json?
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([subjectUserId, status])
  @@index([companyId, status])
  @@index([departmentId, status])
  @@index([ownerId, status])
  @@index([kind, domain])
  @@index([status, effectiveFrom])
}

/// UN COMPTE DE TRÉSORERIE ANCRÉ (§118.176) — « SGA Birkhadem, compte Adventum, 2 966 153 DZD au
/// 28/09/2026 ». L'ANCRAGE (`openingBalance` au jour `openingDate`, en fin de journée, comme un
/// relevé) n'est jamais réécrit par une ouverture : il se CORRIGE, avec un motif tracé. Le solde du
/// compte = l'ancrage + les écritures RÉGLÉES qui lui reviennent, datées APRÈS le jour d'ancrage.
model TreasuryAccount {
  id             String   @id @default(cuid())
  name           String   @unique // « SGA Birkhadem — Adventum », « Banque », …
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  openingDate    DateTime @default(now())
  notes          String?
  /// La banque et l'agence (« SGA Birkhadem ») et le RIB : ce qu'on lit sur le relevé.
  bank           String?
  rib            String?
  /// L'entité titulaire — c'est elle qui paie depuis ce compte.
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Le compte d'où part un paiement de son entité, quand l'écriture ne nomme pas le sien.
  principal      Boolean  @default(false)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions        FinanceTransaction[]
  lignesActualisation LigneActualisationSoldes[]

  @@index([companyId])
}

/// DEMANDE D'ACTUALISATION DES SOLDES — le Super Admin la pose pour UNE entité, les responsables
/// Finance / Budget y répondent compte par compte (nouveau solde de relevé + sa date, ou « pas encore
/// reçu »). Une ligne par compte de l'entité, figée à la demande avec l'ancrage d'alors : on relit ce
/// qu'on a demandé, et ce qui a changé. Auteur et répondant en identifiants simples, comme les comptes.
model DemandeActualisationSoldes {
  id           String    @id @default(cuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  note         String?
  demandeParId String
  createdAt    DateTime  @default(now())
  /// Posée quand TOUS les comptes sont actualisés ; un « pas encore reçu » laisse la demande ouverte.
  termineeLe   DateTime?

  lignes LigneActualisationSoldes[]

  @@index([companyId, termineeLe])
}

model LigneActualisationSoldes {
  id           String                     @id @default(cuid())
  demandeId    String
  demande      DemandeActualisationSoldes @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  compteId     String
  compte       TreasuryAccount            @relation(fields: [compteId], references: [id], onDelete: Cascade)
  /// EN_ATTENTE | ACTUALISE | NON_RECU
  etat         String                     @default("EN_ATTENTE")
  ancienSolde  Decimal                    @db.Decimal(14, 2)
  ancienneDate DateTime
  nouveauSolde Decimal?                   @db.Decimal(14, 2)
  nouvelleDate DateTime?
  traiteParId  String?
  traiteLe     DateTime?

  @@unique([demandeId, compteId])
  @@index([compteId])
}

/// Employee record — shared by RH (dossiers, congés, contrats) and Paie.
// ─────────────── Dossier RH employé (documents & demandes d'attestation) ───────────────

enum HrDocumentCategory {
  CONTRACT // contrat de travail
  AMENDMENT // avenant
  PAYSLIP // bulletin de paie
  WORK_CERTIFICATE // attestation de travail
  CNAS_CERTIFICATE // attestation / affiliation CNAS
  SALARY_STATEMENT // relevé des émoluments
  DOMICILIATION // attestation de domiciliation de salaire
  ID_DOCUMENT // pièce d'identité
  DIPLOMA // diplôme
  MEDICAL // certificat médical
  OTHER
}

enum HrRequestType {
  WORK_CERTIFICATE // attestation de travail
  CNAS_CERTIFICATE // attestation CNAS
  SALARY_STATEMENT // relevé des émoluments
  DOMICILIATION // domiciliation de salaire
  LEAVE_CERTIFICATE // attestation de congé
  LEAVE_TITLE // titre de congé
  MISSION_ORDER // ordre de mission
  EXPENSE_REPORT // note de frais
  EXCEPTIONAL_EXIT // sortie exceptionnelle (autorisation d'absence ponctuelle)
  SICK_LEAVE // arrêt maladie (avec justificatif)
  ANNUAL_LEAVE // demande de congé annuel
  UNPAID_LEAVE // congé sans solde
  SPECIAL_LEAVE // congé exceptionnel (mariage, naissance, décès…)
  MATERNITY_LEAVE // congé de maternité
  HR_INTERVIEW // entrevue avec les RH (date proposée puis confirmée)
  OTHER
}

enum HrRequestStatus {
  PENDING // soumise
  IN_PROGRESS // en préparation
  READY // prête (document disponible)
  DELIVERED // remise à l'employé
  APPROVED // accordée (congé / absence / autorisation — décision, pas un document)
  REJECTED
  CANCELLED // retirée par le salarié avant d'être traitée (décision du 04/10)
}

model Employee {
  custom        Json?
  id            String      @id @default(cuid())
  /// Référentiel R1 : la Personne réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  personneId    String?
  personne      Personne?   @relation(fields: [personneId], references: [id], onDelete: SetNull)
  companyId     String? // entité de rattachement (Adventum / Pharmagène / …)
  company       Company?    @relation(fields: [companyId], references: [id])
  fullName      String
  position      String?
  /// Libellé du département — CACHE dénormalisé du département structuré ci-dessous
  /// (`departmentRef.name`), tenu à jour à chaque rattachement. Conservé pour les vues
  /// et statistiques historiques ; la SOURCE DE VÉRITÉ est `departmentId`. DÉRIVÉ (10/2026) : il ne se
  /// saisit plus, il s'écrit à chaque changement de département (`src/lib/org/source-unique.ts`).
  department    String?
  /// Rattachement STRUCTURÉ : département OU sous-département (n'importe quel niveau).
  departmentId  String?
  departmentRef Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  email         String?
  phone         String?
  iban          String?
  baseSalary    Decimal     @default(0) @db.Decimal(12, 2)
  // Éléments de salaire (bulletin) — visibles par le salarié SAUF salaire brut,
  // retenue SS 35 % et TFP (taxe sur la formation professionnelle).
  retSS9        Decimal?    @db.Decimal(12, 2) // retenue sécurité sociale 9 %
  retSS35       Decimal?    @db.Decimal(12, 2) // retenue SS 35 % (confidentiel)
  tfp           Decimal?    @db.Decimal(12, 2) // taxe formation professionnelle (confidentiel)
  retIrg        Decimal?    @db.Decimal(12, 2) // retenue IRG
  expenseRefund Decimal?    @db.Decimal(12, 2) // remboursement de frais
  netToPay      Decimal?    @db.Decimal(12, 2) // net à payer
  grossSalary   Decimal?    @db.Decimal(12, 2) // salaire brut (confidentiel)
  /// COÛT EMPLOYEUR — ce que le salarié coûte RÉELLEMENT à la société : le brut, plus les
  /// charges patronales. C'est LUI qui fait la masse salariale, pas le brut : deux salariés au
  /// même brut ne coûtent pas la même chose. Confidentiel, comme le brut.
  employerCost  Decimal?    @db.Decimal(12, 2)
  hireDate      DateTime?
  isActive      Boolean     @default(true)
  notes         String?

  // RH — contrat, état civil, congés
  contractType        ContractType?
  contractStart       DateTime?
  contractEnd         DateTime? // échéance du contrat (CDD, stage…)
  // Période d'essai : dates, renouvelable, et si renouvelée → dates de la 2ᵉ période.
  trialStart          DateTime?
  trialEnd            DateTime?
  trialRenewable      Boolean       @default(false)
  trialRenewed        Boolean       @default(false)
  trialRenewalStart   DateTime?
  trialRenewalEnd     DateTime?
  leaveBalanceDays    Decimal       @default(30) @db.Decimal(6, 1) // solde de congés (jours)
  // Acquisition automatique des congés : 2,5 j / mois. Marqueur « YYYY-MM » du dernier
  // mois crédité (idempotent) — voir accrueMonthlyLeave() dans src/lib/scheduled.ts.
  leaveAccruedThrough String?
  birthDate           DateTime?
  nationalId          String? // NIN
  cnasNumber          String? // n° sécurité sociale (CNAS)
  address             String?

  // Compte applicatif lié (un employé peut avoir un accès au logiciel)
  userId String? @unique
  user   User?   @relation("UserEmployee", fields: [userId], references: [id])

  /// Ses moyens de contact vérifiés (annuaire interne).
  directoryEntry DirectoryEntry? @relation("EmployeeDirectory")

  // Hiérarchie (manager / N+1) — manager EXPLICITE ; à défaut, le N+1 est déduit du
  // département (responsable, puis responsable du parent). Voir src/lib/departments.ts.
  managerId String?
  manager   Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[]   @relation("EmployeeManager")
  // Départements dont cet employé est responsable / adjoint.
  headOf    Department[] @relation("DepartmentHead")
  deputyOf  Department[] @relation("DepartmentDeputy")
  // Position mémorisée sur la CARTE de l'organigramme (glisser-déposer). Null = placement auto.
  orgX      Float?
  orgY      Float?

  payrolls      PayrollEntry[]
  transactions  FinanceTransaction[]
  leaveRequests LeaveRequest[]
  advances      SalaryAdvance[]
  documents     EmployeeDocument[]
  hrRequests    HrDocumentRequest[]
  /// La candidature dont cette fiche est issue, quand elle vient d'un recrutement.
  recruitedAs   RecruitmentCandidate? @relation("RecruitmentHire")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([department])
  @@index([departmentId])
  @@index([managerId])
  @@index([contractEnd])
  @@index([personneId])
}

// Document RH rattaché à un employé (contrat, bulletin PDF, attestation…),
// stocké chiffré (FileBlob). Visible par l'employé dans son dossier.
model EmployeeDocument {
  id                String             @id @default(cuid())
  employeeId        String
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category          HrDocumentCategory @default(OTHER)
  name              String
  blobId            String
  mime              String
  size              Int
  period            String? // ex. « 2026-01 » pour un bulletin
  visibleToEmployee Boolean            @default(true)
  uploadedById      String?
  createdAt         DateTime           @default(now())

  // Lien optionnel : ce document répond à une demande d'attestation.
  requestId String?            @unique
  request   HrDocumentRequest? @relation("RequestFulfilment", fields: [requestId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([category])
}

// Demande d'attestation faite par l'employé (travail, CNAS, relevé des émoluments…),
// traitée par les RH qui peuvent y attacher le document généré.
model HrDocumentRequest {
  id          String            @id @default(cuid())
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        HrRequestType     @default(WORK_CERTIFICATE)
  status      HrRequestStatus   @default(PENDING)
  details     String? // précisions du demandeur
  hrNote      String? // note des RH
  handledById String?
  /// LE MOMENT OÙ LES RH ONT TRAITÉ la demande (prête, remise, accordée ou refusée) — posé UNE fois, jamais
  /// écrasé. Il alimente la brique KPI « demandes traitées » et son délai médian. Nul = pas encore traitée,
  /// ou antérieure à ce champ sans trace pour la dater (jamais estimée).
  handledAt   DateTime?
  fulfilment  EmployeeDocument? @relation("RequestFulfilment")

  // Note de frais : mois concerné (« YYYY-MM »), mois d'imputation retenu par les RH
  // (le même ou le suivant), et accusé de réception des ORIGINAUX par le bureau
  // du secrétariat (depuis son module).
  expenseMonth     String?
  approvedMonth    String?
  originalsAckAt   DateTime?
  originalsAckById String?

  /// LE MONTANT AVANCÉ, en DZD — séparé du texte de la note.
  ///
  /// Il vivait DANS `details`, mélangé au motif (« 4 200 DZD — taxi et péage »). Un montant
  /// noyé dans une phrase ne s'additionne pas, ne se compare pas, ne se contrôle pas : les RH
  /// relisaient chaque ligne pour savoir ce qu'on leur demandait de rembourser. Chaque note de
  /// frais porte donc SON montant et SA pièce.
  expenseAmount Decimal? @db.Decimal(12, 2)

  /// LES QUINZE MINUTES POUR SE CORRIGER.
  ///
  /// On envoie, on relit, on voit qu'on s'est trompé d'un chiffre. Sans cette fenêtre, il faut
  /// annuler et refaire — ce qui laisse deux demandes dans l'historique, dont une morte, et
  /// oblige les RH à deviner laquelle fait foi. La fenêtre est POSÉE À LA CRÉATION plutôt que
  /// recalculée à la lecture : ainsi elle se lit dans la base, et une éventuelle prolongation
  /// s'écrit ici au lieu de se déduire d'une règle qu'il faudrait retrouver.
  editableUntil DateTime?

  /// LA MODIFICATION ROUVERTE PAR LES RH — hors des quinze minutes.
  ///
  /// « Votre reçu est illisible, corrigez » n'a aucun sens si la personne ne peut plus rien
  /// changer : elle refait une seconde note, et l'on se retrouve avec deux demandes pour une
  /// dépense. C'est une décision HUMAINE, tracée par son auteur : l'audit portera son nom.
  /// Remise à null quand les RH referment.
  editUnlockedAt   DateTime?
  editUnlockedById String?

  // Entrevue RH : dernière date/heure proposée, par qui, et confirmation par l'autre partie.
  meetingAt           DateTime?
  meetingProposedById String?
  meetingConfirmedAt  DateTime?

  // Congés / absences : période demandée + nombre de jours. Pour un CONGÉ ANNUEL approuvé,
  // le solde de l'employé est débité une seule fois (balanceAppliedAt = verrou).
  periodStart      DateTime?
  periodEnd        DateTime?
  periodDays       Decimal?  @db.Decimal(5, 1)
  balanceAppliedAt DateTime? // solde de congés déjà débité pour cette demande

  // Archivage : dossier « Dossier traité » créé dans le Drive du traitant.
  archivedNodeId String?

  /// MISSION AD & PRO (Direction, 10/2026) — l'ordre de mission ou la note de frais d'une
  /// assignation. L'ordre passe d'abord par le N+1 (`managerGate` PENDING) avant la file RH ;
  /// nul = pas de marche N+1 (personne au-dessus, ou demande d'avant cette règle).
  missionAssignmentId String?
  managerGate         HrManagerGate?
  managerUserId       String?
  managerDecidedAt    DateTime?
  managerNote         String?
  /// Champs de l'ordre pré-remplis depuis la mission (objet, destination, dates) — repris par le générateur RH.
  omPrefill           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([missionAssignmentId])
}

/// La marche du N+1 sur un ordre de mission, avant les RH.
enum HrManagerGate {
  PENDING
  APPROVED
  REJECTED
}

/// Demande de congé / absence avec circuit de validation.
model LeaveRequest {
  custom       Json?
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         LeaveType   @default(ANNUAL)
  startDate    DateTime
  endDate      DateTime
  days         Decimal     @default(0) @db.Decimal(5, 1)
  reason       String?
  status       LeaveStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?       @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  /// Le numéro où JOINDRE la personne pendant son absence. Pré-rempli depuis la fiche employé,
  /// mais modifiable à la demande : on part rarement en congé avec son téléphone de bureau.
  /// Tout le reste de la fiche (nom, fonction, date de recrutement, direction) se LIT de
  /// l'employé — le recopier ici en ferait une seconde vérité qui vieillirait mal.
  phone String?

  /// ─── Circuit à trois marches : N+1 → RH → DG ───
  stage              LeaveStage @default(MANAGER)
  managerId          String? /// responsable résolu à la soumission (organigramme)
  managerDecidedById String?
  managerDecidedAt   DateTime?
  managerNote        String?
  hrDecidedById      String?
  hrDecidedAt        DateTime?
  hrNote             String?
  dgDecidedById      String?
  dgDecidedAt        DateTime?
  dgNote             String?
  createdById        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  /// ─── INTÉRIMAIRE : quelqu'un tient la place pendant l'absence ───
  ///
  /// L'absent DÉSIGNE (il est seul à savoir qui peut le remplacer sur son métier), les RH
  /// VALIDENT (sans quoi chacun se choisirait un remplaçant complaisant), et la délégation ne
  /// vit QUE pendant le congé : c'est le calendrier qui la ferme, pas la mémoire de quelqu'un.
  standInId          String?
  standIn            User?          @relation("LeaveStandIn", fields: [standInId], references: [id], onDelete: SetNull)
  standInStatus      StandInStatus?
  /// Les modules délégués — jamais tout le compte. Un directeur en congé délègue ses
  /// validations, pas la lecture de ses courriels. Voir `lib/hr/stand-in.ts`.
  standInModules     String[]       @default([])
  standInDecidedById String?
  standInDecidedAt   DateTime?
  standInNote        String?

  /// ─── DEMANDER À SON N+1 (Direction, 06/10) ───
  /// Le responsable peut demander l'avis de SON propre N+1, qui peut remonter encore, jusqu'au sommet ; les
  /// validations redescendent ensuite, une marche à la fois. `currentApproverId` : la PERSONNE (User) qui tient la
  /// décision de la marche N+1 quand elle a été remontée — nul = le N+1 de la demande. La trace : `escalations`.
  currentApproverId String?
  escalations       LeaveEscalation[]

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([standInId, standInStatus])
  @@index([currentApproverId])
}

/// UNE MARCHE REMONTÉE sur un congé : qui a demandé l'avis de qui, quand, pourquoi — et ce qui est redescendu
/// (validé ou refusé, par qui, quand). Une ligne par échelon franchi, dans l'ordre.
model LeaveEscalation {
  id           String       @id @default(cuid())
  leaveId      String
  leave        LeaveRequest @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  order        Int
  fromUserId   String
  toUserId     String
  note         String?
  askedAt      DateTime     @default(now())
  /// APPROVED | REJECTED — nul tant que la marche du dessus n'a pas répondu.
  decision     String?
  decisionNote String?
  decidedAt    DateTime?

  @@unique([leaveId, order])
  @@index([toUserId])
}

enum StandInStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Tâche assignable — cœur de l'espace de travail (to-do, délégation, suivi).
model Task {
  custom             Json?
  id                 String        @id @default(cuid())
  title              String
  description        String?
  assignedToId       String?
  assignedTo         User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  // Personnes associées à la tâche, fixées à la création. Les PARTICIPANTS peuvent agir
  // (démarrer, terminer) comme le responsable ; les LECTEURS la voient sans pouvoir la changer.
  // Identifiants bruts (pas de relation) — même patron léger que `Dossier.participantIds`.
  participantIds     String[]      @default([])
  readerIds          String[]      @default([])
  createdById        String?
  createdBy          User?         @relation("TaskCreator", fields: [createdById], references: [id])
  dueDate            DateTime?
  priority           Priority      @default(MEDIUM)
  status             TaskStatus    @default(TODO)
  module             String? // module concerné (REGULATORY, FINANCES…)
  relatedEntityType  EntityType?
  relatedEntityId    String?
  completedAt        DateTime?
  // Tâches « course / livraison » (coordinateur-coursier) : lieu à atteindre + suivi
  // de durée. `startedAt` = départ effectif ; durée = completedAt − startedAt ;
  // retard = durée > expectedMinutes (si défini).
  address            String? // adresse / lieu (ouvre un lien Maps)
  startedAt          DateTime? // départ effectif (« je pars »)
  expectedMinutes    Int? // durée estimée en minutes (détection de retard)
  // ── Tâche née d'une DEMANDE faite à quelqu'un ───────────────────────────────────────────
  // `requestedAt` non nul = on a DEMANDÉ cette tâche à une personne, qui l'accepte ou la
  // refuse. Une fois acceptée, elle n'a plus d'étape intermédiaire : on entre dedans, on
  // dépose ce qu'il faut, on valide son travail. Le champ sert précisément à distinguer ce
  // parcours de celui d'une tâche ordinaire créée directement.
  requestedAt        DateTime?
  respondedAt        DateTime? // acceptation ou refus, horodatés
  /// RELANCE — le demandeur rappelle sa demande à celui qui ne l'a pas encore traitée.
  /// Un seul horodatage suffit à tenir l'anti-spam ; le compteur, lui, se lit dans le fil
  /// (chaque relance y laisse un message) et sert à dire « 3ᵉ relance » sans le recompter.
  lastNudgeAt        DateTime?
  nudgeCount         Int           @default(0)
  declineReason      String? // motif du refus — FACULTATIF : dire non ne se justifie pas
  /// Compte rendu de la personne qui a fait le travail, TOUJOURS modifiable après validation.
  completionNote     String?
  // ── CE QUE LA TÂCHE ATTEND, ET CE QUI PROUVE QUE C'EST FAIT ─────────────────────────────
  //
  // Cas réel : « Déposer le contrat de la consultante dans Ad&Pro > Consulting » — le contrat
  // A ÉTÉ déposé, personne n'a coché la tâche, et Adam a annoncé « en retard ». Vrai au sens
  // du champ `status`, faux au sens de l'entreprise.
  //
  // `expectedEvent` déclare l'événement métier qui satisfait la tâche (voir
  // `src/lib/tasks/evidence.ts`). Quand il est posé À LA CRÉATION, le rapprochement est exact
  // et la clôture peut être automatique. Sans lui, l'attente se DÉDUIT du titre — et l'on
  // inscrit alors la preuve SANS clore : une déduction ne doit jamais effacer une vraie tâche.
  expectedEvent      String?
  /// La preuve : l'entité qui satisfait l'attente, quand, et par qui.
  evidenceEntityType EntityType?
  evidenceEntityId   String?
  evidenceAt         DateTime?
  evidenceActorId    String?
  /// Ce qui a été reconnu — affiché à l'humain qui arbitre, jamais réinterprété.
  evidenceNote       String?
  /// Le fil d'échange de la tâche — questions, précisions, comptes rendus intermédiaires.
  comments           TaskComment[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([assignedToId, status])
  @@index([createdById])
  @@index([dueDate])
  @@index([status])
  @@index([requestedAt])
}

/// Demande d'avance sur salaire. Validée par les RH, réglée par la Comptabilité
/// (crée alors une écriture de trésorerie OUT) et déductible d'un futur bulletin.
model SalaryAdvance {
  custom        Json?
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  reason        String?
  status        AdvanceStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?         @relation("AdvanceDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  transactionId String? // écriture Finances générée au paiement
  paidDate      DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
}

/// Ordre de dépense : émis automatiquement quand la Direction valide une dépense
/// (sponsoring accepté, avance approuvée…). Le comptable l'exécute, ce qui génère
/// l'écriture de trésorerie OUT et marque la source comme payée.
model ExpenseOrder {
  custom                Json?
  id                    String                 @id @default(cuid())
  companyId             String? // entité de rattachement (Adventum / Pharmagène / …)
  company               Company?               @relation(fields: [companyId], references: [id])
  reference             String                 @unique // OD-2026-001
  label                 String
  beneficiary           String?
  amount                Decimal                @db.Decimal(14, 2)
  category              FinanceCategory        @default(AUTRE)
  status                ExpenseOrderStatus     @default(PENDING)
  dueDate               DateTime?
  requiresInvoice       Boolean                @default(false) // facture obligatoire avant règlement (dépenses événementielles)
  budgetCategoryId      String? // (sous-)catégorie budgétaire choisie par la Direction — sert d'attribution au règlement
  notes                 String?
  // Aller-retour comptable ↔ Direction : le comptable pouvait demander une baisse de budget.
  // CE CIRCUIT EST RETIRÉ — au décaissement, les Finances ne disposent plus que des trois états
  // du règlement (non payé, reporté, payé) ; l'arbitrage du montant appartient au centre de
  // paiement, qui voit la file entière. Les colonnes SURVIVENT : elles portent l'historique des
  // ordres qui ont connu une révision, et l'effacer réécrirait le passé.
  revisionReason        String? // motif de la demande de révision (historique)
  proposedAmount        Decimal?               @db.Decimal(14, 2) // montant proposé (historique)
  revisionById          String? // comptable ayant demandé la révision (historique)
  /// LE REPORT DE PAIEMENT — une DATE, jamais un statut.
  /// Un statut « reporté » obligerait quelqu'un à le remettre à « non payé » le jour venu, et ce
  /// quelqu'un oublierait. Une date expire seule : le 12 au matin, l'ordre reporté au 12 est de
  /// nouveau simplement dû. Voir `src/lib/finance/settlement.ts`.
  deferredUntil         DateTime?
  deferredReason        String?
  deferredById          String?
  deferredAt            DateTime?
  /// La nature de l'échéance DÉCLARÉE PAR LE DEMANDEUR — `FIXED` (non négociable), `IMPORTANT`,
  /// `MODERATE`. Elle classe la file et exige un motif pour reporter une échéance fixe.
  deadlineNature        String?
  sourceType            EntityType? // SPONSORING, SALARY_ADVANCE…
  sourceId              String?
  requestedById         String?
  requestedBy           User?                  @relation("ExpenseOrderRequester", fields: [requestedById], references: [id])
  paidById              String?
  transactionId         String?
  paidDate              DateTime?
  /// LE CENTRE DE PAIEMENT — l'autorisation du sommet, pour TOUT décaissement quel que soit son
  /// montant (le seuil et l'exemption des moyens généraux ont disparu). `NOT_REQUIRED` est un état
  /// HISTORIQUE (ordres émis sous l'ancienne règle) : aucun ordre n'y naît plus — l'unique
  /// écrivain, `createExpenseOrder`, pose `AWAITING`, et un cliquet interdit tout second
  /// écrivain qui hériterait de ce défaut (§118.148). Voir `src/lib/payments/authorization.ts`.
  centralStatus         String                 @default("NOT_REQUIRED")
  centralDecidedById    String?
  centralDecidedAt      DateTime?
  /// Le montant que le centre demande de retenir, quand il demande une révision.
  centralProposedAmount Decimal?               @db.Decimal(14, 2)
  centralMessages       PaymentCentreMessage[]
  /// La remise de caisse d'avance que cet ordre paie (§118.176) — nulle pour tout autre ordre.
  pettyCashAllotment    PettyCashAllotment?    @relation("PettyCashAllotmentOrder")
  /// Le virement de paie que cet ordre porte (§118.176) — nul pour tout autre ordre.
  payrollWire           PayrollWire?
  /// RETIRÉ DE L'HISTORIQUE de « Banque & paiements » par le Super Admin — un MASQUE d'écran, jamais
  /// une suppression : un ordre réglé est le fait que lisent le budget (payé / engagé d'un poste), les
  /// gardes anti-doublon (BV, poste, facture) et la paie. Voir `purgeSettledExpenseOrders`.
  historiqueMasqueLe    DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status])
  @@index([sourceType, sourceId])
  @@index([companyId])
  @@index([centralStatus])
}

/// LE FIL DU CENTRE DE PAIEMENT — la discussion qui accompagne une autorisation.
/// Une décision n'est pas toujours « oui » ou « non » : le centre demande une révision du montant
/// ou une argumentation, le demandeur répond, et cela peut faire plusieurs allers-retours. Sans
/// endroit pour l'écrire, cet échange part en messagerie et se sépare du paiement qu'il concerne :
/// six mois plus tard, l'ordre dit « autorisé » et personne ne sait à quelles conditions.
model PaymentCentreMessage {
  id        String       @id @default(cuid())
  orderId   String
  order     ExpenseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// La décision qui accompagne ce message, s'il en porte une (`APPROVE`, `REFUSE`,
  /// `REQUEST_CHANGES`, `REQUEST_INFO`) — nul pour une simple réponse du demandeur.
  decision  String?
  body      String
  /// `SET NULL` : désactiver un compte ne doit pas effacer ce qu'il a écrit sur un décaissement.
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([orderId])
}

// ───────────────────────────── Drive (stockage interne) ─────────────────────────────

/// Nœud de l'arborescence Drive : dossier ou fichier. Le contenu binaire vit dans
/// FileBlob (chiffré, adressé par contenu) ; l'historique dans FileVersion.
model DriveNode {
  custom           Json?
  id               String              @id @default(cuid())
  /// Référentiel R5 : la Pièce (le fichier une fois pour toutes) que cette ligne montre — nul tant que non reprise (P2).
  pieceId          String?
  piece            Piece?              @relation(fields: [pieceId], references: [id], onDelete: SetNull)
  name             String
  type             DriveNodeType
  parentId         String?
  parent           DriveNode?          @relation("DriveTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         DriveNode[]         @relation("DriveTree")
  ownerId          String?
  owner            User?               @relation("DriveOwner", fields: [ownerId], references: [id])
  // Catégorie/espace partagé (ex. « Promotion Médicale ») auquel ce nœud appartient. null =
  // Drive PERSONNEL (comportement historique). Tout le sous-arbre d'un espace porte le même
  // spaceId (l'invariant est maintenu à la création et au déplacement).
  spaceId          String?
  space            DriveSpace?         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  mimeType         String? // version courante (fichier)
  size             Float               @default(0) // octets de la version courante ; 0 pour un dossier (Float : exact jusqu'à 9 Po, tient les fichiers de plus de 2 Go sans passer en BigInt)
  category         String? // classement choisi à l'import (Contrat, Facture, Réglementaire…)
  isTrashed        Boolean             @default(false)
  versions         FileVersion[]
  legalDocs        LegalDocument[]
  mailEntries      MailEntry[]
  shares           DriveShare[]
  comments         DriveComment[]
  /// Messages qui RÉFÉRENCENT ce nœud (partage dans la messagerie, sans recopie).
  messageRefs      MessageAttachment[] @relation("MessageDriveRef")
  mailPieces       MailEntryPiece[]    @relation("MailPieceDriveNode")
  textIndex        DriveTextIndex?
  /// Les sessions Live Office ouvertes sur ce fichier (§3).
  artifactSessions ArtifactSession[]   @relation("ArtifactSessions")
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  mentions         EntityMention[]

  @@index([parentId])
  @@index([ownerId])
  @@index([isTrashed])
  @@index([spaceId])
  @@index([pieceId])
}

/// Catégorie / espace PARTAGÉ du Drive (ex. « Promotion Médicale »), présenté comme un onglet
/// à côté de « Drive » et « Documents ». Créé par le Super Admin ou un rôle qu'il a autorisé
/// (AppSetting.driveSpaceCreatorRoles). L'accès est encadré exactement comme une enveloppe
/// budgétaire : rôles/personnes en CONSULTATION (accessRoles/accessUserIds) et rôles/personnes
/// GESTIONNAIRES (managerRoles/managerUserIds : déposer, organiser, supprimer, régler les accès).
/// Le créateur est ajouté d'office aux gestionnaires. Les fichiers d'un espace sont partagés
/// entre les personnes autorisées (DriveNode.spaceId), indépendamment de la propriété perso.
model DriveSpace {
  id             String      @id @default(cuid())
  name           String
  icon           String? // nom d'icône lucide (optionnel, pour l'onglet)
  accessRoles    String[]    @default([])
  accessUserIds  String[]    @default([])
  managerRoles   String[]    @default([])
  managerUserIds String[]    @default([])
  isArchived     Boolean     @default(false)
  nodes          DriveNode[]
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([isArchived])
}

/// Contenu binaire chiffré (AES-256-GCM), dédupliqué par empreinte du clair (SHA-256).
model FileBlob {
  id         String          @id @default(cuid())
  sha256     String          @unique
  size       Float // taille du CLAIR en octets (Float : exact jusqu'à 9 Po ; un objet envoyé directement au bucket peut dépasser 2 Go)
  /// COMPRESSION SANS PERTE AU REPOS (§118.214). Nul = octets bruts (tout fichier d'avant, et tout
  /// ce que la mesure juge déjà compressé) ; « br » = le clair est compressé en brotli AVANT d'être
  /// chiffré. `sha256` et `size` disent TOUJOURS le clair d'origine : l'empreinte reste vérifiable.
  codec      String?
  /// Taille du contenu STOCKÉ avant chiffrement (le clair compressé) ; nul quand `codec` l'est.
  storedSize Float?
  iv         Bytes // nonce AES-GCM
  data       Bytes? // contenu chiffré EN BASE, en UNE valeur (petits fichiers) ; null si chunké ou en objet
  storageKey String? // clé objet S3/R2 du contenu chiffré (null = stocké en base) — dé-gonfle le disque BDD
  refCount   Int             @default(0)
  createdAt  DateTime        @default(now())
  /// Dernière prise par un détenteur (création OU réemploi) : la purge des orphelins n'efface
  /// jamais un blob touché depuis moins d'une heure — sa fiche est peut-être en train de s'écrire.
  touchedAt  DateTime        @default(now())
  versions   FileVersion[]
  chunks     FileBlobChunk[] // gros fichiers : contenu chiffré découpé en TRANCHES ordonnées (mémoire bornée)
}

/// Tranche de contenu chiffré d'un gros FileBlob (data=null). Concaténées dans l'ordre `idx`, elles
/// reforment `ciphertext || tag`. Permet des fichiers jusqu'à ~1 Go en base sans encodage hex géant.
model FileBlobChunk {
  id     String   @id @default(cuid())
  blobId String
  idx    Int // ordre de la tranche (0..n)
  data   Bytes // fragment de contenu chiffré
  blob   FileBlob @relation(fields: [blobId], references: [id], onDelete: Cascade)

  @@unique([blobId, idx])
}

/// Version d'un fichier (historique). Pointe vers un FileBlob partagé.
model FileVersion {
  id          String    @id @default(cuid())
  nodeId      String
  node        DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  blobId      String
  blob        FileBlob  @relation(fields: [blobId], references: [id])
  version     Int
  size        Float
  mimeType    String?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([nodeId, version])
  @@index([nodeId])
}

/// INDEX TEXTUEL PROGRESSIF du Drive — le texte extrait d'un fichier, mémorisé à la première
/// lecture (read_document, find_documents). C'est lui qui rend la DÉCOUVERTE possible quand le
/// nom ne dit rien (« scan_0234.pdf ») : on cherche dans le CONTENU déjà lu. Il grandit à
/// l'usage — jamais de balayage massif. Ce n'est PAS un cache d'autorisation : le droit Drive
/// se revérifie nœud par nœud à chaque requête qui s'en sert.
model DriveTextIndex {
  id         String    @id @default(cuid())
  nodeId     String    @unique
  node       DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// Version du fichier dont ce texte provient — une nouvelle version invalide l'entrée.
  versionId  String
  /// Premiers ~20 000 caractères du texte extrait (assez pour retrouver et citer).
  text       String
  /// Le même texte REPLIÉ (minuscules sans accents) — la colonne de RECHERCHE :
  /// « reglement » doit trouver « Règlement ».
  textFold   String
  note       String?
  /// Classification DÉTERMINISTE du document (contrat de travail, facture, devis, BC, fiche de
  /// poste…) — le nom est un indice, le CONTENU est la preuve. Null = non classé / unknown.
  docKind    String?
  /// Vecteur sémantique (512d, JSONB — pgvector indisponible sur cette infra) : la recherche
  /// par le SENS quand le lexical ne trouve pas. Null = pas encore vectorisé.
  embedding  Json?
  /// Estampille d'extraction des MENTIONS d'entités (fabric F4). Null = jamais extrait —
  /// le balayage de rattrapage s'appuie dessus, et une date permet de ré-extraire après un
  /// changement de dictionnaire sans booléen à trois états.
  mentionsAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([updatedAt])
  @@index([docKind])
}

/// LIEN PERSISTÉ document ↔ entité canonique (fabric F4). Extrait à l'INGESTION par
/// dictionnaire déterministe — « tout ce qui est relié à X » devient une lecture d'index, et
/// les ALIAS se franchissent (un document qui ne dit que « Keytruda » est lié au produit dont
/// la DCI est « pembrolizumab », parce que l'entité canonique porte les deux noms).
model EntityMention {
  id          String    @id @default(cuid())
  nodeId      String
  node        DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// PRODUIT | PERSONNE | ORGANISATION — le vocabulaire du registre des sources.
  entityType  String
  /// L'identifiant CANONIQUE (RegulatoryProduct.id, Employee.id…) — jamais un libellé.
  entityId    String
  /// Le libellé au moment de l'extraction, pour l'affichage sans jointure.
  entityLabel String
  occurrences Int       @default(1)
  createdAt   DateTime  @default(now())

  @@unique([nodeId, entityType, entityId])
  @@index([entityType, entityId])
}

/// ÉTAT CHAUD précalculé (fabric F5) : un résultat coûteux persisté avec son instant de
/// calcul et son coût MESURÉ. `subjectId` est la clé de DROITS — l'état calculé pour une
/// personne n'est jamais servi à une autre. `staleAt` = invalidé par un fait métier.
model AssistantHotState {
  id         String    @id @default(cuid())
  kind       String
  subjectId  String
  payload    Json
  computedAt DateTime
  /// Ce que le calcul a RÉELLEMENT coûté (ms) — la preuve que le précalcul achète quelque chose.
  costMs     Int
  staleAt    DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([kind, subjectId])
  @@index([kind, staleAt])
}

/// Partage d'un nœud avec un utilisateur précis (droits VIEW/EDIT).
model DriveShare {
  id        String      @id @default(cuid())
  nodeId    String
  node      DriveNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("DriveShareUser", fields: [userId], references: [id], onDelete: Cascade)
  access    DriveAccess @default(VIEW)
  createdAt DateTime    @default(now())

  @@unique([nodeId, userId])
  @@index([userId])
}

/// Commentaire sur un nœud du Drive (fichier ou dossier) : fil de discussion PAR document,
/// utile notamment quand quelqu'un modifie un document (contexte, motif du changement…).
/// Chaque document a ses propres commentaires ; visible/écrit par qui a accès au nœud.
model DriveComment {
  id        String    @id @default(cuid())
  nodeId    String
  node      DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?     @relation("DriveCommentAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime  @default(now())

  @@index([nodeId])
}

// ───────────────────── Centre de demandes administratives ─────────────────────

/// Demande administrative transverse (« Bureau de Donna »). Tout ce qu'on demande à
/// l'assistante devient une demande ; documents/commentaires/validations/missions/
/// paiements s'y rattachent. Champs spécifiques au type stockés dans `fields`.
model AdministrativeRequest {
  custom              Json?
  id                  String             @id @default(cuid())
  companyId           String? // entité de rattachement (Adventum / Pharmagène / …)
  company             Company?           @relation(fields: [companyId], references: [id])
  reference           String             @unique // REQ-2026-001
  title               String
  type                AdminRequestType
  subtype             String?
  status              AdminRequestStatus @default(NEW)
  priority            Priority           @default(MEDIUM)
  description         String?
  deadline            DateTime?
  fields              Json? // champs spécifiques au type de demande
  requesterId         String?
  requester           User?              @relation("ReqRequester", fields: [requesterId], references: [id])
  concernedUserId     String?
  concerned           User?              @relation("ReqConcerned", fields: [concernedUserId], references: [id])
  assignedToId        String?
  assignedTo          User?              @relation("ReqAssignee", fields: [assignedToId], references: [id])
  validatorId         String?
  validator           User?              @relation("ReqValidator", fields: [validatorId], references: [id])
  departmentId        String?
  department          Department?        @relation(fields: [departmentId], references: [id])
  confidentiality     Confidentiality    @default(INTERNAL)
  linkedEntityType    EntityType?
  linkedEntityId      String?
  blockedReason       String?
  processingStartedAt DateTime? // « Commencer le traitement » (assistante)
  completedAt         DateTime?
  cancelledAt         DateTime?
  // Regroupement multi-cellules : plusieurs demandes soumises en un seul envoi
  // partagent le même batchId (chaque cellule reste pilotée indépendamment).
  batchId             String?
  // Suppression traçable (soft delete) : l'enregistrement reste en base.
  deletedAt           DateTime?
  deletedById         String?
  deletionReason      String?
  // Archivage : dossier « Dossier traité » créé dans le Drive du traitant.
  archivedNodeId      String?
  createdById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  approvals       AdminApproval[]
  missions        DriverMission[]
  /// Postes Ad & Pro dont CETTE demande sert à obtenir le devis.
  adProItemQuotes AdProItem[]               @relation("AdProItemQuoteRequest")
  /// Dépense imputée à un budget départemental à l'issue de CETTE demande.
  budgetExpenses  DepartmentBudgetExpense[]

  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([requesterId])
  @@index([priority])
  @@index([deadline])
  @@index([batchId])
  @@index([deletedAt])
  @@index([companyId])
}

/// Catalogue d'articles de fourniture de bureau (Achats). Maintenu par
/// l'assistante de direction ; alimente le menu déroulant des demandes d'achat.
model OfficeSupplyArticle {
  id             String   @id @default(cuid())
  name           String
  category       String? // papeterie, informatique, mobilier, consommable…
  unit           String? // pièce, boîte, paquet, rame…
  reference      String? // code interne / réf. fournisseur
  estimatedPrice Decimal? @db.Decimal(12, 2) // prix indicatif (DZD)
  supplierHint   String? // fournisseur habituel (indicatif)
  active         Boolean  @default(true)
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Achats réels de cet article — ce qui rend le catalogue vivant plutôt que déclaratif.
  expenseLines DepartmentExpenseLine[]

  @@index([active])
  @@index([category])
}

/// Demande de validation rattachée à une demande administrative.
model AdminApproval {
  id            String                @id @default(cuid())
  requestId     String
  request       AdministrativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestedById String?
  validatorId   String?
  validator     User?                 @relation("ApprovalValidator", fields: [validatorId], references: [id])
  status        AdminApprovalStatus   @default(PENDING)
  comment       String?
  amount        Decimal?              @db.Decimal(14, 2)
  currency      String                @default("DZD")
  decidedAt     DateTime?
  /// QUI A TRANCHÉ (audit des managers, M14) — le validateur nommé, son intérimaire, un détenteur du droit
  /// « Valider » du module ou la vue globale. `SetNull` : supprimer un compte ne fait pas disparaître la
  /// décision ; elle se lit alors « auteur inconnu », comme celles d'avant cet enregistrement.
  decidedById   String?
  decidedBy     User?                 @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// LA PAROLE DE CELUI QUI TRANCHE (M15) — exigée pour un refus ou une demande de modification. À part de
  /// `comment`, qui porte celle de celui qui DEMANDE (l'estimation du catalogue, la note de l'assistante) :
  /// une colonne pour deux voix efface l'une sous l'autre (§118.146).
  decisionNote  String?
  createdAt     DateTime              @default(now())

  @@index([requestId])
  @@index([validatorId, status])
}

/// Mission chauffeur / coursier (Akila), autonome ou rattachée à une demande.
model DriverMission {
  id            String                 @id @default(cuid())
  requestId     String?
  request       AdministrativeRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  title         String
  assignedToId  String?
  assignedTo    User?                  @relation("MissionDriver", fields: [assignedToId], references: [id])
  startLocation String?
  destination   String?
  address       String?
  contactName   String?
  contactPhone  String?
  instructions  String?
  deadline      DateTime?
  status        DriverMissionStatus    @default(NEW)
  proofType     String?
  proofComment  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  stops         DriverMissionStop[]

  @@index([assignedToId, status])
  @@index([requestId])
}

/// Point de passage d'une course chauffeur (point A, B, C…) : le lieu et la
/// consigne à ce point. Le chauffeur coche chaque point au fur et à mesure.
model DriverMissionStop {
  id        String        @id @default(cuid())
  missionId String
  mission   DriverMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  position  Int
  location  String
  task      String?
  done      Boolean       @default(false)
  doneAt    DateTime?

  @@index([missionId, position])
}

/// Monthly payslip. When PAID it links to a FinanceTransaction (treasury OUT).
model PayrollEntry {
  id                  String        @id @default(cuid())
  employeeId          String
  employee            Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year                Int
  month               Int
  gross               Decimal       @default(0) @db.Decimal(12, 2)
  /// COÛT EMPLOYEUR du mois — le montant imputé au BUDGET, et la brique de la masse salariale.
  /// Nul sur les mois saisis avant l'introduction du champ : les lectures retombent alors sur
  /// le brut, en le disant (voir `src/lib/hr/payroll-cost.ts`).
  employerCost        Decimal?      @db.Decimal(12, 2)
  bonuses             Decimal       @default(0) @db.Decimal(12, 2)
  deductions          Decimal       @default(0) @db.Decimal(12, 2)
  net                 Decimal       @default(0) @db.Decimal(12, 2)
  status              PayrollStatus @default(DRAFT)
  paidDate            DateTime?
  transactionId       String?
  notes               String?
  // Paie RH : fiche de paie déposée, notification différée à l'employé (24 h de
  // marge en cas d'erreur), et transfert vers une catégorie budgétaire.
  payslipDocumentId   String? // EmployeeDocument (fiche de paie, période YYYY-MM)
  employeeNotifyAt    DateTime? // instant à partir duquel notifier l'employé
  employeeNotifiedAt  DateTime? // notification effectivement envoyée
  budgetTransferredAt DateTime? // transféré dans le budget (verrouille la ligne)
  budgetCategoryId    String? // (sous-)catégorie budgétaire choisie au transfert
  /// LE VIREMENT qui porte ce salaire (§118.176) — posé quand la paie de l'entité part au centre
  /// de paiement. Un virement refusé ne couvre plus rien : le salaire repart au prochain envoi.
  /// Nul sur un salaire pas encore envoyé, et sur l'historique de l'ancien « transfert au budget »
  /// (qui porte, lui, `transactionId` et `budgetTransferredAt`).
  payrollWireId       String?
  payrollWire         PayrollWire?  @relation(fields: [payrollWireId], references: [id], onDelete: SetNull)
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([status])
  @@index([employeeNotifyAt])
  @@index([payrollWireId])
}

/// LE VIREMENT DE LA PAIE D'UNE ENTITÉ POUR UN MOIS (§118.176) — « pour la paie, c'est un bouton
/// pour toute la paie avec mention obligatoire de la somme des salaires à virer (un bouton par
/// entité) ». L'envoi crée un ORDRE DE DÉPENSE en attente du centre de paiement ; c'est son
/// RÈGLEMENT par les Finances qui écrit au livre — une seule écriture, de la somme DÉCLARÉE — et
/// qui fait passer les salaires qu'il porte à « virés » (les salariés ne sont prévenus qu'alors).
///
/// `paidAt` et `transactionId` gardent le FAIT du virement même quand l'ordre est purgé de
/// l'historique des règlements : sans eux, une paie virée redeviendrait « à envoyer » et
/// partirait deux fois. Plusieurs virements par mois sont possibles (un complément après le
/// premier), jamais deux en cours à la fois.
model PayrollWire {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  /// LA SOMME DES SALAIRES À VIRER, déclarée par les RH — c'est elle que le centre autorise.
  amount         Decimal       @db.Decimal(14, 2)
  expenseOrderId String?       @unique
  expenseOrder   ExpenseOrder? @relation(fields: [expenseOrderId], references: [id], onDelete: SetNull)
  paidAt         DateTime?
  transactionId  String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entries PayrollEntry[]

  @@index([companyId, year, month])
}

// ─────────────── Validation Center (règles configurables par le Super Admin) ───────────────
// Système de validation transversal : le Super Admin définit DES RÈGLES (qui valide
// quoi, selon module / type / montant / département / rôle / priorité / catégorie),
// et chaque demande de validation est routée vers 1 ou 2 validateurs, en séquentiel
// ou en parallèle. Réutilisable par n'importe quel module.

enum ValidationMode {
  SEQUENTIAL // validateur 1 puis validateur 2
  PARALLEL // les deux en même temps
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum ValidationStepState {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

model ValidationRule {
  id            String         @id @default(cuid())
  name          String
  module        String? // module concerné (null = tous)
  objectType    String? // type d'objet (PURCHASE, PAYMENT, SPONSORING, LEAVE…) (null = tous)
  description   String?
  minAmount     Decimal?       @db.Decimal(16, 2)
  maxAmount     Decimal?       @db.Decimal(16, 2)
  department    String?
  requesterRole UserRole? // rôle du demandeur (null = tous)
  priority      Priority? // priorité ciblée (null = toutes)
  category      String?
  validator1Id  String?
  validator2Id  String?
  mode          ValidationMode @default(SEQUENTIAL)
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  requests ValidationRequest[]

  @@index([active])
  @@index([module])
}

model ValidationRequest {
  id           String           @id @default(cuid())
  reference    String           @unique // VAL-2026-001
  ruleId       String?
  rule         ValidationRule?  @relation(fields: [ruleId], references: [id])
  module       String
  objectType   String?
  title        String
  description  String?
  amount       Decimal?         @db.Decimal(16, 2)
  department   String?
  priority     Priority         @default(MEDIUM)
  category     String?
  link         String? // URL vers l'objet source (pour ouvrir directement)
  entityType   EntityType?
  entityId     String?
  /// Pièce jointe PRÉCISE visée (model Document) quand la validation porte sur une pièce et non
  /// sur l'objet entier — ex. une facture d'une demande du Bureau du secrétariat. Une validation
  /// de pièce ne pilote PAS le cycle de vie de l'objet parent.
  documentId   String?
  requesterId  String
  requester    User             @relation("ValidationRequester", fields: [requesterId], references: [id])
  mode         ValidationMode   @default(SEQUENTIAL)
  status       ValidationStatus @default(PENDING)
  currentOrder Int              @default(1) // étape active en mode séquentiel
  /// La VERSION de la demande : 1 au dépôt, +1 à chaque resoumission après un renvoi pour correction
  /// (audit 360°, R08). Le validateur sait qu'il relit une demande corrigée ; l'historique des motifs
  /// et des corrections vit dans le fil de la demande (`Comment`, écrit à la resoumission).
  version      Int              @default(1)
  deadline     DateTime?
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  steps        ValidationStep[]
  /// LES PARTICIPANTS (Direction, 06/10) : des collègues ajoutés à la demande — ils la lisent et prennent part à sa
  /// discussion (le fil `Comment`), sans rien valider.
  participants ValidationParticipant[]

  @@index([status])
  @@index([requesterId])
}

/// Un collègue ajouté à une demande de validation : il la lit et en discute, il ne la valide pas.
model ValidationParticipant {
  id        String            @id @default(cuid())
  requestId String
  request   ValidationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  addedById String?
  createdAt DateTime          @default(now())

  @@unique([requestId, userId])
  @@index([userId])
}

model ValidationStep {
  id          String              @id @default(cuid())
  requestId   String
  request     ValidationRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order       Int
  validatorId String
  validator   User                @relation("ValidationStepValidator", fields: [validatorId], references: [id])
  status      ValidationStepState @default(PENDING)
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())

  itemDecisions ValidationItemDecision[]

  @@index([validatorId, status])
  @@index([requestId])
}

// Décision GRANULAIRE d'un validateur, élément par élément : le « message » de la
// demande (itemKey = "MESSAGE") ET chaque pièce jointe (itemKey = id du Document).
// Chaque élément peut être approuvé / refusé / à réviser, avec un commentaire
// OPTIONNEL. Vient EN PLUS de la décision globale de l'étape (qui, elle, fait
// avancer le circuit) : elle donne au demandeur un retour précis par pièce.
model ValidationItemDecision {
  id        String              @id @default(cuid())
  stepId    String
  step      ValidationStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  itemKey   String // "MESSAGE" | id du Document (pièce jointe)
  decision  ValidationStepState // APPROVED | REJECTED | CHANGES_REQUESTED
  comment   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([stepId, itemKey])
  @@index([stepId])
}

// ─────────────── Portail Fournisseur (comptes externes isolés) ───────────────
// Comptes EXTERNES, totalement séparés des utilisateurs internes (table dédiée,
// session dédiée). Un fournisseur ne voit QUE ses propres produits, et seulement
// les champs externes exposés par l'équipe Regulatory.

model Supplier {
  id           String   @id @default(cuid())
  /// Référentiel R2 : l'Organisation réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  organisationId String?
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name         String
  country      String?
  contactEmail String?
  /// LES COORDONNÉES de l'annuaire « Fournisseurs Regulatory » (Direction, 06/10) — un annuaire comme les autres.
  contactName  String?
  phone        String?
  website      String?
  address      String?
  city         String?
  /// Code officiel de la wilaya (référentiel `Wilaya`), LU du texte saisi par `src/lib/lieux/normaliser.ts` — nul si
  /// ce texte est vide ou ambigu. Le texte reste la saisie (reprise « lieux-wilaya », double écriture V2-D).
  wilayaCode            String?
  wilayaRef             Wilaya?                    @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  active       Boolean  @default(true)
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users    SupplierUser[]
  products RegulatoryProduct[]

  @@index([active])
  @@index([organisationId])
  @@index([wilayaCode])
}

model SupplierUser {
  id           String    @id @default(cuid())
  /// Référentiel R1 : la Personne réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  personneId   String?
  personne     Personne? @relation(fields: [personneId], references: [id], onDelete: SetNull)
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  email        String    @unique
  name         String
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([supplierId])
  @@index([personneId])
}

// ─────────────── PCH — marchés publics (appels d'offres → bons de commande) ───────────────
// Chaque appel d'offres GAGNÉ devient une ligne ; les bons de commande reçus de
// la PCH en sont les sous-lignes. Caution obligatoire (marché public).

model PchTender {
  id                 String          @id @default(cuid())
  companyId          String? // entité (Adventum / Pharmagène / …)
  company            Company?        @relation(fields: [companyId], references: [id])
  reference          String          @unique // référence EXTERNE du marché / appel d'offres
  /// Référence INTERNE AMD, si l'entreprise en pose une (« AO-2026-ONCO-04 »).
  internalReference  String?
  title              String?
  products           String? // produits concernés
  supplier           String?
  supplierCountry    String?
  quantity           Int             @default(0)
  value              Decimal?        @db.Decimal(16, 2)
  client             String          @default("PCH")
  status             PchTenderStatus @default(NOT_STARTED)
  // ── LES DATES DU CYCLE DE VIE. Le niveau affiché (Préparation → Soumis → Attribué →
  // Exécution → Clôturé) est DÉRIVÉ de ces faits par `lib/pch/market-math.ts`, même doctrine
  // que le niveau de process Regulatory : deux champs qui racontent la même chose divergent.
  publishedAt        DateTime? // publication de l'AO par l'organisme
  submissionDeadline DateTime? // date limite de dépôt — nourrit les alertes d'échéance
  submittedAt        DateTime? // dépôt OFFICIEL (posé par la soumission verrouillée)
  awardDate          DateTime? // date d'attribution
  /// LE RESPONSABLE INTERNE du dossier — celui qu'on appelle quand l'échéance approche.
  responsibleId      String?
  responsible        User?           @relation("PchTenderResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  /// Dernier rappel d'ÉCHÉANCE DE DÉPÔT envoyé (balayage quotidien) — le verrou anti-spam :
  /// on prévient à l'ENTRÉE dans une zone (J-7, J-2, dépassement), jamais tous les jours.
  deadlineRemindedAt DateTime?
  /// La Business Unit concernée, quand il y en a une (marché mono-gamme).
  businessUnitId     String?
  businessUnit       BusinessUnit?   @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  // Caution (obligatoire)
  cautionAmount    Decimal?  @db.Decimal(14, 2)
  cautionDeposited Boolean   @default(false)
  cautionStart     DateTime?
  cautionEnd       DateTime?

  notes       String?
  orders      PchOrder[]
  lines       PchTenderLine[]
  /// Les LECTURES de son document (texte natif ou OCR → lignes) — ce qui a été lu, et ce qui ne l'a pas été.
  extractions PchTenderExtraction[]
  /// Les VERSIONS de préparation de la soumission — la déposée est verrouillée.
  submissions PchSubmission[]
  /// Les CONTRATS nés de ce marché — le lien FORT qui remplace la recherche par texte.
  contracts   LegalDocument[]       @relation("TenderContracts")
  createdById String?
  updatedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status])
  @@index([submissionDeadline])
  @@index([responsibleId])
}

// Suivi par produit d'un appel d'offres (ligne du tableau du marché) : issu de l'analyse IA du
// document (OCR), enrichi par l'intelligence marché (concurrents, nomenclature, estimation, prix).
enum PchLineStatus {
  PENDING // à étudier
  QUOTED // chiffré (prix posé)
  SUBMITTED // soumissionné
  WON // attribué (gagné) — l'attribution PARTIELLE se lit sur `awardedQuantityUnits` < demandé
  LOST // perdu
  /// Lot déclaré infructueux par l'organisme : personne n'a gagné — ce n'est PAS « perdu ».
  UNSUCCESSFUL
  /// Lot annulé / retiré du marché avant décision.
  CANCELLED
}

model PchTenderLine {
  id                     String                      @id @default(cuid())
  tenderId               String
  tender                 PchTender                   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  sortOrder              Int                         @default(0)
  designation            String // produit demandé (libellé du marché)
  dci                    String?
  dosage                 String?
  form                   String? // forme galénique
  // Conditionnement : le marché demande des UNITÉS ; nos produits sont en BOÎTES de N unités.
  quantityUnits          Int                         @default(0) // quantité demandée (unités)
  unitsPerBox            Int? // « boîte de N » → nombre de boîtes = ceil(unités / N)
  /// Nature de l'unité demandée : « comprimé », « flacon », « seringue », « ampoule »…
  /// Un appel d'offres ne parle pas toujours de comprimés — le dire évite de comparer
  /// des flacons à des comprimés.
  unitLabel              String?
  // Avons-nous ce produit ? + rattachement au produit Regulatory (id + libellé dénormalisé).
  haveProduct            Boolean                     @default(false)
  ourProductId           String?
  ourProduct             String?
  unitPriceDzd           Decimal?                    @db.Decimal(14, 2) // notre prix unitaire (DZD)
  /// NOTRE PRIX DE PARTICIPATION, À LA BOÎTE — le chiffre réellement négocié, celui qui figure
  /// sur l'offre. Quand il est saisi, il FAIT FOI et `unitPriceDzd` s'en déduit
  /// (`lib/pch/box-economics.ts`) : l'inverse ferait de 1 000 DZD la boîte de 30 un prix
  /// unitaire de 33,33 puis une boîte à 999,90, un centime perdu à chaque aller-retour.
  boxPriceDzd            Decimal?                    @db.Decimal(14, 2)
  /// NOTRE COÛT D'ACHAT, À LA BOÎTE. Sans lui, on soumissionnait sans que la plateforme sache
  /// si le lot était gagnant ou perdant — la marge se voit désormais AVANT le dépôt.
  boxCostDzd             Decimal?                    @db.Decimal(14, 2)
  suppliersInfo          String? // nos fournisseurs + prix (texte)
  // Prix de RÉFÉRENCE verrouillé depuis les réceptions PCH 2025 (vérifié dosage + forme).
  refPriceDzd            Decimal?                    @db.Decimal(14, 2)
  refPriceSource         String? // libellé/source de la ligne Réception 2025 rapprochée
  // Enrichissement intelligence marché.
  competitorCount        Int?
  registeredNomenclature Boolean                     @default(false) // présent à la nomenclature (marché) ?
  registeredOurs         Boolean                     @default(false) // NOUS avons un produit enregistré correspondant
  nomLines               Int? // nombre de lignes nomenclature détectées
  marketEstimateDzd      Decimal?                    @db.Decimal(18, 2) // estimation de la taille de marché
  /// PAYSAGE CONCURRENTIEL, calculé par l'intelligence marché (`analyzeMolecule`) sur le
  /// triplet molécule + dosage + forme de la ligne. Dénormalisé ici pour rester lisible
  /// dans le tableau et dans l'export Excel, sans recalcul à chaque affichage.
  marketOrigin           String? // LOCAL | IMPORT | MIXTE — fabriqué en Algérie ou importé
  marketVillePct         Decimal?                    @db.Decimal(5, 2) // part du marché de ville (%)
  marketHopitalPct       Decimal?                    @db.Decimal(5, 2) // part du marché hospitalier (%)
  marketHhi              Int? // concentration (Herfindahl) : > 2500 = marché concentré
  competitorsTop         String? // « GSK 45 % · HIKMA 25 % · BIOCARE 14 % »
  // Suivi commercial de la ligne.
  status                 PchLineStatus               @default(PENDING)
  /// Quantité SOUMISE si elle diffère de la demandée (on peut soumissionner partiellement).
  submittedQuantityUnits Int?
  /// Quantité ATTRIBUÉE — c'est elle qui rend l'attribution PARTIELLE représentable :
  /// 8 000 demandées, 4 000 gagnées. Nulle = non renseignée (repli : quantité demandée).
  awardedQuantityUnits   Int?
  awardedUnitPriceDzd    Decimal?                    @db.Decimal(14, 2) // prix d'attribution si gagné
  /// PHOTO de NOTRE produit au moment du DÉPÔT (nom, présentation, dosage, fabricant, n° AMM,
  /// statut réglementaire, prix, quantité). La relation `product` reste DYNAMIQUE ; cette
  /// photo, elle, est figée : si la fiche Regulatory change dans deux ans, l'AO continue de
  /// montrer exactement ce qui a été déposé. Posée par le verrouillage de la soumission.
  submissionSnapshot     Json?
  note                   String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  /// LE PRODUIT CANONIQUE que cette ligne de marché désigne, quand nous le portons.
  /// NULLABLE et le restera : un AO nomme des produits que nous ne vendons pas, et le libellé
  /// du marché (`designation`) fait foi juridiquement même sans correspondance chez nous.
  /// `ourProductId` (identifiant orphelin, sans relation) est CONSERVÉ le temps de la bascule.
  productId              String?
  product                Product?                    @relation("TenderLineProduct", fields: [productId], references: [id], onDelete: SetNull)
  adProAllocations       AdProProductAllocation[]
  sales                  Sale[]                      @relation("SaleTenderLine")
  contractLines          PchContractLine[]
  orderLines             PchOrderLine[]              @relation("OrderLineTenderLine")
  /// LES BUSINESS UNITS QUI PORTENT CE PRODUIT — voir `PchTenderLineBusinessUnit`.
  businessUnits          PchTenderLineBusinessUnit[]
  /// LA LECTURE dont cette ligne est née — `null` : saisie à la main, ou née avant que les lectures soient tracées.
  /// Une lecture ne remplace QUE des lignes nées d'une lecture, que personne n'a touchées (`lib/pch/extraction.ts`).
  extractionId           String?
  extraction             PchTenderExtraction?        @relation(fields: [extractionId], references: [id], onDelete: SetNull)
  /// CE QUE LA LECTURE AVAIT LU (désignation, dosage, forme, quantité), figé : c'est lui, et non la ligne corrigée,
  /// qui reconnaît le même produit à la lecture suivante — une quantité mal lue puis corrigée n'est pas recréée.
  empreinteExtraction    String?
  /// La dernière fois qu'une PERSONNE a changé cette ligne. `updatedAt` bouge aussi quand l'enrichissement écrit ;
  /// seul ce champ dit « touchée à la main ».
  modifieeLe             DateTime?

  @@index([tenderId])
  @@index([productId])
  @@index([extractionId])
}

/// UNE LECTURE DU DOCUMENT D'UN APPEL D'OFFRES — ce qu'on a lu, comment, et ce qu'on n'a PAS lu (audit 360°, lot D1c).
///
/// La lecture d'avant océrisait même un PDF qui porte son texte, coupait le texte à 24 000 caractères sans le dire,
/// et AJOUTAIT ses lignes aux précédentes. Une lecture porte désormais sa méthode, ses pages, sa coupe (`caracteres`
/// / `caracteresLus`) et le fichier gardé ; ses lignes la désignent (`PchTenderLine.extractionId`), ce qui permet
/// à la lecture suivante de remplacer ce que personne n'a touché — et seulement cela.
model PchTenderExtraction {
  id             String          @id @default(cuid())
  tenderId       String
  tender         PchTender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  /// « document » (fichier lu) ou « texte » (texte collé).
  source         String
  nomFichier     String?
  /// Le fichier gardé dans les documents du marché, quand il a pu l'être (`Document`, polymorphe : pas de clé étrangère).
  documentId     String?
  /// « texte » : texte natif ; « ocr » : reconnu sur des images.
  methode        String
  confiance      Int?
  aRelire        Boolean         @default(false)
  pagesLues      Int?
  pagesTotal     Int?
  caracteres     Int
  caracteresLus  Int
  produits       Int
  complementaire Boolean         @default(false)
  createdById    String?
  createdAt      DateTime        @default(now())
  lignes         PchTenderLine[]

  @@index([tenderId, createdAt])
}

/// QUI PORTE CE PRODUIT DU MARCHÉ — l'affectation d'un lot d'AO à une ou plusieurs Business Units.
///
/// ── POURQUOI PAS UN CHAMP SUR LE MARCHÉ ────────────────────────────────────────────────────
///
/// `PchTender.businessUnitId` existait déjà : UNE BU pour tout le marché. Or un appel d'offres
/// PCH porte vingt lots qui relèvent de gammes différentes — l'oncologie et l'anti-infectieux
/// dans le même bordereau. Le champ unique obligeait à n'en nommer qu'une, et les dix-neuf autres
/// lots se retrouvaient rattachés à la mauvaise équipe, ou à aucune.
///
/// L'affectation est donc PAR PRODUIT, et MULTIPLE : deux BU peuvent légitimement se partager un
/// même produit (une gamme ville et une gamme hôpital sur la même molécule).
///
/// ── CE QU'ELLE DÉCLENCHE ───────────────────────────────────────────────────────────────────
///
/// Affecter une BU inscrit le produit à son PORTEFEUILLE (`PromoProduct`), d'où la force de vente
/// l'attribue ensuite à ses KAM par le circuit existant (`PromotionAssignment`, cycle par cycle).
/// On ne construit pas un second mécanisme d'attribution : celui de la force de vente marche, il
/// a ses écrans et ses droits — il lui manquait seulement de savoir que ces produits existent.
model PchTenderLineBusinessUnit {
  id             String        @id @default(cuid())
  tenderLineId   String
  tenderLine     PchTenderLine @relation(fields: [tenderLineId], references: [id], onDelete: Cascade)
  businessUnitId String
  businessUnit   BusinessUnit  @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdById    String?
  createdAt      DateTime      @default(now())

  @@unique([tenderLineId, businessUnitId])
  @@index([businessUnitId])
}

model PchOrder {
  id              String         @id @default(cuid())
  tenderId        String
  tender          PchTender      @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  /// Le CONTRAT dont ce bon de commande est l'exécution. Nullable : un BC arrive parfois
  /// avant que le contrat soit enregistré — le rattacher ensuite est un geste, pas un blocage.
  contractId      String?
  contract        LegalDocument? @relation("ContractOrders", fields: [contractId], references: [id], onDelete: SetNull)
  lineId          String? // HÉRITAGE mono-ligne — conservé le temps de la bascule vers `orderLines` (backfillé)
  reference       String? // n° du bon de commande PCH
  products        String?
  quantity        Int            @default(0)
  value           Decimal?       @db.Decimal(16, 2)
  status          PchOrderStatus @default(PENDING)
  receivedDate    DateTime?
  paymentDate     DateTime?
  // Logistique : suivi de l'acheminement de la marchandise (client = PCH).
  expectedArrival DateTime? // date d'arrivée prévue
  arrivedDate     DateTime? // date d'arrivée réelle (marchandise reçue)
  notes           String?
  /// BC D'AVENANT — commandé au-delà du volume attribué par l'AO (Ventes PCH › Contrats le compte à part).
  estAvenant      Boolean        @default(false)
  /// Les LIGNES du bon — un BC réel porte plusieurs produits, chacun relié à sa ligne
  /// contractuelle (contrôle du restant) ou, à défaut, à sa ligne d'AO.
  orderLines      PchOrderLine[]
  /// Les LIVRAISONS — un BC peut être servi en plusieurs fois.
  deliveries      PchDelivery[]
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenderId])
  @@index([lineId])
  @@index([contractId])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// MARKET 360° — l'appel d'offres devient un dossier transversal de bout en bout.
///
/// La chaîne : AO (`PchTender`) → lots (`PchTenderLine` → `Product`) → soumission versionnée
/// (`PchSubmission`) → attribution (quantités/prix sur les lignes) → contrat (`LegalDocument`
/// kind CONTRACT, `tenderId`) → avenants (kind AMENDMENT, `amendsId`, deltas) → lignes
/// contractuelles (`PchContractLine`) → bons de commande (`PchOrder` + `PchOrderLine`) →
/// livraisons (`PchDelivery` + lignes, mouvements de stock) → factures (`LegalDocument`
/// kind INVOICE, `sourceType = PCH_ORDER`) → règlements (Finance). Chaque flèche est une FK ;
/// les montants
/// dérivés (valeur contractuelle courante, restant à commander/livrer/encaisser) se CALCULENT
/// dans `lib/pch/market-math.ts` — jamais stockés deux fois.
/// ═══════════════════════════════════════════════════════════════════════════════════════════

model PchSubmission {
  id          String    @id @default(cuid())
  tenderId    String
  tender      PchTender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  /// V1, V2, V3… — l'ordre de travail. Unique par marché.
  version     Int
  /// « Brouillon », « Relecture DG », « Version finale »… le nom que l'équipe lui donne.
  label       String?
  /// DRAFT | REVIEW | FINAL | SUBMITTED. Une chaîne et non un enum : ajouter un état de
  /// préparation ne doit pas demander une migration (même patron que `ProductAssignment.role`).
  status      String    @default("DRAFT")
  /// LA CHECKLIST du dépôt : `[{ key, label, done, doneById, doneAt }]` — dossier
  /// administratif, technique, certificats, AMM, GMP, prix, garantie, déclarations…
  /// Un tableau JSON et non une table : les exigences varient d'un AO à l'autre.
  checklist   Json?
  notes       String?
  /// LE DÉPÔT OFFICIEL. Non nul ⇒ la version est celle qui a été remise à l'organisme.
  submittedAt DateTime?
  /// LE VERROU LOGIQUE (§63) : une fois posé, les actions serveur REFUSENT toute modification
  /// de cette version — la pièce déposée doit rester exactement ce qui a été déposé.
  lockedAt    DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenderId, version])
  @@index([tenderId])
}

model PchContractLine {
  id            String         @id @default(cuid())
  /// La pièce qui PORTE la ligne : le contrat de base, ou un avenant. Sur un avenant, la
  /// quantité est un DELTA (négatif possible) — l'historique exact reste lisible pièce par
  /// pièce, et la position courante se calcule en sommant les pièces effectives.
  documentId    String
  document      LegalDocument  @relation("DocContractLines", fields: [documentId], references: [id], onDelete: Cascade)
  /// Le contrat RACINE du groupe (== documentId pour les lignes du contrat de base) —
  /// dénormalisé pour agréger un contrat sans remonter la chaîne des avenants.
  contractId    String
  contract      LegalDocument  @relation("RootContractLines", fields: [contractId], references: [id], onDelete: Cascade)
  /// La ligne d'AO dont elle découle — le fil AO → contrat, lot par lot.
  tenderLineId  String?
  tenderLine    PchTenderLine? @relation(fields: [tenderLineId], references: [id], onDelete: SetNull)
  /// Le produit canonique. Nullable comme sur la ligne d'AO : le libellé du contrat fait foi.
  productId     String?
  product       Product?       @relation("ContractLineProduct", fields: [productId], references: [id], onDelete: SetNull)
  /// Le libellé EXACT de la pièce contractuelle — figé, comme la désignation d'AO.
  designation   String
  /// En unités. NÉGATIF sur un avenant de réduction.
  quantityUnits Int
  unitPriceDzd  Decimal?       @db.Decimal(14, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orderLines PchOrderLine[]

  @@index([contractId])
  @@index([documentId])
  @@index([tenderLineId])
  @@index([productId])
}

model PchOrderLine {
  id             String           @id @default(cuid())
  orderId        String
  order          PchOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// La ligne CONTRACTUELLE commandée — c'est elle qui permet le contrôle du restant.
  contractLineId String?
  contractLine   PchContractLine? @relation(fields: [contractLineId], references: [id], onDelete: SetNull)
  /// REPLI : la ligne d'AO, quand le BC arrive avant l'enregistrement du contrat.
  tenderLineId   String?
  tenderLine     PchTenderLine?   @relation("OrderLineTenderLine", fields: [tenderLineId], references: [id], onDelete: SetNull)
  designation    String
  quantityUnits  Int              @default(0)
  /// CONDITIONNEMENT COMMANDÉ — « boîte de N ». Il peut différer de celui de l'AO : un bon de
  /// commande porte le conditionnement réellement livré, et le nombre de boîtes s'en déduit.
  unitsPerBox    Int?
  unitPriceDzd   Decimal?         @db.Decimal(14, 2)
  /// LE PRIX À LA BOÎTE du bon — même règle que sur la ligne d'AO : saisi, il fait foi, et le
  /// prix unitaire s'en déduit. Voir `lib/pch/box-economics.ts`.
  boxPriceDzd    Decimal?         @db.Decimal(14, 2)
  createdAt      DateTime         @default(now())

  deliveryLines PchDeliveryLine[]

  @@index([orderId])
  @@index([contractLineId])
  @@index([tenderLineId])
}

model PchDelivery {
  id             String            @id @default(cuid())
  orderId        String
  order          PchOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// N° de bordereau de livraison (BL).
  reference      String?
  expectedAt     DateTime?
  /// Non nulle ⇒ livrée. Pas de champ « statut » : livré/attendu/en retard se DÉDUISENT des
  /// dates, un statut posé à la main aurait divergé d'elles.
  deliveredAt    DateTime?
  location       String?
  /// Réserves émises à la réception — vides = réception conforme.
  reserves       String?
  notes          String?
  receivedById   String?
  lines          PchDeliveryLine[]
  stockMovements StockMovement[]
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([orderId])
  @@index([deliveredAt])
}

model PchDeliveryLine {
  id            String        @id @default(cuid())
  deliveryId    String
  delivery      PchDelivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderLineId   String?
  orderLine     PchOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  designation   String
  quantityUnits Int           @default(0)
  /// Lot pharmaceutique et péremption — quand le BL les donne.
  batchNumber   String?
  expiryDate    DateTime?

  @@index([deliveryId])
  @@index([orderLineId])
}

/// « RELIER À… » d'un courrier : un pli concerne souvent PLUSIEURS objets (le marché, son
/// contrat, un BC). Multi-lien TYPÉ (enum `EntityType`), scoped aux courriers — pas un
/// polymorphisme universel : les relations structurantes restent des FK.
/// LE REGISTRE UNIQUE DES LIENS D'AFFAIRE — « relié à… », pour TOUTES les natures.
///
/// Il remplace `MailEntryLink`, qui ne savait relier qu'un courrier (ses lignes ont été
/// recopiées ici par la migration). Garder deux tables aurait produit exactement la dérive
/// qu'on redoute : un lien courrier↔contrat d'un côté, un lien contrat↔bon de l'autre, et la
/// fiche d'un contrat obligée d'interroger DEUX registres — dont un qu'on oublierait le jour
/// d'un troisième besoin (§17 : pas de second registre).
///
/// LA PAIRE EST RANGÉE CANONIQUEMENT (voir `lib/links/graph.ts`) : « relier A à B » et
/// « relier B à A » sont le même fait, donc la même ligne. L'unicité suffit alors à empêcher
/// le doublon, sans aucun code de déduplication.
///
/// Les LIBELLÉS des deux bouts sont photographiés à la création : afficher « Relié à » ne
/// coûte aucune requête, et une pièce renommée garde le nom sous lequel on l'a reliée.
model EntityLink {
  id          String     @id @default(cuid())
  fromType    EntityType
  fromId      String
  fromLabel   String?
  toType      EntityType
  toId        String
  toLabel     String?
  /// Pourquoi ce lien, quand la personne l'a précisé (« couvre le lot 3 »).
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())

  @@unique([fromType, fromId, toType, toId])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

// ─────────────── Stocks (suivi des stocks de nos produits à la PCH) ───────────────

model StockMovement {
  id          String             @id @default(cuid())
  product     String // libellé du produit (instantané ; repris du produit Regulatory si lié)
  productId   String? // produit Regulatory associé (source de vérité du catalogue produits)
  productRef  RegulatoryProduct? @relation(fields: [productId], references: [id])
  dci         String?
  direction   StockDirection     @default(IN)
  quantity    Int                @default(0)
  date        DateTime           @default(now())
  location    String             @default("PCH")
  notes       String?
  /// La LIVRAISON de marché dont ce mouvement est l'écriture stock, quand il y en a une.
  /// Le stock reste la source de vérité des quantités ; le lien évite la double saisie.
  deliveryId  String?
  delivery    PchDelivery?       @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime           @default(now())

  @@index([product])
  @@index([productId])
  @@index([date])
  @@index([deliveryId])
}

/// Stock initial d'un produit à un emplacement (PCH…). Sert de base de calcul :
/// niveau courant = stock initial + mouvements (entrées − sorties + ajustements).
/// Permet d'initialiser le stock à l'adoption, puis de le calculer.
model StockOpeningLevel {
  id          String   @id @default(cuid())
  productId   String? // produit Regulatory associé (catalogue), sinon libellé libre
  product     String // libellé du produit (instantané)
  dci         String?
  location    String   @default("PCH")
  quantity    Int      @default(0)
  date        DateTime @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([location])
}

// ─────────────── Matériel promotionnel (workflow multi-acteurs) ───────────────
// Circuit : Marketing (initiateur) → Assistante de direction → Finances →
// Information médicale → Direction → agence. Devis, bon de commande, bordereau de
// paiement, quittance, matériel, visa publicitaire, facture & règlement.
/// Nature du matériel promotionnel demandé (présentoir, stand, poster, vidéo…).
enum MaterialType {
  PRESENTOIRE
  STAND_BOOTH
  CARNET_BILAN
  SOUS_MAINS
  BLOC_NOTE
  SAC_A_DOS
  PORTE_CARTE_RDV
  BANNER
  FICHE_POSO
  ADV
  FICHE_CONSEILS
  FICHE_GAMME
  POSTER
  VIDEO
  CADEAUX_FIN_ANNEE
  CARTES_INVITATIONS
  STYLOS
  CLE_USB
  AUTRES
}

enum PromoMaterialStatus {
  PROSPECTION_REQUESTED // Marketing a demandé la prospection d'agences (reçu comme demande administrative)
  QUOTES_UPLOADED // l'assistante a déposé les devis
  AGENCY_CHOSEN // Marketing a choisi l'agence/devis et demandé la création du bon de commande
  BC_FINANCE_REVIEW // l'assistante a déposé le BC et sollicité la validation des finances
  BC_VALIDATED // les finances ont validé/signé le bon de commande
  BC_SENT // l'assistante a validé le BC et l'a transmis à l'agence (hors plateforme)
  PAYMENT_INITIATED // l'information médicale a initié le bordereau de paiement
  PAYMENT_DONE // les finances ont effectué le paiement (quittance)
  MATERIAL_PRODUCED // matériel réalisé par l'agence, déposé par Marketing
  CONFORMITY_REVIEW // l'information médicale vérifie la conformité / le dépôt
  VISA_OBTAINED // référence + visa publicitaire obtenus (déposés par l'information médicale)
  BAT_PRINTING // retour Marketing pour BAT / impression
  FINAL_MATERIAL // matériel final déposé par Marketing
  INVOICED // l'agence a émis la facture finale + bon de livraison
  SETTLED // les finances ont réglé
  CANCELLED
}

model PromoMaterial {
  /// LA BUSINESS UNIT qui porte cette demande — c'est SON budget Ad&Pro qui est engagé.
  /// Sans elle, la dépense pesait sur un total commercial que personne ne pouvait
  /// répartir : « combien la gamme oncologie a-t-elle dépensé ? » n'avait pas de réponse.
  businessUnitId String?
  businessUnit   BusinessUnit?       @relation("AdProPromoMaterial", fields: [businessUnitId], references: [id], onDelete: SetNull)
  /// LE BUDGET DU DOSSIER (Direction, 27/10 — point 21) : la (sous-)catégorie que la Direction Marketing lui impute.
  /// Ses BC signés y comptent en ENGAGÉ, ses ordres fournisseur en CONSOMMÉ (`queries/budget-sources.ts`).
  budgetCategoryId  String?
  budgetCategory    BudgetCategoryLine? @relation("PromoMaterialBudget", fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  budgetImputeLe    DateTime?
  budgetImputeParId String?
  id             String              @id @default(cuid())
  reference      String              @unique // MP-2026-001
  title          String
  description    String?
  materialType   MaterialType? // nature du support (présentoir, poster, vidéo…)
  companyId      String? // entité (Adventum / Pharmagène / …)
  company        Company?            @relation(fields: [companyId], references: [id])
  status         PromoMaterialStatus @default(PROSPECTION_REQUESTED)

  requesterId String? // Marketing — initiateur
  assistantId String? // Assistante de direction en charge

  chosenAgency  String? // agence retenue
  chosenAmount  Decimal? @db.Decimal(14, 2) // montant du devis retenu
  amount        Decimal? @db.Decimal(14, 2) // budget global (si distinct)
  bcReference   String? // n° de bon de commande
  visaReference String? // référence + visa publicitaire
  authorityRef  String? // référence de dépôt aux autorités

  bcValidatedAt        DateTime?
  paymentInitiatedAt   DateTime?
  paymentDoneAt        DateTime?
  financeReminderAt    DateTime? // dernière relance des finances
  financeReminderCount Int       @default(0)

  paymentOrderId    String? // ordre de dépense — bordereau de paiement (information médicale → finances)
  settlementOrderId String? // ordre de dépense — règlement final (facture agence)
  adminRequestId    String? // demande administrative liée (visibilité assistante)

  /// LE CIRCUIT COURT — cinq étapes au lieu de seize, puis trois chantiers EN PARALLÈLE.
  /// L'ancien `status` (seize valeurs en file indienne) reste écrit pour les dossiers en cours et
  /// pour l'historique ; c'est `circuitState` qui pilote désormais. Voir
  /// `src/lib/promo-material/circuit.ts`.
  circuitState String? // QUOTE_REQUESTED · REVIEW_* · IN_EXECUTION · COMPLETED · REFUSED
  /// Le N+1 qui doit valider — figé à la création : un changement d'organigramme en cours de
  /// circuit ne doit pas transférer une validation en attente à quelqu'un qui n'a rien suivi.
  managerId    String?
  /// Les chantiers parallèles déjà clos (`PURCHASE_ORDER`, `PAYMENT`, `AD_VISA`), séparés par des
  /// virgules. Le dossier n'est terminé que lorsque les trois y figurent.
  tracksDone   String?
  /// LE RENVOI POUR CORRECTION (audit 360°, lot C4b, R05) — la troisième issue, entre valider et
  /// refuser. À la validation de la demande, le dossier RESTE à son étape et cette marque dit que la
  /// balle est chez le demandeur ; renvoyé depuis une validation du choix, il repart au choix des
  /// lignes et la marque y porte le motif jusqu'à ce que le demandeur revalide. Voir
  /// `src/lib/promo-material/renvoi.ts`.
  returnedAt   DateTime?
  returnedById String?
  returnNote   String?
  /// L'étape qui a renvoyé (`REVIEW_REQUEST`, `REVIEW_MANAGER`, `REVIEW_DG`…) — l'écran le dit.
  returnedFrom String?

  /// LA VERSION DU CIRCUIT (§118.152). 1 = le circuit court d'origine — les dossiers déjà en vol
  /// gardent la chaîne qui leur avait été PROMISE (§118.142) ; 2 = la demande validée, les devis
  /// RETRANSCRITS en lignes, le choix ligne à ligne, les BC générés par la plateforme, une facture
  /// par BC, et une demande de visa ou de déclaration à chaque paiement. Voir `promo-material/circuit.ts`.
  circuitVersion       Int                @default(1)
  /// LE VALIDATEUR DE LA DEMANDE (étape 0 du circuit 2), figé à la création : la directrice
  /// marketing pour un membre de la Direction Marketing, sinon le N+1 — jamais au-delà du directeur
  /// des opérations. Nul alors que l'étape a lieu = la Direction des opérations valide (le plafond).
  /// Figé pour la raison de `managerId` : un organigramme qui change ne transfère pas une
  /// validation en attente à quelqu'un qui n'a rien suivi.
  requestValidatorId   String?
  /// La demande passe-t-elle par une validation hiérarchique ? Figé à la création, comme son
  /// validateur : faux pour la directrice marketing elle-même et pour un demandeur au plafond.
  requestValidation    Boolean            @default(false)
  /// LA DIRECTRICE MARKETING DE CE DEMANDEUR, quand il appartient à la Direction Marketing (figée) :
  /// c'est elle qui valide son devis. Nulle pour les autres : la ou les cheffes de la Direction
  /// Marketing valident, lues à l'étape.
  marketingValidatorId String?
  /// Quand, et par qui, les devis ont été demandés au secrétariat.
  quotesRequestedAt    DateTime?
  quotesRequestedById  String?
  /// Les précisions du demandeur pour l'assistante de direction (§118.204) — saisies dans « Articles
  /// demandés » à la création, envoyées avec la demande de devis quand elle part.
  precisionsDevis      String?
  /// LA DATE DE BESOIN (Direction, 10/2026) : « besoin pour le … » — saisie par le demandeur, modifiable par lui tant que
  /// le matériel n'est pas livré. Nulle = pas de date demandée.
  neededBy             DateTime?
  /// Les devis RETRANSCRITS par l'assistante de direction — un par agence ou partenaire.
  quotes               PromoQuote[]
  /// LES ARTICLES DEMANDÉS (§118.165) — ce que le demandeur veut faire faire, pioché dans le
  /// catalogue : c'est ce que l'assistante cherche à faire chiffrer, et à quoi chaque ligne de
  /// devis se rapproche.
  articlesDemandes     PromoRequestItem[]
  /// Les postes HISTORIQUES du dossier (intégration des dépenses réelles Ad & Pro 2026).
  postesHistoriques    AdProItem[]        @relation("AdProItemDossierPromo")

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([assistantId])
  @@index([budgetCategoryId])
}

/// UN DEVIS REÇU, RETRANSCRIT (§118.152) — le tableau interne de l'entreprise, par fournisseur.
///
/// L'assistante de direction recopie le devis de l'agence ligne à ligne : référence, unité,
/// quantité, prix unitaire. Le TOTAL n'est jamais saisi : il se calcule (§118.59 — un total écrit
/// à la main est une photographie qu'on ne peut pas vérifier). Le total ANNONCÉ sur le papier, lui,
/// se saisit à part, pour que l'écart se VOIE : c'est ce qui attrape une ligne oubliée.
///
/// Le FOURNISSEUR est choisi dans l'annuaire de l'entreprise (`CompanyContact`) : c'est lui qui
/// porte l'adresse, le RC et le NIF que le bon de commande imprimera — un nom tapé à la main ne
/// ferait qu'un bon de commande sans identité.
model PromoQuote {
  id                    String           @id @default(cuid())
  promoMaterialId       String
  promoMaterial         PromoMaterial    @relation(fields: [promoMaterialId], references: [id], onDelete: Cascade)
  position              Int              @default(0)
  supplierId            String?
  supplier              CompanyContact?  @relation("PromoQuoteSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  /// Le nom affiché, tenu à jour depuis l'annuaire — il survit à un contact supprimé.
  supplierName          String
  /// Le numéro du devis du fournisseur (« 26/0576 »), repris sous « Devis N° » du bon de commande.
  reference             String?
  quoteDate             DateTime?
  /// Le taux de TVA du devis, en pour cent, TEL QU'IL EST IMPRIMÉ ; 0 pour un devis exonéré. `null` tant que la
  /// personne ne l'a pas indiqué depuis le papier (un devis rangé « à retranscrire ») : rien n'est deviné.
  tvaRate               Decimal?         @db.Decimal(5, 2)
  /// Une taxe ADDITIONNELLE au HT, hors base de TVA — la « Taxe Pub 2 % » d'un support
  /// publicitaire (§118.135). Nulle = aucune. Elle entre dans le montant engagé, donc dans le seuil.
  extraTaxLabel         String?
  extraTaxRate          Decimal?         @db.Decimal(5, 2)
  /// Le total HT imprimé sur le devis — pour CONTRÔLER la retranscription, jamais pour calculer.
  announcedTotal        Decimal?         @db.Decimal(14, 2)
  /// Le scan du devis (pièce du dossier) — une retranscription sans sa source ne se vérifie pas.
  documentId            String?
  note                  String?
  lines                 PromoQuoteLine[]
  /// LE BON DE COMMANDE généré pour CE devis (pièce Legal). Nul = pas encore généré, ou annulé.
  purchaseOrderId       String?
  /// L'APERÇU DU BC « à vérifier par le demandeur » (Direction, 10/2026) : déposé par la génération, SANS numéro ; la
  /// validation par le demandeur (ou le Super Admin) émet le BC et l'efface. Forme : `lib/promo-material/bc-brouillon-promo.ts`.
  bcBrouillon           Json?
  /// Le BC est-il parti chez le fournisseur ? Seul un BC SIGNÉ part (§118.149).
  purchaseOrderSentAt   DateTime?
  purchaseOrderSentById String?
  /// Les factures DÉTAILLÉES du BC de ce devis (§118.165).
  factures              PromoFacture[]
  createdById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([promoMaterialId])
  @@index([purchaseOrderId])
}

/// UNE LIGNE DE DEVIS — ce que le demandeur RETIENT, ou non, une à une.
model PromoQuoteLine {
  id            String              @id @default(cuid())
  quoteId       String
  quote         PromoQuote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position      Int                 @default(0)
  /// La référence ou la désignation de l'article, telle que sur le devis.
  reference     String
  /// L'unité de compte (« pièce », « lot de 50 », « m² ») — facultative.
  unit          String?
  quantity      Decimal             @db.Decimal(14, 3)
  /// Le prix unitaire HORS TAXES.
  unitPrice     Decimal             @db.Decimal(14, 2)
  /// Retenue par le demandeur : c'est ce qui entre dans le montant validé et dans le bon de commande.
  selected      Boolean             @default(false)
  /// L'ACTION que cette ligne chiffre — conception, impression, location… (§118.165) : un même
  /// article se commande souvent en deux temps chez deux fournisseurs. Nulle sur les lignes d'avant.
  action        PromoAction?
  /// L'ARTICLE DEMANDÉ que cette ligne chiffre. Nul = une ligne « en plus », que le demandeur
  /// n'avait pas demandée et peut quand même retenir (ou une ligne d'avant ce rapprochement).
  requestItemId String?
  requestItem   PromoRequestItem?   @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  factureLignes PromoFactureLigne[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([quoteId])
  @@index([requestItemId])
}

/// CE QU'ON ATTEND DU FOURNISSEUR sur un article (§118.165) — « pour le devis ainsi que pour le BC
/// du matériel promotionnel, on peut avoir plusieurs actions en l'occurrence conception, impression ».
/// Vocabulaire FERMÉ : c'est lui qui dit si une ligne reçue entre au stock (une impression oui, une
/// conception non) — ouvert, il ferait entrer au magasin des prestations qui ne se comptent pas.
enum PromoAction {
  CONCEPTION /// Création graphique, maquette, BAT : une prestation, rien à compter.
  IMPRESSION /// Tirage d'un support conçu : des unités qui entrent au stock.
  FABRICATION /// Fabrication d'un objet (présentoir, stand) : des unités qui entrent au stock.
  ACHAT /// Achat d'un objet fini (stylos, goodies) : des unités qui entrent au stock.
  LOCATION /// Location : l'objet repart chez le fournisseur, rien n'entre au stock.
  LIVRAISON /// Transport, livraison : une prestation.
  INSTALLATION /// Montage, installation : une prestation.
  AUTRE /// Toute autre prestation : rien à compter.
}

/// UN ARTICLE DEMANDÉ (§118.165) — une ligne de la demande d'achat ou de location, piochée dans le
/// CATALOGUE : l'article, le ou les produits qu'il promeut, la quantité souhaitée, ce qu'on attend
/// du fournisseur (conception, impression…) et un commentaire. C'est ce que l'assistante de
/// direction cherche à faire chiffrer, et ce que la réception fera entrer au stock.
model PromoRequestItem {
  id              String                    @id @default(cuid())
  promoMaterialId String
  promoMaterial   PromoMaterial             @relation(fields: [promoMaterialId], references: [id], onDelete: Cascade)
  position        Int                       @default(0)
  /// L'article du catalogue. Restrict : un article demandé ne s'efface pas sous une demande — il
  /// s'archive (le registre de suppression le dit avant le clic).
  catalogueId     String
  catalogue       PromoCatalogueArticle     @relation(fields: [catalogueId], references: [id], onDelete: Restrict)
  /// La quantité souhaitée — facultative : une conception seule n'a rien à compter.
  quantite        Decimal?                  @db.Decimal(12, 3)
  /// Ce qu'on attend du fournisseur — au moins une action.
  actions         PromoAction[]             @default([])
  commentaire     String?
  /// CE QUE LA LIGNE PROMEUT (§118.204), lisible tel quel : { societe, gammes:[{id,nom}], produits:[{id,nom}],
  /// autre }. Les produits sont ceux des Business Units ; `produits` (ci-dessous) garde le lien CANONIQUE
  /// quand il existe, pour le stock. Nul : ligne d'avant (ses produits canoniques font foi).
  promus          Json?
  produits        PromoRequestItemProduct[]
  lignesDevis     PromoQuoteLine[]
  lignesFacture   PromoFactureLigne[]
  createdById     String?
  updatedById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([promoMaterialId])
  @@index([catalogueId])
}

/// LES PRODUITS d'un article demandé — les produits CANONIQUES, ceux que portera l'article de stock.
model PromoRequestItemProduct {
  itemId    String
  item      PromoRequestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation("PromoDemandeProduit", fields: [productId], references: [id], onDelete: Restrict)

  @@id([itemId, productId])
  @@index([productId])
}

/// LA FACTURE D'UN BC DE MATÉRIEL PROMOTIONNEL, DÉTAILLÉE (§118.165) — ce que la pièce Legal ne
/// porte pas : ses lignes, ses taxes, et le total imprimé qui contrôle la saisie.
///
/// « La facture doit renseigner exactement le matériel reçu en stock. » La pièce Legal garde son
/// rôle (registre, règlement, centre de paiement) ; cette table porte ce qu'on a facturé ligne à
/// ligne, et ce que le demandeur a coché REÇU — c'est ce qui entre au stock, et ce qu'on paie.
model PromoFacture {
  id              String              @id @default(cuid())
  legalDocumentId String              @unique
  legalDocument   LegalDocument       @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  /// Le devis dont le BC découle — le lien vers les lignes VALIDÉES.
  quoteId         String?
  quote           PromoQuote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// TVA en POUR CENT, reprise du BC et corrigeable : une facture à 9 % pour un BC à 19 % se paie
  /// au montant facturé — le plafond du BC tient de toute façon.
  tvaRate         Decimal             @db.Decimal(5, 2)
  extraTaxLabel   String?
  extraTaxRate    Decimal?            @db.Decimal(5, 2)
  /// Le total TTC IMPRIMÉ sur la facture — pour CONTRÔLER la saisie, jamais pour calculer.
  totalImprime    Decimal?            @db.Decimal(14, 2)
  lignes          PromoFactureLigne[]
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([quoteId])
}

/// UNE LIGNE DE FACTURE — ce qui est facturé, puis ce qui est REÇU (§118.165).
///
/// Pré-remplie depuis la ligne du BC (`quoteLineId`) ; la quantité et le prix se corrigent pour
/// coller à la facture, et l'écart avec le BC se voit. La RÉCEPTION est cochée par le demandeur :
/// une ligne qui produit des unités (impression, fabrication, achat) entre alors au magasin central
/// en un LOT au coût de la facture (`stockLotId`). Une ligne non livrée ne se paie pas — et y
/// renoncer est définitif : « un paiement pour cette ligne ne pourra pas être fait ultérieurement ».
model PromoFactureLigne {
  id            String            @id @default(cuid())
  factureId     String
  facture       PromoFacture      @relation(fields: [factureId], references: [id], onDelete: Cascade)
  position      Int               @default(0)
  designation   String
  action        PromoAction?
  unite         String?
  quantite      Decimal           @db.Decimal(14, 3)
  /// Le prix unitaire HORS TAXES facturé.
  prixUnitaire  Decimal           @db.Decimal(14, 2)
  /// La ligne du BC (donc du devis) que cette ligne facture.
  quoteLineId   String?
  quoteLine     PromoQuoteLine?   @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  /// L'article demandé, hérité de la ligne du devis : c'est lui qui dit quel article de stock reçoit.
  requestItemId String?
  requestItem   PromoRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  /// LA RÉCEPTION — la quantité reçue (une prestation : la quantité facturée, cochée « faite »).
  quantiteRecue Decimal?          @db.Decimal(14, 3)
  recueLe       DateTime?
  recueParId    String?
  /// LE RENONCEMENT — ce qui n'a pas été livré (toute la ligne, ou son reliquat) ne se paiera pas.
  renonce       Boolean           @default(false)
  renonceMotif  String?
  renonceLe     DateTime?
  renonceParId  String?
  /// Où la ligne est entrée au stock : l'article et le lot créés à la réception.
  stockItemId   String?
  stockItem     PromoStockItem?   @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  stockLotId    String?
  stockLot      PromoStockLot?    @relation(fields: [stockLotId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([factureId])
  @@index([quoteLineId])
  @@index([requestItemId])
  @@index([stockLotId])
}

/// LES TROIS FAMILLES DU MATÉRIEL PROMOTIONNEL — trois comportements, pas trois étiquettes (§118.164).
enum PromoFamille {
  CONSOMMABLE /// Fiches posologiques, flyers, stylos, blocs : une quantité qui baisse à chaque remise.
  DURABLE /// Banners, présentoirs, stands : des unités qui se prêtent, reviennent, et s'abîment.
  NUMERIQUE /// E-flyer, vidéo, e-ADV : pas de quantité — un lien et une période de validité.
}

/// LE CATALOGUE DU MATÉRIEL PROMOTIONNEL — ce qu'on PEUT commander, chacun sous une référence FIXE.
///
/// Le Super Admin le tient ; il l'ouvre en lecture ou en écriture à qui il veut (module
/// `PROMO_CATALOG`, Administration › Accès). La référence `CAT-0001` ne change plus une fois
/// donnée : c'est elle que citent les demandes, les stocks et (plus tard) les factures. Le NOM, lui,
/// se corrige — une faute de frappe ne doit pas obliger à recréer l'article.
model PromoCatalogueArticle {
  id               String             @id @default(cuid())
  /// CAT-0001, CAT-0002… — distincte des dossiers « MP-AAAA-NNN » pour ne jamais s'y confondre.
  reference        String             @unique
  nom              String
  famille          PromoFamille
  /// Le même vocabulaire que les demandes (fiche posologique, banner, présentoir…).
  materialType     MaterialType?
  unite            String             @default("pièce")
  description      String?
  /// Un support qui n'existe que pour un produit (fiche posologique, ADV) : le produit est exigé
  /// à l'entrée en stock — « 300 fiches posologiques » sans produit ne désigne rien qu'on puisse remettre.
  exigeProduit     Boolean            @default(false)
  /// Archivé : ne se propose plus, mais reste lisible partout où il a servi.
  actif            Boolean            @default(true)
  /// « AUTRE ARTICLE » saisi librement depuis une demande : archivé (il ne se propose pas) tant qu'un gestionnaire du
  /// catalogue ne l'y a pas ajouté (« Proposer au catalogue »).
  horsCatalogue    Boolean            @default(false)
  createdById      String?
  updatedById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  articlesStock    PromoStockItem[]
  /// Les articles DEMANDÉS qui le citent (§118.165).
  articlesDemandes PromoRequestItem[]

  @@index([famille, actif])
}

/// UN ARTICLE DE STOCK — un article du catalogue, pour un ou des produits, dans une société.
///
/// « Fiche posologique — Nivolex » et « Fiche posologique — Trastuzex » sont deux articles de stock
/// du même article du catalogue : physiquement, ce ne sont pas les mêmes feuilles. L'identité est
/// (société, article du catalogue, produits) ; un index unique en base la garantit.
///
/// La quantité N'EST PAS stockée ici : elle se calcule à partir des mouvements, par lot et par
/// détenteur. Un nombre écrit puis corrigé à la main est faux dès la première sortie non saisie,
/// et rien ne dit quand.
model PromoStockItem {
  id              String                         @id @default(cuid())
  companyId       String? // entité (Adventum / Pharmagène / …)
  company         Company?                       @relation(fields: [companyId], references: [id])
  /// L'article du catalogue que ce stock matérialise.
  catalogueId     String
  catalogue       PromoCatalogueArticle          @relation(fields: [catalogueId], references: [id])
  /// LA CLÉ DES PRODUITS — leurs identifiants canoniques triés, joints par une virgule ("" = sans
  /// produit). Écrite UNE fois, à la création : c'est elle que l'index d'unicité lit.
  produitsCle     String                         @default("")
  produits        PromoStockItemProduct[]
  /// Libellé à la création (article + produits). L'écran recompose depuis le catalogue ; ce champ
  /// sert à la recherche et aux lecteurs d'avant ce registre.
  name            String
  /// Nature du support (héritée des articles d'avant le catalogue).
  materialType    MaterialType?
  /// Référence interne / fournisseur, quand elle existe (articles d'avant le catalogue).
  reference       String?
  /// Unité de compte : « pièce », « boîte », « lot de 50 »…
  unit            String?
  /// Où c'est rangé au magasin.
  location        String?
  /// Seuil d'alerte propre à l'article — 50 présentoirs, ce n'est pas 50 stylos.
  alertThreshold  Decimal?                       @db.Decimal(12, 3)
  notes           String?
  /// Campagne dont cet article est issu, quand il vient d'une commande tracée.
  promoMaterialId String?
  /// Support NUMÉRIQUE : le lien (Drive, site, plateforme) et la date de fin de validité. Un support
  /// numérique n'a ni lot ni mouvement — il n'y a rien à compter.
  lien            String?
  valableJusquau  DateTime?
  isActive        Boolean                        @default(true)
  lots            PromoStockLot[]
  movements       PromoStockMovement[]
  transferts      PromoStockTransfer[]
  demandes        PromoStockRequest[]
  /// Les lignes de facture reçues dans cet article (§118.165).
  factureLignes   PromoFactureLigne[]
  /// Les présentations en visite d'un support numérique (§118.166).
  presentations   MedicalVisitSupportNumerique[]
  /// Les réservations pour des événements Ad & Pro (§118.167).
  lignesEvenement AdProStockLine[]
  /// Les lignes de comptage qui l'ont compté (§118.168).
  lignesComptage  PromoStockComptageLigne[]
  /// Les propositions de refonte d'un support DURABLE (§118.168).
  refontes        PromoStockRefonte[]
  createdById     String?
  updatedById     String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([companyId])
  @@index([isActive])
  @@index([promoMaterialId])
  @@index([catalogueId])
}

/// LES PRODUITS d'un article de stock — les produits CANONIQUES, ceux que la visite coche (§118.115).
model PromoStockItemProduct {
  itemId    String
  item      PromoStockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  productId String
  /// Restrict : un produit qui porte du matériel en stock ne s'efface pas en silence.
  product   Product        @relation("PromoStockProduit", fields: [productId], references: [id], onDelete: Restrict)

  @@id([itemId, productId])
  @@index([productId])
}

/// D'OÙ VIENT UN LOT — ce que l'écran dit quand on demande « pourquoi ce lot existe ».
enum PromoLotOrigine {
  SAISIE /// Entrée manuelle du Super Admin (don, retour fournisseur, stock trouvé…).
  OUVERTURE /// Inventaire d'ouverture : le magasin, puis ce que chacun avait déjà en main.
  CORRECTION /// Unités retrouvées à l'inventaire, dont on ne sait pas de quel lot elles viennent.
  REPRISE /// L'historique d'avant le registre par lots, repris tel quel.
  ACHAT /// Réception d'une facture du circuit d'achat.
}

/// UN LOT — une entrée datée, avec son coût et sa fin de validité.
///
/// Personne ne choisit un lot à la main : une sortie prend toujours le lot qui expire le plus tôt
/// (puis le plus ancien). Un lot périmé ne se distribue plus ; il se déclare perdu ou détruit.
model PromoStockLot {
  id             String               @id @default(cuid())
  itemId         String
  item           PromoStockItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Rang du lot dans l'article (Lot 1, Lot 2…) — ce qu'on lit à l'écran.
  numero         Int
  origine        PromoLotOrigine
  recuLe         DateTime             @default(now())
  coutUnitaire   Decimal?             @db.Decimal(14, 2)
  /// Fin de validité (RCP, visa, campagne). Absente : le lot ne périme pas.
  valableJusquau DateTime?
  libelle        String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  mouvements     PromoStockMovement[]
  /// La ligne de facture dont ce lot est la réception (origine ACHAT, §118.165).
  factureLignes  PromoFactureLigne[]

  @@unique([itemId, numero])
  @@index([itemId])
}

/// UN MOUVEMENT DE STOCK — la seule chose qu'on écrit vraiment. Jamais supprimé : une erreur se
/// corrige par un mouvement INVERSE (`annuleId`), et l'histoire reste entière.
model PromoStockMovement {
  id            String              @id @default(cuid())
  itemId        String
  item          PromoStockItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Le lot touché. NoAction : vérifié en fin d'instruction, donc la suppression d'un article
  /// (qui emporte lots et mouvements) passe, et la suppression d'un lot seul ne passe pas.
  lotId         String
  lot           PromoStockLot       @relation(fields: [lotId], references: [id], onDelete: NoAction)
  /// QUI détient : null = le magasin central de la société de l'article.
  holderId      String?
  kind          PromoMovementKind
  /// Variation SIGNÉE : + entrée, − sortie. Le sens vient de la nature, pas de la saisie.
  delta         Decimal             @db.Decimal(12, 3)
  /// Le transfert dont ce mouvement est une jambe (départ, arrivée, retour).
  transferId    String?
  transfer      PromoStockTransfer? @relation(fields: [transferId], references: [id], onDelete: NoAction)
  /// Le mouvement que celui-ci ANNULE — unique : un mouvement ne s'annule qu'une fois.
  annuleId      String?             @unique
  annule        PromoStockMovement? @relation("PromoMouvementAnnule", fields: [annuleId], references: [id], onDelete: NoAction)
  annulation    PromoStockMovement? @relation("PromoMouvementAnnule")
  /// À qui / pour quoi : un événement, un congrès (texte des mouvements d'avant le registre).
  recipient     String?
  reason        String?
  /// LA VISITE où ce matériel a été remis (§118.166) — SetNull : le stock dit la vérité du
  /// mouvement ; la visite en est le contexte, et sa suppression ne recrée pas les fiches.
  visitId       String?
  visit         MedicalVisit?       @relation("PromoRemiseVisite", fields: [visitId], references: [id], onDelete: SetNull)
  /// LE COMPTE RENDU DE VISITE (rapport terrain) où ce matériel a été déclaré remis, quand aucune
  /// visite ne le porte (§118.204). SetNull, comme la visite : le stock dit la vérité du mouvement.
  /// L'action refuse de supprimer un rapport qui porte des remises.
  fieldReportId String?
  fieldReport   FieldReport?        @relation("PromoRemiseRapport", fields: [fieldReportId], references: [id], onDelete: SetNull)
  /// LE MÉDECIN qui l'a reçu — l'historique de sa fiche.
  doctorId      String?
  doctor        MedicalDoctor?      @relation("PromoRemiseMedecin", fields: [doctorId], references: [id], onDelete: SetNull)
  /// LA LIGNE DU POSTE AD & PRO pour laquelle ce matériel a été réservé, ou est revenu (§118.167).
  /// SetNull : le registre garde la vérité du mouvement ; la ligne en est le contexte.
  adProLineId   String?
  adProLine     AdProStockLine?     @relation(fields: [adProLineId], references: [id], onDelete: SetNull)
  /// LE COMPTAGE dont ce mouvement corrige l'écart (§118.168). SetNull : le registre garde la vérité
  /// du mouvement ; le comptage en est le contexte (« pourquoi −15 ? — le comptage du 12/10 »).
  comptageId    String?
  comptage      PromoStockComptage? @relation(fields: [comptageId], references: [id], onDelete: SetNull)
  occurredAt    DateTime            @default(now())
  createdById   String?
  createdAt     DateTime            @default(now())

  @@index([itemId, occurredAt])
  @@index([itemId, holderId])
  @@index([holderId])
  @@index([lotId])
  @@index([fieldReportId])
  @@index([transferId])
  @@index([visitId])
  @@index([doctorId])
  @@index([adProLineId])
  @@index([comptageId])
}

enum PromoMovementKind {
  RECEIPT /// Entrée : livraison, saisie manuelle du Super Admin
  DISTRIBUTION /// Sortie : remise (mouvements d'avant le registre ; remise à un médecin)
  LOSS /// Sortie sans contrepartie : casse, perte, support périmé détruit, écart de réception
  CORRECTION /// Correction d'inventaire — dans les deux sens, et assumée
  OPENING /// Inventaire d'ouverture — une fois par article et par détenteur
  TRANSFER_OUT /// Départ d'un transfert (dotation, transfert, retour) : quitte le détenteur
  TRANSFER_IN /// Arrivée confirmée par celui qui reçoit
  TRANSFER_BACK /// Retour à l'envoyeur : transfert refusé ou annulé
  REVERSAL /// Annulation d'un mouvement erroné — son exact inverse
  RESERVATION_OUT /// Réservé pour un événement Ad & Pro : quitte le magasin à l'accord du poste (§118.167)
  RESERVATION_BACK /// Retour d'événement : ce qui n'a pas été remis, ou le durable rendu
}

/// LA NATURE d'un transfert — déduite de ses deux bouts, jamais saisie.
enum PromoTransfertNature {
  DOTATION /// Magasin → une personne
  TRANSFERT /// Une personne → une autre
  RETOUR /// Une personne → le magasin
}

enum PromoTransfertStatut {
  EN_ROUTE /// Parti, pas encore confirmé par celui qui reçoit
  RECU /// Confirmé (en tout ou en partie) par celui qui reçoit
  REFUSE /// Refusé par celui qui reçoit : tout revient à l'envoyeur
  ANNULE /// Annulé avant réception : tout revient à l'envoyeur
}

/// UN TRANSFERT — l'un déclare, l'autre confirme (§118.164).
///
/// Tant qu'il est EN_ROUTE, la quantité a quitté l'envoyeur et n'est chez personne : elle est
/// « en route », et l'écran le dit. Le délégué CONFIRME la réception (décision de la Direction,
/// 01/10) : c'est une attestation, faite par lui, dans sa session.
model PromoStockTransfer {
  id             String               @id @default(cuid())
  itemId         String
  item           PromoStockItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  nature         PromoTransfertNature
  /// Qui donne : null = le magasin central.
  deId           String?
  /// Qui reçoit : null = le magasin central (un retour).
  versId         String?
  quantite       Decimal              @db.Decimal(12, 3)
  /// Ce que le destinataire a réellement reçu — l'écart, s'il y en a, est déclaré manquant.
  quantiteRecue  Decimal?             @db.Decimal(12, 3)
  statut         PromoTransfertStatut @default(EN_ROUTE)
  note           String?
  noteDecision   String?
  initiateurId   String
  decideParId    String?
  decideLe       DateTime?
  /// Le rappel « confirmez la réception » ne part qu'une fois.
  rappelEnvoyeLe DateTime?
  /// La demande de matériel que ce transfert sert, le cas échéant.
  demandeId      String?              @unique
  demande        PromoStockRequest?   @relation(fields: [demandeId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  mouvements     PromoStockMovement[]

  @@index([versId, statut])
  @@index([deId, statut])
  @@index([itemId, statut])
}

enum PromoDemandeStatut {
  OUVERTE
  SERVIE
  REFUSEE
  ANNULEE
}

/// UNE DEMANDE DE MATÉRIEL — un délégué demande au magasin ; le magasin la sert en une dotation.
model PromoStockRequest {
  id                  String              @id @default(cuid())
  itemId              String
  item                PromoStockItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  demandeurId         String
  quantite            Decimal             @db.Decimal(12, 3)
  note                String?
  statut              PromoDemandeStatut  @default(OUVERTE)
  decideParId         String?
  decideLe            DateTime?
  noteDecision        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  transfert           PromoStockTransfer?
  /// Demande faite depuis une mission Ad & Pro (« Mes missions › Matériel promotionnel »).
  missionAssignmentId String?

  @@index([statut])
  @@index([demandeurId, statut])
  @@index([itemId])
  @@index([missionAssignmentId])
}

/// L'ÉTAT D'UN COMPTAGE (§118.168).
enum PromoComptageStatut {
  DEMANDE /// Demandé, en attente de la saisie de celui qui détient le matériel
  SAISI /// Compté : chaque écart est au registre, en correction qui porte ce comptage
  ANNULE /// Annulé avant la saisie, par son demandeur ou le Super Admin
}

/// LA CADENCE d'une récurrence de comptage.
enum PromoComptageFrequence {
  HEBDOMADAIRE
  MENSUEL
  TRIMESTRIEL
  SEMESTRIEL
}

/// À QUI s'adresse un comptage récurrent.
enum PromoComptageCible {
  PERSONNE /// Une personne nommée
  EQUIPE /// Toute l'équipe de l'auteur — RELUE à chaque déclenchement : qui a quitté l'équipe ne reçoit plus rien
  MAGASIN /// Le magasin central, compté par sa gestionnaire
}

/// UN COMPTAGE — « comptez ce que vous avez en main », demandé par le directeur des opérations
/// (décision de la Direction, 01/10) (§118.168).
///
/// Compter est une ATTESTATION : seul celui qui détient le matériel la donne (la gestionnaire du
/// magasin pour le magasin). L'écart entre le compté et le registre se lit SOUS LE VERROU de chaque
/// article au moment de la saisie — jamais au moment de la demande : une visite faite entre-temps
/// aurait sinon passé pour un manquant. Chaque écart devient une CORRECTION au registre, qui porte
/// ce comptage : « pourquoi −15 ? » a toujours sa réponse.
model PromoStockComptage {
  id           String                        @id @default(cuid())
  /// Qui compte : null = le magasin central.
  holderId     String?
  /// La famille comptée ; null = tout ce qui se compte (consommables et durables).
  famille      PromoFamille?
  demandeurId  String
  recurrenceId String?
  recurrence   PromoStockComptageRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  statut       PromoComptageStatut           @default(DEMANDE)
  /// Le jour où le comptage est attendu — minuit UTC du jour dit, INCLUSIF (en retard le lendemain).
  echeance     DateTime
  note         String?
  saisiLe      DateTime?
  saisiParId   String?
  annuleLe     DateTime?
  annuleParId  String?
  annuleMotif  String?
  /// LA DERNIÈRE CORRECTION D'UNE SAISIE (audit 360°, R19) : qui, quand, pourquoi. Les écarts
  /// corrigés vivent au registre (mouvements portant ce comptage) ; ceci les dit à l'écran.
  corrigeLe    DateTime?
  corrigeParId String?
  corrigeMotif String?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  lignes       PromoStockComptageLigne[]
  mouvements   PromoStockMovement[]

  @@index([holderId, statut])
  @@index([statut, echeance])
  @@index([recurrenceId, statut])
  @@index([demandeurId])
}

/// UNE LIGNE DE COMPTAGE — ce que le registre attendait, ce qui a été compté, l'écart.
model PromoStockComptageLigne {
  id         String             @id @default(cuid())
  comptageId String
  comptage   PromoStockComptage @relation(fields: [comptageId], references: [id], onDelete: Cascade)
  itemId     String
  item       PromoStockItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Le solde que le registre portait au moment de la saisie, relu sous le verrou de l'article.
  attendu    Decimal            @db.Decimal(12, 3)
  compte     Decimal            @db.Decimal(12, 3)
  /// compte − attendu : négatif = manquant, positif = retrouvé.
  ecart      Decimal            @db.Decimal(12, 3)

  @@unique([comptageId, itemId])
  @@index([itemId])
}

/// UN COMPTAGE RÉCURRENT — posé une fois, il repart seul (§118.168, sur le modèle de §118.119).
///
/// L'AUTORITÉ DE L'AUTEUR EST RELUE À CHAQUE DÉCLENCHEMENT : un auteur qui n'a plus le droit de
/// demander ce comptage — mutation, départ, droits retirés — voit sa récurrence mise en PAUSE, avec
/// le motif, jamais supprimée. Sans cette relecture, une planification serait une permission qui
/// survit à son titulaire. Et l'on ne RATTRAPE pas : six mois de pause ne font pas six comptages le
/// jour de la reprise — ce qui n'a pas eu lieu à sa date n'a plus d'objet.
model PromoStockComptageRecurrence {
  id               String                 @id @default(cuid())
  cible            PromoComptageCible
  /// La personne, pour une cible PERSONNE ; null sinon.
  holderId         String?
  famille          PromoFamille?
  frequence        PromoComptageFrequence
  /// La première échéance : chaque occurrence se calcule DEPUIS elle — le 31 janvier mensuel donne
  /// le 28 février puis le 31 mars, jamais le 28 pour toujours.
  ancreLe          DateTime
  /// La prochaine échéance (UTC) — c'est elle que le battement interroge.
  prochaineLe      DateTime
  /// Combien de jours la personne a pour compter, à partir du déclenchement.
  delaiJours       Int                    @default(7)
  note             String?
  /// QUI L'A POSÉE — c'est SON autorité qui fait partir chaque comptage.
  auteurId         String?
  actif            Boolean                @default(true)
  pauseMotif       String?
  pauseLe          DateTime?
  derniereLe       DateTime?
  /// Combien de déclenchements ont réellement produit au moins un comptage.
  nbDeclenchements Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  comptages        PromoStockComptage[]

  @@index([actif, prochaineLe])
  @@index([auteurId])
}

/// UNE ALERTE DE STOCK DÉJÀ ENVOYÉE — l'alerte part à l'ENTRÉE dans un état, pas à chaque battement
/// (§118.168). La clé dit quoi (« seuil:<article> », « peremption:<lot>:<détenteur> »…) ; elle se
/// retire quand l'état cesse, et l'alerte repartira s'il revient. La clé est prise AVANT la
/// notification : deux battements concurrents n'alertent pas deux fois.
model PromoStockAlerte {
  cle      String   @id
  envoyeLe DateTime @default(now())
}

enum PromoRefonteStatut {
  OUVERTE
  RETENUE
  ECARTEE
}

/// UNE PROPOSITION DE REFONTE d'un support DURABLE — « ce kakémono est usé, son visuel a vieilli »
/// (§118.168). Quiconque voit le stock propose ; la gestionnaire du magasin (ou le Super Admin)
/// retient ou écarte, avec un mot. Retenir ne commande rien : c'est la décision qui ouvre une
/// demande de matériel, faite ensuite par le circuit d'achat. Au plus UNE OUVERTE par personne et
/// par article : un index partiel l'impose (migration), pas une lecture suivie d'une création.
model PromoStockRefonte {
  id           String             @id @default(cuid())
  itemId       String
  item         PromoStockItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  auteurId     String
  motif        String
  statut       PromoRefonteStatut @default(OUVERTE)
  decideParId  String?
  decideLe     DateTime?
  noteDecision String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([itemId, statut])
  @@index([statut])
}

// ─────────────── Feedback utilisateur ───────────────

model Feedback {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation("UserFeedback", fields: [userId], references: [id])
  module      String? // module concerné (optionnel)
  message     String
  status      FeedbackStatus       @default(NEW)
  handledById String?
  adminNote   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  attachments FeedbackAttachment[]

  @@index([status])
  @@index([userId])
}

/// PIÈCE JOINTE D'UN RETOUR — une capture, un PDF, un tableau : ce qui rend un bogue
/// reproductible au lieu de racontable.
///
/// Le contenu vit dans le MÊME magasin que toutes les autres pièces de l'ERP (FileBlob :
/// chiffré au repos, dédupliqué par sha256, compté par référence, en base ou en objet S3).
/// C'est ce qui permet au Chief d'y accéder par le chemin habituel — aucune représentation
/// de fichier propre au Feedback, qui lui serait invisible.
///
/// `onDelete: Cascade` : un retour supprimé emporte ses pièces. Le blob, lui, n'est libéré
/// qu'après `releaseBlob` — c'est le compteur de références qui décide, pas cette table.
model FeedbackAttachment {
  id           String   @id @default(cuid())
  feedbackId   String
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// FileBlob chiffré — le contenu réel, partagé avec le reste de l'ERP.
  blobId       String
  /// Le nom ASSAINI (jamais celui reçu du navigateur) et le type déduit de l'extension.
  name         String
  mime         String
  size         Int
  uploadedById String
  uploadedBy   User     @relation("FeedbackAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([feedbackId])
  @@index([blobId])
}

// ─────────────────────────── Messagerie interne ───────────────────────────
// Espace de communication unique de l'entreprise : messages directs, groupes
// privés et canaux d'équipe. Pensé pour remplacer WhatsApp / e-mail en interne :
// réactions, fils de discussion, mentions, pièces jointes chiffrées (FileBlob),
// épinglage, favoris, présence et accusés de lecture. L'accès à une conversation
// est strictement gouverné par l'appartenance (ConversationMember), pas par un
// scope RBAC : on ne voit que les conversations dont on est membre.

enum ConversationType {
  DIRECT // tête-à-tête (1-1)
  GROUP // groupe privé multi-personnes
  CHANNEL // canal d'équipe (découvrable, on le rejoint)
}

enum ConvMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ConvNotifyLevel {
  ALL // notifier chaque message
  MENTIONS // notifier uniquement quand on est mentionné
  NONE // ne jamais notifier
}

enum MessageKind {
  TEXT
  SYSTEM // « X a créé le groupe », « Y a rejoint le canal »…
  FILE // message ne portant que des pièces jointes
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType @default(DIRECT)
  title       String? // nom (groupes & canaux)
  description String? // sujet / objet (canaux)
  color       String? // accent visuel de l'avatar
  icon        String? // icône lucide (canaux)
  isArchived  Boolean          @default(false)
  // « Tout est relié » : une conversation peut être rattachée à un objet de l'OS
  // (dossier réglementaire, marché PCH, congrès…) pour discuter en contexte.
  refType     EntityType?
  refId       String?

  createdById   String?
  createdBy     User?    @relation("ConvCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
  @@index([lastMessageAt])
  @@index([refType, refId])
}

model ConversationMember {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation("ConvMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role           ConvMemberRole  @default(MEMBER)
  notifyLevel    ConvNotifyLevel @default(ALL)
  isPinned       Boolean         @default(false) // épinglée en haut de la liste perso
  isMuted        Boolean         @default(false)
  lastReadAt     DateTime? // accusé de lecture → compteur de non-lus
  joinedAt       DateTime        @default(now())
  leftAt         DateTime? // quitté le canal/groupe (historique conservé)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  kind           MessageKind  @default(TEXT)
  body           String       @db.Text

  // Fils de discussion : une réponse pointe vers son message parent.
  parentId String?
  parent   Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Message[] @relation("MessageReplies")

  isPinned Boolean @default(false)

  // Partage d'un objet de l'OS directement dans un message.
  refType  EntityType?
  refId    String?
  refLabel String?

  editedAt  DateTime?
  deletedAt DateTime? // suppression douce → « message supprimé »
  createdAt DateTime  @default(now())

  reactions   MessageReaction[]
  attachments MessageAttachment[]
  mentions    MessageMention[]
  bookmarks   MessageBookmark[]

  @@index([conversationId, createdAt])
  @@index([parentId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// Pièce jointe d'un message — de DEUX natures, jamais des deux à la fois.
///   • `blobId` renseigné : fichier TÉLÉVERSÉ, contenu chiffré adressé par contenu (réutilise le
///     stockage du Drive). C'est une copie, figée à l'instant de l'envoi.
///   • `driveNodeId` renseigné : RÉFÉRENCE à un nœud du Drive — rien n'est recopié, et les
///     destinataires reçoivent un DriveShare en lecture. Le document reste celui du Drive, avec
///     ses versions ; recopier un contrat à chaque conversation multiplierait le stockage ET
///     figerait une version dont personne ne saurait, six mois plus tard, si elle fait foi.
/// Voir `lib/messaging-attachments.ts` pour les règles.
model MessageAttachment {
  id          String     @id @default(cuid())
  messageId   String
  message     Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  blobId      String? // FileBlob chiffré — null quand la pièce est une référence au Drive
  driveNodeId String? // nœud du Drive référencé — null quand le fichier a été téléversé
  driveNode   DriveNode? @relation("MessageDriveRef", fields: [driveNodeId], references: [id], onDelete: SetNull)
  /// Vrai quand la référence désigne un DOSSIER : il ne s'aperçoit ni ne se télécharge, il se navigue.
  isFolder    Boolean    @default(false)
  name        String
  mime        String
  size        Int
  createdAt   DateTime   @default(now())

  @@index([messageId])
  @@index([driveNodeId])
}

model MessageMention {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("MentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageBookmark {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("BookmarkUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

// ─────────────────────────── Rapports terrain vocaux ───────────────────────────
// Le délégué parle ; l'audio est transcrit (Whisper) puis structuré par l'IA en un
// rapport de visite. L'IA ne valide JAMAIS seule : le délégué relit, corrige,
// ajoute des pièces jointes, puis valide. Une fois validé, le rapport alimente les
// vues Direction / Chef de produit / Promotion médicale / Process Intelligence.

enum FieldReportStatus {
  DRAFT // brouillon (transcrit / analysé, en attente de relecture)
  VALIDATED // validé par le délégué
  ARCHIVED
}

model FieldReport {
  id         String            @id @default(cuid())
  companyId  String? // entité de rattachement (Adventum / Pharmagène / …)
  company    Company?          @relation(fields: [companyId], references: [id])
  delegateId String?
  delegate   User?             @relation("FieldReportDelegate", fields: [delegateId], references: [id], onDelete: SetNull)
  status     FieldReportStatus @default(DRAFT)
  visitDate  DateTime          @default(now())

  transcript  String? // transcription brute (Whisper) ou saisie manuelle
  audioBlobId String? // audio chiffré (optionnel)

  // Identité de la visite. doctorId = médecin principal (compat) ; doctorIds = tous les
  // médecins de la visite (un compte rendu peut concerner plusieurs praticiens).
  doctorId          String?
  doctor            MedicalDoctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  doctorIds         String[]       @default([]) // médecins (annuaire) rattachés à la visite
  doctorName        String? // nom tel que dicté (si non rattaché)
  institution       String?
  specialty         String?
  // Anciens champs structurés (IA) — conservés pour l'historique, plus alimentés.
  products          String? // produits discutés
  interest          String? // intérêt du médecin
  objection         String?
  medicalQuestion   String?
  documentRequest   String?
  sponsoringRequest String?
  careRequest       String? // demande de prise en charge / congrès
  competitorInfo    String?
  opportunity       String?
  qualitySignal     String? // qualité / pharmacovigilance (à confirmer)
  nextAction        String?
  summary           String? // compte rendu synthétique
  aiNotes           String? // éléments « à confirmer » signalés par l'IA

  validatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attachments FieldReportAttachment[]

  /// LA VISITE QUE CE RAPPORT DOCUMENTE.
  ///
  /// Elle manquait : un rapport vocal et la visite planifiée qu'il raconte vivaient en deux
  /// lignes sans lien, donc l'emploi du temps du KAM ne pouvait pas passer au VERT sur un
  /// rapport dicté — la seule façon de « faire » sa visite était de la saisir en écrit. Le
  /// rapport reste un objet À PART (transcription, audio, analyse, sa propre validation) : on
  /// ajoute le lien, on ne fond pas les deux (§118.5).
  visitId String?
  visit   MedicalVisit?        @relation("FieldReportVisit", fields: [visitId], references: [id], onDelete: SetNull)
  /// Le matériel promotionnel déclaré remis dans ce compte rendu (§118.204).
  remises PromoStockMovement[] @relation("PromoRemiseRapport")

  @@index([visitId])
  @@index([delegateId])
  @@index([status])
  @@index([doctorId])
  @@index([visitDate])
  @@index([companyId])
}

model FieldReportAttachment {
  id        String      @id @default(cuid())
  reportId  String
  report    FieldReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  blobId    String
  name      String
  mime      String
  size      Int
  createdAt DateTime    @default(now())

  @@index([reportId])
}

// ─────────────────────────── Pharmacovigilance (Direction, 06/10) ───────────────────────────
// Le KAM SIGNALE un cas depuis les Rapports terrain (produit, établissement, date, ce qui s'est
// passé) ; Regulatory le REÇOIT, l'analyse, ouvre au besoin une enquête approfondie et le clôt. Un
// fil d'échange (Comment, entityType PHARMACOVIGILANCE_CASE) relie le KAM, Regulatory et les
// personnes ajoutées. Aucune donnée identifiante du patient : âge et sexe seulement, facultatifs.

enum PvCaseStatus {
  RECU // signalé, pas encore pris en charge
  EN_ANALYSE // Regulatory l'instruit
  ENQUETE // enquête approfondie : des informations complémentaires sont demandées
  CLOS // clos, avec sa note de clôture
}

enum PvSeverity {
  NON_GRAVE
  GRAVE
  DECES
  INCONNU
}

model PharmacovigilanceCase {
  id         String       @id @default(cuid())
  /// PV-AAAA-NNN
  reference  String       @unique
  reporterId String // le KAM qui signale
  status     PvCaseStatus @default(RECU)

  /// Le produit choisi dans le catalogue des BU (`PromoProduct`) et son canonique quand il est connu ;
  /// le LIBELLÉ est un instantané : un produit renommé ou archivé ne réécrit pas un signalement.
  promoProductId  String?
  productId       String?
  productLabel    String
  /// L'établissement de l'annuaire (`MedicalInstitution`) et son nom au jour du signalement.
  institutionId   String?
  institutionName String
  doctorName      String? // médecin concerné (facultatif, texte)
  occurredOn      DateTime // date de survenue
  description     String // ce qui s'est passé
  patientAge      Int?
  patientSex      String? // "F" | "M"
  severity        PvSeverity?

  // Enquête approfondie
  investigationOpenedAt   DateTime?
  investigationOpenedById String?
  requestedInfo           String? // informations complémentaires demandées au KAM

  // Clôture
  closedAt    DateTime?
  closedById  String?
  closingNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants PharmacovigilanceParticipant[]

  @@index([reporterId])
  @@index([status])
  @@index([occurredOn])
  @@index([promoProductId])
}

/// Une personne ajoutée à l'échange d'un cas : elle lit le cas et prend part à la conversation.
model PharmacovigilanceParticipant {
  id        String                @id @default(cuid())
  caseId    String
  case      PharmacovigilanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String
  addedById String?
  createdAt DateTime              @default(now())

  @@unique([caseId, userId])
  @@index([userId])
}

// ─────────────────────────── Retours & réclamations (Operations & Sales) ───────────────────────────
// Un RETOUR de marchandise, une RÉCLAMATION QUALITÉ ou un RAPPEL DE LOT : le produit (catalogue des BU), le lot, la
// quantité, l'établissement et/ou le site PCH (DR / annexe), ce qui s'est passé. Statut OUVERTE → EN_ANALYSE → CLOTUREE
// (avec sa conclusion). Le fil d'échange est un `Comment` (entityType RECLAMATION), les pièces des `Document`. Comme la
// pharmacovigilance : aucune relation dure — les libellés sont des instantanés, un produit renommé ne réécrit rien.
// module retiré le 09/10/2026, table conservée
model Reclamation {
  id              String    @id @default(cuid())
  /// REC-AAAA-NNN
  reference       String    @unique
  /// RETOUR | RECLAMATION_QUALITE | RAPPEL_LOT
  type            String
  /// OUVERTE | EN_ANALYSE | CLOTUREE
  status          String    @default("OUVERTE")
  promoProductId  String?
  productId       String?
  productLabel    String
  /// La BU du produit au jour de la déclaration — le filtre « par BU ».
  businessUnitId  String?
  lot             String?
  quantity        Int?
  institutionId   String?
  institutionName String?
  /// Le site PCH concerné (direction régionale, annexe) — texte libre.
  pchSite         String?
  occurredOn      DateTime?
  description     String
  conclusion      String?
  /// Le cas de pharmacovigilance lié, quand la réclamation en relève.
  pvCaseId        String?
  declaredById    String
  /// LE RESPONSABLE — celui qui est prévenu et qui instruit.
  ownerId         String?
  analysedAt      DateTime?
  closedAt        DateTime?
  closedById      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([businessUnitId])
  @@index([declaredById])
  @@index([ownerId])
  @@index([createdAt])
}

// ─────────────────────────── Module Events / Billetterie ───────────────────────────
// Gestion de bout en bout des événements (congrès, séminaires, staffs, webinars…) :
// inscriptions (formulaire public + lien), QR code par participant, check-in,
// présence et statistiques. Relié à Promotion médicale, budgets et sponsoring.

enum EventType {
  CONGRESS
  SEMINAR
  ROUND_TABLE
  HOSPITAL_STAFF
  SYMPOSIUM
  WEBINAR
  TRAINING
  SCIENTIFIC_DAY
  OTHER
}

enum EventScope {
  NATIONAL
  INTERNATIONAL
}

enum EventFormat {
  PRESENTIAL
  WEBINAR
  HYBRID
}

enum EventStatus {
  DRAFT
  AWAITING_VALIDATION
  VALIDATED
  PREPARATION
  REGISTRATION_OPEN
  FULL
  COMPLETED
  CANCELLED
}

enum ParticipantRole {
  DOCTOR
  PROFESSOR
  HEAD_OF_SERVICE
  PHARMACIST
  OTHER
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  PENDING
  REJECTED
  PRESENT
  ABSENT
  CANCELLED
}

model Event {
  /// LA BUSINESS UNIT qui porte cette demande — c'est SON budget Ad&Pro qui est engagé.
  /// Sans elle, la dépense pesait sur un total commercial que personne ne pouvait
  /// répartir : « combien la gamme oncologie a-t-elle dépensé ? » n'avait pas de réponse.
  businessUnitId  String?
  businessUnit    BusinessUnit? @relation("AdProEvent", fields: [businessUnitId], references: [id], onDelete: SetNull)
  id              String        @id @default(cuid())
  companyId       String? // entité de rattachement (Adventum / Pharmagène / …)
  company         Company?      @relation(fields: [companyId], references: [id])
  name            String
  type            EventType     @default(CONGRESS)
  scope           EventScope    @default(NATIONAL)
  format          EventFormat   @default(PRESENTIAL)
  status          EventStatus   @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  location        String?
  city            String?
  country         String?
  specialty       String?
  products        String?
  /// LES PRATICIENS CONCERNÉS — noms joints, choisis dans l'annuaire (`ad-pro/pickers.ts`).
  /// Même convention que `SponsoringRequest.doctor` : la valeur vient du référentiel, la colonne
  /// reste un TEXTE parce que la liste, la fiche, l'ordre de dépense, la notification et l'export
  /// la lisent tous comme tel. Porter deux conventions dans le même pôle les ferait diverger.
  doctor          String?
  description     String?
  /// PLUS ÉCRITE (Direction, 27/10) : les événements Ad & Pro sont externes — ni capacité ni liste d'attente.
  /// La colonne reste pour l'historique.
  capacity        Int?
  /// QUI ORGANISE l'événement (société savante, hôpital, laboratoire…) — un événement Ad & Pro est EXTERNE.
  organizer       String?
  estimatedBudget Decimal?      @db.Decimal(14, 2)
  meetingLink     String? // lien Meet / Zoom / Teams (manuel)
  responsibleId   String?
  responsible     User?         @relation("EventResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  participantIds  String[]      @default([]) // participants Adventum (users)

  // ─── Demande de prise en charge (circuit identique aux congrès, règle du 27/10/2026) ───
  // Événements pharma/scientifiques EXTERNES. requestStatus = null → né hors circuit : ni poste ni paiement
  // tant qu'il n'est pas prévalidé. Soumis : N+1 → Directeur des opérations → Direction Marketing (prévalidation,
  // requestStatus APPROVED), puis postes, puis le DG sur le total au-dessus du seuil (`AdProPorteDg`).
  requesterId          String?
  requestStatus        CongressRequestStatus?
  productManagerId     String?
  productManagerBudget Decimal?               @db.Decimal(14, 2)
  productManagerNotes  String?
  preliminaryById      String?
  preliminaryAt        DateTime?
  preliminaryNote      String?
  finalById            String?
  finalAt              DateTime?
  finalNote            String?
  finalAmount          Decimal?               @db.Decimal(14, 2)
  rejectionReason      String?
  expenseOrderId       String?

  registrations EventRegistration[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Postes (consulting, traiteur, salle…) validés un par un — voir AdProItem.
  items AdProItem[]

  @@index([status])
  @@index([startDate])
  @@index([type])
  @@index([companyId])
}

model EventRegistration {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  specialty   String?
  institution String?
  city        String?
  email       String?
  phone       String?
  role        ParticipantRole    @default(DOCTOR)
  comment     String?
  status      RegistrationStatus @default(REGISTERED)
  qrToken     String             @unique @default(cuid()) // jeton unique pour le QR / check-in
  checkedInAt DateTime?
  source      String? // "public" (formulaire) ou "internal"
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([eventId])
  @@index([status])
}

/// Accompagnant ou délégué de référence assigné à un congrès (national/international),
/// un événement ou un sponsoring. La personne assignée peut **demander** un ordre de
/// mission, et le responsable peut lui en **émettre** un. Pièces (ordre de mission) et
/// discussions vivent sur l'entité polymorphe MISSION_ASSIGNMENT (Document/Comment).
enum MissionRole {
  ACCOMPAGNANT // accompagnant
  DELEGATE_REFERENCE // délégué de référence
}

enum MissionOrderStatus {
  NONE // assigné, pas d'ordre de mission
  REQUESTED // l'assigné a demandé un ordre de mission
  ISSUED // le responsable a émis l'ordre de mission
}

/// LA RÉPONSE DE LA PERSONNE ASSIGNÉE (missions reliées au profil, Direction 10/2026) : une
/// assignation est une INVITATION — rien ne se demande avant « Je confirme ». Les assignations
/// d'avant cette règle valent CONFIRMEE (acceptées implicitement).
enum MissionResponse {
  INVITEE
  CONFIRMEE
  DECLINEE
}

model MissionAssignment {
  id          String             @id @default(cuid())
  entityType  EntityType // CONGRESS_NATIONAL | CONGRESS_INTERNATIONAL | EVENT | SPONSORING
  entityId    String
  userId      String
  user        User               @relation("MissionAssignee", fields: [userId], references: [id], onDelete: Cascade)
  role        MissionRole        @default(ACCOMPAGNANT)
  orderStatus MissionOrderStatus @default(NONE)
  requestedAt DateTime?
  issuedAt    DateTime?
  issuedById  String?
  note        String? // précision (mission, ville, dates…)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  /// Réponse à l'invitation — un refus porte son motif (l'organisateur doit pouvoir remplacer).
  response           MissionResponse @default(INVITEE)
  respondedAt        DateTime?
  declineReason      String?
  /// Relances de l'organisateur (règle des tâches : quatre heures entre deux).
  lastNudgeAt        DateTime?
  nudgeCount         Int             @default(0)
  /// Dates et ville PROPRES à la mission — reprises de la demande Ad & Pro, modifiables. Le
  /// sponsoring n'a pas de dates : c'est ici qu'il en prend, pour paraître aux calendriers.
  dateDepart         DateTime?
  dateRetour         DateTime?
  ville              String?
  /// Étapes facultatives AJOUTÉES par la personne (« ⋯ › Ajouter ») : TRANSPORT, HEBERGEMENT,
  /// MATERIEL, NOTE_FRAIS. Une étape absente ne s'affiche pas (Direction, 10/2026).
  etapes             String[]        @default([])
  /// Retrait SOUPLE : une assignation qui porte des pièces, un fil ou des demandes s'archive.
  archivedAt         DateTime?
  archivedById       String?
  /// Frais de l'équipe intégrés au budget à la clôture : depuis 10/2026 l'id d'une ligne `BudgetExpenseLine` du budget
  /// Operations & Sales ; avant, l'id d'un poste Ad & Pro créé à la main (historique, laissé tel quel).
  transportPosteId   String?
  hebergementPosteId String?

  /// LA DEMANDE DE PARTICIPATION (Direction, 10/2026) — la personne répond par sa fiche ; chaque proposition
  /// ou contre-proposition est une VERSION (`MissionParticipationVersion`). L'accord pointe la version retenue.
  versions              MissionParticipationVersion[]
  accordVersionId       String?
  accordAt              DateTime?
  /// LE BILLET ÉMIS quand Adventum réserve (assistante de direction, organisateur, Direction Marketing, Super
  /// Admin) : e-billet, PNR, et pour l'aller puis le retour le n° de vol / train et les heures (`DetailTrajet[]`).
  billetDocumentId      String?
  billetReference       String?
  billetTrajets         Json?
  billetDeposeParId     String?
  billetDeposeLe        DateTime?
  /// LA CONFIRMATION D'HÔTEL : voucher, nom de l'hôtel, n° de confirmation.
  hotelNom              String?
  hotelConfirmation     String?
  hotelDocumentId       String?
  hotelDeposeParId      String?
  hotelDeposeLe         DateTime?
  /// Le sujet de l'assistante de direction qui réserve pour l'équipe (un par demande, partagé par ses membres).
  reservationDossierId  String?
  reservationDemandeeLe DateTime?
  /// L'IMPUTATION des frais de mission (`BudgetCategoryLine`) — au budget Operations & Sales depuis 10/2026 : catégorie par
  /// défaut posée d'office (`budgetChoisiParId` nul), changeable par la Direction ; une ancienne ligne Ad & Pro reste telle quelle.
  budgetCategoryId      String?
  budgetChoisiParId     String?
  budgetChoisiLe        DateTime?
  /// LE RAPPORT DE MISSION — envoyé à l'organisateur à la clôture.
  rapportDeroule        String?
  rapportMedecins       String?
  rapportRetombees      String?
  rapportSuites         String?
  rapportLe             DateTime?
  /// LA CLÔTURE — les notes de frais partent au N+1 puis aux RH (`noteFraisRequestId`), le rapport à l'organisateur.
  clotureLe             DateTime?
  clotureParId          String?
  noteFraisRequestId    String?
  frais                 MissionExpenseLine[]

  @@unique([entityType, entityId, userId])
  @@index([userId])
  @@index([entityType, entityId])
}

/// UNE VERSION DE LA FICHE DE PARTICIPATION — proposition de la personne ou contre-proposition d'Adventum
/// (organisateur, Direction Marketing, Super Admin). `contenu` = la fiche (`FicheParticipation`, missions-equipe/
/// participation.ts). Son sort s'écrit sur elle : EN_ATTENTE, ACCEPTEE, REFUSEE (motif) ou REMPLACEE (contre-proposée).
model MissionParticipationVersion {
  id            String            @id @default(cuid())
  assignmentId  String
  assignment    MissionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  numero        Int
  auteurId      String
  cote          String // PERSONNE | ADVENTUM
  nature        String // PROPOSITION | CONTRE_PROPOSITION
  contenu       Json
  motif         String?
  statut        String            @default("EN_ATTENTE")
  decideParId   String?
  decideLe      DateTime?
  motifDecision String?
  createdAt     DateTime          @default(now())

  @@unique([assignmentId, numero])
}

/// UNE DÉPENSE DE MISSION (note de frais d'un membre de l'équipe) — à l'international, tout sauf le billet se
/// saisit en USD et entre à `montant × usdDzdRate` de la demande (240 par défaut).
model MissionExpenseLine {
  id           String            @id @default(cuid())
  assignmentId String
  assignment   MissionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  date         DateTime
  nature       String // TRANSPORT | TAXI | REPAS | HOTEL | AUTRE
  detail       String?
  amount       Decimal           @db.Decimal(14, 2)
  currency     CareCurrency      @default(DZD)
  amountDzd    Decimal?          @db.Decimal(14, 2)
  documentId   String?
  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([assignmentId])
}

/// Anti-bruteforce / anti-credential-stuffing : suivi des tentatives de connexion
/// échouées par identifiant (fenêtre glissante). Verrouillage temporaire après N
/// échecs, réinitialisé à la première connexion réussie. Durée de blocage
/// croissante en cas d'acharnement. Clé = e-mail tenté (en minuscules).
model LoginAttempt {
  id          String    @id @default(cuid())
  email       String    @unique
  ipAddress   String? // dernière IP observée (indicatif, journalisation)
  failures    Int       @default(0)
  lockedUntil DateTime?
  lastAttempt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ipAddress])
  @@index([lockedUntil])
}

/// Centre de contrôle IA (réglages globaux, Super Admin uniquement). Une seule
/// ligne (`id = "global"`). Permet d'activer/couper l'IA globalement ou par
/// fonction sans toucher au code ni aux variables d'environnement.
/// Configuration personnalisée de l'Assistant IA par rôle métier (Jalon 4 — Décision Q4/Q12).
/// Le RBAC reste le plafond indépassable. Une valeur absente retombe sur le comportement par défaut.
model AssistantRoleConfig {
  role               UserRole                   @id
  assistantName      String?
  tone               String?
  customInstructions String?                    @db.VarChar(2000)
  allowedTools       String[]                   @default([])
  confirmationLevel  String                     @default("CRITIQUE")
  enforcedModel      String?
  updatedAt          DateTime                   @updatedAt
  updatedById        String?
  updatedBy          User?                      @relation("AssistantRoleConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  audits             AssistantRoleConfigAudit[] @relation("RoleConfigAudits")
}

/// Traçabilité des modifications des configurations de rôle de l'Assistant IA (qui, quand, avant/après).
model AssistantRoleConfigAudit {
  id           String              @id @default(cuid())
  role         UserRole
  roleConfig   AssistantRoleConfig @relation("RoleConfigAudits", fields: [role], references: [role], onDelete: Cascade)
  actorId      String
  actor        User                @relation("AssistantRoleConfigAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  previousData Json?
  newData      Json
  createdAt    DateTime            @default(now())

  @@index([role, createdAt])
  @@index([actorId])
}

model AiSetting {
  id                     String   @id @default("global")
  masterEnabled          Boolean  @default(true) // interrupteur général
  assistantEnabled       Boolean  @default(true) // chatbot + bulle flottante
  proactiveNudgesEnabled Boolean  @default(true) // suggestions proactives
  brainEnabled           Boolean  @default(true) // Adventum Brain (synthèse, copilote)
  processIntelEnabled    Boolean  @default(true) // Process Intelligence
  fieldReportAiEnabled   Boolean  @default(true) // analyse IA des rapports terrain
  voiceTranscriptEnabled Boolean  @default(true) // transcription vocale (Whisper)
  siteWebAiEnabled       Boolean  @default(true) // « Rédiger avec l'IA » — articles et offres du site (§118.160)
  /// Lecture des LIGNES d'une pièce commerciale par un modèle (lot D2). COUPÉE par défaut : elle a un coût, et la
  /// lecture locale (texte natif, OCR sur ce serveur, en-têtes et totaux repérés) suffit à proposer sans rien envoyer.
  lecturePiecesEnabled   Boolean  @default(false)
  /// Luna CONSEILLE où ranger une pièce déposée sur une demande Ad & Pro — consultatif, aucune écriture : allumé par défaut.
  conseilPiecesEnabled   Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  updatedById            String?
}

/// LES BORNES DE L'ASSISTANT IA (lot V3-D, audit 27/10 rapport 06) — UNE ligne (`id = "global"`),
/// réglée par le Super Admin (Administration › Consommation IA). Sans ligne : les défauts ci-dessous,
/// les mêmes que dans `agent/consommation-regles.ts`. Lue par `agent/consommation.ts`.
model AssistantIaReglage {
  id                     String   @id @default("global")
  /// Jetons (entrée + sortie) par personne et par jour, heure d'Alger. Atteint : refus dit, avis au Super Admin.
  plafondJetonsJour      Int      @default(600000)
  /// Jetons d'UN tour (toutes ses étapes, résumés de documents compris) : au-delà, le tour s'arrête et le dit.
  plafondJetonsTour      Int      @default(150000)
  /// Étapes (appels du modèle) d'un tour, au plus — plafonne aussi les tours en arrière-plan (24 avant).
  etapesMaxTour          Int      @default(12)
  /// Décision IA-ASSISTANT-09 : le message saisi et l'historique passent le filtre de confidentialité.
  censurerSaisie         Boolean  @default(true)
  /// Décision IA-ASSISTANT-10 : une carte dont la personne vient de reparler est retirée avant le tour.
  retirerCartesCaduques  Boolean  @default(true)
  /// IA-ASSISTANT-07 : une carte non confirmée expire après ce délai (heures).
  expirationCartesHeures Int      @default(24)
  updatedAt              DateTime @default(now()) @updatedAt
  updatedById            String?
}

/// LE PLAFOND DU JOUR FRANCHI — une ligne par personne et par jour : la clé unique fait qu'un seul
/// avis part au Super Admin, même quand deux tours le franchissent en même temps.
model AssistantIaPlafondAtteint {
  id        String   @id @default(cuid())
  userId    String
  jour      DateTime @db.Date
  jetons    Int
  plafond   Int
  createdAt DateTime @default(now())

  @@unique([userId, jour])
}

/// Seuils de déclenchement du Risk Radar (Adventum Brain), ajustables par le
/// Super Admin. Une seule ligne (`id = "global"`). Les détecteurs lisent ces
/// valeurs ; en l'absence de ligne, des valeurs par défaut s'appliquent.
model RiskSetting {
  id                         String   @id @default("global")
  pchCautionWarnDays         Int      @default(30)
  congressStaleDays          Int      @default(4)
  sponsoringStaleDays        Int      @default(4)
  expenseStaleDays           Int      @default(7)
  budgetWarnPct              Int      @default(85)
  kolVisitStaleDays          Int      @default(60)
  medicalInfoStaleDays       Int      @default(5)
  silentSupplierDays         Int      @default(14)
  stockLowThreshold          Int      @default(10)
  deliveryGraceDays          Int      @default(3)
  eventHorizonDays           Int      @default(7)
  eventMinAttendance         Int      @default(5)
  /// Détecteurs ajoutés avec la refonte d'Adventum Brain (07/10) — voir `lib/adventum/risks-plus.ts`.
  recruitmentUnpublishedDays Int      @default(3)
  fieldCoverageMinPct        Int      @default(50)
  adproCdMaxPct              Int      @default(25)
  bcUnsignedDays             Int      @default(5)
  tourPlanLeadDays           Int      @default(3)
  aiCostDriftPct             Int      @default(50)
  processStuckDays           Int      @default(14)
  updatedAt                  DateTime @updatedAt
  updatedById                String?
}

/// Adventum Pulse — instantané périodique (au plus 1×/h) de l'état d'intelligence de la société :
/// agrégats du Risk Radar (Adventum Brain) + de Process Intelligence. Persisté pour l'analyse EN
/// CONTINU : tendances (deltas, courbe) affichées dans les cockpits, et alertes PROACTIVES (nouveau
/// risque critique) envoyées au Super Admin même si personne n'ouvre le module. Calculé sur des
/// données réelles, sans IA. Le champ `bucket` (« YYYY-MM-DDTHH ») sert de verrou : un seul
/// instantané par heure, y compris sous concurrence (contrainte d'unicité).
model IntelligenceSnapshot {
  id                 String   @id @default(cuid())
  bucket             String   @unique
  createdAt          DateTime @default(now())
  riskCritical       Int      @default(0)
  riskHigh           Int      @default(0)
  riskMedium         Int      @default(0)
  riskLow            Int      @default(0)
  riskTotal          Int      @default(0)
  inProgress         Int      @default(0)
  stuck              Int      @default(0)
  overdue            Int      @default(0)
  validationsPending Int      @default(0)
  detail             Json? /// { byCategory: {CAT: n}, criticalIds: [id], topRisks: [{id,level,module,title,object,href}] }

  @@index([createdAt])
}

/// UN RISQUE QUI A UNE VIE (Adventum Brain, refonte 07/10). Le Risk Radar recalcule les risques chaque
/// heure ; cette table les fait DURER : la clé stable (détecteur + objet) relie le risque d'une heure à
/// celui de l'heure suivante. NOUVEAU → PRIS_EN_CHARGE (une tâche, une personne) → RESOLU (le détecteur
/// ne le voit plus, ou une personne l'a dit) ; IGNORE jusqu'à une date (`snoozedUntil`, motif dans `note`).
/// Un risque résolu qui réapparaît repasse NOUVEAU. Réconciliation pure : `lib/adventum/lifecycle.ts`.
model BrainRisk {
  id             String    @id @default(cuid())
  key            String    @unique
  category       String
  module         String
  level          String // critical | high | medium | low
  title          String
  object         String
  owner          String
  href           String?
  /// Le dernier calcul du détecteur : preuves, cause, impact, recommandation, gestes proposés.
  detail         Json
  recommendation String
  status         String    @default("NOUVEAU") // NOUVEAU | PRIS_EN_CHARGE | RESOLU | IGNORE
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  snoozedUntil   DateTime?
  assigneeId     String?
  taskId         String?
  resolvedAt     DateTime?
  /// Vrai quand la résolution vient du détecteur (il ne le voit plus) et non d'une personne.
  resolvedAuto   Boolean   @default(false)
  note           String?
  /// L'histoire du risque : `[{ at, kind, by, note }]` — apparu, pris en charge, relancé, ignoré, résolu, réapparu.
  history        Json      @default("[]")
  updatedAt      DateTime  @updatedAt

  @@index([status, level])
  @@index([lastSeenAt])
}

/// LE BRIEFING DU MATIN, GARDÉ — un par jour (heure d'Alger). Généré à 7 h par le planificateur (ou à la
/// demande), chaque phrase cite ses sources (`content.paragraphs[].sentences[].refs` → risques connus).
/// `source` dit qui l'a écrit : « ia » (modèle, coût dans `costUsd`) ou « regles » (repli déterministe).
model BrainBriefing {
  id            String   @id @default(cuid())
  day           String   @unique // YYYY-MM-DD, heure d'Alger
  content       Json
  risks         Json /// instantané des risques cités (clé, titre, module, lien)
  source        String   @default("regles")
  model         String?
  costUsd       Decimal? @db.Decimal(12, 6)
  error         String?
  generatedById String?
  generatedAt   DateTime @default(now())

  @@index([generatedAt])
}

/// UNE QUESTION POSÉE À ADVENTUM BRAIN, et sa réponse — avec ses sources et les gestes proposés.
model BrainQuestion {
  id        String   @id @default(cuid())
  userId    String
  question  String
  answer    String
  ok        Boolean  @default(true)
  sources   Json     @default("[]")
  proposals Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// LE DÉLAI CIBLE D'UNE ÉTAPE DE CIRCUIT (Process Intelligence). Au-delà, le dossier est « bloqué » et
/// Adventum Brain le signale. `circuit` + `stepKey` sont ceux de `lib/process/mining.ts`.
model ProcessStepSla {
  id          String   @id @default(cuid())
  circuit     String
  stepKey     String
  stepLabel   String
  targetDays  Int
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([circuit, stepKey])
}

/// Réglage du score d'adoption — **poids** de chaque dimension et **seuils** de
/// libellé, définis librement par le Super Admin. Le score reste calculé sur des
/// données réelles ; ces valeurs ne font que pondérer/segmenter le résultat.
/// Valeurs par défaut (en code) si la ligne n'existe pas encore.
model AdoptionSetting {
  id             String   @id @default("global")
  wRegularity    Int      @default(22)
  wTime          Int      @default(10)
  wBreadth       Int      @default(15)
  wDiversity     Int      @default(12)
  wDurable       Int      @default(15)
  wInteraction   Int      @default(18)
  wRecency       Int      @default(8)
  wCycle         Int      @default(12) // temps de cycle : vitesse à traiter les éléments qui vous incombent (pas le volume de clics)
  tChampion      Int      @default(80)
  tActive        Int      @default(60)
  tModerate      Int      @default(40)
  tWeak          Int      @default(20)
  // Cibles « 100 % » par dimension (réglables par le Super Admin) : combien d'heures /
  // d'actions / de jours sont nécessaires pour atteindre le plein sous-score.
  tgtActiveDays  Int      @default(18) // jours actifs (sur 30) pour 100 % de régularité
  tgtTimeHours   Int      @default(10) // heures d'activité (premier plan) pour 100 % de temps
  tgtDiversity   Int      @default(8) // types d'actions distincts pour 100 % de diversité
  tgtDurable     Int      @default(12) // contributions abouties pour 100 % de travail durable
  tgtInteraction Int      @default(40) // points d'interaction pour 100 % d'interaction
  tgtModules     Int      @default(0) // modules utilisés pour 100 % d'étendue (0 = auto par rôle)
  tgtCycleHours  Int      @default(48) // délai médian (h) entre l'arrivée d'un élément et son traitement, pour 100 % (plus rapide = mieux)
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

/// Historique quotidien du score d'adoption (un instantané par utilisateur et par
/// jour). Persisté en backend pour rendre l'évolution **visible** : le score monte
/// ET descend selon l'usage réel sur la fenêtre glissante de 30 jours. Sert aux
/// graphiques d'évolution (moyenne d'équipe + courbe individuelle) et au calcul de
/// la tendance (delta vs jours précédents). Calculé sur données réelles, jamais simulé.
model AdoptionSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date // un instantané par jour
  score      Int
  activeDays Int      @default(0)
  components Json? // détail des sous-scores (pour l'historique fin)
  createdAt  DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}

/// Fichiers des **documents** (modèle Document, hors Drive) stockés de façon
/// **durable** : le contenu vit dans `FileBlob` (chiffré, dédupliqué, en base),
/// ce qui survit aux redéploiements (le disque local de Render est éphémère).
/// `key` = clé opaque portée par `Document.fileKey`.
model StoredFile {
  key       String   @id
  blobId    String
  size      Float // Float : un document va jusqu'à 10 Go (un entier 32 bits plafonne à 2 Go)
  createdAt DateTime @default(now())

  @@index([blobId])
}

/// Réglages d'instance modifiables par le Super Admin (limites de taille d'upload, etc.).
/// Ligne unique « global » ; valeurs par défaut (en code) si absente.
/// Corbeille des suppressions définitives (Super Admin) : chaque suppression
/// « définitive » y dépose un instantané (ligne principale + pièces + commentaires)
/// restaurable, jusqu'à destruction réelle. Visible du Super Admin uniquement.
model DeletedRecord {
  id          String    @id @default(cuid())
  kind        String // type du registre (EMPLOYEE, SPONSORING, HR_REQUEST…)
  label       String // libellé lisible du type (« demande RH »)
  name        String // nom lisible de l'élément supprimé
  sourceId    String // id d'origine de la ligne supprimée
  payload     Json // ligne principale complète (scalaires)
  documents   Json? // pièces jointes polymorphes (métadonnées, fichiers conservés)
  comments    Json? // commentaires polymorphes
  /// LE LOT (§118.162) — les BRANCHES parties avec l'élément (sa déclaration d'information
  /// médicale, ses demandes au secrétariat, son circuit, ses postes…), parents d'abord, et les
  /// liens extérieurs à rétablir. Nul : l'élément est parti seul, comme avant.
  lot         Json?
  deletedById String?
  deletedAt   DateTime  @default(now())
  restoredAt  DateTime? // restauré (l'entrée reste pour l'historique)
  purgedAt    DateTime? // détruit réellement (fichiers effacés)

  @@index([kind])
  @@index([deletedAt])
}

model AppSetting {
  id                            String    @id @default("global")
  /// ARRÊT D'URGENCE DES ACTIONS EXTERNES DE L'IA. Vrai = plus AUCUNE action de l'assistant qui
  /// touche le monde réel (messages, e-mails, tâches pour autrui, mutations métier, relances
  /// planifiées) — même confirmée. Les lectures, analyses et rappels pour soi continuent.
  /// Réglé par le Super Admin (écran Réglages ou update_platform_setting).
  aiExternalActionsDisabled     Boolean   @default(false)
  /// SUSPENSION GLOBALE DES MISSIONS D'ADAM (§118.132). Vrai = AUCUNE mission d'exécution
  /// n'avance, ne se replanifie, ne se lance ni ne notifie — pour tout le monde, jusqu'à la
  /// levée. Ce n'est pas `PAUSED` posé sur chaque mission : c'est un interrupteur du MOTEUR,
  /// lu par le moteur lui-même, le battement, le pilote d'horizon et le lancement. Levé, les
  /// missions repartent exactement où elles en étaient — rien n'a été touché.
  /// Posé depuis l'écran des réglages d'Adam ou par le geste RÉDUCTEUR de `mission_control` ;
  /// LEVÉ depuis l'écran seulement (§118.15 : Adam ne relève pas ses propres barrières).
  missionsPaused                Boolean   @default(false)
  missionsPausedAt              DateTime?
  missionsPausedById            String?
  maxUploadMb                   Int       @default(200) // pièces jointes des modules (Documents/messagerie/RH) — ZIP de dossier
  maxDriveUploadMb              Int       @default(10240) // fichiers du Drive (10 Go ; au-delà de 2 Go : envoi direct au bucket)
  driveCapacityGb               Int       @default(100) // capacité globale du Drive (modifiable Super Admin)
  driveUserQuotaGb              Int       @default(10) // quota par utilisateur (modifiable Super Admin)
  // Budget total au-dessus des enveloppes : FIXED (montant figé) ou FLEXIBLE
  // (= somme des enveloppes actives). Réglé par le Super Admin.
  budgetTotalMode               String    @default("FLEXIBLE")
  budgetFixedTotal              Decimal   @default(0) @db.Decimal(14, 2)
  /// SEUIL Ad & Pro AU-DELÀ DUQUEL LE DIRECTEUR GÉNÉRAL VALIDE EN PLUS (§118.138).
  /// Décision de la Direction (09/2026) : « toutes les demandes Ad&Pro, matériel promotionnel
  /// compris, passent par la validation du DG à partir de 1 000 000 DZD, mais ce seuil doit
  /// pouvoir être configuré par le super admin. » UN seul chiffre, lu par les quatre circuits
  /// configurables ET par le matériel promotionnel, qui n'a pas d'étapes en base : cinq copies
  /// auraient divergé au premier ajustement (§118.5). 0 = aucune porte du DG.
  adProDgThreshold              Decimal   @default(1000000) @db.Decimal(14, 2)
  /// SEUIL DES BONS DE COMMANDE (§118.149). Décision de la Direction (09/2026) : « tout BC
  /// supérieur à un montant configuré dans les centres de validations Ad&Pro devra passer par la
  /// validation d'un des centres ». STRICTEMENT au-dessus → un centre (Ad & Pro ou normal, selon
  /// l'origine) ; en dessous → directement à la signature des Finances. Distinct du seuil du DG :
  /// l'un gouverne les DEMANDES, l'autre les PIÈCES qui engagent la société. 0 = tout BC passe
  /// par un centre — le comportement d'avant la règle, jusqu'à ce que la Direction fixe le montant.
  bcValidationThreshold         Decimal   @default(0) @db.Decimal(14, 2)
  /// SEUIL DES BONS DE COMMANDE HORS AD & PRO (Direction, 10/2026 : « les BC hors Ad & Pro passent par le centre de
  /// validation, mets-moi un seuil là-bas aussi »). Celui qui précède ne vaut plus que pour les BC du centre Ad & Pro ;
  /// celui-ci, réglé depuis le centre de validations, pour les BC qu'il valide. 0 = tout BC y passe.
  bcValidationThresholdCentre   Decimal   @default(0) @db.Decimal(14, 2)
  // Onglet Regulatory « Enregistrement » (analyseur de dossier CTD) — masqué tant que
  // le Super Admin ne l'a pas débloqué.
  regEnrollmentEnabled          Boolean   @default(false)
  /// MODULES MASQUÉS — retirés de la plateforme sans toucher aux droits ni aux données.
  /// Ce n'est pas une permission : c'est « ce module n'est pas en service ici, pour personne ».
  /// Le Super Admin continue de les voir (signalés), sans quoi il ne pourrait plus les rallumer.
  hiddenModules                 String[]  @default([])
  // Rôles « superviseurs Regulatory » (en plus du Super Admin, toujours inclus) : fixent
  // la priorité et les dates cibles, reçoivent les notifications (nouveau dossier / dépôt),
  // et peuvent demander des mises à jour de statut. Configurable en Administration.
  regulatorySupervisorRoles     String[]  @default([])
  // Segments thérapeutiques que le tableau Regulatory propose (menu déroulant multi-choix de la
  // colonne « Segments »). VIDE = la liste par défaut intégrée. L'administrateur les gère en
  // Administration : le marché d'un groupe pharma n'est pas celui d'un autre.
  regulatoryTherapeuticSegments String[]  @default([])
  /// COLONNES RETIRÉES du tableau Regulatory — sur les DEUX sous-modules (Suivi de dossiers et
  /// Pipeline), pour tout le monde. Ce n'est pas la préférence d'affichage locale au navigateur
  /// (« je ne veux pas voir ça sur MON écran ») : c'est « cette colonne n'a pas lieu d'être dans
  /// cette maison ». Le catalogue des clés vit dans `lib/regulatory/colonnes.ts`, et la référence
  /// ne s'y masque jamais — sans elle on ne saurait plus de quel dossier on parle.
  regulatoryHiddenColumns       String[]  @default([])
  // Rôles autorisés à CRÉER des « Demandes à Regulatory » (en plus du PRIM, toujours inclus).
  // L'équipe Regulatory RÉPOND mais ne crée pas. Configurable en Administration.
  regRequestCreatorRoles        String[]  @default([])
  // Rôles autorisés à CRÉER des « catégories » de Drive (espaces partagés type « Promotion
  // Médicale » présentés en onglets à côté de Drive/Documents). En plus du Super Admin,
  // toujours inclus. Configurable en Administration.
  driveSpaceCreatorRoles        String[]  @default([])
  // Rôles autorisés (par le Super Admin) à voir l'onglet « Overview » des Rapports terrain
  // (graphes d'analyse : visites par médecin / hôpital / délégué / spécialité, tendance…).
  // En plus du Super Admin, toujours inclus. Configurable en Administration.
  fieldReportsOverviewRoles     String[]  @default([])
  /// QUI ÉCRIT LES MESSAGES PRÉ-DÉFINIS de la Direction Marketing (en plus du Super Admin).
  ///
  /// Une LISTE DE RÔLES et non un élargissement du module `MEDICAL` : `PRODUCT_MANAGER`
  /// (Direction Marketing) n'y a que la LECTURE, et lui donner l'écriture lui ouvrirait aussi les
  /// praticiens et les visites — une empreinte réelle bien plus large que la demande (§118.16).
  /// C'est le mécanisme que le dépôt emploie déjà pour ce genre de question, et il laisse la
  /// DÉCISION DE PERMISSION au Super Admin, à qui elle appartient (§118.86).
  /// Défaut : la Direction Marketing (Direction, 07/10) — `20270115140000_cockpit_marketing_auteurs`.
  promoMessageAuthorRoles       String[]  @default(["PRODUCT_MANAGER"])
  // ORGANIGRAMME — qui a le droit de le CONSULTER (l'édition reste au Super Admin). Les RH en
  // ont besoin au quotidien ; d'autres personnes peuvent y être ajoutées nommément. Un
  // consultant voit toutes les entités ou filtre sur l'une d'elles ; il ne modifie rien.
  orgChartViewerRoles           String[]  @default([])
  orgChartViewerUserIds         String[]  @default([])
  /// ENREGISTREMENT (CTD) — l'onglet est réservé à l'ADMINISTRATEUR par défaut (liste vide) ;
  /// l'admin peut l'ouvrir à des rôles précis depuis la console.
  regEnrollmentRoles            String[]  @default([])
  /// PIPELINE (dossiers VERROUILLÉS) — deux droits distincts, réglés en Administration.
  /// CONSULTER : voir les dossiers à l'étude, partout (pipeline, recherche, sélecteurs).
  /// CADENAS : ouvrir un dossier, donc le publier à toute l'entreprise — l'acte est irréversible
  /// dans les faits (ce qui a été lu a été lu), il se donne à moins de monde. Le Super Admin
  /// détient toujours les deux. Voir `lib/regulatory/pipeline-access.ts`.
  pipelineViewerRoles           String[]  @default([])
  pipelineViewerUserIds         String[]  @default([])
  pipelineManagerRoles          String[]  @default([])
  pipelineManagerUserIds        String[]  @default([])
  /// DIRECTIVES (notes de service) — deux droits distincts, réglés en Administration.
  /// LIRE : recevoir et consulter les directives publiées qui vous concernent. ÉMETTRE :
  /// rédiger une note et la soumettre à la direction générale. Le Super Admin et le Directeur
  /// Général détiennent toujours les deux — ce sont eux qui publient.
  /// Voir `lib/directives/access.ts`.
  directiveReaderRoles          String[]  @default([])
  directiveReaderUserIds        String[]  @default([])
  directiveIssuerRoles          String[]  @default([])
  directiveIssuerUserIds        String[]  @default([])
  /// LE SERVICE DES MOYENS GÉNÉRAUX — un seul, pour toute la société.
  ///
  /// Les moyens généraux ne sont pas « ceux de mon département » : c'est UN service qui achète
  /// et décaisse pour tout le monde. Chacun arrive donc sur la MÊME caisse, quel que soit son
  /// rattachement. Le découpage par département n'a pas disparu — il reste la façon dont
  /// l'argent est imputé — mais il ne se PILOTE plus que depuis le compte Super Admin.
  /// Nul = aucun service désigné ; on retombe alors sur le rattachement, comme avant.
  generalMeansDepartmentId      String?
  /// L'INSTANT OÙ LA PAIE EST PASSÉE PAR LE CENTRE DE PAIEMENT (§118.176) — posé UNE fois par la
  /// migration `20261220090000_paie_avant_le_centre`, jamais déplacé. Avant lui, « marquer payé »
  /// voulait dire « versé » : l'ancien circuit prévenait le salarié « votre salaire a été versé »
  /// 24 h après. Ces salaires-là sont VIRÉS — les présenter « à envoyer » au centre les ferait payer
  /// une seconde fois. Après lui, marquer payé n'est plus qu'une SAISIE.
  payrollCentreSince            DateTime?
  // Clés VAPID (Web Push) auto-générées et persistées si non fournies par l'environnement.
  // La clé privée reste côté serveur ; la publique est servie via /api/push/key.
  vapidPublicKey                String?
  vapidPrivateKey               String?
  /// LE SITE WEB A REFUSÉ LA CONFIGURATION (§118.158) — un 401 (clé ou signature refusée) ou une
  /// redirection (adresse fausse). Tant que l'EMPREINTE de la configuration en vigueur est celle
  /// qui a été refusée, plus rien ne part vers le site : réessayer en boucle une clé refusée ne
  /// fait que remplir les journaux des deux côtés (« Ne pas réessayer en boucle », contrat §6).
  /// Une configuration différente (clé ou adresse changée) lève le blocage d'elle-même. On ne
  /// stocke JAMAIS la clé : seulement une empreinte tronquée de son condensat.
  siteBlocageEmpreinte          String?
  siteBlocageAt                 DateTime?
  siteBlocageMotif              String?
  /// LA DERNIÈRE LECTURE DE LA SANTÉ DU SITE (§118.159) — `GET /health` avec la clé active, au plus
  /// une fois l'heure : ce que le site dit de lui-même (liaison à l'ERP, signature, candidatures en
  /// attente de livraison, stockage). Une fois l'heure et pas plus : chaque lecture RÉVEILLE un site
  /// hébergé en plan gratuit, et le garder éveillé en permanence consommerait les heures gratuites de
  /// tout le compte Render — le jour où elles manquent, c'est le site public qui s'éteint.
  siteSante                     Json?
  siteSanteAt                   DateTime?
  /// L'identifiant de DÉMARRAGE du site : il change quand le site redémarre (déploiement, mise en
  /// veille du plan gratuit, qui efface ce qu'il a reçu). L'ERP rapproche alors aussitôt.
  siteBootId                    String?
  /// REFONTE V2-C — DOUBLE ÉCRITURE DES ORGANISATIONS (`referentiels/organisations/double-ecriture.ts`). Vrai = la
  /// création d'un fournisseur, d'un partenaire ou d'un établissement crée aussi (ou retrouve) son `Organisation`.
  /// Faux par défaut : le Super Admin l'ouvre depuis Administration › Refonte des données, et le referme d'un clic.
  doubleEcritureOrganisations   Boolean   @default(false)
  /// L'ENRICHISSEMENT DES FICHES PAR LES PIÈCES DÉPOSÉES (refonte, lot V2-A). Faux par défaut : aucun dépôt
  /// n'est mis en file ni traité. Ouvert et refermé par le Super Admin depuis Administration › Refonte des
  /// données ; refermé, la file garde ce qu'elle a et reprend à la réouverture.
  enrichissementActif           Boolean   @default(false)
  /// REFONTE DES DONNÉES, lot V2-B : la DOUBLE ÉCRITURE des Personnes. Vrai = les écrivains de création
  /// (salarié, praticien, bénéficiaire de prise en charge, voyageur…) créent ou relient la `Personne` dans
  /// la même transaction (`referentiels/personnes/double-ecriture.ts`). Éteint par défaut ; le Super Admin
  /// l'allume après la reprise, et l'éteint pour revenir en arrière.
  refontePersonnesDoubleEcriture Boolean   @default(false)
  /// LE COFFRE EN DOUBLE ÉCRITURE (refonte V2-E) : chaque écriture d'une colonne sensible écrit aussi sa
  /// copie chiffrée au coffre. Fermé par défaut ; ouvert par le Super Admin (Administration › Refonte des données).
  coffreEcriture                Boolean   @default(false)
  /// LE COFFRE EN DOUBLE LECTURE : écrans, exports et pièces lisent la valeur par le coffre (politique +
  /// journal `AccesDonneeSensible`) ; ailleurs, le masque seul. Fermé par défaut.
  coffreLecture                 Boolean   @default(false)
  /// LA SÉPARATION DES TÂCHES AU CENTRE DE PAIEMENT (audit 27/10, ARGENT-06). Vrai (défaut) : qui a DEMANDÉ un
  /// paiement ne l'autorise pas, qui l'a demandé ou autorisé ne le règle pas (`payments/separation.ts`).
  /// Suspendue par le Super Admin seulement (Réglages & diffusion), geste journalisé.
  separationTachesPaiement      Boolean   @default(true)
  updatedAt                     DateTime  @updatedAt
  updatedById                   String?
  /// REFONTE V2-D — DOUBLE ÉCRITURE DES LIEUX. Vrai = chaque saisie d'une wilaya / ville sur une fiche (praticien,
  /// établissement, partenaire, fournisseur, secteur) pose aussi `wilayaCode`. Faux = seul le texte est écrit
  /// (la reprise « lieux-wilaya » rattrape). Réglé par le Super Admin dans Administration › Refonte des données.
  lieuxDoubleEcriture           Boolean   @default(true)
}

/// Sonde QUOTIDIENNE de l'API IA (chatbot & fonctions IA). Le planificateur interne
/// lance un vrai ping /v1/messages une fois par jour ; chaque résultat est journalisé
/// ici (statut + latence + message EXACT en cas d'échec) et, si l'API est en panne,
/// le Super Admin est alerté. Sert aussi d'historique de santé pour le Contrôle IA.
model AiHealthCheck {
  id         String    @id @default(cuid())
  checkedAt  DateTime  @default(now())
  ok         Boolean
  model      String
  status     Int? // code HTTP de la réponse (null si échec réseau)
  latencyMs  Int?
  error      String? // message exact (statut + extrait du corps, ou erreur réseau)
  notifiedAt DateTime? // horodatage de l'alerte envoyée aux Super Admins (échec)

  @@index([checkedAt])
}

/// Abonnement Web Push (PWA) d'un appareil/navigateur d'un utilisateur, pour les
/// notifications poussées sur le téléphone. Secrets propres au navigateur (pas sensibles).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserPushSubs", fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Journal d'usage de l'IA — alimente le tableau de bord du Centre de contrôle
/// (volume, taux de succès, latence, erreurs) par fonction et par utilisateur.
/// Best-effort : la journalisation ne doit jamais casser un appel IA.
model AiUsageLog {
  id                String   @id @default(cuid())
  feature           String // assistant | nudge | brain | briefing | process_intel | field_report | voice
  provider          String   @default("anthropic") // anthropic | openai
  model             String?
  userId            String?
  ok                Boolean
  latencyMs         Int?
  errorCode         String? // ex. "HTTP 429", "disabled", "not_configured"
  /// Observabilité de la BOUCLE AGENT (assistant / Chief of Staff) — nuls hors boucle :
  /// délai avant le PREMIER mot (ressenti), nombre de tours modèle↔outils, appels d'outils,
  /// erreurs d'outils, temps total passé DANS les outils. C'est ce qui distingue « le modèle
  /// est lent » de « une requête SQL est lente » quand on dépanne une réponse à 12 s.
  ttftMs            Int?
  turns             Int?
  toolCalls         Int?
  toolErrors        Int?
  toolLatencyMs     Int?
  /// ── LE COÛT DU TOUR (§coût) ─────────────────────────────────────────────────────────────
  /// Jetons et coût AGRÉGÉS sur le tour (tous les appels de modèle qu'il a provoqués). `costUsd`
  /// vaut NULL dès qu'UN appel n'avait pas de tarif — un total partiel se lirait comme un total.
  /// Le détail appel par appel vit dans `ModelCallLog`, relié par `turnId`.
  turnId            String?
  route             String?
  complexity        String?
  threadId          String?
  llmCalls          Int?
  inputTokens       Int?
  outputTokens      Int?
  cachedInputTokens Int?
  reasoningTokens   Int?
  webSearchCalls    Int?
  costUsd           Decimal? @db.Decimal(12, 6)
  createdAt         DateTime @default(now())

  @@index([feature])
  @@index([createdAt])
  @@index([userId])
  @@index([threadId])
}

/// LE JOURNAL DES APPELS DE MODÈLE — une ligne PAR APPEL, écrite par la passerelle via un puits.
///
/// `AiUsageLog` dit ce qu'un TOUR a coûté ; cette table dit à QUEL modèle, dans quel RÔLE, pour
/// quelle MISSION ou quel FIL, avec combien de jetons en cache. C'est elle qui répond à « où part
/// l'argent ? » — par modèle, par usage, par personne, par mission — sans recalcul. Aucun contenu
/// n'y figure : des nombres, des identifiants, un modèle.
model ModelCallLog {
  id                String   @id @default(cuid())
  at                DateTime @default(now())
  turnId            String?
  route             String?
  feature           String?
  userId            String?
  threadId          String?
  missionId         String?
  role              String
  provider          String
  model             String
  inputTokens       Int
  outputTokens      Int
  cachedInputTokens Int      @default(0)
  reasoningTokens   Int      @default(0)
  webSearchCalls    Int      @default(0)
  /// NULL = tarif inconnu pour ce modèle. Jamais zéro par défaut.
  costUsd           Decimal? @db.Decimal(12, 6)
  ms                Int      @default(0)
  attempts          Int      @default(1)
  incompleteReason  String?

  @@index([at])
  @@index([userId, at])
  @@index([missionId])
  @@index([threadId])
  @@index([model, at])
  @@index([turnId])
  @@index([feature, userId, at])
}

/// LE TOUR DE PAROLE VOCAL, MESURÉ — un enregistrement PAR TOUR, pas par session.
///
/// AiUsageLog agrège une session entière : « 14 tours, 2 erreurs d'outil ». Utile pour la
/// facture, inutile pour réparer. Quand le PDG dit « ça marche mal », la question est TOUJOURS
/// « quel étage a cassé, sur quel tour ? » — et cette question demande la granularité du tour.
///
/// L'attribution (`failedStage`) est calculée par `src/lib/assistant/voice/turn-metrics.ts` au
/// PREMIER étage cassé : audio → transcription → détection de tour → compréhension → outil →
/// restitution. Elle est dénormalisée ici pour que la vue de débogage puisse grouper sans
/// recalculer 10 000 tours.
///
/// CE QUI EST STOCKÉ ET CE QUI NE L'EST PAS. La transcription FINALE est conservée : la mission
/// l'exige pour comparer « ce qui a été dit » à « ce qui a été transcrit » (§4), et sans elle il
/// est impossible de savoir si un échec vient de l'oreille ou de la tête. AUCUN AUDIO n'est
/// stocké ici — l'enregistrement de diagnostic (§18) est un dispositif distinct, explicitement
/// activé pour un test, et jamais implicite.
model VoiceTurnLog {
  id        String @id @default(cuid())
  sessionId String
  turnId    String
  userId    String

  /// ── Audio ───────────────────────────────────────────────────────────────────────────────
  speechMs    Int?
  /// Crête du niveau d'entrée, 0..1 — millièmes pour rester en entier (420 = 0,42).
  inputPeak   Int?
  clipped     Boolean @default(false)
  /// Le périphérique effectivement retenu. « default » n'est pas une réponse, c'est un symptôme.
  inputDevice String?

  /// ── Transcription ───────────────────────────────────────────────────────────────────────
  transcript   String?
  /// Confiance en millièmes (930 = 0,93). Null = non fournie, ce qui n'est PAS zéro.
  confidence   Int?
  partialCount Int?
  transcriptMs Int?

  /// ── Détection de tour ───────────────────────────────────────────────────────────────────
  interruptions Int     @default(0)
  falseBargeIns Int     @default(0)
  cutShort      Boolean @default(false)

  /// ── Compréhension & outil ───────────────────────────────────────────────────────────────
  intentKind  String?
  fastPath    Boolean  @default(false)
  toolName    String?
  toolOk      Boolean?
  toolError   String?
  intentMs    Int?
  toolStartMs Int?
  toolMs      Int?

  /// ── Restitution ─────────────────────────────────────────────────────────────────────────
  speakMs         Int?
  /// LE chiffre : fin de parole → premier son de réponse.
  firstResponseMs Int?
  delivered       Boolean @default(false)
  nudged          Boolean @default(false)
  spokenChars     Int?

  /// ── Verdict (§16 : le succès vu par le PDG, pas par les outils) ─────────────────────────
  ok          Boolean @default(false)
  failedStage String?
  reasons     String?
  slowLegs    String?

  /// Conditions d'essai, pour comparer micro de bureau / casque / mobile / bruit (§15).
  scenario String?
  device   String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([userId])
  @@index([failedStage])
  @@index([scenario])
}

// ───────────────────────── Appels & réunions (Jitsi) ─────────────────────────
// Une « réunion » = une salle Jitsi (meet.jit.si, gratuit, zéro config). Un « appel »
// dans la messagerie est une réunion instantanée lancée depuis une conversation.
// Restitution facultative : enregistrement (audio) → transcription → compte rendu IA →
// tâches proposées (acceptables en vraies tâches). Tout reste inerte si l'IA/STT
// n'est pas configurée — la salle Jitsi, elle, fonctionne toujours.

enum MeetingStatus {
  SCHEDULED // planifiée (à venir)
  LIVE // en cours
  ENDED // terminée
}

enum MeetingKind {
  MEETING // réunion classique (module Réunions)
  CALL // appel lancé depuis la messagerie
}

enum MeetingTaskStatus {
  PROPOSED // proposée par l'IA à partir du compte rendu
  ACCEPTED // transformée en tâche
  DISMISSED // écartée
}

model Meeting {
  id          String        @id @default(cuid())
  title       String
  description String?
  // Salle Jitsi (nom unique, stable → lien permanent) + jeton du lien externe public.
  slug        String        @unique
  publicToken String        @unique
  kind        MeetingKind   @default(MEETING)
  status      MeetingStatus @default(SCHEDULED)
  withVideo   Boolean       @default(true) // appel vidéo (sinon audio seul)
  // Présentiel : réunion PHYSIQUE (pas de lien en ligne). `location` = lieu du rendez-vous.
  inPerson    Boolean       @default(false)
  location    String?
  // Lien de réunion externe (Google Meet / Teams / Zoom…). S'il est présent, on l'utilise
  // comme lien « Rejoindre » à la place de l'embed Jitsi (Jitsi reste dans le code).
  meetLink    String?

  scheduledAt    DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  // Rappel automatique ~30 min avant le début (envoyé une seule fois).
  reminderSentAt DateTime?

  organizerId String
  organizer   User   @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  // Conversation d'origine (pour les appels lancés depuis la messagerie).
  conversationId String?

  // Restitution IA (facultative).
  transcript  String? @db.Text
  summary     String? @db.Text
  audioBlobId String? // blob audio de l'enregistrement (storage chiffré)

  participants MeetingParticipant[]
  proposals    MeetingTaskProposal[]
  messages     MeetingMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([status])
  @@index([scheduledAt])
}

model MeetingParticipant {
  id        String               @id @default(cuid())
  meetingId String
  meeting   Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation("MeetingParticipant", fields: [userId], references: [id], onDelete: Cascade)
  // Réponse à l'invitation (façon agenda) : INVITED (défaut) / ACCEPTED / DECLINED / TENTATIVE.
  response  CalendarInviteStatus @default(INVITED)
  createdAt DateTime             @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
}

model MeetingTaskProposal {
  id            String            @id @default(cuid())
  meetingId     String
  meeting       Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  assigneeId    String?
  assignee      User?             @relation("MeetingTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status        MeetingTaskStatus @default(PROPOSED)
  createdTaskId String? // tâche créée si acceptée
  createdAt     DateTime          @default(now())

  @@index([meetingId])
}

/// Fil de discussion (chat) d'une réunion — texte + pièces jointes, comme le chat des dossiers.
/// Ouvert à l'organisateur et aux participants ; supprimé en cascade avec la réunion.
model MeetingMessage {
  id          String                     @id @default(cuid())
  meetingId   String
  meeting     Meeting                    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?                      @relation("MeetingMsgAuthor", fields: [authorId], references: [id])
  body        String // peut être vide si le message ne porte qu'une pièce jointe
  attachments MeetingMessageAttachment[]
  createdAt   DateTime                   @default(now())

  @@index([meetingId])
}

/// Pièce jointe d'un message du fil d'une réunion — stockée chiffrée via le backend Drive (blob),
/// comme la messagerie. Supprimée en cascade avec son message.
model MeetingMessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   MeetingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  blobId    String
  name      String
  mime      String
  size      Int
  createdAt DateTime       @default(now())

  @@index([messageId])
}

// ─────────────── Calendrier (rendez-vous, infos, invitations) ───────────────
// Calendrier partagé façon Google Agenda. Heures stockées en UTC, affichées au
// fuseau d'Alger (Africa/Algiers, UTC+1, sans heure d'été). Chacun voit ses
// rendez-vous (organisés ou auxquels il est invité). L'assistant IA peut créer
// des rendez-vous et lancer des invitations.
enum CalendarEventKind {
  APPOINTMENT // rendez-vous
  MEETING // réunion
  REMINDER // rappel
  DEADLINE // échéance
  INFO // information importante
  OTHER
}

enum CalendarInviteStatus {
  INVITED // invité, sans réponse
  ACCEPTED // accepté
  DECLINED // refusé
  TENTATIVE // peut-être
}

model CalendarEvent {
  id          String            @id @default(cuid())
  title       String
  description String?
  location    String?
  kind        CalendarEventKind @default(APPOINTMENT)
  startAt     DateTime // UTC ; affiché en Africa/Algiers
  endAt       DateTime?
  allDay      Boolean           @default(false)
  color       String? // pastille (hex) facultative
  meetLink    String? // lien visio facultatif

  organizerId String
  organizer   User             @relation("CalendarOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  invitees    CalendarInvite[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startAt])
  @@index([organizerId])
}

model CalendarInvite {
  id          String               @id @default(cuid())
  eventId     String
  event       CalendarEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User                 @relation("CalendarInvitee", fields: [userId], references: [id], onDelete: Cascade)
  status      CalendarInviteStatus @default(INVITED)
  respondedAt DateTime?
  createdAt   DateTime             @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

// ───────────────────────── Moteur de workflow configurable (Ad & Pro) ─────────────────────────
// Circuits de validation « no-code » éditables par le Super Admin dans Administration :
// une définition par catégorie (Sponsoring, Congrès intl/national, Événements), composée
// d'étapes ordonnées. Chaque étape déclare QUI agit (rôles + portée) et ses POUVOIRS. Le
// moteur (src/lib/workflow) pilote le gating et la progression au runtime ; le statut
// « legacy » de l'entité source reste synchronisé pour les frises/badges/queries existants.

model WorkflowDefinition {
  id          String             @id @default(cuid())
  category    String             @unique // SPONSORING | CONGRESS_INTERNATIONAL | CONGRESS_NATIONAL | EVENTS
  name        String
  description String?
  isActive    Boolean            @default(true)
  updatedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  steps       WorkflowStep[]
  instances   WorkflowInstance[]
}

model WorkflowStep {
  id           String             @id @default(cuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  position     Int
  slug         String // stable dans la définition (preliminary/analysis/final/… ou custom)
  title        String
  description  String?
  actorRoles   String[]           @default([]) // UserRole[] autorisés à agir
  actorScope   String             @default("ROLE") // ROLE | ASSIGNEE | GLOBAL_VIEW | REQUESTER
  powers       String[]           @default([]) // APPROVE REJECT ASSIGN SET_AMOUNT SET_CATEGORY COMMENT

  assignRole             String? // rôle désignable si pouvoir ASSIGN
  requireAmount          Boolean  @default(false)
  // Seuil anti-bureaucratie : si le montant de travail de l'instance est ≤ ce seuil (DZD),
  // l'étape est franchie AUTOMATIQUEMENT (tracée : WorkflowStepEvent « AUTO_SKIP »). Jamais
  // appliqué à une étape de désignation, d'émission financière, ni à la décision finale.
  autoSkipMaxAmount      Decimal? @db.Decimal(14, 2)
  // Auto-accord si autorité : si le DEMANDEUR détient déjà le rôle/portée de cette étape,
  // elle est approuvée automatiquement en son nom (tracée : « AUTO_APPROVE_REQUESTER ») — on ne
  // fait pas valider quelqu'un sa propre demande. Mêmes gardes que le seuil (jamais désignation,
  // émission ni décision finale). Opt-in ; défaut false ⇒ aucun changement de comportement.
  autoApproveIfRequester Boolean  @default(false)
  requireCategory        Boolean  @default(false)
  requireNote            Boolean  @default(false)
  emitDeclaration        Boolean  @default(false) // à l'approbation : créer une déclaration info médicale (si PRIM)
  emitExpenseOrder       Boolean  @default(false) // à l'approbation : émettre un ordre de dépense
  notifyRoles            String[] @default([])
  optional               Boolean  @default(false)
  confidential           Boolean  @default(false) // avis/montant de l'étape masqués au demandeur (ex. analyse chef de produit)
  legacyStatus           String? // projection vers le statut enum de l'entité source (frises existantes)
  createdAt              DateTime @default(now())

  @@unique([definitionId, position])
  @@unique([definitionId, slug])
  @@index([definitionId])
}

model WorkflowInstance {
  id               String              @id @default(cuid())
  definitionId     String
  definition       WorkflowDefinition  @relation(fields: [definitionId], references: [id])
  entityType       EntityType
  entityId         String
  category         String
  status           String              @default("IN_PROGRESS") // IN_PROGRESS | RETURNED (à corriger, chez le demandeur) | APPROVED | REJECTED | CANCELLED
  currentSlug      String? // étape en attente d'action ; null si terminal ; gardée pendant un renvoi (la demande y reviendra)
  /// L'ÉTAPE QUI TRANCHE POUR CETTE DEMANDE — null = la dernière étape de la définition.
  ///
  /// Le parcours Ad&Pro dépend de QUI demande. Ce champ disait « les deux chaînes sont des
  /// tranches CONTIGUËS de la même colonne vertébrale, il suffit donc de deux bornes » : c'est
  /// FAUX depuis la règle du 22/09/2026 (un KAM traverse `preliminary` sans `final`, un National
  /// Sales `final` sans `preliminary`). Aucun ordre d'étapes ne rend ces deux tranches contiguës
  /// à la fois, donc le parcours est un TAMIS et il faut DEUX champs : celui-ci dit OÙ la chaîne
  /// s'arrête, `skippedSlugs` dit ce qu'elle NE TRAVERSE PAS. Les fondre en un seul les ferait
  /// diverger — une demande s'arrêterait là où l'écran annonce qu'elle continue (§118.5).
  ///
  /// La borne est FIXÉE À LA NAISSANCE de l'instance et jamais recalculée : un KAM promu
  /// National Sales en cours de circuit ne doit pas voir sa demande changer de chaîne, et un
  /// National Sales redevenu KAM ne doit surtout pas perdre la validation de la Direction qui
  /// lui était promise. Le parcours est un fait de la DEMANDE, pas une fonction du poste
  /// qu'occupe son auteur aujourd'hui.
  finalSlug        String?
  /// LES ÉTAPES DE LA COLONNE VERTÉBRALE QUE CETTE DEMANDE NE TRAVERSE PAS.
  ///
  /// GELÉ À LA NAISSANCE pour la même raison que `finalSlug`, et il ne se DÉDUIT pas de lui : un
  /// KAM et un demandeur ordinaire tranchent tous deux chez Direction Marketing (donc même
  /// borne : aucune) et ne traversent pourtant pas les mêmes étapes — le premier passe par son
  /// superviseur national, le second par personne.
  ///
  /// Une étape ignorée n'est pas « franchie automatiquement » : elle n'est pas SUR la route,
  /// donc rien n'est tracé à son nom. Tracer un franchissement que personne n'a demandé ferait
  /// lire au demandeur qu'un validateur a laissé passer sa demande.
  skippedSlugs     String[]
  amount           Decimal?            @db.Decimal(14, 2)
  budgetCategoryId String?
  assigneeId       String?
  /// UN GESTE EST EN COURS SUR CE CIRCUIT depuis cet instant (§118.186) — null sinon.
  ///
  /// Approuver, refuser, renvoyer, resoumettre, retirer, relancer, faire appel : chaque geste
  /// PREND le circuit avant son premier effet et le REND à la fin. Sans cette prise, deux clics à
  /// une seconde d'intervalle sur « Approuver » à l'étape qui tranche lisaient le même état et
  /// émettaient DEUX ordres de dépense ; un renvoi et un accord donnés ensemble s'appliquaient
  /// tous les deux. Une condition sur l'état seul ne suffit pas : l'approbation ne déplace l'étape
  /// qu'à sa FIN, et un second geste lu entre-temps la croyait toujours libre.
  ///
  /// Une prise plus vieille que deux minutes est réputée abandonnée (processus tombé en plein
  /// geste) et se reprend : un circuit ne reste jamais bloqué par une panne.
  claimedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  events           WorkflowStepEvent[]

  @@unique([entityType, entityId])
  @@index([category, status])
}

model WorkflowStepEvent {
  id         String           @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepSlug   String
  stepTitle  String
  action     String // APPROVE | REJECT | ASSIGN | COMMENT
  actorId    String
  actorName  String?
  note       String?
  amount     Decimal?         @db.Decimal(14, 2)
  createdAt  DateTime         @default(now())

  @@index([instanceId])
}

// ───────────────────────── Suivi de stock par ÉTATS DATÉS ─────────────────────────
// Saisie simple : « à telle date, il reste X unités » — sans entrées/sorties. La courbe
// (date → quantité) se dessine au fil des saisies, par produit et par lieu.

/// Lieu de stockage nommé du module Stocks, géré par le Super Admin. `kind` distingue les
/// HÔPITAUX (`HOSPITAL`) des ANNEXES PCH (`ANNEX`, sites de stockage secondaires de la PCH).
/// Le nom « StockAnnex » est conservé (pas de renommage de table) ; il porte désormais les deux.
model StockAnnex {
  id            String                           @id @default(cuid())
  name          String                           @unique
  kind          String                           @default("HOSPITAL") // HOSPITAL | ANNEX
  /// L'ÉTABLISSEMENT DE L'ANNUAIRE que ce lieu de stock désigne — hôpitaux seulement (§118.134).
  /// Les hôpitaux du module Stocks SONT ceux de l'annuaire des établissements : c'est ce lien qui
  /// donne à un KAM les stocks de SON secteur. Nul = lieu HÉRITÉ, nommé à la main avant que
  /// l'annuaire ne soit la seule source ; il reste lisible par la vue globale et se RATTACHE
  /// depuis l'écran des stocks (Super Admin) pour que son historique rejoigne l'établissement.
  /// `SetNull` : un établissement retiré de l'annuaire n'efface pas des relevés.
  institutionId String?                          @unique
  institution   MedicalInstitution?              @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdAt     DateTime                         @default(now())
  snapshots     StockSnapshot[]
  /// LES RÉCURRENCES de demande d'état qui le visent.
  recurrences   StockRequestRecurrenceHospital[]

  @@index([kind])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LA RÉCURRENCE D'UNE DEMANDE D'ÉTAT DE STOCK — ce que le directeur des opérations POSE une
/// fois, et qui repart tout seul.
///
/// ── POURQUOI UN OBJET, ET PAS UNE HABITUDE ────────────────────────────────────────────────
///
/// Demander chaque mois l'état de stock de ses hôpitaux à chaque KAM était un geste répété à la
/// main. Un geste répété à la main est un geste OUBLIÉ un mois sur trois, et personne ne peut
/// dire lequel : la demande ne vit que dans la mémoire de celui qui la fait. Une promesse qui
/// ne vit que dans une phrase meurt à la fin du tour (§118.57a) — ici elle devient une ligne.
///
/// ── ELLE NE PORTE PAS SES DEMANDES ────────────────────────────────────────────────────────
///
/// Ce que chaque déclenchement produit est une `Task` assignée + sa notification, par le MÊME
/// chemin que le bouton de l'écran (`requestStockState`). Lui donner une table jumelle de
/// « demandes » aurait fait DEUX vérités sur ce qui a été demandé, et celle de la récurrence
/// aurait pris du retard au premier correctif (§118.5). Le lien se lit par `Task.module` et par
/// le journal d'audit, comme pour une demande faite à la main.
///
/// ── LA GRAMMAIRE DE RÉCURRENCE EST EMPRUNTÉE, PAS RÉINVENTÉE ──────────────────────────────
///
/// Mêmes champs et mêmes valeurs que `ScheduledWorkflow` (récurrence nommée + heure locale +
/// jour), et le MÊME calcul d'échéance (`lib/scheduler/contract.ts`, module pur). Deux
/// grammaires de récurrence dans un même produit finiraient par ne pas dire la même chose de
/// « tous les dimanches à 7 h ».
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model StockRequestRecurrence {
  id String @id @default(cuid())

  /// Ce que le directeur lit dans sa liste — « Relevé mensuel Est ».
  name String

  /// LE KAM à qui la demande est adressée. `Cascade` : son compte supprimé, la récurrence
  /// disparaît — une réquisition adressée à personne ne doit pas continuer à tourner.
  assigneeId String
  assignee   User   @relation("StockRecurrenceAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  /// Le mot que la demande portera. Facultatif : sans lui, le texte canonique suffit.
  note String?

  /// DAILY | WEEKLY | MONTHLY. `HOURLY` existe dans la grammaire partagée et n'est PAS admis
  /// ici : demander un comptage physique toutes les heures produirait vingt-quatre tâches par
  /// jour que personne ne ferait, et un compteur de tâches ignorées n'est pas un pilotage.
  recurrence String
  /// Heure locale d'Alger (0-23) du déclenchement.
  hourLocal  Int    @default(8)
  /// Jour de la semaine (0 = dimanche) pour WEEKLY ; jour du mois pour MONTHLY.
  dayOfWeek  Int?
  dayOfMonth Int?

  /// ACTIVE | PAUSED. Une récurrence en pause garde son historique et sa prochaine échéance :
  /// la reprendre ne doit pas effacer ce qu'elle a déjà demandé.
  status String @default("ACTIVE")

  /// La prochaine échéance, en UTC — c'est ELLE qu'on interroge, jamais une expression à
  /// réévaluer pour chaque récurrence à chaque battement.
  nextRunAt DateTime
  lastRunAt DateTime?
  /// Verrou d'exécution : un battement la prend par `updateMany`, les autres passent leur
  /// chemin. Sans lui, deux processus concurrents enverraient deux fois la même demande.
  claimedAt DateTime?
  /// Combien de fois elle a réellement produit une demande — ce que l'écran affiche, et la
  /// seule preuve qu'elle n'est pas une promesse muette.
  runCount  Int       @default(0)

  /// QUI L'A POSÉE. C'est SON autorité qui fait partir la demande, et elle est RELUE à chaque
  /// déclenchement : une récurrence dont l'auteur a perdu le droit de réquisitionner s'arrête.
  /// Sans cette relecture, la récurrence serait une permission qui survit à son titulaire.
  createdById String?
  createdBy   User?   @relation("StockRecurrenceAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  hospitals StockRequestRecurrenceHospital[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextRunAt])
  @@index([assigneeId])
}

/// LES HÔPITAUX visés par une récurrence. Une table de liaison et non une liste de texte : un
/// hôpital renommé doit rester le même hôpital, et un hôpital supprimé doit disparaître de la
/// récurrence au lieu d'y laisser un nom qui ne désigne plus rien.
model StockRequestRecurrenceHospital {
  recurrenceId String
  recurrence   StockRequestRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  annexId      String
  annex        StockAnnex             @relation(fields: [annexId], references: [id], onDelete: Cascade)

  @@id([recurrenceId, annexId])
  @@index([annexId])
}

model StockSnapshot {
  id            String                  @id @default(cuid())
  companyId     String? // entité (Adventum / Pharmagène / …)
  company       Company?                @relation(fields: [companyId], references: [id])
  scope         String // PCH (central) | HOSPITAL | ANNEX (une annexe nommée, ou une DIRECTION RÉGIONALE de la PCH — `drCode`)
  annexId       String?
  annex         StockAnnex?             @relation(fields: [annexId], references: [id], onDelete: Cascade)
  /// LA DIRECTION RÉGIONALE de la PCH (« DRA », « DRBE »… — le code des fichiers Ventes PCH, `PchDirectionRegionale`) quand le
  /// relevé est celui du stock d'une DR : `scope` ANNEX, `annexId` nul. Direction, 10/2026 : les stocks Adventum viennent de
  /// la PCH (central + DR) et des hôpitaux (relevés des KAM) — nous n'avons pas de stock propre. Nul pour tout autre lieu.
  drCode        String?
  productId     String
  product       RegulatoryProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  date          DateTime
  quantity      Int
  createdById   String?
  createdAt     DateTime                @default(now())
  /// Les lignes de demande de stocks dont l'envoi a écrit cet état.
  demandeLignes StockCountRequestLine[]

  @@index([productId, scope, annexId, date])
  @@index([scope, drCode, date])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UNE DEMANDE DE STOCKS — le directeur des opérations la lance, chaque KAM la renseigne.
///
/// Direction, 06/10 : « le DO sélectionne le ou les hôpitaux — aucun = tous — et pour chacun le
/// ou les produits — aucun = tous. Chaque KAM reçoit la demande et ajoute, pour chaque hôpital,
/// les stocks de chaque produit demandé. »
///
/// ── DÉVELOPPÉE À LA CRÉATION ─────────────────────────────────────────────────────────────
///
/// « Tous » est un INSTANTANÉ : les établissements et produits du jour sont écrits ligne à ligne.
/// Résolu plus tard, « tous » changerait de sens sous les pieds du KAM — un hôpital ajouté à un
/// secteur après coup apparaîtrait dans une demande que personne n'a lancée pour lui.
///
/// ── UNE SEULE VÉRITÉ SUR LE STOCK ────────────────────────────────────────────────────────
///
/// La ligne porte la SAISIE (brouillon compris). L'ENVOI écrit l'état daté (`StockSnapshot`) du
/// module Stocks : la courbe de l'hôpital se nourrit de la réponse, sans seconde table de stocks.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model StockCountRequest {
  id           String    @id @default(cuid())
  title        String
  dueDate      DateTime?
  notes        String?
  /// OUVERTE | CLOTUREE. Clôturée, elle ne se renseigne plus et sort de « Mon espace » des KAM.
  status       String    @default("OUVERTE")
  /// « Aucun hôpital choisi » au moment de la création — dit à l'écran « tous (N) ».
  toutHopitaux Boolean   @default(false)
  createdById  String?
  createdBy    User?     @relation("StockCountRequestAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hopitaux      StockCountRequestHospital[]
  lignes        StockCountRequestLine[]
  destinataires StockCountRequestRecipient[]

  @@index([status, createdAt])
}

/// UN ÉTABLISSEMENT VISÉ. Le nom et la wilaya sont FIGÉS : un établissement renommé ou retiré
/// de l'annuaire ne doit pas rendre illisible une demande passée (`SetNull` sur le lien).
model StockCountRequestHospital {
  id            String              @id @default(cuid())
  requestId     String
  request       StockCountRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  institutionId String?
  institution   MedicalInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  name          String
  wilaya        String?
  /// Aucun produit choisi : « tous ceux que ses KAM portent ».
  tousProduits  Boolean             @default(false)
  /// Aucun KAM ne couvre l'établissement — listé au DO, jamais adressé à personne.
  sansKam       Boolean             @default(false)
  /// Le mot du KAM sur cet établissement (« pharmacie fermée le jeudi »).
  note          String?
  noteById      String?

  lignes StockCountRequestLine[]

  @@unique([requestId, institutionId])
  @@index([institutionId])
}

/// UNE CASE de la matrice établissement × produit. `kamIds` : les KAM qui la portent (secteur
/// couvrant l'établissement, produit de leur BU) — vide = « sans KAM ». Partagée : deux KAM du
/// même secteur voient la même case, la dernière saisie fait foi (`savedById`).
model StockCountRequestLine {
  id           String                    @id @default(cuid())
  requestId    String
  request      StockCountRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     StockCountRequestHospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  productId    String?
  product      RegulatoryProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productLabel String
  kamIds       String[]                  @default([])
  /// En boîtes. Nul = pas encore renseigné.
  quantity     Int?
  rupture      Boolean                   @default(false)
  savedAt      DateTime?
  savedById    String?
  /// L'état daté écrit à l'envoi — le pont vers la courbe du module Stocks.
  snapshotId   String?
  snapshot     StockSnapshot?            @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@unique([hospitalId, productId])
  @@index([requestId])
  @@index([productId])
  @@index([snapshotId])
}

/// UN KAM DESTINATAIRE — une seule vue par KAM et par demande, son envoi, ses relances.
model StockCountRequestRecipient {
  id          String            @id @default(cuid())
  requestId   String
  request     StockCountRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kamId       String
  kam         User              @relation("StockCountRequestKam", fields: [kamId], references: [id], onDelete: Cascade)
  submittedAt DateTime?
  remindedAt  DateTime?
  remindCount Int               @default(0)
  createdAt   DateTime          @default(now())

  @@unique([requestId, kamId])
  @@index([kamId, submittedAt])
}

// ═══════════════════════════ Regulatory Intelligence OS ═══════════════════════════
// Fondations (Phase 1). Toutes les entités : org-scopées (companyId), auditées, versionnées.
// Relations internes avec ON DELETE CASCADE (contraintes FK posées en migration idempotente) :
// supprimer un dossier purge versions → documents → jobs → audit. `companyId` reste un String
// simple (portée multi-entités, pas de FK dure vers Company).
// Tailles en Int (octets) : ingestion plafonnée < 2 Go ; migrer en BigInt si dossiers plus gros.

enum RegProcedureType {
  PRESUBMISSION
  INITIAL_REGISTRATION
  NEW_ACTIVE_SUBSTANCE
  GENERIC
  BIOSIMILAR
  IMPORTED
  LOCAL_MANUFACTURING
  ADD_DOSAGE
  ADD_PRESENTATION
  EXTENSION_INDICATION
  VARIATION
  RENEWAL
  TRANSFER
  RESERVE_RESPONSE
  SUPPLEMENT
  WITHDRAWAL
  CESSATION
  OTHER
}

enum RegDossierStatus {
  DRAFT
  INGESTING
  INGESTED
  ANALYSING
  IN_REVIEW
  SUPPLIER_LOOP
  READY_FOR_REVIEW
  SUBMITTED
  DECISION
  MAINTAINED
  ARCHIVED
  ERROR
}

enum RegDocKind {
  ORIGINAL
  WORKING
  APPROVED
}

enum RegDocSecurityStatus {
  PENDING
  SAFE
  BLOCKED_EXECUTABLE
  BLOCKED_ENCRYPTED
  BLOCKED_PATH
  BLOCKED_OVERSIZE
  SUSPICIOUS
  CORRUPTED
}

enum RegDocExtractionStatus {
  PENDING
  TEXT_EXTRACTED
  OCR_REQUIRED
  OCR_COMPLETED
  LOW_CONFIDENCE
  CORRUPTED
  PASSWORD_PROTECTED
  UNSUPPORTED
  MANUAL_REVIEW_REQUIRED
}

enum RegJobType {
  INGEST
  EXTRACT
  OCR
  CLASSIFY
  FACTS
  RULES
  AI_REVIEW
  /// Examen VISUEL des pages : figures (courbes, chromatogrammes, schémas) et contrôle de FORME
  /// (capture d'écran, photo d'écran, scan illisible, filigrane brouillon, signature absente) —
  /// des défauts structurellement invisibles dans le texte extrait.
  VISION
  CHALLENGER
  /// Simulation d'examen multi-perspectives — DERNIÈRE étape de l'analyse : le dossier ne passe
  /// « en revue » qu'une fois qu'on sait aussi ce que les examinateurs vont probablement demander.
  SIMULATE
}

enum RegJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

/// Déblocage du module Regulatory Intelligence PAR ORGANISATION (Company). Masqué par défaut.
model RegulatoryFeatureAccess {
  id          String   @id @default(cuid())
  companyId   String   @unique
  enabled     Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Un dossier réglementaire (un produit × une procédure) pour une organisation.
model RegulatoryDossier {
  id            String           @id @default(cuid())
  companyId     String
  productId     String? // lien optionnel vers RegulatoryProduct existant
  reference     String           @unique
  title         String
  procedureType RegProcedureType @default(INITIAL_REGISTRATION)
  status        RegDossierStatus @default(DRAFT)
  /// BUDGET IA MAXIMUM du dossier, en dollars. Au-delà, les analyses économiques s'arrêtent
  /// et l'écran le dit clairement plutôt que de laisser filer la facture. null = pas de
  /// plafond propre au dossier (le plafond global de `AppSetting` s'applique).
  aiBudgetUsd   Decimal?         @db.Decimal(10, 4)
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  versions         RegulatoryDossierVersion[]
  aiCalls          RegulatoryAiCall[]
  jobs             RegulatoryJob[]
  auditLogs        RegulatoryAuditLog[]
  reserveCycles    RegulatoryReserveCycle[]
  supplierRequests RegulatorySupplierRequest[]
  lifecycleEvents  RegulatoryLifecycleEvent[]
  obligations      RegulatoryObligation[]
  chatMessages     RegulatoryDossierChatMessage[]

  @@index([companyId])
  @@index([productId])
  @@index([status])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LA SURVEILLANCE DURABLE — « surveille ce dossier et préviens-moi seulement s'il y a un problème ».
///
/// Une surveillance est portée par une MISSION (kind WATCH) : c'est elle qui donne le journal
/// (`MissionEvent`), la porte d'attention (dédoublonnage, plafond, canaux), la conduite
/// (suspendre, arrêter) et l'écran — on ne recrée rien de tout cela. Cette table porte ce qui
/// est propre à une surveillance : la cible, les RÈGLES (évaluées par du code, jamais par un
/// modèle), la cadence, le dernier état observé et la dernière signature de problème signalée
/// — ce qui rend le « seulement s'il y a un problème » exact : le même problème n'est pas
/// re-signalé, un problème résolu se dit une fois, et rien ne dépend de la mémoire d'un
/// processus. Un redémarrage relit la table ; un fait métier qui touche la cible avance
/// `nextCheckAt` à maintenant (réveil par le registre d'événements).
/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UN MICRO-OUTIL CRÉÉ PAR ADAM (mandat 5 §36) : du code passé par la porte de qualité, exposé comme
/// outil TEMPORAIRE à son créateur, puis PROMU par une personne (jamais par l'agent) ou jeté.
/// Les connecteurs déclarés (`lib/skills/plugins/`) et les playbooks enseignés (règles WORKFLOW)
/// ne vivent pas ici : ils n'ont pas de code à garder.
model AdamSkill {
  id           String    @id @default(cuid())
  slug         String
  ownerId      String
  owner        User      @relation("AdamSkills", fields: [ownerId], references: [id], onDelete: Cascade)
  /// PERSON | GROUP | COMPANY — le périmètre de visibilité une fois PROMU.
  scope        String    @default("PERSON")
  companyId    String?
  departmentId String?
  title        String
  description  String    @db.Text
  domain       String    @default("DATA")
  /// js | python
  langage      String
  code         String    @db.Text
  inputSchema  Json
  exemple      Json?
  attentes     Json?
  schemaSortie Json?
  /// TEMP | PROMOTED | DROPPED
  status       String    @default("TEMP")
  version      Int       @default(1)
  usageCount   Int       @default(0)
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  promotedById String?
  promotedAt   DateTime?
  /// { threadId, missionId, porte: { tests, etapes } }
  provenance   Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([ownerId, slug])
  @@index([status, scope])
  @@index([companyId, status])
  @@index([departmentId, status])
}

/// UN FAIT REÇU DE L'EXTÉRIEUR (mandat 5 §37) — ce qu'un webhook a livré, sa source, son identifiant
/// fournisseur (exactly-once), ce qu'on en a décidé (accepté, doublon, rejeté, à vérifier) et le fait
/// du registre qu'il est devenu. Le registre canonique reste `BusinessEvent` (§17) : ceci est la
/// trace de RÉCEPTION, pas un second registre.
model IngestedEvent {
  id              String   @id @default(cuid())
  source          String
  externalId      String
  type            String
  /// ACCEPTED | DUPLICATE | REJECTED | A_VERIFIER | SANS_ASSOCIATION
  status          String
  confidence      Float?
  businessEventId String?
  refs            String[] @default([])
  candidats       Json?
  payload         Json?
  reason          String?
  receivedAt      DateTime @default(now())

  @@unique([source, externalId])
  @@index([status, receivedAt])
  @@index([type, receivedAt])
}

/// LA TRANSCRIPTION D'UN MÉDIA du Drive (mandat 5 §38) — segments horodatés, locuteurs, chapitres,
/// extraction (décisions, engagements, actions, entités), texte indexé. Une par version de fichier :
/// retranscrire la même version ne coûte rien, une nouvelle version fait une nouvelle transcription.
model MediaTranscript {
  id          String   @id @default(cuid())
  nodeId      String
  version     Int
  nom         String
  langue      String?
  dureeS      Int?
  modele      String
  /// [{ debut, fin, texte, locuteur }]
  segments    Json
  /// [{ debut, fin, titre, de, a }]
  chapitres   Json
  /// [{ locuteur, secondes, part, segments }]
  locuteurs   Json
  /// { decisions, engagements, actions, entites, questions } — instants en secondes
  extraction  Json?
  texte       String   @db.Text
  coutUsd     Float?
  horodate    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([nodeId, version])
  @@index([createdAt])
}

model AdamWatch {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation("AdamWatches", fields: [ownerId], references: [id], onDelete: Cascade)
  missionId     String    @unique
  mission       Mission   @relation("MissionWatch", fields: [missionId], references: [id], onDelete: Cascade)
  label         String
  /// REGULATORY_PRODUCT | REGULATORY_DOSSIER | TASK | EXPENSE_ORDER | PAYMENT_REQUEST | VALIDATION_REQUEST | PCH_TENDER | PRODUIT | ORGANISATION | PERSONNE
  targetType    String
  targetId      String
  targetRef     String?
  /// [{ code, jours?, valeurs?, champ?, op?, valeur? }] — voir `lib/missions/watch/rules.ts`.
  rules         Json
  /// ACTIVE | CLOSED (la pause passe par la mission-support).
  status        String    @default("ACTIVE")
  checkEveryH   Int       @default(24)
  nextCheckAt   DateTime  @default(now())
  lastCheckedAt DateTime?
  lastState     Json?
  lastSignature String?
  lastSignalAt  DateTime?
  closeReason   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextCheckAt])
  @@index([ownerId, status])
  @@index([targetType, targetId])
}

/// Une version reçue du dossier (fournisseur V1, V2…). Contient l'archive ORIGINALE figée.
model RegulatoryDossierVersion {
  id                String   @id @default(cuid())
  dossierId         String
  versionNo         Int
  label             String?
  originalZipBlobId String? // blob chiffré de l'archive reçue (immuable)
  originalSha256    String? // hash de l'archive AVANT toute transformation
  fileCount         Int      @default(0)
  totalBytes        Int      @default(0)
  createdById       String
  createdAt         DateTime @default(now())

  dossier       RegulatoryDossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  documents     RegulatoryDocument[]
  jobs          RegulatoryJob[]
  findings      RegulatoryFinding[]
  assessment    RegulatoryAssessment?
  facts         RegulatoryFact[]
  conflicts     RegulatoryConflict[]
  generatedDocs RegulatoryGeneratedDoc[]
  simulations   RegulatorySimulation[]

  @@unique([dossierId, versionNo])
  @@index([dossierId])
}

/// Un document du dossier = entrée de MANIFEST immuable + statut de sécurité/extraction.
/// L'ORIGINAL conserve toujours chemin + nom d'origine ; le renommage vise la copie de travail.
model RegulatoryDocument {
  id                   String                 @id @default(cuid())
  dossierVersionId     String
  kind                 RegDocKind             @default(ORIGINAL)
  originalPath         String // chemin exact dans l'archive
  originalFilename     String
  suggestedFilename    String?
  approvedFilename     String?
  ext                  String
  detectedMimeType     String?
  declaredMimeType     String?
  sizeBytes            Int                    @default(0)
  sha256               String
  compressionRatio     Float?
  securityStatus       RegDocSecurityStatus   @default(PENDING)
  extractionStatus     RegDocExtractionStatus @default(PENDING)
  blobId               String? // copie de travail chiffrée (si extraite)
  // Classification CTD déterministe (Phase 3) — proposition, jamais imposée.
  ctdModule            String? // "M1".."M5"
  ctdSection           String? // code CTD PRINCIPAL, ex. "3.2.P.8"
  containedSections    String[]               @default([]) // sections CTD AUSSI présentes (PDF consolidé « Module X.pdf »)
  ctdConfidence        Float? // 0..1
  classificationMethod String? // "code-path" | "keyword" | "module-only" | "none"
  createdAt            DateTime               @default(now())

  dossierVersion RegulatoryDossierVersion @relation(fields: [dossierVersionId], references: [id], onDelete: Cascade)
  extraction     RegulatoryExtraction?

  @@index([dossierVersionId])
  @@index([sha256])
  @@index([securityStatus])
}

/// Texte extrait d'un document (une entrée par document). Alimente règles + agents IA.
/// Contenu plafonné (colonne Text) ; `truncated` signale une troncature.
model RegulatoryExtraction {
  id            String   @id @default(cuid())
  documentId    String   @unique
  method        String // "plain" | "docx" | "xlsx" | "pdf-text" | "ocr" …
  lang          String?
  charCount     Int      @default(0)
  truncated     Boolean  @default(false)
  content       String // texte brut extrait
  // OCR (G13) — métadonnées séparées du texte natif : confiance, pages, revue humaine.
  ocrConfidence Float? // confiance moyenne OCR 0..100 (null si extraction native)
  pageCount     Int? // nombre de pages (source)
  ocrPages      Json? // [{ page, confidence, chars, lowConfidence }]
  /// pageMap[i] = position (caractères) du début de la page i+1 dans `content` — la carte qui
  /// rend un constat localisable AU CLIC (PDF ouvert à la page exacte). Null = extraction
  /// antérieure à la carte : on retombe sur l'estimation par tranches.
  pageMap       Json?
  needsReview   Boolean  @default(false) // pages de faible confiance → revue humaine
  createdAt     DateTime @default(now())

  document RegulatoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum RegFindingSeverity {
  CRITICAL
  MAJOR
  MINOR
  INFO
}

enum RegFindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WAIVED
}

enum RegFindingSource {
  RULE
  AI
  HUMAN
}

/// Constat d'analyse (moteur de règles déterministe OU agent IA OU humain). Preuve exigée.
/// Les constats CRITICAL marqués `blocker` verrouillent la soumission (pas de fausse conformité).
model RegulatoryFinding {
  id                String             @id @default(cuid())
  dossierVersionId  String
  code              String // ex. "MISSING_REQUIRED_SECTION"
  severity          RegFindingSeverity
  category          String // "completeness" | "security" | "extraction" | "classification" | "content"
  title             String
  detail            String
  evidence          String?
  sectionCode       String?
  documentId        String?
  source            RegFindingSource   @default(RULE)
  status            RegFindingStatus   @default(OPEN)
  blocker           Boolean            @default(false)
  draft             Boolean            @default(true) // sortie IA = DRAFT tant qu'un humain n'a pas revu
  // ── EXIGENCES DE QUALITÉ : un constat sans preuve ni règle n'est pas défendable devant
  //    l'ANPP. Ces champs rendent chaque finding vérifiable ligne par ligne.
  /// Règle appliquée (code de règle, article de ligne directrice, ou règle dérivée validée).
  ruleRef           String?
  /// Confiance 0..1 — une confiance basse appelle une relecture, elle ne se cache pas.
  confidence        Float?
  /// Page EXACTE dans le document visé.
  page              Int?
  /// Extrait EXACT, copié tel quel : c'est la pièce.
  excerpt           String?
  /// Valeurs qui se contredisent entre documents (ex. « 36 mois (3.2.P.8) vs 24 mois (RCP) »).
  conflictingValues String[]           @default([])
  /// Ce qu'il faut faire, concrètement, avant soumission.
  recommendation    String?
  /// Réserves ANPP historiques comparables — des PRÉCÉDENTS, jamais une règle opposable.
  similarReserveIds String[]           @default([])
  /// Probabilité (0..1) qu'une réserve de ce type soit émise, d'après nos précédents.
  reserveRisk       Float?
  resolutionNote    String? // justification humaine (obligatoire pour lever un bloqueur)
  reviewedById      String?
  reviewedAt        DateTime?
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  dossierVersion RegulatoryDossierVersion @relation(fields: [dossierVersionId], references: [id], onDelete: Cascade)

  @@index([dossierVersionId])
  @@index([severity])
  @@index([source])
}

enum RegSourceStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// CORPUS RÉGLEMENTAIRE VERSIONNÉ — une source (texte de loi/arrêté/guideline). Remplace
/// progressivement `anpp-knowledge.ts` (corpus legacy). Une source a plusieurs versions.
model RegulatorySource {
  id           String   @id @default(cuid())
  authority    String // "ANPP" | "EMA" | "ICH" | "FDA"…
  jurisdiction String // "DZ" | "EU" | "ICH"…
  code         String // ex. "Arrêté 2021-05-10"
  title        String
  language     String   @default("fr")
  /// CATÉGORIE du corpus de connaissance — le corpus n'est pas que réglementaire pharma :
  /// « Droit du travail » | « Droit fiscal » | « Droit des sociétés » | « ANPP » | « MIPH » |
  /// « Enregistrement » | « Marchés publics / PCH » | « Interne »… Libre mais filtrable.
  category     String?
  sourceUrl    String? // référence officielle
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions RegulatorySourceVersion[]

  @@index([authority])
  @@index([jurisdiction])
  @@index([category])
}

/// Version datée d'une source : texte original + hash, statut (ACTIVE = fait foi), approbation.
model RegulatorySourceVersion {
  id                   String          @id @default(cuid())
  sourceId             String
  version              String
  publishedAt          DateTime?
  effectiveAt          DateTime?
  status               RegSourceStatus @default(DRAFT)
  hash                 String? // sha-256 du texte original
  originalText         String? // texte intégral (peut être volumineux)
  /// D'où vient le texte : "texte" (natif) ou "ocr" (scan reconnu). Une source océrisée n'est
  /// pas une lecture de la loi : l'écran le dit, et Adam ne la cite pas comme un texte natif.
  extractionMethod     String?
  /// Confiance moyenne de l'OCR (0-100). NULL pour un texte natif.
  extractionConfidence Float?
  supersedesId         String? // version remplacée
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  source    RegulatorySource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sections  RegulatorySourceSection[]
  approvals RegulatoryCorpusApproval[]

  @@index([sourceId])
  @@index([status])
}

/// Section/article d'une version — unité de découpage pour le RAG + citation exacte.
model RegulatorySourceSection {
  id              String   @id @default(cuid())
  sourceVersionId String
  path            String // "art. 4" | "annexe I" | "3.2.P.8"…
  heading         String?
  text            String
  ordinal         Int      @default(0)
  createdAt       DateTime @default(now())

  sourceVersion RegulatorySourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  /// Vecteur sémantique (512d) — recherche trans-langue FR↔EN. Null = pas encore vectorisé.
  embedding     Json?

  @@index([sourceVersionId])
}

/// Traçabilité d'approbation d'une version de corpus (qui a validé/activé/retiré).
model RegulatoryCorpusApproval {
  id              String   @id @default(cuid())
  sourceVersionId String
  approverId      String
  decision        String // "APPROVED" | "ACTIVATED" | "RETIRED" | "REJECTED"
  note            String?
  createdAt       DateTime @default(now())

  sourceVersion RegulatorySourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)

  @@index([sourceVersionId])
}

enum RegFactStatus {
  PROPOSED
  CONFIRMED
  CORRECTED
  REJECTED
}

/// JUMEAU NUMÉRIQUE — un fait réglementaire canonique par (version, clé) : valeur proposée
/// puis approuvée par un humain. Chaque valeur trouvée est une OCCURRENCE sourcée.
model RegulatoryFact {
  id               String        @id @default(cuid())
  dossierVersionId String
  factKey          String // "INN", "STRENGTH", "SHELF_LIFE"…
  label            String
  value            String? // valeur canonique proposée
  unit             String?
  status           RegFactStatus @default(PROPOSED)
  hasConflict      Boolean       @default(false)
  approvedValue    String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  dossierVersion RegulatoryDossierVersion   @relation(fields: [dossierVersionId], references: [id], onDelete: Cascade)
  occurrences    RegulatoryFactOccurrence[]

  @@unique([dossierVersionId, factKey])
  @@index([dossierVersionId])
}

/// Une occurrence sourcée d'un fait : document + section (+ page quand l'OCR la fournit),
/// extrait EXACT, confiance, méthode d'extraction, statut humain, date d'effet.
model RegulatoryFactOccurrence {
  id              String    @id @default(cuid())
  factId          String
  documentId      String
  sectionCode     String?
  page            Int?
  rawValue        String
  normalizedValue String?
  extract         String // extrait exact du document (preuve)
  confidence      Float     @default(0)
  method          String // "regex" | "keyword" | "label" | "ai"
  humanStatus     String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  effectiveDate   DateTime?
  createdAt       DateTime  @default(now())

  fact RegulatoryFact @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@index([factId])
  @@index([documentId])
}

enum RegConflictStatus {
  OPEN
  RESOLVED
  WAIVED
}

/// CONFLIT : valeurs concurrentes d'un même fait entre documents/modules. `values` = toutes
/// les occurrences opposées (valeur, source, section, extrait). Résolution humaine → valeur finale.
model RegulatoryConflict {
  id               String             @id @default(cuid())
  dossierVersionId String
  factKey          String
  label            String
  severity         RegFindingSeverity @default(MAJOR)
  status           RegConflictStatus  @default(OPEN)
  values           Json // [{ value, documentId, sectionCode, extract, confidence }]
  proposedAction   String?
  resolutionNote   String?
  finalValue       String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  dossierVersion RegulatoryDossierVersion @relation(fields: [dossierVersionId], references: [id], onDelete: Cascade)

  @@index([dossierVersionId])
}

/// Bilan de complétude/conformité d'une version (recalculé à chaque passage du moteur).
/// `conforme` = aucun bloqueur — un score élevé NE suffit PAS si un bloqueur existe.
model RegulatoryAssessment {
  id               String   @id @default(cuid())
  dossierVersionId String   @unique
  completeness     Int      @default(0) // 0..100
  conforme         Boolean  @default(false)
  blockers         Int      @default(0)
  criticals        Int      @default(0)
  majors           Int      @default(0)
  minors           Int      @default(0)
  requiredPresent  Int      @default(0)
  requiredTotal    Int      @default(0)
  computedAt       DateTime @default(now())

  dossierVersion RegulatoryDossierVersion @relation(fields: [dossierVersionId], references: [id], onDelete: Cascade)
}

/// File de jobs asynchrones (Node-first, en base). Runner idempotent, reprise, progression.
model RegulatoryJob {
  id               String       @id @default(cuid())
  companyId        String?
  dossierId        String?
  dossierVersionId String?
  type             RegJobType
  status           RegJobStatus @default(QUEUED)
  progress         Int          @default(0)
  attempts         Int          @default(0)
  maxAttempts      Int          @default(3)
  lockedAt         DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  error            String?
  payload          Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  dossier        RegulatoryDossier?        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierVersion RegulatoryDossierVersion? @relation(fields: [dossierVersionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([dossierId])
}

/// Journal d'audit dédié Regulatory Intelligence (qui, quoi, quand, preuve/méta).
model RegulatoryAuditLog {
  id               String   @id @default(cuid())
  companyId        String?
  actorId          String
  dossierId        String?
  dossierVersionId String?
  action           String
  detail           String
  meta             Json?
  createdAt        DateTime @default(now())

  dossier RegulatoryDossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([companyId])
  @@index([createdAt])
}

enum RegRuleKind {
  SECTION_REQUIRED // section CTD dont l'absence est un bloqueur
  SECTION_EXPECTED // section CTD attendue (non bloquante)
  DOCUMENT_PRESENT // au moins un document rattaché à une section
  FACT_REQUIRED // un fait du jumeau numérique doit être renseigné
  CUSTOM // logique portée par `params` (réservé, non exécuté par défaut)
}

/// MOTEUR DE RÈGLES ADMINISTRABLE (G5) — un « rule pack » regroupe des règles versionnées,
/// approuvées puis activées (ACTIVE = fait foi). Remplace progressivement les profils codés
/// en dur (`requirements.ts`), conservés comme repli tant qu'aucun pack actif n'existe.
model RegulatoryRulePack {
  id           String          @id @default(cuid())
  code         String          @unique // ex. "ANPP-ENREGISTREMENT-IMPORTE"
  name         String
  description  String?
  jurisdiction String          @default("DZ")
  version      String          @default("1.0")
  status       RegSourceStatus @default(DRAFT)
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  rules RegulatoryRule[]

  @@index([status])
  @@index([jurisdiction])
}

/// Une règle exécutable, sourcée sur le corpus (citation) — appliquée par le moteur déterministe.
/// `procedureTypes`/`productTypes` = applicabilité (vide = toutes). `tests` = cas golden (JSON).
model RegulatoryRule {
  id              String             @id @default(cuid())
  packId          String
  code            String // unique dans le pack
  kind            RegRuleKind        @default(SECTION_REQUIRED)
  sectionCode     String? // section CTD ciblée (ex. "3.2.P.8")
  factKey         String? // pour FACT_REQUIRED
  severity        RegFindingSeverity @default(CRITICAL)
  blocker         Boolean            @default(true)
  title           String
  detail          String?
  remediation     String? // comment corriger
  procedureTypes  String[] // RegProcedureType[] applicables (vide = toutes)
  productTypes    String[] // "MEDICINE" | "MEDICAL_DEVICE" (vide = tous)
  sourceVersionId String? // lien corpus (citation)
  sourcePath      String? // ex. "art. 4" dans la source
  effectiveAt     DateTime? // date d'entrée en vigueur
  active          Boolean            @default(true)
  params          Json? // logique étendue (CUSTOM)
  tests           Json? // cas de test golden : [{ name, docs:[{section}], facts:[key], expectPass }]
  ordinal         Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  pack RegulatoryRulePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, code])
  @@index([packId])
  @@index([kind])
}

enum RegUploadStatus {
  UPLOADING
  FINALIZING
  COMPLETED
  ABORTED
}

/// UPLOAD RÉSUMABLE DE GROS FICHIERS (G14) — session d'envoi par parties. Chaque partie est
/// stockée séparément → le chemin d'upload ne charge JAMAIS l'archive complète en RAM. La
/// finalisation vérifie taille + SHA-256 côté stockage puis produit un FileBlob (inspection
/// seulement APRÈS finalisation). Quotas par organisation appliqués à la création.
model RegulatoryUploadSession {
  id              String          @id @default(cuid())
  companyId       String
  dossierId       String?
  createdById     String
  filename        String
  contentType     String?
  totalBytes      BigInt // taille annoncée (contrôlée à la création : quota + capacité)
  partSize        Int // taille de partie attendue
  expectedSha256  String? // SHA-256 annoncé (vérifié à la finalisation si fourni)
  receivedBytes   BigInt          @default(0)
  status          RegUploadStatus @default(UPLOADING)
  blobId          String? // renseigné après finalisation
  storageKey      String? // clé objet S3/R2 pour l'upload DIRECT (chantier 1) ; null = mode résumable
  /// Identifiant du téléversement EN PLUSIEURS PARTIES piloté par le navigateur. Renseigné, il
  /// signifie que les parties montent en parallèle vers le bucket et qu'il faudra les recoller
  /// (`CompleteMultipartUpload`) à la finalisation — ou les libérer à l'abandon.
  storageUploadId String?
  versionId       String? // version de dossier créée à la finalisation
  error           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  parts RegulatoryUploadPart[]

  @@index([companyId])
  @@index([status])
  @@index([dossierId])
}

/// Une partie reçue d'une session d'upload (octets chiffrés au repos non requis ici : données
/// transitoires supprimées à la finalisation/abandon). Idempotent par index → reprise possible.
model RegulatoryUploadPart {
  id        String   @id @default(cuid())
  sessionId String
  index     Int
  size      Int
  sha256    String
  data      Bytes
  createdAt DateTime @default(now())

  session RegulatoryUploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, index])
  @@index([sessionId])
}

/// GÉNÉRATION DOCUMENTAIRE (G10) — un document produit à partir d'un TEMPLATE versionné et des
/// données du JUMEAU NUMÉRIQUE APPROUVÉ (jamais d'extraction libre). Traçable : quel template,
/// quelle version, quel instant, quel blob produit.
model RegulatoryGeneratedDoc {
  id               String   @id @default(cuid())
  dossierVersionId String
  templateCode     String
  templateVersion  String
  filename         String
  blobId           String // docx chiffré (putBlob)
  sizeBytes        Int      @default(0)
  factsUsed        Int      @default(0)
  factsMissing     Int      @default(0)
  generatedById    String
  createdAt        DateTime @default(now())

  dossierVersion RegulatoryDossierVersion @relation(fields: [dossierVersionId], references: [id], onDelete: Cascade)

  @@index([dossierVersionId])
}

/// MESSAGERIE DU DOSSIER — le fil « Discuter avec ce dossier » PERSISTE côté serveur, comme une
/// messagerie : on quitte l'app, on revient, la discussion est là. UN fil par (dossier, utilisateur).
/// Les pièces soumises conservent leur TEXTE EXTRAIT dans `attachments` : l'agent continue de les
/// voir aux tours suivants (une lettre de réserves envoyée hier reste discutable aujourd'hui).
model RegulatoryDossierChatMessage {
  id          String   @id @default(cuid())
  dossierId   String
  userId      String
  role        String // "user" | "assistant"
  content     String
  citations   Json? // ChatCitation[] (réponses de l'agent)
  files       Json? // AgentFile[] — PDF générés par l'agent
  attachments Json? // pièces soumises : { filename, text? (extrait conservé), error? (motif d'illisibilité) }
  error       Boolean  @default(false)
  createdAt   DateTime @default(now())

  dossier RegulatoryDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId, userId, createdAt])
}

enum RegReservePointStatus {
  OPEN
  DRAFTED
  APPROVED
}

/// RÉSERVES ANPP (G9) — un CYCLE de réserves = une lettre reçue de l'ANPP, océrisée (texte
/// verbatim), décomposée en POINTS catégorisés, chacun avec réponse proposée puis approuvée.
/// Multi-cycles (1ʳᵉ lettre, 2ᵉ lettre…). Traçable.
model RegulatoryReserveCycle {
  id             String   @id @default(cuid())
  dossierId      String
  cycle          Int      @default(1)
  /// Type de réserve ANPP : TECHNICO_REGLEMENTAIRE (module 1) | QC (contrôle qualité sur place,
  /// rare) | EVALUATION_SCIENTIFIQUE (modules 3 et 5 — les plus nombreuses). Classifié
  /// automatiquement depuis le texte de la lettre ; null = indéterminé.
  reserveType    String?
  letterFilename String
  letterBlobId   String? // lettre chiffrée (putBlob)
  ocrText        String? // texte VERBATIM extrait (OCR réel)
  ocrConfidence  Float?
  ocrNeedsReview Boolean  @default(false)
  status         String   @default("OPEN") // OPEN | RESPONDED | CLOSED
  receivedAt     DateTime @default(now())
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dossier RegulatoryDossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  points  RegulatoryReservePoint[]

  @@index([dossierId])
}

/// Un point de réserve décomposé : extrait verbatim, catégorie, réponse proposée/approuvée.
model RegulatoryReservePoint {
  id               String                @id @default(cuid())
  cycleId          String
  ordinal          Int                   @default(0)
  category         String                @default("AUTRE")
  /// Section CTD sous laquelle la lettre range ce point (ex. « 3.2.S.4.3 ») — les lettres ANPP
  /// d'évaluation scientifique sont structurées ainsi. Reprise de l'EN-TÊTE, jamais inventée.
  sectionCode      String?
  /// Sujet porté par l'en-tête englobant, verbatim (ex. « LAMIVUDINE », « Produit fini ») :
  /// sans lui, « compléter les données de stabilité » ne dit pas de QUELLE substance il s'agit.
  subject          String?
  verbatim         String // extrait EXACT de la lettre
  proposedResponse String? // brouillon de réponse (humain ou IA)
  finalResponse    String? // réponse approuvée
  evidence         String? // preuves/annexes citées (texte libre)
  status           RegReservePointStatus @default(OPEN)
  assignedToId     String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  cycle RegulatoryReserveCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
}

/// COÛT DE L'IA, appel par appel — la seule façon honnête de répondre à « combien coûte ce
/// dossier ? ». Rattaché au DOSSIER, à l'ÉTAPE et au FICHIER : c'est ce niveau de détail qui
/// permet de voir quel document ou quelle étape mange le budget, et de le corriger.
///
/// `cacheKey` est l'empreinte de l'entrée (SHA-256 du prompt + modèle + schéma) : deux analyses
/// identiques ne sont facturées qu'une fois, et un fichier inchangé entre deux versions du
/// dossier n'est jamais ré-analysé.
model RegulatoryAiCall {
  id               String   @id @default(cuid())
  dossierId        String?
  dossierVersionId String?
  documentId       String? /// fichier concerné, quand l'appel porte sur un document précis
  step             String /// "classify" | "review" | "facts" | "reserve-extract" | "reserve-similar"…
  provider         String   @default("openai") /// openai | anthropic | mistral
  model            String
  batch            Boolean  @default(false)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cachedTokens     Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs        Int?
  ok               Boolean  @default(true)
  errorCode        String?
  /// Empreinte de l'entrée : permet de retrouver un résultat déjà calculé (0 $ au lieu de refacturer).
  cacheKey         String?
  /// Vrai si la réponse a été SERVIE DEPUIS LE CACHE (coût réel nul, tracé quand même).
  fromCache        Boolean  @default(false)
  createdAt        DateTime @default(now())

  dossier RegulatoryDossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId, createdAt])
  @@index([dossierVersionId])
  @@index([step])
  @@index([cacheKey])
}

/// LOT D'ANALYSE DIFFÉRÉE (Batch) — la voie à MOITIÉ PRIX.
///
/// Le fournisseur facture deux fois moins cher les analyses qu'on accepte d'attendre (jusqu'à
/// 24 h). C'est sans intérêt pour une analyse qu'on regarde tout de suite, et très intéressant
/// pour une RÉANALYSE COMPLÈTE de dossier — qu'on lance le soir et qu'on lit le lendemain.
///
/// `mapping` relie chaque réponse du lot au document et à la part de texte d'origine : sans lui,
/// un résultat revenu 12 h plus tard ne serait rattachable à rien.
model RegulatoryAiBatch {
  id               String    @id @default(cuid())
  companyId        String?
  dossierId        String?
  dossierVersionId String?
  step             String /// "review" | "reserve-extract"…
  provider         String    @default("openai")
  model            String
  /// Identifiant du lot chez le fournisseur.
  externalId       String    @unique
  inputFileId      String?
  outputFileId     String?
  /// submitted | in_progress | completed | failed | cancelled | expired
  status           String    @default("submitted")
  requestCount     Int       @default(0)
  completedCount   Int       @default(0)
  failedCount      Int       @default(0)
  /// customId → { documentId, filename, ctdSection, part, total } — sans quoi les résultats
  /// différés seraient orphelins.
  mapping          Json?
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  costUsd          Decimal   @default(0) @db.Decimal(10, 6)
  findingsCreated  Int       @default(0)
  error            String?
  createdById      String?
  submittedAt      DateTime  @default(now())
  completedAt      DateTime?
  processedAt      DateTime? /// résultats lus ET persistés (garde-fou d'idempotence)
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([dossierId])
  @@index([dossierVersionId])
}

/// RÉSULTAT D'ANALYSE MIS EN CACHE — indexé par empreinte d'entrée. C'est ce qui rend
/// l'analyse d'une V2 quasi gratuite quand seuls quelques fichiers ont changé : tout ce qui
/// est identique est relu ici, jamais recalculé.
model RegulatoryAiCache {
  id        String    @id @default(cuid())
  cacheKey  String    @unique
  step      String
  model     String
  /// Réponse brute (texte ou JSON) telle qu'elle a été produite.
  payload   String
  hits      Int       @default(0)
  lastHitAt DateTime?
  createdAt DateTime  @default(now())

  @@index([step])
}

// ═══════════════════ BIBLIOTHÈQUE DES RÉSERVES ANPP (apprentissage) ═══════════════════
//
// Les modèles `RegulatoryReserveCycle` / `RegulatoryReservePoint` ci-dessus restent : ils
// gèrent le TRAITEMENT d'une lettre de réserves sur UN dossier. Ce qui suit est autre chose —
// une bibliothèque TRANSVERSE, indépendante des dossiers, qui permet de répondre à :
//   « cette réserve, l'avons-nous déjà reçue ? sur quel produit ? qu'avions-nous répondu ?
//     l'ANPP l'a-t-elle acceptée ? ce fournisseur la déclenche-t-il souvent ? »
//
// RÈGLE ABSOLUE — pas d'apprentissage aveugle : une réserve historique n'est JAMAIS une règle
// opposable. Elle devient un PRÉCÉDENT que l'on montre, et éventuellement une RÈGLE DÉRIVÉE
// qu'un humain du Regulatory doit valider explicitement avant qu'elle ne produise le moindre
// finding.

/// Cycle de vie d'une réserve, du point de vue de l'apprentissage.
enum AnppReserveStatus {
  OPEN /// reçue, pas encore répondue
  ANSWERED /// réponse envoyée à l'ANPP
  ACCEPTED /// l'ANPP a accepté la réponse → exemple POSITIF
  REITERATED /// l'ANPP a redemandé → exemple NÉGATIF (la réponse n'a pas suffi)
  CLOSED /// clôturée (acceptée ou abandonnée), plus d'action attendue
}

enum AnppReserveSeverity {
  CRITICAL /// bloque l'enregistrement
  MAJOR /// exige une correction documentée
  MINOR /// remarque de forme
}

/// LOT DE RÉSERVES — une lettre, un courriel, un tableau reçu de l'ANPP. Conserve le fichier
/// d'origine et son empreinte : la preuve doit rester vérifiable des années plus tard.
model AnppReserveBatch {
  id             String   @id @default(cuid())
  companyId      String?
  /// Dossier d'origine, quand la lettre vient d'un dossier suivi dans la plateforme.
  dossierId      String?
  /// Cycle de réserves d'origine, si l'import vient du traitement d'une lettre.
  sourceCycleId  String?
  sourceFilename String
  sourceKind     String   @default("PDF") /// PDF | SCAN | DOCX | XLSX | EMAIL | TEXT
  blobId         String? /// fichier d'origine, chiffré
  sha256         String /// empreinte du fichier : dédoublonne les imports
  receivedAt     DateTime @default(now())
  /// Texte VERBATIM extrait (OCR ou parse) — jamais réécrit.
  rawText        String?
  ocrConfidence  Float?
  pageCount      Int      @default(0)
  extractedCount Int      @default(0)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reserves AnppReserve[]

  @@unique([sha256])
  @@index([companyId])
  @@index([dossierId])
  @@index([receivedAt])
}

/// UNE RÉSERVE ANPP, normalisée et rattachée à son contexte produit et CTD.
model AnppReserve {
  id      String @id @default(cuid())
  batchId String
  ordinal Int    @default(0)

  // ── Contexte produit (ce qui permet de dire « déjà vu sur ce type de produit »)
  productName   String?
  dci           String?
  pharmaForm    String?
  dosage        String?
  procedureType String? /// INITIAL_REGISTRATION | VARIATION | RENEWAL…
  supplier      String? /// fournisseur / fabricant visé — clé des statistiques par fournisseur
  productId     String? /// rattachement au catalogue Regulatory, si identifié

  // ── Localisation CTD
  ctdModule  String? /// "M1".."M5"
  ctdSection String? /// "3.2.P.8.3"…

  // ── La réserve elle-même
  verbatim        String /// TEXTE EXACT de la réserve — jamais reformulé
  category        String              @default("AUTRE")
  severity        AnppReserveSeverity @default(MAJOR)
  targetDocument  String? /// document ou donnée visé(e) par la réserve
  legalBasis      String? /// justification réglementaire citée par l'ANPP, le cas échéant
  requestedAction String? /// ce que l'ANPP demande concrètement

  // ── Notre réponse et son issue
  response       String? /// réponse envoyée par Adventum ou le fournisseur
  responseAt     DateTime?
  correctiveDocs String[]          @default([]) /// documents correctifs fournis
  status         AnppReserveStatus @default(OPEN)
  outcomeNote    String? /// pourquoi acceptée / pourquoi réitérée — l'enseignement réel
  closedAt       DateTime?

  // ── PREUVE : sans elle, rien n'est opposable
  evidenceFile    String? /// nom du fichier d'où vient la réserve
  evidencePage    Int? /// page exacte
  evidenceExcerpt String? /// extrait exact, tel quel

  /// Confiance de l'EXTRACTION automatique (0..1). Une extraction peu sûre doit être relue.
  extractionConfidence Float?
  /// Un humain a-t-il vérifié cette fiche ? Tant que non, elle ne sert que d'indication.
  verifiedById         String?
  verifiedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch     AnppReserveBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// Vecteur sémantique (512d) — rapprochement des précédents au sens, pas au mot.
  embedding Json?

  @@index([batchId])
  @@index([ctdModule, ctdSection])
  @@index([category])
  @@index([status])
  @@index([supplier])
  @@index([dci])
}

enum AnppRuleStatus {
  PROPOSED /// dérivée automatiquement — n'a AUCUN effet tant qu'elle n'est pas validée
  VALIDATED /// un humain du Regulatory l'a acceptée : elle peut produire des findings
  REJECTED /// écartée — conservée pour ne pas la reproposer sans fin
}

/// RÈGLE DÉRIVÉE d'un ensemble de réserves récurrentes.
///
/// C'est ici que se joue « apprendre sans apprendre aveuglément » : le système PROPOSE une
/// règle quand il voit le même reproche revenir, mais elle reste inerte jusqu'à validation
/// humaine. Elle cite toujours les réserves qui la fondent — on peut donc toujours remonter
/// aux preuves.
model AnppDerivedRule {
  id                 String              @id @default(cuid())
  title              String
  statement          String /// la règle, formulée en une phrase vérifiable
  ctdModule          String?
  ctdSection         String?
  category           String              @default("AUTRE")
  severity           AnppReserveSeverity @default(MAJOR)
  /// Identifiants des réserves qui fondent la règle — la preuve, toujours.
  evidenceReserveIds String[]            @default([])
  /// Nombre de réserves observées à l'appui.
  occurrences        Int                 @default(0)
  /// Confiance (0..1) : croît avec le nombre d'occurrences et les acceptations obtenues.
  confidence         Float               @default(0)
  status             AnppRuleStatus      @default(PROPOSED)
  reviewNote         String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([ctdModule, ctdSection])
}

/// REVIEWER SIMULATOR (G11) — stress test MULTI-PERSPECTIVES du dossier, présenté comme une
/// SIMULATION INTERNE NON PRÉDICTIVE (jamais une décision ANPP). Résultats par perspective
/// (verdict simulé, questions probables, risques), tracés.
model RegulatorySimulation {
  id               String   @id @default(cuid())
  dossierVersionId String
  perspectives     Json // [{ perspective, verdict, questions[], risks[] }]
  overall          String? // synthèse simulée
  configured       Boolean  @default(false) // IA réellement appelée ?
  createdById      String
  createdAt        DateTime @default(now())

  dossierVersion RegulatoryDossierVersion @relation(fields: [dossierVersionId], references: [id], onDelete: Cascade)

  @@index([dossierVersionId])
}

enum RegSupplierStatus {
  DRAFT
  SENT
  RESPONDED
  CLOSED
}

/// BOUCLE FOURNISSEUR (G8) — demande de compléments au fournisseur : tableau de questions,
/// BROUILLON d'e-mail (l'IA ne crée qu'un brouillon ; l'envoi reste une action humaine),
/// échéance, réponse, relance, historique. Rattachée au dossier.
model RegulatorySupplierRequest {
  id            String            @id @default(cuid())
  dossierId     String
  supplierName  String?
  supplierEmail String?
  subject       String
  emailDraft    String? // brouillon (IA ou modèle) — jamais envoyé automatiquement
  status        RegSupplierStatus @default(DRAFT)
  deadline      DateTime?
  createdById   String
  sentAt        DateTime?
  remindedAt    DateTime?
  respondedAt   DateTime?
  responseNote  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  dossier   RegulatoryDossier            @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  questions RegulatorySupplierQuestion[]

  @@index([dossierId])
}

/// Une question posée au fournisseur (+ réponse reçue).
model RegulatorySupplierQuestion {
  id        String   @id @default(cuid())
  requestId String
  ordinal   Int      @default(0)
  question  String
  answer    String?
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())

  request RegulatorySupplierRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

enum RegLifecycleKind {
  SUBMISSION
  SEQUENCE
  SUPPLEMENT
  MODIFICATION
  RENEWAL
  RESPONSE
  APPROVED
  WITHDRAWAL
}

enum RegLifecycleOperation {
  NEW
  REPLACE
  DELETE
  APPEND
}

enum RegObligationStatus {
  OPEN
  DONE
  OVERDUE
}

/// LIFECYCLE (G12) — chronologie réglementaire d'un dossier : soumission initiale, séquences,
/// compléments, modifications, renouvellements, réponses, version approuvée. Opérations
/// NEW/REPLACE/DELETE/APPEND sur les pièces. Tracé.
model RegulatoryLifecycleEvent {
  id            String                 @id @default(cuid())
  dossierId     String
  kind          RegLifecycleKind
  sequenceNo    Int?
  operation     RegLifecycleOperation?
  label         String
  note          String?
  effectiveDate DateTime?
  createdById   String
  createdAt     DateTime               @default(now())

  dossier RegulatoryDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
}

/// OBLIGATION post-enregistrement / certificat expirant (G12) — échéance + suivi.
model RegulatoryObligation {
  id          String              @id @default(cuid())
  dossierId   String
  label       String
  certType    String? // "CPP" | "GMP" | "AMM"… si applicable
  dueDate     DateTime?
  status      RegObligationStatus @default(OPEN)
  note        String?
  createdById String
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  dossier RegulatoryDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([status])
}

// ═══════════════════════ Force de vente & prévisions (SFE) ═══════════════════════
// Fondation « par produit » : Société → BU (franchise) → produits promus ; cycles mensuels ;
// prévisions Direction par produit ; paramètres 100% configurables (capacité, positions, fréquences).

enum CycleStatus {
  OPEN
  CLOSED
}

// Business Unit / franchise thérapeutique (Neurology, Infectiologie, Urologie…). Rattachée à une société.
/// LA BUSINESS UNIT — l'unité de la force de vente, et rien d'autre au-dessus d'elle.
///
/// Elle portait autrefois seulement un nom et un chef ; le superviseur et les KAM vivaient sur
/// une `SalesTeam` intermédiaire, qui redisait ce qu'était la BU. Monter une force de vente
/// demandait alors quatre allers-retours entre deux écrans, et personne ne savait laquelle des
/// deux faisait autorité. Une BU EST une équipe : un superviseur, des KAM, un canal, des produits.
model BusinessUnit {
  id           String         @id @default(cuid())
  companyId    String?
  company      Company?       @relation(fields: [companyId], references: [id])
  name         String
  code         String?
  color        String?
  headId       String? // chef de BU (id utilisateur, résolu en requête)
  /// LE SUPERVISEUR de la force de vente de cette BU — celui à qui remontent les alertes terrain
  /// et qui a le droit d'éditer les affectations de SES KAM (et d'eux seuls).
  supervisorId String?
  /// LE TERRAIN COUVERT : officine de ville, secteur hospitalier, ou les deux. Il qualifie la BU
  /// entière — c'est la question qu'on pose en la créant, pas produit par produit.
  channel      ProductChannel @default(BOTH)
  /// LE SOUS-DÉPARTEMENT de la BU, sous la Direction commerciale.
  ///
  /// Une Business Unit a un budget Ad&Pro et une masse salariale : ce sont exactement les deux
  /// choses qu'un DÉPARTEMENT porte déjà, avec ses écrans, ses droits, ses demandes et son
  /// arbre. Lui donner ses propres colonnes de budget aurait créé un second mécanisme à côté de
  /// celui qui marche — et deux réponses à « combien la gamme a-t-elle dépensé ? ».
  ///
  /// Nul = BU non encore rattachée : elle vit, mais elle n'a ni budget ni masse salariale.
  departmentId String?
  department   Department?    @relation("BusinessUnitDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  sortOrder    Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  products               PromoProduct[]
  /// LES KAM de la BU — le rattachement direct, sans étage intermédiaire.
  reps                   SalesRepProfile[]
  /// SES SECTEURS — les territoires nommés sur lesquels ses KAM sont affectés.
  sectors                SalesSector[]
  /// LES MESSAGES PRÉ-DÉFINIS que la Direction Marketing lui a écrits.
  promoMessages          PromoMessage[]
  tenders                PchTender[]
  /// LES LOTS D'APPEL D'OFFRES qui lui sont affectés, produit par produit.
  tenderLines            PchTenderLineBusinessUnit[]
  /// LES DEMANDES Ad&Pro qui engagent son budget.
  sponsorings            SponsoringRequest[]             @relation("AdProSponsoringRequest")
  congressNationaux      CongressNational[]              @relation("AdProCongressNational")
  congressInternationaux CongressInternational[]         @relation("AdProCongressInternational")
  events                 Event[]                         @relation("AdProEvent")
  promoMaterials         PromoMaterial[]                 @relation("AdProPromoMaterial")
  consultings            ConsultingContract[]            @relation("AdProConsulting")
  autresDemandes         AdProOtherRequest[]             @relation("AdProOther")
  marketingReferents     BusinessUnitMarketingReferent[] @relation("AdProMarketingReferents")
  /// SES STRATÉGIES DE SEGMENTATION (Segmentation Studio) — une active à la fois en pratique, l'historique gardé.
  segmentationStrategies SegmentationStrategie[]
  /// LA RÉPARTITION DE SES COÛTS PARTAGÉS entre ses produits, année par année.
  repartitionsCouts      CoutRepartitionBu[]
  /// LES SPÉCIALITÉS QU'ELLE VISE (§118.183) — plusieurs, dont une principale facultative.
  specialites            BusinessUnitSpecialty[]

  @@index([companyId])
  @@index([supervisorId])
}

/// UNE BUSINESS UNIT VISE PLUSIEURS SPÉCIALITÉS (§118.183) — « BU ≠ spécialité ».
///
/// La BU Specialty Care vise la neurologie, la dermatologie et l'urologie : une colonne `specialtyId`
/// sur la BU aurait interdit ce cas. La PRINCIPALE est un drapeau facultatif, qui sert l'affichage et
/// ne restreint rien ; « au plus une principale par BU » est tenu par un index PARTIEL de la migration
/// (`BusinessUnitSpecialty_une_principale`), que ce schéma ne sait pas déclarer.
model BusinessUnitSpecialty {
  id             String           @id @default(cuid())
  businessUnitId String
  businessUnit   BusinessUnit     @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  specialtyId    String
  /// RESTRICT : retirer du référentiel une spécialité qu'une BU vise changerait, en silence, ce que la
  /// BU concerne — l'action refuse en nommant les BU, et la base refuse aussi.
  specialty      MedicalSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  principale     Boolean          @default(false)
  createdById    String?
  createdAt      DateTime         @default(now())

  @@unique([businessUnitId, specialtyId])
  @@index([specialtyId])
}

// Produit promu (marque marketing) — catalogue structuré pour l'affectation et les prévisions.
// Canal de distribution d'un produit : officine de VILLE, secteur HOSPITALIER, ou LES DEUX.
enum ProductChannel {
  RETAIL // produit de ville (officine)
  HOSPITAL // produit hospitalier
  BOTH // les deux
}

model PromoProduct {
  id                  String             @id @default(cuid())
  /// Le dossier réglementaire du produit promu, quand il est confirmé. Même règle que pour
  /// `BdProduct` : proposé par le rapprochement, validé par une personne, jamais imposé.
  regulatoryProductId String?
  regulatoryProduct   RegulatoryProduct? @relation("PromoProductDossier", fields: [regulatoryProductId], references: [id], onDelete: SetNull)
  name                String
  code                String?
  channel             ProductChannel     @default(BOTH) // Ville / Hôpital / les deux
  businessUnitId      String?
  businessUnit        BusinessUnit?      @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  managerId           String? // chef de produit (id utilisateur)
  isActive            Boolean            @default(true)
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  forecasts         ProductForecast[]
  assignments       PromotionAssignment[]
  /// LE PRODUIT CANONIQUE. Coexiste avec `regulatoryProductId` : le premier dit QUEL produit,
  /// le second QUEL dossier — un produit promu peut ne pas encore en avoir.
  productId         String?
  canonicalProduct  Product?                 @relation("ProductPromoProfile", fields: [productId], references: [id], onDelete: SetNull)
  /// LES SPÉCIALITÉS QUE CE PRODUIT VISE DANS SA BU — une partie de celles de la BU. Vide = toutes celles de la BU.
  specialitesCibles PromoProductSpecialite[]

  @@index([businessUnitId])
  @@index([productId])
}

// Cycle promotionnel mensuel.
model PromoCycle {
  id        String      @id @default(cuid())
  year      Int
  month     Int // 1..12
  label     String
  status    CycleStatus @default(OPEN)
  createdAt DateTime    @default(now())

  forecasts   ProductForecast[]
  assignments PromotionAssignment[]

  @@unique([year, month])
  @@index([year, month])
}

// Prévision Direction par produit et par cycle (FTE cible, couverture, visites, budget).
model ProductForecast {
  id                String       @id @default(cuid())
  cycleId           String
  cycle             PromoCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  productId         String
  product           PromoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetFte         Decimal      @default(0) @db.Decimal(8, 2)
  coverageTargetPct Int?
  plannedVisits     Int?
  budget            Decimal?     @db.Decimal(14, 2)
  note              String?
  updatedById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([cycleId, productId])
  @@index([cycleId])
  @@index([productId])
}

// Paramètres SFE (ligne globale) : 100% configurables par la Direction / le Super Admin.
model SfeSettings {
  id              String   @id @default("global")
  positionWeights Json? // { "1": 1, "2": 0.5, "3": 0.25 }
  capacity        Json? // { daysPerMonth: 20, visitsPerDay: 7, fieldPct: 80 }
  frequencyByTier Json? // { VERY_HIGH: 3, HIGH: 2, MEDIUM: 1, LOW: 1, VERY_LOW: 0 }
  /// LA PLANIFICATION DE TOURNÉE : { granularity: "MONTH", submissionLeadDays: 15 }.
  ///
  /// Ici et non dans une nouvelle table de réglages : le Super Admin a déjà UN endroit où il
  /// règle le moteur SFE, et un second lui donnerait deux écrans pour une seule question (§118.5).
  tourPlanning    Json?
  updatedById     String?
  updatedAt       DateTime @updatedAt
}

// ─────────────────── Force de vente : hiérarchie & affectations (Phase 2/3) ───────────────────

// Équipe de KAM pilotée par un superviseur national. Rattachable à une BU (franchise) ou transverse.
// LE MODÈLE `SalesTeam` A ÉTÉ RETIRÉ (2026-08). Il portait un superviseur et des membres sous
// une BU — c'est-à-dire exactement ce qu'est une BU. Ses lignes ont été reprises dans
// `BusinessUnit` par la migration `20261002090000_bu_colonne_vertebrale` ; la TABLE existe encore
// (les données valent mieux qu'un schéma tiré au cordeau) mais plus aucun code ne la lit.

// Profil de KAM / délégué — configuration INDIVIDUELLE (équipe, capacité surchargée, ETP contractuel).
model SalesRepProfile {
  id              String        @id @default(cuid())
  repId           String        @unique // utilisateur KAM / délégué
  /// LA BU DU KAM — son équipe, son superviseur et son canal en un seul rattachement.
  businessUnitId  String?
  businessUnit    BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  region          String?
  /// ANTI-SPAM DES ALERTES DE SUPERVISION. Une alerte qui se répète chaque nuit se fait
  /// couper — et c'est la VRAIE qu'on rate ensuite. On garde donc la dernière alerte
  /// envoyée (sa clé : `type:AAAA-MM`) : la même ne repart pas dans le même cycle.
  lastAlertKey    String?
  lastAlertAt     DateTime?
  // Capacité individuelle : surcharge du paramétrage global (null = valeur globale).
  capDaysPerMonth Int?
  capVisitsPerDay Int?
  capFieldPct     Int?
  fteBudget       Decimal       @default(1) @db.Decimal(6, 2) // ETP contractuel (temps plein = 1,0)
  seniority       String? // libellé libre : junior / senior / expert…
  isActive        Boolean       @default(true)
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([businessUnitId])
}

/// LE SECTEUR — une sélection d'hôpitaux qui porte un NOM (« Est », « Oranais », « Alger »).
///
/// POURQUOI IL APPARTIENT À LA BU ET NON AU KAM. La demande dit « pour chaque KAM de la BU, le
/// secteur est une sélection d'hôpitaux avec un nom » — et c'est bien ce que l'écran montre. Mais
/// « Est » est un fait du TERRITOIRE, pas de la personne : deux KAM peuvent le couvrir (un senior
/// et un junior, un remplacement de congés), et un KAM qui part n'emporte pas la carte avec lui.
/// Porté par le KAM, le même territoire aurait vécu en deux listes de quarante hôpitaux qui
/// divergent au premier hôpital ajouté (§118.5), et remplacer un KAM aurait demandé de tout
/// re-sélectionner. Le secteur est donc défini UNE fois, et les KAM y sont AFFECTÉS.
///
/// PLUSIEURS SECTEURS PAR KAM. Un KAM peut couvrir « Alger » ET « Est » ; son panel est alors
/// l'UNION des hôpitaux de ses secteurs. Le forcer à un seul secteur ferait fabriquer un
/// « Alger+Est » dont les hôpitaux seraient recopiés de deux autres — le défaut qu'on vient
/// d'éviter, par l'autre porte.
model SalesSector {
  id             String       @id @default(cuid())
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  /// LE NOM QUE LA FORCE DE VENTE EMPLOIE. C'est lui qu'on lit sur un plan de tournée et dans un
  /// tableau de bord, jamais un identifiant.
  name           String
  /// LA VILLE PIVOT du secteur, quand il en a une. Le KAM planifie par ville (« la semaine du 18
  /// je suis à Oran ») : ceci ouvre son secteur sur la bonne ville sans qu'il ait à la chercher.
  /// Nul = secteur multi-villes, la ville se lit alors sur chaque hôpital.
  city           String?
  /// LA WILAYA PIVOT (Direction, 08/10) — choisie dans la liste fermée des 58 wilayas, sur la ligne du KAM. Une visite dans
  /// cette wilaya = IN, ailleurs = OUT (segmentation). Nul = on lit encore la ville pivot (`city`).
  wilayaPivot    String?
  /// Code officiel de la wilaya (référentiel `Wilaya`), LU du texte saisi par `src/lib/lieux/normaliser.ts` — nul si
  /// ce texte est vide ou ambigu. Le texte reste la saisie (reprise « lieux-wilaya », double écriture V2-D).
  wilayaCode            String?
  wilayaRef             Wilaya?                    @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  color          String?
  isActive       Boolean      @default(true)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  /// LE KAM DONT C'EST LE TERRITOIRE PROPRE (04/10/2026). Dans une BU hospitalière, le territoire
  /// d'un KAM se choisit SUR SA LIGNE (établissements de l'annuaire, tous leurs services ou
  /// certains) : c'est un secteur qui n'appartient qu'à lui, et qui porte aussi sa ligne
  /// `SalesSectorRep` — la règle du panel (`clausePanelDuKam`) et la portée des stocks continuent
  /// de lire le territoire par ce lien, sans rien changer. Nul = un secteur PARTAGÉ d'avant
  /// (« Est », « Oranais »), repris dans les territoires propres par la migration
  /// `20270106093000_territoire_kam` et désactivé, jamais supprimé.
  repId          String?
  rep            User?        @relation("SalesSectorTerritoireKam", fields: [repId], references: [id], onDelete: Cascade)

  institutions       SalesSectorInstitution[]
  reps               SalesSectorRep[]
  /// Les fiches de segmentation rangées À LA MAIN dans ce secteur (les autres s'y rangent par l'établissement).
  segmentationFiches SegmentationFiche[]

  /// Deux secteurs « Est » dans la même BU sont une erreur de saisie, pas deux territoires.
  @@unique([businessUnitId, name])
  /// UN TERRITOIRE PROPRE PAR KAM ET PAR BU. Les secteurs partagés (repId nul) n'y entrent pas :
  /// sous Postgres, deux NULL ne se heurtent jamais.
  @@unique([businessUnitId, repId])
  @@index([businessUnitId])
  @@index([wilayaCode])
}

/// UN HÔPITAL DANS UN SECTEUR. Lien pur : si l'établissement disparaît de l'annuaire, le lien
/// n'a plus d'objet (Cascade) — contrairement à `SalesRepProfile`, qui porte une CONFIGURATION
/// (capacité, ETP) qu'on ne jette pas avec la personne.
model SalesSectorInstitution {
  id              String                          @id @default(cuid())
  sectorId        String
  sector          SalesSector                     @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  institutionId   String
  institution     MedicalInstitution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  /// TOUS LES SERVICES de l'établissement — le défaut, et ce que portait tout lien d'avant
  /// (§118.172). Faux = seulement les services listés dans `services`. Un service ajouté plus tard
  /// à l'établissement entre dans un secteur « tous les services », jamais dans un secteur qui en
  /// a choisi certains.
  tousLesServices Boolean                         @default(true)
  services        SalesSectorInstitutionService[]
  createdAt       DateTime                        @default(now())

  @@unique([sectorId, institutionId])
  @@index([institutionId])
}

/// UN SERVICE CHOISI dans un établissement d'un secteur (§118.172) — seulement quand le secteur
/// n'en couvre pas TOUS. Supprimer le service retire la ligne ; un lien qui n'a plus aucun
/// service ne s'élargit JAMAIS en « tous les services » : élargir un territoire en silence
/// ouvrirait à un KAM des praticiens que personne ne lui a confiés. Il le dit à l'écran.
model SalesSectorInstitutionService {
  id                  String                    @id @default(cuid())
  sectorInstitutionId String
  sectorInstitution   SalesSectorInstitution    @relation(fields: [sectorInstitutionId], references: [id], onDelete: Cascade)
  serviceId           String
  service             MedicalInstitutionService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([sectorInstitutionId, serviceId])
  @@index([serviceId])
}

/// LE KAM AFFECTÉ À UN SECTEUR.
///
/// La clé est l'UTILISATEUR et non `SalesRepProfile` : un KAM peut être rattaché à sa BU avant
/// qu'un profil de capacité n'existe pour lui (`hasProfile: false` à l'écran), et exiger le
/// profil d'abord ferait dépendre l'affectation d'un territoire d'un réglage d'ETP. C'est aussi
/// la convention de tout ce voisinage (`SalesRepProfile.repId`, `SalesRepMonthlyKpi.repId`,
/// `PromotionAssignment.repId`).
model SalesSectorRep {
  id         String      @id @default(cuid())
  sectorId   String
  sector     SalesSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  repId      String
  rep        User        @relation("SalesSectorRepUser", fields: [repId], references: [id], onDelete: Cascade)
  assignedAt DateTime    @default(now())

  @@unique([sectorId, repId])
  @@index([repId])
}

// ─────────────────── Force de vente : le PLAN DE TOURNÉE ───────────────────

/// LA MAILLE DE PLANIFICATION. Mensuelle par défaut ; le Super Admin peut choisir hebdomadaire,
/// trimestrielle ou semestrielle (`SfeSettings.tourPlanning`). Les libellés et le calcul des
/// périodes vivent dans le module PUR `lib/sfe/tournee.ts`.
enum TourPlanGranularity {
  WEEK
  MONTH
  QUARTER
  HALF_YEAR
}

/// LES ÉTATS D'UN PLAN DE TOURNÉE.
///
/// `ESCALATED` n'est pas un `SUBMITTED` de plus : c'est le N+2 qui décide, et confondre les deux
/// ferait attendre une décision de la personne qui vient de s'en dessaisir.
enum TourPlanStatus {
  DRAFT
  SUBMITTED
  ESCALATED
  APPROVED
  REJECTED
  /// UN PLAN VALIDÉ ROUVERT POUR RÉVISION (§118.193 — audit 360°, R13) : il se modifie, puis se resoumet. Ni un
  /// brouillon (son échéance d'origine est passée), ni un rejet (personne ne l'a refusé).
  REVISION
}

/// D'OÙ VIENT UNE VISITE — et les trois cas sont dans la demande.
///
/// `PLAN` : prévue par un plan de tournée validé. `UNPLANNED` : le KAM a rencontré un médecin en
/// sortant de l'hôpital. `DIRECTION` : « demain va voir Achour » — la Direction l'a commandée.
///
/// POURQUOI CE N'EST PAS DÉDUIT DE `tourPlanId`. Une visite sans plan peut être l'un ou l'autre,
/// et la Direction a besoin de distinguer ce que le terrain a improvisé de ce qu'elle a
/// elle-même demandé : sans la colonne, « le KAM improvise beaucoup » et « la Direction envoie
/// beaucoup de monde en urgence » se lisent pareil.
enum VisitOrigin {
  PLAN
  UNPLANNED
  DIRECTION
}

/// LE PLAN DE TOURNÉE d'un KAM pour une période — et son circuit de validation.
///
/// ── IL NE PORTE PAS SES VISITES ─────────────────────────────────────────────────────────────
///
/// Une visite planifiée EST une `MedicalVisit` au statut `PLANNED` : c'est déjà l'objet
/// canonique de l'ERP (date, praticien, délégué, produits, compte rendu), celui que « Ma
/// journée » écrit et que le pilotage compte. Lui donner une table jumelle aurait fait deux
/// dénominateurs possibles pour « visitées / planifiées », et deux dénominateurs divergent
/// toujours (§118.5, §118.51). Le plan porte donc le PÉRIMÈTRE et la DÉCISION ; les visites
/// pointent sur lui par `MedicalVisit.tourPlanId`.
model TourPlan {
  id          String              @id @default(cuid())
  /// LE KAM dont c'est la tournée.
  repId       String
  rep         User                @relation("TourPlanRep", fields: [repId], references: [id], onDelete: Cascade)
  /// LA PÉRIODE COUVERTE — début inclus, fin incluse (23:59:59 du dernier jour).
  periodStart DateTime
  periodEnd   DateTime
  granularity TourPlanGranularity @default(MONTH)
  status      TourPlanStatus      @default(DRAFT)

  /// L'ÉCHÉANCE DE SOUMISSION, figée à la CRÉATION du plan.
  ///
  /// Elle est stockée et non recalculée à la lecture : le réglage de maille peut changer entre
  /// la création et la décision, et un plan jugé « en retard » sur une échéance qui n'existait
  /// pas quand il a été écrit serait un reproche fabriqué après coup (§118.107 : le parcours est
  /// un fait de la demande, pas une fonction du réglage du jour).
  submissionDueAt DateTime
  submittedAt     DateTime?

  /// LE N+1 QUI DOIT TRANCHER, figé à la soumission — une promotion entre la soumission et la
  /// décision ne doit pas changer qui décide.
  reviewerId    String?
  reviewer      User?     @relation("TourPlanReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  /// LE N+2, quand le N+1 a demandé une validation au-dessus de lui.
  escalatedToId String?
  escalatedTo   User?     @relation("TourPlanEscalatedTo", fields: [escalatedToId], references: [id], onDelete: SetNull)
  escalatedAt   DateTime?

  decidedAt        DateTime?
  decidedById      String?
  decidedBy        User?     @relation("TourPlanDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// LES COMMENTAIRES DE RECTIFICATION. Un rejet sans motif ne se corrige pas — il se subit.
  rejectionComment String?
  /// 48 H POUR RESOUMETTRE, à partir du rejet — ou de la demande de révision.
  resubmitDueAt    DateTime?

  /// LA RÉVISION D'UN PLAN VALIDÉ (§118.193) : pourquoi, qui, quand — lue par le validateur quand le plan lui
  /// revient, effacée par sa décision. `revisionById` est un identifiant sans relation, la convention des marques
  /// de renvoi (§118.192).
  revisionNote          String?
  revisionRequestedAt   DateTime?
  revisionRequestedById String?
  /// Combien de fois le plan a été rouvert après validation. Au-dessus de zéro, il a été validé au moins une fois :
  /// ses visites passées ne se retirent plus (`retraitInterditApresRevision`).
  revisionCount         Int       @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visits MedicalVisit[]

  /// UN SEUL PLAN par KAM et par période. Un rejet ne crée pas un second plan : c'est le MÊME
  /// qui repasse en soumission, sans quoi l'historique de la décision se perdrait.
  @@unique([repId, periodStart, periodEnd])
  @@index([repId, status])
  @@index([reviewerId, status])
  @@index([escalatedToId, status])
}

/// UN MESSAGE PRÉ-DÉFINI PAR LA DIRECTION MARKETING — ce que le KAM doit dire au médecin.
///
/// La demande l'exige à la création d'un rapport terrain, choisi dans un menu déroulant. Aucun
/// référentiel de ce genre n'existait : la seule façon de le porter était le texte libre, donc
/// personne ne pouvait mesurer quel message passe et lequel ne passe pas.
///
/// LA PORTÉE SUIT LA CONVENTION DU DÉPÔT : `businessUnitId` nul = message ouvert à toutes les
/// gammes, `productId` nul = message non lié à un produit. « Vide = ouvert à tous » est déjà la
/// règle des lecteurs d'annuaire et des lecteurs Legal — en inventer une autre ici ferait deux
/// façons de dire « pour tout le monde ».
model PromoMessage {
  id             String        @id @default(cuid())
  title          String
  body           String?
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?      @relation("PromoMessageProduct", fields: [productId], references: [id], onDelete: SetNull)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  visitLinks MedicalVisitMessage[]

  @@index([businessUnitId])
  @@index([productId])
}

/// LES MESSAGES RETENUS lors d'un rapport terrain. Lien pur : si le message est retiré du
/// référentiel, le lien n'a plus d'objet — mais la visite, elle, reste.
model MedicalVisitMessage {
  id        String       @id @default(cuid())
  visitId   String
  visit     MedicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  messageId String
  message   PromoMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([visitId, messageId])
  @@index([messageId])
}

// ─────────────────── Force de vente : la FICHE DE COACHING (§118.157) ───────────────────

/// UNE VERSION DE LA GRILLE DE COACHING — administrée par le directeur des opérations.
///
/// La grille (titre, quatre niveaux de maîtrise, axes et critères, libellés du bilan) est UN
/// document JSON validé par `lib/coaching/grille.ts`. Chaque modification crée une VERSION et
/// n'en réécrit jamais une : une fiche garde la grille sous laquelle elle a été remplie, sinon
/// un « 3 » coché l'an dernier se relirait dans les critères du jour.
model CoachingGrid {
  id          String   @id @default(cuid())
  /// 1, 2, 3… — la version courante est la plus haute.
  version     Int      @unique
  content     Json
  /// POURQUOI cette version — le motif qu'a écrit le directeur des opérations, s'il en a donné un.
  note        String?
  createdById String?
  createdBy   User?    @relation("CoachingGridAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  sheets CoachingSheet[]
}

enum CoachingSheetStatus {
  DRAFT
  FINALIZED
}

/// UNE FICHE DE COACHING — une tournée en double, évaluée sur SA version de la grille.
///
/// Le TOTAL n'est pas stocké : il se calcule sur les notes et la grille (`bilanDesNotes`). Le
/// stocker ferait deux vérités, et celle qu'on oublie de recalculer serait celle qu'on exporte.
model CoachingSheet {
  id             String              @id @default(cuid())
  gridId         String
  grid           CoachingGrid        @relation(fields: [gridId], references: [id], onDelete: Restrict)
  /// LE COLLABORATEUR ÉVALUÉ — le KAM, le délégué.
  collaboratorId String
  collaborator   User                @relation("CoachingCollaborator", fields: [collaboratorId], references: [id], onDelete: Cascade)
  /// LE MANAGER qui a fait la tournée en double — l'auteur, par défaut.
  managerId      String?
  manager        User?               @relation("CoachingManager", fields: [managerId], references: [id], onDelete: SetNull)
  /// LE JOUR DE LA TOURNÉE.
  visitDate      DateTime            @db.Date
  /// « Secteur / Région / CDR » — pré-rempli depuis la force de vente, modifiable.
  sector         String?
  /// `{ <clé d'axe>: 1..4 }` — un axe non noté est ABSENT, jamais 0.
  scores         Json
  strengths      String?
  improvements   String?
  status         CoachingSheetStatus @default(DRAFT)
  finalizedAt    DateTime?
  finalizedById  String?
  finalizedBy    User?               @relation("CoachingFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?               @relation("CoachingAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([collaboratorId, visitDate])
  @@index([managerId])
  @@index([createdById, status])
}

/// L'INSTANTANÉ MENSUEL D'UN KAM — le mois clos ne se recalcule plus.
///
/// POURQUOI STOCKER CE QUI SE CALCULE. Le cockpit dérive tout du présent : panel actuel,
/// affectations actuelles, paramétrage actuel. C'est juste pour le mois EN COURS, et faux pour
/// un mois passé — un praticien retiré du panel en juin change rétroactivement la couverture de
/// mars, et « on avait fait 78 % » devient 91 % sans que personne n'ait rien fait. Or c'est
/// précisément ce chiffre-là qu'on relit en entretien annuel.
///
/// L'instantané est donc écrit UNE FOIS, au passage du mois, avec ce qui était vrai ce mois-là
/// — équipe comprise (un KAM change d'équipe ; son historique, non). Il est idempotent : le
/// balayage peut repasser, il réécrit la même ligne (`@@unique`) tant que le mois n'est pas
/// clos, et cesse d'y toucher une fois `closedAt` posé.
model SalesRepMonthlyKpi {
  id    String  @id @default(cuid())
  repId String // utilisateur KAM / délégué (résolu en requête, comme PromotionAssignment)
  year  Int
  month Int // 1..12
  /// LA BU AU MOMENT du mois — photographiée, jamais relue depuis le profil courant.
  buId  String?

  panelSize      Int @default(0)
  capacity       Int @default(0) // visites/mois (capacité terrain nette)
  plannedVisits  Int @default(0) // affectations du cycle
  requiredVisits Int @default(0) // fréquence cible du panel
  realVisits     Int @default(0) // visites COMPLETED du mois
  coveredDoctors Int @default(0) // praticiens distincts visités

  /// Dérivés au moment de l'instantané : les relire sans les recalculer est tout l'intérêt.
  realizationPct Int @default(0)
  coveragePct    Int @default(0)

  /// Mois CLOS : plus aucun balayage n'y touche. Null = mois encore vivant (réécriture permise).
  closedAt   DateTime?
  computedAt DateTime  @default(now())

  @@unique([repId, year, month])
  @@index([year, month])
  @@index([buId])
}

// Affectation d'un produit à un KAM pour un cycle, avec rang de détail (position) et visites prévues.
// Matrice KAM × produit × cycle — transverse aux BU (un KAM peut porter des produits de plusieurs BU).
model PromotionAssignment {
  id            String       @id @default(cuid())
  cycleId       String
  cycle         PromoCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  repId         String // utilisateur KAM / délégué
  productId     String
  product       PromoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  position      Int          @default(1) // rang de détail : 1 = P1 (prioritaire), 2 = P2, 3 = P3
  plannedVisits Int          @default(0)
  note          String?
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([cycleId, repId, productId])
  @@index([cycleId])
  @@index([repId])
  @@index([productId])
}

// ─────────────────── Business Development : études de marché (Market Research) ───────────────────

enum MarketResearchStatus {
  DRAFT
  FINAL
}

// Statut d'un acteur du marché : importateur ou fabricant local.
enum PlayerStatus {
  IMPORT
  MANUFACTURING
}

model MarketResearch {
  id             String               @id @default(cuid())
  title          String
  status         MarketResearchStatus @default(DRAFT)
  notes          String?
  sources        String? // sources de données de l'étude (IQVIA, Nomenclature, Réceptions PCH…), modifiables
  participantIds String[]             @default([]) // collaborateurs de l'étude (utilisateurs)
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  rows          MarketResearchRow[]
  presentations MarketResearchPresentation[]

  @@index([createdById])
}

// Une ligne = un produit / une molécule dans une classe thérapeutique.
model MarketResearchRow {
  id                String         @id @default(cuid())
  researchId        String
  research          MarketResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  therapeuticClass  String?
  product           String // DCI / molécule / marque
  marketVolume      Decimal?       @db.Decimal(18, 2) // taille du marché en volume (boîtes)
  marketValueUsd    Decimal?       @db.Decimal(18, 2) // taille du marché en valeur ($)
  avgPricePerBoxUsd Decimal?       @db.Decimal(14, 2) // prix moyen par boîte ($)
  comment           String?
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  players MarketResearchPlayer[]

  @@index([researchId])
}

// Un acteur du marché sur une ligne (Player 1, 2, 3… — non plafonné).
model MarketResearchPlayer {
  id               String            @id @default(cuid())
  rowId            String
  row              MarketResearchRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  rank             Int               @default(1)
  name             String
  marketShareValue Decimal?          @db.Decimal(18, 2) // part de marché (valeur)
  status           PlayerStatus? // Import ou Manufacturing
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([rowId])
}

// Présentation stratégique (PPTX) générée par IA à partir d'une étude de marché.
// Une présentation regroupe plusieurs VERSIONS : chaque relance d'analyse (avec des
// commentaires ajoutés) produit une nouvelle version, historisée. Le .pptx est
// (re)construit à la demande à partir de l'analyse structurée stockée (source de vérité).
model MarketResearchPresentation {
  id          String         @id @default(cuid())
  researchId  String
  research    MarketResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  title       String
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  versions MarketResearchPresentationVersion[]

  @@index([researchId])
}

// Une version = une passe d'analyse IA. `instruction` = commentaires ajoutés par
// l'utilisateur pour cette relance ; `analysis` = JSON structuré (synthèse, analyse par
// produit, opinion, recommandation) ancré sur les données de l'étude ; `model` = modèle utilisé.
model MarketResearchPresentationVersion {
  id             String                     @id @default(cuid())
  presentationId String
  presentation   MarketResearchPresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  version        Int                        @default(1)
  instruction    String? // commentaires ajoutés pour cette relance d'analyse
  analysis       Json // analyse structurée renvoyée par l'IA (ancrée sur l'étude)
  model          String? // modèle IA ayant produit l'analyse
  createdById    String?
  createdAt      DateTime                   @default(now())

  @@unique([presentationId, version])
  @@index([presentationId])
}

// ─────────────────────────── Adventum Autonomous Test Center ───────────────────────────
// Certification autonome de la plateforme. Un run ne supprime QUE les ressources dont
// l'ID exact figure dans son manifeste (TestArtifact) — jamais par nom/préfixe.

enum TestRunMode {
  READ_ONLY_AUDIT
  SAFE_SYNTHETIC_TEST
  STAGING_FULL_TEST
  CHAOS_TEST
  SECURITY_AUDIT
  PERFORMANCE_BENCHMARK
}

enum TestRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  ABORTED
  CLEANUP_INCOMPLETE
}

enum TestCleanupStatus {
  NOT_REQUIRED
  PENDING
  RUNNING
  DONE
  INCOMPLETE
}

enum TestSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Verdict de certification (§36) — un run incomplet n'est jamais présenté comme réussi.
enum TestCertification {
  CERTIFIED
  CERTIFIED_WITH_RESERVATIONS
  BLOCKED
  INCONCLUSIVE
}

model TestRun {
  id            String            @id @default(cuid())
  mode          TestRunMode       @default(SAFE_SYNTHETIC_TEST)
  environment   String            @default("unknown") // dev | staging | production
  status        TestRunStatus     @default(PENDING)
  cleanupStatus TestCleanupStatus @default(NOT_REQUIRED)

  initiatedById String // ID de l'initiateur (Super Admin) — pas de FK pour ne pas alourdir User
  gitCommit     String?
  gitBranch     String?
  config        Json? // périmètre : modules, rôles, entités, profondeur…

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  progress   Int       @default(0) // 0-100
  step       String? // étape courante (exécution en direct)

  score            Int? // 0-100
  criticalCount    Int   @default(0)
  findingsCount    Int   @default(0)
  resourcesCreated Int   @default(0)
  resourcesDeleted Int   @default(0)
  summary          Json?

  // Certification (§36) : verdict + paquet de preuves immuable (haché) + différentiel (§32).
  certification TestCertification?
  evidenceHash  String? // sha256 du paquet de preuves (immuabilité)
  evidence      Json? // paquet de preuves (commit, env, couverture, résultats, hashs…)
  differential  Json? // comparaison avec le run de référence précédent

  artifacts TestArtifact[]
  findings  TestFinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startedAt])
}

// Le MANIFESTE : chaque ressource synthétique créée par le run. Le nettoyage s'appuie
// EXCLUSIVEMENT sur `recordId` (l'ID réel), en ordre inverse de dépendance.
model TestArtifact {
  id            String    @id @default(cuid())
  testRunId     String
  run           TestRun   @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  resourceType  String // "user" | "document" | "blob" | "notification" | …
  model         String? // nom du modèle Prisma (pour la suppression typée)
  recordId      String // ID réel de l'enregistrement créé
  blobKey       String? // clé S3/R2 / StoredFile éventuelle
  dependsOn     String[]  @default([]) // IDs (TestArtifact) dont dépend cette ressource
  deleteMethod  String    @default("prisma") // prisma | blob | noop
  deletedAt     DateTime?
  cleanupResult String? // "deleted" | "already-absent" | "error: …"
  createdAt     DateTime  @default(now())

  @@index([testRunId])
  @@index([testRunId, deletedAt])
}

model TestFinding {
  id         String       @id @default(cuid())
  testRunId  String
  run        TestRun      @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  severity   TestSeverity @default(INFO)
  category   String // functional | rbac | data | ux | security | performance | ai | coverage
  module     String?
  route      String?
  roleTested String?
  title      String
  detail     String
  evidence   Json? // assertion, log, réponse API, différence base… (expurgé)
  suggestion String?
  confidence String? // high | medium | low
  createdAt  DateTime     @default(now())

  @@index([testRunId, severity])
}

/// ÉTUDE DE CAS — un produit PASSÉ, son dossier et son ISSUE RÉELLE à l'ANPP. C'est la matière
/// d'ENTRAÎNEMENT de l'analyseur : ses extraits sont injectés dans l'analyse comme PRÉCÉDENTS
/// (« voilà ce que l'agence a réellement accepté/reproché sur NOS produits »), jamais comme
/// règles opposables. Alimenté et géré par le SUPER ADMIN uniquement (module Entraînement IA).
model RegulatoryCaseStudy {
  id          String              @id @default(cuid())
  title       String // « Amoxicilline 500 mg gélules — enregistrement 2023 »
  productName String?
  outcome     RegCaseOutcome      @default(UNKNOWN)
  /// La leçon retenue, dite par un humain — la phrase qui vaut de l'or pour la suivante.
  lesson      String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  documents   RegulatoryCaseDoc[]
}

model RegulatoryCaseDoc {
  id         String   @id @default(cuid())
  caseId     String
  filename   String
  /// Section CTD principale déduite du nom de fichier (repérage), null si indéterminée.
  ctdSection String?
  /// Sections CTD détectées dans le texte (gros PDF consolidés).
  sections   String[] @default([])
  /// Texte extrait, borné — la matière première des précédents injectés.
  text       String
  sha256     String
  /// Vecteur sémantique (rattrapage par le planificateur) — recherche FR/EN.
  embedding  Json?
  createdAt  DateTime @default(now())

  case RegulatoryCaseStudy @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([ctdSection])
}

enum RegCaseOutcome {
  ACCEPTED
  ACCEPTED_WITH_RESERVES
  REJECTED
  UNKNOWN
}

// ─────────────────────────── API pour agents (ChatGPT & co.) ───────────────────────────

/// CLIENT MACHINE de l'API. Jamais un compte humain partagé : un agent a sa propre identité,
/// ses propres portées, et se révoque sans couper personne.
///
/// DEUX COUCHES d'autorisation, et c'est volontaire : les `scopes` disent ce que
/// l'INTÉGRATION a le droit de faire (lire, écrire, valider…), l'utilisateur `actAs` dit ce
/// que cette identité VOIT dans l'ERP (portée par ligne, entité, module). L'agent ne peut donc
/// jamais dépasser ni l'un ni l'autre — et le mode lecture seule s'obtient en ne donnant que
/// les portées de lecture, sans toucher aux droits de la personne.
model ApiClient {
  id          String    @id @default(cuid())
  name        String
  /// Empreinte SHA-256 de la clé. La clé en clair n'existe QU'UNE FOIS, à la création : une
  /// clé stockée en clair est une clé déjà compromise.
  keyHash     String    @unique
  /// Début de la clé (« amd_sk_a1b2c3 »), pour la reconnaître dans une liste sans la révéler.
  keyPrefix   String
  scopes      String[]
  /// Utilisateur au nom duquel l'agent agit. Sa portée RBAC s'applique intégralement.
  actAsUserId String?
  actAs       User?     @relation("ApiClientActAs", fields: [actAsUserId], references: [id], onDelete: SetNull)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  calls    ApiCall[]
  webhooks WebhookEndpoint[]

  @@index([isActive])
}

/// JOURNAL DES APPELS D'API. Distinct du journal d'audit humain (`AuditLog`) et relié à lui :
/// on doit pouvoir dire « ceci a été fait par l'agent, pas par une personne », et retrouver la
/// requête exacte par son identifiant de corrélation.
model ApiCall {
  id            String     @id @default(cuid())
  clientId      String?
  client        ApiClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Utilisateur au nom duquel l'appel a été fait (celui dont la portée s'est appliquée).
  actorUserId   String?
  correlationId String
  method        String
  path          String
  operationId   String?
  entityType    String?
  entityId      String?
  status        Int
  ok            Boolean
  errorCode     String?
  /// Ce qui a changé : l'état avant et après. Un journal qui ne dit que « UPDATE » n'explique rien.
  before        Json?
  after         Json?
  durationMs    Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([clientId, createdAt])
  @@index([correlationId])
  @@index([entityType, entityId])
  @@index([operationId])
}

/// CLÉ D'IDEMPOTENCE. Un agent rejoue une requête dès qu'il perd la réponse : sans cette table,
/// un incident réseau crée deux dossiers, envoie deux notifications ou valide deux fois.
model ApiIdempotencyKey {
  id          String   @id @default(cuid())
  clientId    String
  key         String
  /// Empreinte du corps de la requête : la même clé avec un contenu DIFFÉRENT n'est pas un
  /// rejeu mais une erreur d'appelant — on la refuse au lieu de rendre une réponse trompeuse.
  requestHash String
  status      Int
  response    Json
  createdAt   DateTime @default(now())

  @@unique([clientId, key])
  @@index([createdAt])
}

/// ABONNEMENT À DES ÉVÉNEMENTS. L'agent est prévenu au lieu d'interroger en boucle.
model WebhookEndpoint {
  id        String     @id @default(cuid())
  clientId  String?
  client    ApiClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url       String
  /// Secret de signature HMAC : le destinataire vérifie que l'appel vient bien de l'ERP.
  secret    String
  /// Événements souscrits (« regulatory.dossier.updated »…). Vide = tous.
  events    String[]
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  deliveries WebhookDelivery[]

  @@index([isActive])
}

/// UNE LIVRAISON d'événement. Conservée même en échec : un webhook perdu en silence est pire
/// qu'un webhook en erreur, parce que personne ne sait qu'il manque.
model WebhookDelivery {
  id          String          @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  payload     Json
  status      WebhookStatus   @default(PENDING)
  attempts    Int             @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([status, createdAt])
  @@index([endpointId, createdAt])
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

/// QUI PORTE UNE AUTORITÉ DE VALIDATION — configurable, jamais codé en dur.
///
/// Une autorité se rattache à un RÔLE, pas à une personne : « le directeur des opérations »
/// valide, quel que soit celui qui occupe le poste. Le jour où la personne change, rien à
/// reprogrammer. Seule exception assumée, la DIRECTION GÉNÉRALE, qui est nominative — c'est
/// une signature personnelle, et elle se transfère nommément à quelqu'un d'autre.
model AuthorityHolder {
  id                String    @id @default(cuid())
  /// NATIONAL_SUPERVISOR | PRODUCT_MANAGER | HR | OPERATIONS | GENERAL_MANAGEMENT | FINANCE
  authority         String    @unique
  /// Rôles porteurs — le cas normal.
  roles             String[]
  /// Titulaires NOMMÉS — l'exception (direction générale).
  userIds           String[]
  /// Personne à qui l'autorisation a été TRANSFÉRÉE, tant que le transfert est actif.
  delegatedToUserId String?
  delegatedById     String?
  delegatedAt       DateTime?
  delegationNote    String?
  updatedById       String?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

/// Seuil au-delà duquel la direction générale entre dans la chaîne, par entité.
/// Un seuil en base et non dans le code : changer un chiffre de gestion ne doit pas
/// demander de livrer une version du logiciel.
model PaymentThreshold {
  id          String   @id @default(cuid())
  companyId   String?  @unique
  amount      Decimal  @default(500000) @db.Decimal(14, 2)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════ AD & PRO — CONSULTING ═══════════════════════

/// L'état d'un contrat de consulting, tel que le voit celui qui le suit.
/// « Expiré » n'est pas « annulé » : le premier a produit ses effets jusqu'au bout,
/// le second a été rompu. Les confondre, c'est perdre l'historique de la relation.
enum ConsultingStatus {
  DRAFT
  AWAITING_VALIDATION
  ACTIVE
  EXPIRED
  CANCELLED
}

/// Rythme de la rémunération — il change la lecture d'un montant : 200 000 DZD par mois
/// et 200 000 DZD pour la mission entière ne sont pas la même dépense.
enum ConsultingBilling {
  ONE_OFF
  MONTHLY
  QUARTERLY
  YEARLY
  ON_DELIVERY
}

/// LE PÔLE qui porte un contrat de consulting (§118.150) — et donc QUI le voit et le gère.
/// `AD_PRO` : une dépense de promotion, suivie dans Ad & Pro › Consulting. `RH` : un consultant
/// engagé comme un membre de l'équipe, suivi dans RH › Consultants. Le même contrat change de pôle
/// par un GESTE (transfert), sans rien perdre : référence, tâches, pièces, validation, historique.
enum ConsultingPole {
  AD_PRO
  RH
}

/// CONTRAT DE CONSULTING — un engagement entre DEUX PARTIES.
/// Notre partie est une entité du groupe (`companyId`) ; l'autre est le prestataire,
/// personne physique ou cabinet. Le contrat porte ce qui se négocie : une période, une
/// rémunération, des tâches attendues, et les pièces signées.
model ConsultingContract {
  /// LA BUSINESS UNIT qui porte cette demande — c'est SON budget Ad&Pro qui est engagé.
  /// Le formulaire la demandait, OBLIGATOIRE, depuis que les gammes existent ; la colonne
  /// n'existait pas et l'action ne la lisait pas, si bien que le choix imposé au demandeur
  /// était JETÉ — un champ requis sans effet, ce qui est pire qu'un champ absent (§118.140).
  businessUnitId      String?
  businessUnit        BusinessUnit?     @relation("AdProConsulting", fields: [businessUnitId], references: [id], onDelete: SetNull)
  /// Le ou les praticiens concernés, FACULTATIFS ici (un accompagnement réglementaire n'en a
  /// aucun). Même convention que `SponsoringRequest.doctor` : la valeur vient du référentiel,
  /// la colonne garde le LIBELLÉ affichable, plusieurs séparés par « · » (`readMultiField`).
  doctor              String?
  /// Le ou les produits concernés — mêmes conventions, et seuls les dossiers réglementaires
  /// au traitement TERMINÉ sont proposés.
  product             String?
  id                  String            @id @default(cuid())
  reference           String            @unique // CONS-2026-001
  /// Le pôle qui porte le contrat — Ad & Pro par défaut ; les RH après un transfert (§118.150).
  /// C'est lui qui dit quel MODULE garde le contrat : `lecteurs/consulting.ts` le traduit, une fois.
  pole                ConsultingPole    @default(AD_PRO)
  title               String
  /// L'AUTRE PARTIE : consultant, cabinet, expert.
  counterparty        String
  counterpartyContact String?
  /// Notre partie : l'entité du groupe qui signe.
  companyId           String?
  company             Company?          @relation(fields: [companyId], references: [id])
  /// Objet de la mission — ce pour quoi on paie.
  scope               String?
  startDate           DateTime?
  endDate             DateTime?
  /// Rémunération convenue, dans le rythme indiqué par `billing`.
  amount              Decimal?          @db.Decimal(14, 2)
  billing             ConsultingBilling @default(ONE_OFF)
  paymentTerms        String?
  status              ConsultingStatus  @default(DRAFT)

  requesterId   String? // qui porte le contrat en interne
  /// Personne à qui la validation a été demandée, tant qu'elle n'a pas tranché.
  validatorId   String?
  validatedById String?
  validatedAt   DateTime?
  decisionNote  String?
  cancelledAt   DateTime?
  /// RENVOYÉ POUR CORRECTION (audit 360°, lot C4a) : le validateur rend le contrat à son porteur, qui
  /// le corrige et le resoumet. Effacé à la resoumission — l'historique reste au journal et dans la
  /// discussion de la fiche. Sans lui, la seule issue d'un contrat mal saisi était le refus, donc
  /// l'annulation définitive.
  returnedAt    DateTime?
  returnedById  String?
  returnNote    String?

  notes String?
  tasks ConsultingTask[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([validatorId])
  @@index([companyId])
  @@index([pole])
}

/// UNE TÂCHE ATTENDUE DU PRESTATAIRE.
/// Elles vivent à part et non dans un champ de texte : « ce qui reste à livrer » est une
/// question qu'on pose au contrat, et un paragraphe ne sait pas y répondre.
model ConsultingTask {
  id         String             @id @default(cuid())
  contractId String
  contract   ConsultingContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  label      String
  dueDate    DateTime?
  doneAt     DateTime?
  position   Int                @default(0)
  createdAt  DateTime           @default(now())

  @@index([contractId])
}

// ═══════════════════════ AD & PRO — AUTRE ═══════════════════════

/// L'état d'une demande « Autre ». Le circuit est volontairement court : une demande
/// qui n'entre dans aucune nature n'a pas de circuit propre — elle a un décideur.
enum AdProOtherStatus {
  DRAFT
  /// En cours de circuit (27/10/2026) : chez le National Sales, le Directeur des opérations ou la
  /// Direction Marketing — l'étape exacte est celle du `WorkflowInstance` (catégorie `OTHER`).
  AWAITING_DECISION
  /// PRÉVALIDÉE par la Direction Marketing : les postes se préparent (le DG valide leur total au-dessus du seuil).
  APPROVED
  REFUSED
  DONE
  CANCELLED
  /// RENVOYÉE POUR CORRECTION : chez son demandeur, qui corrige et RESOUMET ; elle revient alors à
  /// l'étape qui l'a renvoyée (comme au sponsoring et aux prises en charge).
  RETURNED
}

/// LA DEMANDE QUI N'ENTRE DANS AUCUNE CASE.
/// Sans elle, une dépense de promotion inhabituelle se déclare « en sponsoring » faute de
/// mieux — et l'on perd à la fois la lisibilité du sponsoring et la trace de la dépense.
/// LES RÉFÉRENTS DIRECTION MARKETING D'UNE GAMME.
///
/// Décision de la Direction (22/09/2026) : « chaque BU aura son ou ses référents de la direction
/// marketing depuis la configuration des BU, mais le directeur du département marketing recevra
/// ÉGALEMENT l'accès et la notif et pourra modifier, valider ».
///
/// CE QUE CETTE DÉSIGNATION FAIT, ET CE QU'ELLE NE FAIT PAS. Elle CIBLE la notification : les
/// demandes Ad & Pro d'une gamme préviennent nommément ses référents, au lieu d'arroser tout le
/// rôle. Elle n'ACCORDE aucun droit : le pouvoir de trancher reste gouverné par le rôle de
/// l'étape (`WorkflowStep.actorRoles`), et l'écran ne propose que des personnes qui le portent
/// déjà. Une désignation qui accorderait un droit serait une porte de permission ouverte depuis
/// un écran de configuration commerciale.
///
/// C'est aussi ce qui donne enfin un ÉCRIVAIN à `productManagerId` (§118.142 : le champ avait
/// sept lecteurs et personne ne l'écrivait) — mais seulement quand la gamme a UN SEUL référent :
/// plusieurs n'en désignent aucun, parce que collapser choisirait l'arbitre à la place d'un
/// humain (§118.34).
model BusinessUnitMarketingReferent {
  id             String       @id @default(cuid())
  businessUnitId String
  businessUnit   BusinessUnit @relation("AdProMarketingReferents", fields: [businessUnitId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("AdProMarketingReferentOf", fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  /// Une personne n'est référente d'une gamme qu'une fois : sans cette contrainte, un double clic
  /// la ferait notifier deux fois et compter deux fois à l'écran.
  @@unique([businessUnitId, userId])
  @@index([userId])
}

model AdProOtherRequest {
  /// LA BUSINESS UNIT qui porte cette demande — même défaut qu'au-dessus, même remède :
  /// le formulaire l'exigeait, rien ne l'écrivait.
  businessUnitId String?
  businessUnit   BusinessUnit?    @relation("AdProOther", fields: [businessUnitId], references: [id], onDelete: SetNull)
  /// Praticien(s) et produit(s) concernés, FACULTATIFS : « autre » ne sait pas d'avance de quoi
  /// il s'agit. Sans ces colonnes, ils repartaient dans la description, où rien ne les compte.
  doctor         String?
  product        String?
  id             String           @id @default(cuid())
  reference      String           @unique // AUT-2026-001
  title          String
  description    String?
  /// Pour qui / avec qui : praticien, association, prestataire…
  beneficiary    String?
  amount         Decimal?         @db.Decimal(14, 2)
  companyId      String?
  company        Company?         @relation(fields: [companyId], references: [id])
  status         AdProOtherStatus @default(AWAITING_DECISION)

  requesterId  String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Les postes de la demande (27/10/2026) — ajoutés après sa prévalidation.
  items AdProItem[]

  @@index([status])
  @@index([requesterId])
  @@index([companyId])
}

/// LE VISA DU CENTRE DE VALIDATION AD & PRO — pour les natures qui n'ont pas d'étape de circuit.
///
/// Cinq des sept natures Ad & Pro portent DÉJÀ la porte du Directeur Général : l'étape `dg` d'un
/// `WorkflowInstance` pour les quatre circuits configurables, `REVIEW_DG` pour le matériel
/// promotionnel. Le consulting et les « autres demandes » n'en avaient AUCUNE — mesuré sur leurs
/// machines à états : rien n'y consultait le seuil, donc un contrat de 5 M DZD sortait sans que
/// personne en haut l'ait vu. Un centre qui les laisserait passer serait une porte ouverte à côté
/// d'une porte gardée (§118.71).
///
/// UNE table et non deux jeux de colonnes : les deux natures ont besoin des mêmes cinq faits, et
/// une troisième qui arriverait demain aussi. Deux jeux de colonnes auraient divergé au premier
/// champ ajouté (§118.5).
///
/// LE SEUIL EST FIGÉ DANS LE VISA (`threshold`) : sans lui, baisser le seuil rendrait toute
/// décision passée inexplicable — on ne saurait plus pourquoi ce dossier-là est passé par le
/// centre (§118.41 : une lecture qui ne se date pas conclut sur une vérité périmée).
///
/// `status` est du TEXTE et non un enum Prisma, comme `WorkflowInstance.status` : PENDING |
/// APPROVED | REFUSED. Ajouter une valeur à un enum Postgres demande une migration en deux temps
/// (`ALTER TYPE ... ADD VALUE` ne peut pas être utilisée dans la transaction qui la crée), et ce
/// vocabulaire est celui du centre, pas celui des natures.
model AdProGateVisa {
  id          String     @id @default(cuid())
  entityType  EntityType
  entityId    String
  status      String     @default("PENDING")
  /// Le seuil EN VIGUEUR au moment où la porte s'est ouverte — figé, jamais relu.
  ///
  /// `null` sur le visa d'un BON DE COMMANDE (`entityType = LEGAL_DOCUMENT`) : sa porte suit le
  /// SEUIL DES BONS DE COMMANDE en vigueur (§118.149), relu à chaque aiguillage et réévalué quand
  /// il change — à l'inverse d'une demande, dont le seuil est figé. Y écrire une valeur la ferait
  /// lire comme la raison du passage alors qu'elle peut ne plus l'être.
  threshold   Decimal?   @db.Decimal(14, 2)
  /// Le budget total qui a déclenché la porte. `null` = non renseigné (la porte s'ouvre quand même).
  amount      Decimal?   @db.Decimal(14, 2)
  decidedById String?
  decidedBy   User?      @relation("adProGateVisaDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  /// Le motif, obligatoire au REFUS : un refus sans motif est une impasse pour le demandeur.
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([entityType, entityId])
  @@index([status])
}

// ═══════════════════════ DEMANDE DE PIÈCE ═══════════════════════

/// L'état d'une demande de pièce. Court, parce que la vie d'une demande de pièce est courte :
/// on demande, on dépose, on accepte — ou l'on redemande parce que ce n'était pas la bonne.
enum DocumentRequestStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  DECLINED
  CANCELLED
}

/// DEMANDER UNE PIÈCE À QUELQU'UN — n'importe qui, pas seulement le secrétariat.
///
/// Une facture est chez le commercial, un devis chez l'assistante, une attestation chez le
/// comptable : la pièce qui manque n'est presque jamais chez celui qui en a besoin. Sans ce
/// mécanisme, on la réclame par message et l'on perd la trace de ce qu'on attend, de qui, depuis
/// quand — jusqu'à ce que le dossier bloque sans que personne sache pourquoi.
///
/// GÉNÉRIQUE par construction : elle vise n'importe quel objet de l'ERP (`entityType`/`entityId`).
/// Une deuxième implémentation « spéciale poste de dépense » finirait par diverger sur un détail
/// qui compte — la relance, l'accès, ou le refus.
model DocumentRequest {
  id        String @id @default(cuid())
  reference String @unique // PIE-2026-001

  /// L'objet auquel la pièce se rattache — un poste de dépense, un contrat, un dossier.
  entityType EntityType
  entityId   String
  /// Retour vers l'écran d'origine : celui à qui l'on demande n'a pas forcément accès au module,
  /// mais celui qui a demandé, si.
  link       String?

  /// Ce qu'on demande, en clair. « La facture définitive de l'agence », pas « pièce n° 3 ».
  label   String
  note    String?
  dueDate DateTime?

  /// LA NATURE DE LA PIÈCE — même vocabulaire qu'une pièce de dossier de paiement (`INVOICE`,
  /// `PURCHASE_ORDER`, `QUOTE`, `DELIVERY_NOTE`, `CONTRACT`, `PROOF`, `OTHER`). C'est elle qui
  /// décide si la pièce, une fois acceptée, rejoint le registre des engagements (Legal).
  /// Voir `src/lib/legal/from-piece.ts`.
  kind            String  @default("OTHER")
  /// La pièce Legal née de cette demande, quand il y en a une. Elle rend le classement
  /// IDEMPOTENT (on n'enregistre pas deux fois) et TRAÇABLE (le fil dit où la pièce est allée).
  legalDocumentId String?

  askedById String
  askedBy   User   @relation("DocRequestAsker", fields: [askedById], references: [id], onDelete: Cascade)
  askedToId String
  askedTo   User   @relation("DocRequestAsked", fields: [askedToId], references: [id], onDelete: Cascade)

  status       DocumentRequestStatus @default(PENDING)
  responseNote String?
  submittedAt  DateTime?
  closedAt     DateTime?
  closedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([askedToId, status])
  @@index([askedById, status])
  @@index([entityType, entityId])
}

// ═══════════════════════ DEMANDE DE PAIEMENT ═══════════════════════

/// L'état d'une demande de paiement, du point de vue de celui qui attend son argent.
/// « En attente » n'est pas « refusée » : la première reviendra, la seconde non — et
/// les confondre, c'est relancer les finances pour rien ou laisser mourir un dossier.
enum PaymentRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ON_HOLD
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// CE QUE PÈSE UNE ÉCHÉANCE DE PAIEMENT, quand il y en a une.
///
/// L'urgence (`PaymentUrgency`) répond à « quand ? » en l'absence de date ; la nature répond à
/// « et si on ne la tient pas ? ». Ce sont deux questions distinctes : une échéance au 30 peut
/// être non négociable, et une demande « urgente » peut n'avoir aucune date engagée.
enum PaymentDeadlineNature {
  MODERATE // moyenne — la date est un repère
  IMPORTANT // importante — un décalage se discute
  FIXED // fixe, non négociable — la date est un engagement pris
}

/// À défaut de date convenue, l'URGENCE. Une demande sans échéance n'est pas une demande
/// sans priorité — et sans ce champ, elle finit systématiquement au bas de la pile.
enum PaymentUrgency {
  WHEN_POSSIBLE
  THIS_MONTH
  THIS_WEEK
  URGENT
}

/// La nature d'une pièce du dossier. Les finances ne cherchent pas « la pièce n° 3 » :
/// elles cherchent LA FACTURE, et le bon de commande qui la justifie.
enum PaymentPieceKind {
  INVOICE
  PURCHASE_ORDER
  QUOTE
  DELIVERY_NOTE
  CONTRACT
  PROOF
  OTHER
}

/// Le verdict des finances sur UNE pièce. Refuser tout un dossier parce qu'une facture
/// est illisible oblige à tout redéposer — ici, on ne reprend que ce qui est en cause.
enum PaymentPieceStatus {
  PENDING
  ACCEPTED
  CHANGES_REQUESTED
  REJECTED
}

/// DEMANDE DE PAIEMENT — le dossier qui part aux Finances.
///
/// Elle porte ce qui décide d'un paiement : un montant, un bénéficiaire, une échéance
/// (ou, à défaut, une urgence), et LES PIÈCES qui le justifient. Ce n'est pas une
/// validation ordinaire : la discussion se tient **pièce par pièce**, elle repart
/// autant de fois qu'il le faut, et le dossier reste vivant entre les tours.
model PaymentRequest {
  id          String  @id @default(cuid())
  reference   String  @unique // PAY-2026-001
  title       String
  description String?

  amount Decimal @db.Decimal(14, 2)
  /// À QUI l'argent va — fournisseur, prestataire, praticien.
  payee  String

  /// Interlocuteur désigné aux Finances. Vide = tout le pôle est prévenu : une demande
  /// adressée à une personne absente ne doit pas dormir jusqu'à son retour.
  recipientId String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])

  /// L'échéance CONVENUE, quand elle existe.
  dueDate        DateTime?
  /// CE QUE CETTE ÉCHÉANCE PÈSE, dit par celui qui l'a négociée. Deux dates identiques ne
  /// valent pas la même chose : le 15 d'un fournisseur mensuel n'est pas le 15 d'une quittance
  /// dont le retard coûte une pénalité. Voir `src/lib/finance/deadline-nature.ts`.
  deadlineNature PaymentDeadlineNature @default(MODERATE)
  /// À défaut de date : le degré d'urgence, discuté.
  urgency        PaymentUrgency        @default(WHEN_POSSIBLE)

  /// LE MOYEN DE PAIEMENT FIGURE SUR LE DOCUMENT — déclaré par celui qui a la pièce sous les
  /// yeux. Sans lui, la comptabilité sait quoi payer mais pas comment : la facture est conforme,
  /// elle est autorisée, et le dossier repart trois jours pour un RIB.
  paymentMethodStated Boolean @default(false)

  /// CONTACT FACULTATIF chez le bénéficiaire — celui qu'on appelle quand une pièce manque ou
  /// qu'un virement n'arrive pas. Facultatif parce qu'il ne l'est pas toujours (une autorité
  /// sanitaire n'a pas d'interlocuteur nommé), et rendre obligatoire ce qui n'est pas toujours
  /// pertinent apprend à remplir les champs pour rien.
  contactName  String?
  contactPhone String?
  contactEmail String?

  status      PaymentRequestStatus @default(DRAFT)
  requesterId String

  /// Objet d'origine (poste de dépense, contrat de consulting…) — facultatif.
  entityType EntityType?
  entityId   String?
  link       String?

  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  /// Motif de la mise en attente — sans lui, « en attente » ne dit rien à personne.
  holdReason   String?

  /// Ordre de dépense créé une fois le bon à payer donné — ou, sur un dossier COMPAGNON,
  /// l'ordre qui a fait naître ce dossier.
  expenseOrderId String?

  /// D'OÙ VIENT CE DOSSIER — `REQUEST` (quelqu'un a demandé un paiement, et la décision sur ce
  /// dossier crée l'ordre) ou `EXPENSE_ORDER` (l'ordre existait déjà, né d'un autre circuit, et
  /// son dossier s'est ouvert automatiquement derrière lui). Deux dossiers identiques à l'écran,
  /// deux règles de décision opposées : un compagnon ne se tranche pas ici, il rassemble les
  /// pièces et la discussion. Voir `src/lib/finance/dossier-auto.ts`.
  origin String @default("REQUEST")

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pieces PaymentPiece[]
  events PaymentRequestEvent[]

  @@index([status])
  @@index([requesterId])
  @@index([recipientId, status])
  /// La file du décaissement lit le dossier DEPUIS l'ordre, en lot : sans cet index, chaque
  /// écran de trois cents ordres balayait la table entière.
  @@index([expenseOrderId])
}

/// UNE PIÈCE DU DOSSIER, avec sa conversation propre.
///
/// Le commentaire du demandeur (`note`) et celui des finances (`reviewNote`) vivent côte à
/// côte : « voici la facture, le montant TTC inclut la livraison » appelle une réponse sur
/// CETTE pièce, pas un message général qu'il faudra rattacher de tête.
model PaymentPiece {
  id         String           @id @default(cuid())
  requestId  String
  request    PaymentRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Le Document réel (blob chiffré, versionné) — jamais recopié ici.
  documentId String
  kind       PaymentPieceKind @default(OTHER)

  /// Ce que le DEMANDEUR dit de cette pièce.
  note String?

  status       PaymentPieceStatus @default(PENDING)
  /// Ce que les FINANCES répondent sur cette pièce.
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  /// Reprise : la pièce qui remplace celle-ci après un refus. On ne supprime pas
  /// l'originale — c'est elle qui explique pourquoi il y a eu un second tour.
  replacesId String?       @unique
  replaces   PaymentPiece? @relation("PieceRevision", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy PaymentPiece? @relation("PieceRevision")

  position    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requestId, position])
  @@index([documentId])
}

/// LE FIL DE LA DEMANDE — chaque geste laisse une trace lisible, dans l'ordre.
/// Un dossier qui a fait trois allers-retours doit pouvoir se relire : sans le fil, on ne
/// sait plus si la facture a été refusée avant ou après le changement de montant.
model PaymentRequestEvent {
  id        String         @id @default(cuid())
  requestId String
  request   PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String?
  /// Geste posé : SUBMIT, HOLD, RESUME, APPROVE, REJECT, CHANGES, COMMENT, PIECE_ADDED,
  /// PIECE_REVIEWED, VALIDATION_ASKED.
  kind      String
  message   String?
  /// Pièce concernée, quand le geste en vise une.
  pieceId   String?
  at        DateTime       @default(now())

  @@index([requestId, at])
}

// ───────────────────────────── LEGAL — les engagements de la société ─────────────────────────────

/// Nature d'un document légal. Les BONS DE COMMANDE vivent ici avec les contrats : ce sont des
/// engagements de la société, ils se relisent et s'opposent de la même façon.
enum LegalDocKind {
  CONTRACT // contrat (prestation, distribution…)
  QUOTE // devis — le premier maillon de la chaîne d'achat
  PURCHASE_ORDER // bon de commande
  INVOICE // facture — le dernier maillon avant le règlement
  /// AVOIR (§118.195) : la correction d'une FACTURE émise, qui ne se réécrit pas — un avoir naît de SA
  /// facture (`chainFromId`), sous son propre numéro, et en réduit le net ; il ne se crée pas seul.
  CREDIT_NOTE
  /// AVENANT à un contrat (`amendsId`) : une vraie pièce Legal — revue, lecteurs, Drive —
  /// qui porte EN PLUS son impact marché (`amountDelta`, lignes en delta). La valeur
  /// contractuelle courante = montant initial + deltas des avenants EFFECTIFS ; elle se
  /// calcule, le montant initial n'est jamais écrasé.
  AMENDMENT
  AGREEMENT // convention / accord-cadre
  NDA // accord de confidentialité
  INSURANCE // police d'assurance
  LICENSE // licence / autorisation
  LEASE // bail
  OTHER
}

/// État d'un document légal. `PERPETUAL` n'existe pas : un document SANS date de fin reste
/// simplement ACTIVE — c'est l'absence d'échéance qui le dit, pas un statut de plus.
enum LegalDocStatus {
  ACTIVE // en vigueur
  EXPIRED // échéance passée
  RENEWED // remplacé par un renouvellement (la suite vit dans un autre document)
  CANCELLED // annulé avant terme
}

/// UN ENGAGEMENT DE LA SOCIÉTÉ — contrat, bon de commande, convention, assurance.
///
/// Le document lui-même reste où il est : dans le DRIVE. On n'en fait pas une copie (deux
/// fichiers divergent toujours) — on pointe vers lui (`driveNodeId`). Le Legal ajoute ce que le
/// Drive ne sait pas dire : le titre exact, les dates, l'échéance, qui est en face, et ce qu'il
/// advient du document (renouvelé, annulé).
model LegalDocument {
  custom                   Json?
  id                       String                @id @default(cuid())
  companyId                String?
  company                  Company?              @relation(fields: [companyId], references: [id])
  reference                String? // référence interne / n° de BC
  title                    String // le titre EXACT, tel qu'il figure sur la pièce
  kind                     LegalDocKind          @default(CONTRACT)
  counterparty             String? // l'autre partie, telle qu'elle s'AFFICHE (nom ou institution)
  /// LES PARTIES, CHOISIES DANS L'ANNUAIRE DE L'ENTREPRISE — une ou plusieurs.
  ///
  /// Identifiants bruts de `CompanyContact` (même patron léger que `Task.participantIds`) :
  /// c'est ce lien qui permet d'ouvrir le nom affiché et d'y lire le mail et le contact, au
  /// lieu d'une chaîne saisie à la main qu'aucun écran ne peut rattacher à personne.
  /// `counterparty` reste le TEXTE affiché — recherche, exports et briefs le lisent tel quel —
  /// et le serveur le tient à jour à partir de cette liste.
  counterpartyIds          String[]              @default([])
  /// Dates FACULTATIVES : beaucoup d'engagements n'ont pas de terme (statuts, police tacite).
  /// `endDate` nul = sans échéance — jamais « expiré », jamais rappelé.
  startDate                DateTime?
  endDate                  DateTime?
  status                   LegalDocStatus        @default(ACTIVE)
  amount                   Decimal?              @db.Decimal(14, 2)
  notes                    String?
  cancelledAt              DateTime?
  cancelReason             String?
  /// Chaîne de RENOUVELLEMENT : le nouveau document pointe vers celui qu'il remplace, et
  /// l'ancien passe en RENEWED. On garde les deux — un renouvellement n'efface pas le passé.
  renewedFromId            String?
  renewedFrom              LegalDocument?        @relation("LegalRenewal", fields: [renewedFromId], references: [id])
  renewals                 LegalDocument[]       @relation("LegalRenewal")
  /// LE FICHIER RESTE DANS LE DRIVE : on le référence, on ne le duplique pas.
  driveNodeId              String?
  driveNode                DriveNode?            @relation(fields: [driveNodeId], references: [id], onDelete: SetNull)
  /// Rattachement à ce qui l'a fait naître (demande Ad & Pro, demande au secrétariat…).
  sourceType               EntityType?
  sourceId                 String?
  /// LE MARCHÉ dont ce contrat est issu — le lien FORT qui remplace la recherche par texte
  /// de référence. Un marché peut porter plusieurs contrats ; un contrat vient d'au plus un
  /// marché. PCH est propriétaire du contexte marché, Legal de la couche juridique : MÊME
  /// objet, deux vues (jamais deux copies).
  tenderId                 String?
  tender                   PchTender?            @relation("TenderContracts", fields: [tenderId], references: [id], onDelete: SetNull)
  /// AVENANT (`kind = AMENDMENT`) : le contrat qu'il modifie. `SetNull` : supprimer un contrat
  /// ne détruit pas les pièces d'avenant — il casse le fil, il n'efface rien.
  amendsId                 String?
  amends                   LegalDocument?        @relation("ContractAmendments", fields: [amendsId], references: [id], onDelete: SetNull)
  amendments               LegalDocument[]       @relation("ContractAmendments")
  /// Impact FINANCIER d'un avenant (± DZD). Le montant initial du contrat n'est JAMAIS
  /// écrasé : la valeur courante = initial + somme des deltas des avenants effectifs.
  amountDelta              Decimal?              @db.Decimal(14, 2)
  /// Signature et prise d'effet — un avenant signé mais non effectif ne compte pas encore.
  /// Pour un BON DE COMMANDE, c'est la signature des FINANCES (§118.149) : posée par
  /// `signerBonDeCommande`, jamais par un formulaire — une signature est une attestation.
  signedAt                 DateTime?
  /// QUI a signé, quand la signature a été donnée dans l'ERP (un BC signé par les Finances).
  /// Nul pour une date de signature reprise d'un papier (contrats du PCH).
  signedById               String?
  signedBy                 User?                 @relation("LegalDocSigner", fields: [signedById], references: [id], onDelete: SetNull)
  /// LE BC SIGNÉ SUR PAPIER (Direction, 06/10) : les Finances téléversent la copie signée (un `Document`
  /// d'étape « BC_SIGNE ») en nommant le SIGNATAIRE — `signedById` est alors la personne des Finances qui l'a
  /// enregistrée, `signedByName` celle qui a signé. `signatureCheck` garde ce que Luna a repéré (signature,
  /// cachet, numéro lu). Effacés avec la signature quand la pièce est révisée.
  signedByName             String?
  signatureCheck           Json?
  /// LA SIGNATURE RENVOYÉE À L'ÉMETTEUR (audit 360°, R09) : un signataire qui ne peut pas signer le
  /// BC tel quel le renvoie avec ce qu'il faut corriger — il quitte la file des signataires. TOUTE
  /// modification de la pièce efface ces trois champs (`aiguillerBC`, `modifie`) : le BC revient à
  /// la signature, ou à son centre si son montant l'y renvoie. Les trois vont ensemble.
  signatureReturnedAt      DateTime?
  signatureReturnedById    String?
  signatureReturnedBy      User?                 @relation("LegalDocSignatureReturner", fields: [signatureReturnedById], references: [id], onDelete: SetNull)
  signatureReturnNote      String?
  /// ENTRÉE D'UN BC DANS LE CIRCUIT « centre → signature des Finances » (§118.149). Posée par
  /// l'aiguillage la première fois qu'il lit la pièce sous cette règle. Nulle = BC d'avant la
  /// règle, jamais touché depuis : il n'est présumé ni à valider ni à signer — sans ce marqueur,
  /// fixer un seuil ferait apparaître tout l'historique dans la file des Finances.
  bcCircuitAt              DateTime?
  /// LA PRÉ-VALIDATION d'un bon de commande (Direction, 10/2026) : le demandeur le soumet d'abord aux validateurs
  /// qu'il choisit (« Demandes de validations »), puis demande la validation FINALE, qui l'adresse au centre. Tant
  /// que `bcPrevalidationAt` est posé, l'aiguillage ne l'envoie à aucun centre (`bons-de-commande/prevalidation.ts`).
  /// `bcPrevalidationRequestId` = la demande de validation qui le retient (nulle : pièce composée, demande pas encore créée).
  bcPrevalidationAt        DateTime?
  bcPrevalidationRequestId String?
  effectiveAt              DateTime?
  /// Les LIGNES CONTRACTUELLES portées par cette pièce (contrat de base ou avenant).
  contractLines            PchContractLine[]     @relation("DocContractLines")
  /// Toutes les lignes du GROUPE contractuel quand cette pièce est le contrat racine.
  rootContractLines        PchContractLine[]     @relation("RootContractLines")
  /// Les BONS DE COMMANDE exécutant ce contrat.
  pchOrders                PchOrder[]            @relation("ContractOrders")
  /// DOSSIER DE CLASSEMENT. Nul = « non classé », et c'est un état normal, pas un oubli :
  /// un engagement se dépose vite, il se range ensuite.
  folderId                 String?
  folder                   LegalFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// LA CHAÎNE DU DOSSIER D'ACHAT : chaque pièce pointe vers celle dont elle DÉCOULE — le bon
  /// de commande vers son devis, la facture vers son bon de commande. C'est ce lien qui permet
  /// de lire un achat d'un bout à l'autre (avec les validateurs et les délais de chaque maillon)
  /// au lieu de rapprocher trois lignes de tableau de tête. `SetNull` : supprimer un maillon ne
  /// détruit pas les suivants — il casse le fil, il n'efface pas les pièces.
  chainFromId              String?
  chainFrom                LegalDocument?        @relation("LegalChain", fields: [chainFromId], references: [id], onDelete: SetNull)
  chainNext                LegalDocument[]       @relation("LegalChain")
  /// LE RÈGLEMENT d'une facture : l'ordre de dépense créé pour la payer — qui passe par le
  /// centre de paiement comme toute dépense. Nul = pas encore envoyée au règlement.
  expenseOrderId           String?
  /// SENS DE L'ARGENT d'une FACTURE (`kind = INVOICE`) — `OUT` : facture REÇUE, la société
  /// paie ; `IN` : facture ÉMISE, elle encaisse. Nul sur toute autre nature. On ne le devine
  /// jamais du nom de la partie : une écriture posée à l'envers est pire qu'une écriture
  /// absente, parce qu'elle se voit moins.
  direction                String?
  /// DATE DE RÈGLEMENT EFFECTIF d'une facture. La renseigner, c'est déclarer la facture
  /// réglée ; l'effacer, c'est la remettre à régler. Le statut ne la contredit jamais :
  /// `LegalDocStatus` dit la vie du document (en vigueur, annulé), `paidDate` dit l'argent.
  paidDate                 DateTime?
  /// L'ÉCRITURE FINANCIÈRE d'un règlement SAISI DIRECTEMENT (facture déjà payée qu'on
  /// enregistre après coup). Quand la facture est partie au CIRCUIT (`expenseOrderId`), c'est
  /// lui qui écrit au paiement : poser ici une seconde écriture compterait le même dinar deux
  /// fois. La règle vit dans `lib/finances/settlement.ts`, testée.
  settlementTxId           String?               @unique
  settlementTx             FinanceTransaction?   @relation("LegalSettlement", fields: [settlementTxId], references: [id], onDelete: SetNull)
  /// LES LECTEURS AUTORISÉS — qui, en plus du déposant, a le droit d'ouvrir ce document.
  ///
  /// Un engagement de la société n'est pas une pièce d'équipe : un bail, un contrat de travail
  /// de cadre, un protocole d'accord ne se lisent pas parce qu'on a le module Legal. Le
  /// déposant désigne ses lecteurs ; hors d'eux (et du Super Admin, qui arbitre), le document
  /// n'existe pas — il ne figure ni dans la liste, ni par son identifiant.
  ///
  /// Liste VIDE = document ouvert à tout le module, comme avant. C'est le seul défaut sûr pour
  /// l'historique : le remplir de listes devinées aurait fermé des documents à ceux qui les
  /// utilisent, sans que personne sache lesquels.
  readers                  LegalDocumentReader[]
  /// Les postes Ad & Pro que cette pièce sert (§118.204).
  postesAdPro              AdProItemPiece[]
  /// Le devis d'un poste Ad & Pro, tel que LU et structuré (§118.206) — au plus un par pièce.
  devisPoste               AdProDevis?           @relation("AdProDevisPiece")
  /// Les lignes de devis de poste que CE bon de commande couvre (§118.206).
  lignesDeDevisCouvertes   AdProDevisLigne[]     @relation("AdProDevisLigneBc")
  /// Dernier rappel d'échéance envoyé — évite de renotifier tous les jours.
  lastRemindedAt           DateTime?
  createdById              String?
  createdBy                User?                 @relation("LegalDocCreator", fields: [createdById], references: [id])
  updatedById              String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  /// LE DÉTAIL d'une facture de matériel promotionnel (§118.165) : lignes, taxes, réception.
  promoFacture             PromoFacture?

  @@index([companyId, status])
  @@index([kind])
  @@index([endDate])
  @@index([sourceType, sourceId])
  @@index([driveNodeId])
  @@index([chainFromId])
  @@index([tenderId])
  @@index([amendsId])
  @@index([bcPrevalidationRequestId])
  @@index([paidDate])
}

/// UN LECTEUR AUTORISÉ d'un document légal. Le déposant les désigne à la création, et peut les
/// revoir ensuite. Supprimer le document emporte ses lecteurs.
/// DOSSIER DE CLASSEMENT DES ENGAGEMENTS — l'armoire, pas le classeur.
///
/// Trois cents contrats dans une seule liste se cherchent au filtre, jamais au regard. Les
/// dossiers rendent au module la structure qu'ont les armoires réelles : « Baux », « Assurances »,
/// « Prestataires 2026 » — avec des sous-dossiers quand c'est utile.
///
/// Le dossier ne porte AUCUN droit : la restriction d'un engagement reste sur lui (ses lecteurs
/// désignés) et sur son entité. Un dossier qui donnerait accès à son contenu ferait qu'y ranger
/// une pièce l'ouvrirait à d'autres — exactement le contraire de ce que le classement doit faire.
model LegalFolder {
  id          String        @id @default(cuid())
  name        String
  /// Entité de rattachement. Nul = dossier commun au groupe.
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      LegalFolder?  @relation("LegalFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    LegalFolder[] @relation("LegalFolderTree")
  description String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  documents LegalDocument[]

  @@index([companyId])
  @@index([parentId])
}

model LegalDocumentReader {
  id          String        @id @default(cuid())
  documentId  String
  document    LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?
  createdAt   DateTime      @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// ───────────────────────────── COURRIERS — le carnet entrant / sortant ─────────────────────────────

/// UN PARTENAIRE DU REGISTRE DES COURRIERS — fournisseur, administration, client, prestataire.
///
/// Liste PROPRE au module, et non les fournisseurs du Regulatory : ceux-là sont des fabricants
/// pharmaceutiques référencés dans des dossiers d'enregistrement, et les mêler ferait de
/// l'assistante de direction quelqu'un qui peut supprimer un fabricant d'AMM en rangeant son
/// courrier. Elle tient CETTE liste, elle seule, et elle n'engage que le registre.
model MailPartner {
  id       String  @id @default(cuid())
  name     String  @unique
  /// Nature libre — « Fournisseur », « Administration », « Client », « Prestataire »…
  kind     String?
  contact  String?
  notes    String?
  isActive Boolean @default(true)

  entries MailEntry[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

enum MailDirection {
  INCOMING // courrier reçu
  OUTGOING // courrier expédié
}

/// UN COURRIER, ENTRANT OU SORTANT — le carnet de l'assistante de direction.
///
/// Les quatre dates ne disent pas la même chose et se remplissent à des moments différents :
/// on POSTE (`sentAt`, avec l'heure), le pli ARRIVE (`receivedAt`), et l'on récupère
/// l'ACCUSÉ (`acknowledgedAt`). Aucune n'est obligatoire : un courrier qu'on vient de déposer
/// n'a encore ni arrivée ni accusé.
model MailEntry {
  custom             Json?
  id                 String           @id @default(cuid())
  companyId          String?
  company            Company?         @relation(fields: [companyId], references: [id])
  reference          String? // n° de chrono
  title              String
  direction          MailDirection
  sender             String? // expéditeur, tel qu'il s'AFFICHE (nom ou institution)
  recipient          String? // destinataire, tel qu'il s'AFFICHE
  /// L'EXPÉDITEUR ET LE DESTINATAIRE, CHOISIS DANS L'ANNUAIRE DE L'ENTREPRISE.
  /// Identifiants bruts de `CompanyContact` : le nom affiché s'ouvre et donne le mail et le
  /// contact. Les colonnes texte ci-dessus restent la valeur AFFICHÉE, tenue par le serveur.
  senderContactId    String?
  recipientContactId String?
  sentAt             DateTime? // date ET heure de départ
  receivedAt         DateTime? // date d'arrivée
  acknowledgedAt     DateTime? // date d'accusé de réception
  carrier            String? // porteur / transporteur (coursier, poste, e-mail…)
  /// LE PARTENAIRE CONCERNÉ, s'il y en a un — choisi dans la liste du module (`MailPartner`).
  /// Facultatif : beaucoup de plis sont internes ou n'engagent personne d'extérieur.
  partnerId          String?
  partner            MailPartner?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  /// LA DIRECTION CONCERNÉE — le département que le pli vise. Un courrier arrive au registre,
  /// mais il s'adresse à quelqu'un : sans cette colonne, l'assistante doit se souvenir de qui
  /// l'attendait, et un pli non relevé ne se retrouve que par son objet.
  departmentId       String?
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// LA PERSONNE CONCERNÉE. Indépendante de la direction, et les deux se cumulent : un contrat
  /// vise « la Direction Générale » ET son directeur, une convocation vise une seule personne.
  concernedUserId    String?
  concernedUser      User?            @relation("MailEntryConcerned", fields: [concernedUserId], references: [id], onDelete: SetNull)
  notes              String?
  /// LE FICHIER RESTE DANS LE DRIVE : on le référence, on ne le duplique pas. Deux copies
  /// auraient divergé dès la première correction, et plus personne n'aurait su laquelle fait foi.
  driveNodeId        String?
  driveNode          DriveNode?       @relation(fields: [driveNodeId], references: [id], onDelete: SetNull)
  /// LE DOSSIER DE CLASSEMENT, s'il y en a un. Un dossier RANGE, il n'autorise pas : le
  /// cloisonnement par entité reste la seule règle d'accès. `SET NULL` : supprimer un dossier
  /// déclasse ses plis, il ne les efface jamais.
  folderId           String?
  folder             MailEntryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sourceType         EntityType?
  sourceId           String?
  pieces             MailEntryPiece[]
  /// « RELIER À… » — un pli peut concerner PLUSIEURS objets (le marché ET son contrat ET un
  /// BC). `sourceType/sourceId` reste la relation de NAISSANCE ; ceci est le classement.
  createdById        String?
  createdBy          User?            @relation("MailEntryCreator", fields: [createdById], references: [id])
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([companyId, direction])
  @@index([sentAt])
  @@index([receivedAt])
  @@index([sourceType, sourceId])
  @@index([driveNodeId])
  @@index([partnerId])
  @@index([departmentId])
  @@index([concernedUserId])
  @@index([folderId])
}

/// UNE PIÈCE D'UN COURRIER, AVEC SON PROPRE DESTINATAIRE.
/// Un pli porte souvent plusieurs pièces qui ne vont pas au même endroit : le contrat signé pour
/// le fournisseur, la copie pour les finances, l'attestation pour l'ANPP. Un destinataire unique
/// au niveau du courrier oblige alors à créer trois courriers pour un seul envoi — et la trace de
/// ce qui est parti à qui se perd.
/// La pièce est SOIT un document téléversé (`documentId`), SOIT une référence au Drive
/// (`driveNodeId`, jamais recopiée) — pas les deux.
model MailEntryPiece {
  id          String     @id @default(cuid())
  entryId     String
  entry       MailEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Le nom qu'on lit dans la liste — celui du fichier ne dit pas à quoi la pièce sert.
  label       String
  /// À QUI CETTE PIÈCE EST DESTINÉE. Libre : un destinataire est parfois une personne, parfois un
  /// service, parfois une administration qui n'a pas de compte ici.
  recipient   String?
  documentId  String?
  document    Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  /// LE FICHIER RESTE DANS LE DRIVE : on le référence, on ne le duplique pas.
  driveNodeId String?
  driveNode   DriveNode? @relation("MailPieceDriveNode", fields: [driveNodeId], references: [id], onDelete: SetNull)
  notes       String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entryId])
  @@index([documentId])
  @@index([driveNodeId])
}

/// LES DOSSIERS DE CLASSEMENT DU COURRIER — l'armoire du registre, pendant exact de LegalFolder.
/// Cinq cents plis dans une liste se cherchent au filtre, jamais au regard ; les dossiers rendent
/// au registre la structure d'une vraie armoire (« Fournisseurs », « ANPP », « Baux 2026 »).
/// ⚠️ UN DOSSIER NE PORTE AUCUN DROIT : le cloisonnement par entité reste la seule règle d'accès.
model MailEntryFolder {
  id          String            @id @default(cuid())
  name        String
  /// Entité de rattachement. Nul = dossier commun au groupe.
  companyId   String?
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      MailEntryFolder?  @relation("MailEntryFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MailEntryFolder[] @relation("MailEntryFolderTree")
  description String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  entries MailEntry[]

  @@index([companyId])
  @@index([parentId])
}

// ───────────────────────────── FACTURES ─────────────────────────────

/// LE REJEU DE SESSION — la suite des actions d'une personne, pour le support technique.
/// Ce N'EST PAS une vidéo : un navigateur ne peut pas filmer l'écran sans autorisation explicite ni
/// indicateur visible. On enregistre les ACTIONS (pages, clics, saisies, envois, erreurs), ce que
/// font LogRocket ou FullStory, et ce qui suffit à reproduire un bug.
/// ⚠️ AUCUNE VALEUR DE CHAMP n'y entre — jamais un mot de passe, un montant, un contenu. Le
/// masquage est appliqué à l'entrée par `src/lib/replay/capture.ts`, et vérifié par ses tests.
/// UN RAPPEL DU CHIEF OF STAFF — « rappelle-moi mardi à 10 h », « tous les dimanches relance
/// Regulatory ». Un rappel appartient à UNE personne ; à l'échéance il la prévient (pop-up), et
/// s'il porte un `targetRole`, il relance AUSSI ce rôle avec la note. `NONE` s'éteint après le
/// premier tir ; les récurrences avancent leur échéance et restent actives.
model AssistantReminder {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("AssistantReminderUser", fields: [userId], references: [id], onDelete: Cascade)
  title        String
  note         String?
  link         String?
  dueAt        DateTime
  recurrence   String    @default("NONE") // NONE | DAILY | WEEKLY | MONTHLY
  /// Rôle à RELANCER à l'échéance (ex. HEAD_OF_REGULATORY) — le cœur du « tous les dimanches,
  /// demande à Regulatory où en sont les dossiers ». Nul = on ne prévient que soi.
  targetRole   String?
  /// PERSONNE NOMMÉE à relancer à l'échéance — « tous les dimanches relance Nesrine ». Se cumule
  /// avec `targetRole` (l'un, l'autre, ou les deux). `SetNull` : un compte supprimé n'emporte pas
  /// le rappel, il cesse simplement d'être relancé.
  targetUserId String?
  targetUser   User?     @relation("AssistantReminderTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  /// SURVEILLANCE CONDITIONNELLE — « si ce paiement n'est pas validé sous 48 h, préviens-moi ».
  /// Le rappel regarde l'entité à l'échéance : encore en attente → il prévient le PROPRIÉTAIRE
  /// (jamais le responsable de l'entité — surveiller n'est pas relancer) ; réglée → il le dit et
  /// s'éteint. `watchType` ∈ EXPENSE_ORDER | PAYMENT_REQUEST | TASK | VALIDATION_REQUEST.
  watchType    String?
  watchId      String?
  watchLabel   String?
  /// PAR OÙ le rappel arrive : NOTIFICATION (défaut — notification interne + push), EMAIL, ou
  /// LES_DEUX. L'e-mail ne part que vers les adresses que la personne a DÉCLARÉES pour elle-même
  /// et sous la nature RAPPEL, l'une des huit qu'elle a autorisées sans confirmation (§118.39) ;
  /// sans adresse lisible, le rappel retombe sur la notification et le DIT.
  channel      String    @default("NOTIFICATION")
  active       Boolean   @default(true)
  lastFiredAt  DateTime?
  /// ÉCHELLE DE RELANCES — heures après chaque tir (« rappelle demain ; si rien, +48 h puis
  /// +72 h » = dueAt demain + [48, 72]). Consommée barreau par barreau ; vide = un seul tir.
  escalationsH Json      @default("[]")
  /// EXTINCTION SUR ÉVÉNEMENT — une Attente (même grammaire que les missions : event/from/
  /// threadId/attachment). Le fait arrive → le rappel s'éteint TOUT SEUL, relances comprises :
  /// « rappelle-moi dans 7 jours SEULEMENT SI Sarah n'a pas envoyé le contrat ».
  stopOnEvent  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, dueAt])
  @@index([userId])
}

model SessionEvent {
  id        String   @id @default(cuid())
  /// La session de navigation — c'est elle qu'on rejoue d'un bout à l'autre.
  sessionId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String // PAGE | CLICK | INPUT | SUBMIT | ERROR | NAV
  /// Millisecondes depuis le début de la session : un horodatage relatif se rejoue tel quel.
  at        Int
  path      String
  /// Le LIBELLÉ de l'élément (« Enregistrer »), jamais sa valeur.
  label     String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([sessionId, at])
  @@index([userId, createdAt])
  @@index([kind])
}

// ═══════════════════════ ADAM — le Chief of Staff VIVANT ═══════════════════════
// Google (Gmail, Agenda, Drive, Docs, Sheets, Slides, Contacts) n'est pas un second
// assistant : ce sont des SENS et des CANAUX de plus pour le MÊME Chief. Ces modèles
// portent donc trois choses, et rien d'autre : la CONNEXION (jetons chiffrés, santé),
// ce qui est ENTRÉ (métadonnées + sémantique — Google reste la source des messages),
// et ce qui doit SORTIR (intention d'envoi, sous autorité du PDG).

/// LA POLITIQUE D'ENVOI — typée, persistante, réglable À CHAUD par le PDG.
///
/// Elle n'est pas dans le code : une règle de sécurité qu'on ne peut changer qu'en
/// redéployant finit par être contournée autrement. `REQUIRE_APPROVAL` est le défaut, et
/// c'est le seul état où personne — ni un plan, ni une mission de fond, ni un cron — ne
/// peut faire partir un message sans que le PDG l'ait vu.
enum MailSendPolicy {
  REQUIRE_APPROVAL /// défaut : aucun envoi sans approbation explicite
  AUTO_SEND /// envoi autonome (bascule SENSIBLE : confirmée, auditée)
  DRAFT_ONLY /// brouillons seulement — rien ne part, même approuvé
}

/// La politique de communication. Une ligne « global » aujourd'hui ; le champ `scope`
/// existe pour la granularité future (identité, domaine destinataire, mission) sans
/// migration : `identity:<id>`, `domain:<x>`, `mission:<id>`.
model CommunicationPolicy {
  id             String         @id @default(cuid())
  scope          String         @unique @default("global")
  mailSendPolicy MailSendPolicy @default(REQUIRE_APPROVAL)
  /// COUPE-CIRCUIT SORTANT — prime sur AUTO_SEND : levé, plus rien ne part.
  outboundPaused Boolean        @default(false)
  /// Traitement de la boîte suspendu (l'ingestion s'arrête, la connexion reste).
  inboundPaused  Boolean        @default(false)
  updatedById    String?
  updatedAt      DateTime       @updatedAt
  createdAt      DateTime       @default(now())
}

/// LA CONNEXION GOOGLE d'une identité de communication du Chief.
///
/// Isolation structurelle : tout part de `userId`. Les jetons dorment chiffrés
/// (AES-256-GCM, `secret-box`) et ne sont déchiffrés qu'au moment d'appeler Google —
/// jamais rendus au navigateur, jamais journalisés.
model GoogleConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation("UserGoogleConnection", fields: [userId], references: [id], onDelete: Cascade)
  /// L'adresse réellement servie (minuscule) — contrôlée contre GOOGLE_ADAM_EMAIL.
  address         String
  displayName     String?
  /// Identifiant stable du compte Google (`sub`) — détecte un changement de compte.
  googleSub       String?
  accessTokenEnc  String?   @db.Text
  refreshTokenEnc String?   @db.Text
  expiresAt       DateTime?
  /// Droits réellement accordés — un consentement partiel doit se voir.
  grantedScopes   String?   @db.Text
  /// connected | needs-reconnect
  status          String    @default("connected")
  lastError       String?
  lastSyncAt      DateTime?
  /// COUPE-CIRCUIT d'intégration : suspend Google (lecture ET écriture) sans déconnecter.
  paused          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  gmail    GmailIngestionState?
  emails   EmailRecord[]
  outbound OutboundMailIntent[]
}

/// L'ÉTAT D'INGESTION GMAIL — la mémoire de ce qu'Adam a déjà vu.
///
/// Le push (watch + Pub/Sub) est un SIGNAL, jamais la charge utile : `lastHistoryId`
/// permet de rejouer l'histoire depuis Google, seule source canonique. La réconciliation
/// périodique existe parce qu'un push manqué (redémarrage, panne réseau, watch expiré)
/// ne doit PAS faire disparaître un message de la conscience d'Adam.
model GmailIngestionState {
  id               String           @id @default(cuid())
  connectionId     String           @unique
  connection       GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  lastHistoryId    String?
  watchExpiration  DateTime?
  watchTopic       String?
  lastNotifiedAt   DateTime?
  lastReconciledAt DateTime?
  lastWatchError   String?
  ingestedCount    Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

/// UN MESSAGE INGÉRÉ — métadonnées + projection sémantique, pas la boîte recopiée.
///
/// Google reste la source de vérité du contenu : on garde ici de quoi CHERCHER, RELIER et
/// SE SOUVENIR (expéditeur résolu, entités, engagements, questions), et l'extrait. Le corps
/// complet se relit à la demande.
model EmailRecord {
  id                String           @id @default(cuid())
  connectionId      String
  connection        GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerMessageId String
  threadId          String
  /// Identifiants RFC — la conversation, pas des messages isolés.
  rfcMessageId      String?
  inReplyTo         String?
  referencesHeader  String?          @db.Text
  /// INBOUND | OUTBOUND
  direction         String           @default("INBOUND")
  fromAddress       String
  fromName          String?
  toAddresses       String[]         @default([])
  ccAddresses       String[]         @default([])
  subject           String?
  snippet           String?          @db.Text
  sentAt            DateTime?
  labels            String[]         @default([])
  hasAttachments    Boolean          @default(false)
  /// L'expéditeur RÉSOLU vers l'ERP quand les preuves le permettent.
  senderUserId      String?
  senderCompanyId   String?
  /// « EmailIntelligence » : sujets, entités, engagements, questions, échéances, actions.
  semantics         Json?
  /// HIGH | MEDIUM | LOW — sert au tri de l'attention, jamais à masquer un message.
  importance        String?
  /// Le message est-il pertinent pour le PDG (a-t-il été remonté) ?
  surfacedAt        DateTime?
  missionId         String?
  mission           Mission?         @relation(fields: [missionId], references: [id], onDelete: SetNull)
  processedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  attachments EmailAttachmentRecord[]

  @@unique([connectionId, providerMessageId])
  @@index([connectionId, sentAt])
  @@index([threadId])
  @@index([fromAddress])
  @@index([missionId])
}

/// UNE PIÈCE JOINTE ARRIVÉE PAR COURRIEL — objet multimodal de première classe.
///
/// Le PDG ne doit jamais avoir à télécharger puis re-téléverser : le texte extrait rend la
/// pièce utilisable par le Chief, et `driveNodeId` / `documentId` la rattachent à l'ERP
/// quand c'est utile.
model EmailAttachmentRecord {
  id                   String      @id @default(cuid())
  emailRecordId        String
  emailRecord          EmailRecord @relation(fields: [emailRecordId], references: [id], onDelete: Cascade)
  /// Identifiant de la pièce chez Google (permet de la retélécharger à la demande).
  providerAttachmentId String?
  filename             String
  mimeType             String?
  sizeBytes            Int         @default(0)
  /// Texte extrait (Excel, PDF, Word, image OCR…) — borné, pour la compréhension.
  extractedText        String?     @db.Text
  extractionNote       String?
  driveNodeId          String?
  documentId           String?
  createdAt            DateTime    @default(now())

  @@index([emailRecordId])
}

/// L'ÉTAT D'UNE INTENTION D'ENVOI — la machine qui rend l'approbation INCONTOURNABLE.
enum OutboundMailStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SENDING
  SENT
  FAILED
  CANCELLED
  EXPIRED
}

/// L'INTENTION D'ENVOI CANONIQUE — le SEUL chemin par lequel un message peut partir.
///
/// L'approbation porte sur un CONTENU EXACT (`contentHash` : destinataires, objet, corps,
/// pièces, identité). Modifier un champ après approbation invalide l'approbation — on ne
/// peut pas faire approuver A puis envoyer B. `idempotencyKey` garantit qu'un double clic,
/// un rejeu réseau ou un webhook répété n'expédient jamais deux fois.
model OutboundMailIntent {
  id                String             @id @default(cuid())
  connectionId      String
  connection        GoogleConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Le compte ERP au nom duquel l'intention existe (le PDG).
  userId            String
  threadId          String?
  inReplyTo         String?
  referencesHeader  String?            @db.Text
  recipients        String[]           @default([])
  cc                String[]           @default([])
  bcc               String[]           @default([])
  subject           String
  bodyText          String             @db.Text
  bodyHtml          String?            @db.Text
  /// Pièces jointes RÉFÉRENCÉES (nœuds Drive / pièces reçues) — jamais des octets ici.
  attachments       Json               @default("[]")
  missionId         String?
  mission           Mission?           @relation(fields: [missionId], references: [id], onDelete: SetNull)
  /// Pourquoi ce message existe — « demandé par le PDG », « relance de la mission X ».
  reason            String?
  /// chief | mission | plan | manual — d'où vient l'intention.
  generatedBy       String             @default("chief")
  status            OutboundMailStatus @default(DRAFT)
  /// L'approbation était-elle requise au moment de la préparation (photo de la politique) ?
  approvalRequired  Boolean            @default(true)
  policyAtCreation  MailSendPolicy     @default(REQUIRE_APPROVAL)
  contentHash       String
  /// Le hash EXACT approuvé — comparé au contentHash courant avant tout envoi.
  approvedHash      String?
  approvedById      String?
  approvedAt        DateTime?
  idempotencyKey    String             @unique
  sendingStartedAt  DateTime?
  sentAt            DateTime?
  providerMessageId String?
  providerThreadId  String?
  failureReason     String?
  attempts          Int                @default(0)
  /// Journal des transitions [{ status, at, by }] — l'historique d'autorisation.
  events            Json               @default("[]")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, status])
  @@index([missionId])
  @@index([connectionId, createdAt])
}

/// L'ÉTAT D'UNE MISSION — une demande du PDG qui SURVIT à un tour de conversation.
enum MissionStatus {
  /// ─── Missions de COORDINATION (historique) ───
  DRAFT
  ACTIVE
  WAITING
  PARTIAL
  BLOCKED
  NEEDS_CEO
  READY_TO_SEND
  COMPLETED
  CANCELLED
  /// ─── Missions d'EXÉCUTION (Mission Runtime) ───
  /// Les valeurs historiques ne sont pas renommées : des lignes réelles les portent, et les
  /// renommer aurait cassé des missions en cours pour un gain cosmétique. `Mission.kind`
  /// distingue les deux familles sans les séparer en deux tables.
  PLANNING
  READY
  AWAITING_APPROVAL
  RUNNING
  WAITING_EVENT
  WAITING_INPUT
  WAITING_DEPENDENCY
  RETRYING
  FAILED
  /// SUSPENDUE PAR UNE PERSONNE — distincte de BLOCKED, qui décrit une mission à qui il manque
  /// quelque chose. Ici rien ne manque : on lui a dit d'attendre, et elle repart au même point.
  PAUSED
}

/// UNE MISSION — la coordination humaine, tenue dans le temps.
///
/// « Demande à Regulatory ce dont ils ont besoin de Deepak » n'est pas une réponse de chat :
/// c'est une boucle DEMANDER → ATTENDRE → COLLECTER → RÉCONCILIER → RELANCER → CONSOLIDER →
/// TRANSMETTRE, qui dure des jours. La mission porte cet état, et c'est elle qui permet de
/// répondre « qui n'a pas encore répondu ? » sans rien redemander à personne.
model Mission {
  id          String        @id @default(cuid())
  /// Le PDG propriétaire — l'isolation part d'ici.
  ownerId     String
  owner       User          @relation("UserMissions", fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  /// L'objectif en une phrase — ce qu'on cherche à obtenir, pas la manière.
  objective   String        @db.Text
  context     String?       @db.Text
  status      MissionStatus @default(DRAFT)
  /// Entités ERP concernées [{ type, id, label }] — le lien avec le reste de l'OS.
  entities    Json          @default("[]")
  /// Demandes extraites des réponses reçues, consolidées.
  extracted   Json          @default("[]")
  /// Engagements pris par les uns et les autres [{ who, what, dueAt }].
  commitments Json          @default("[]")
  /// La prochaine action suggérée par Adam (jamais exécutée seule si elle sort).
  nextAction  String?       @db.Text
  dueAt       DateTime?
  /// Dernière relance envoyée — évite de relancer deux fois le même jour.
  lastNudgeAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// COORDINATION (poursuivre des humains) | RUNTIME (exécuter un DAG durable).
  kind            String    @default("COORDINATION")
  /// L'objectif tel que le PDG l'a formulé, MOT POUR MOT. `objective` est la reformulation ;
  /// c'est le brut qui fait foi quand on juge si l'objectif est atteint (§20).
  goalRaw         String?   @db.Text
  /// Les critères d'acceptation, produits par le planner et VÉRIFIÉS avant COMPLETED.
  acceptance      Json      @default("[]")
  /// Les deux axes INDÉPENDANTS (§1) : A|B|C pour le raisonnement, S|M|L|XL|MASSIVE pour l'échelle.
  complexity      String?
  scale           String?
  /// Incrémentée à chaque replan. Une étape d'un plan périmé n'est pas supprimée : elle est
  /// marquée — l'historique d'une mission compte autant que son état.
  planVersion     Int       @default(1)
  parentMissionId String?
  parentMission   Mission?  @relation("SubMissions", fields: [parentMissionId], references: [id], onDelete: SetNull)
  subMissions     Mission[] @relation("SubMissions")
  /// `null` = pas encore évalué, ce qui n'est PAS `false`.
  goalSatisfied   Boolean?
  qaPassed        Boolean?
  goalVerdict     String?   @db.Text
  /// Observabilité (§54) — ce que la mission a réellement coûté.
  modelCalls      Int       @default(0)
  toolCalls       Int       @default(0)
  tokensIn        Int       @default(0)
  tokensOut       Int       @default(0)
  costUsd         Float     @default(0)
  startedAt       DateTime?
  /// Limite OPÉRATIONNELLE de parallélisme, jamais une limite d'architecture (§4).
  maxConcurrency  Int       @default(6)
  /// PRIORITÉ d'ordonnancement : le battement sert les priorités hautes d'abord. 0 = normal.
  priority        Int       @default(0)
  /// BAIL multi-instances : l'instance qui détient le bail fait avancer, les autres passent.
  /// La sûreté ne dépend PAS du bail (les étapes se réservent en base) — il évite le travail
  /// en double quand plusieurs battements tournent.
  leaseOwner      String?
  leaseUntil      DateTime?
  /// PLAFOND d'appels de modèle (« ne dépense plus de modèle sur ce dossier aujourd'hui »).
  /// Nul = pas de plafond. Atteint : la mission dort (BUDGET_HOLD), elle n'échoue pas.
  modelCallsCap   Int?
  /// LA CARTE DU PLAN telle que le planificateur l'a rendue : axes de travail, livrables
  /// attendus, stratégie d'accord, critère arithmétique de fin. Lue par le contrôle qualité et
  /// par le juge — quatre informations qui naissent ensemble et dont aucune ne s'interroge seule.
  planMeta        Json      @default("{}")

  /// LA PAUSE SAIT DEPUIS QUAND, POURQUOI, ET D'OÙ ELLE REPART.
  ///
  /// `PAUSED` existait comme statut sans rien pour le décrire : on ne pouvait ni l'afficher
  /// honnêtement (« en pause » depuis quand ?) ni le reprendre (reprendre VERS quel état ?).
  /// `pausedFrom` garde le statut d'avant la pause, ce qui rend « reprends-la demain » exact au
  /// lieu d'être une re-déduction qui pourrait diverger.
  pausedAt     DateTime?
  pausedReason String?
  pausedFrom   String?

  /// LA PERSÉVÉRANCE SE JUGE AU PROGRÈS, PAS AU NOMBRE D'ESSAIS (§118.18).
  ///
  /// `replanRefus` est la signature du dernier refus de compilation — ses CODES, jamais ses
  /// clés d'étape : un planificateur qui reprend son plan renomme presque toujours ses clés,
  /// et signer `code@étape` rendrait chaque refus « nouveau ».
  ///
  /// `replanBloque` est ce que lit la requête du battement. Vrai = le refus s'est répété (ou
  /// le plafond opérationnel local est atteint) : un tour de plus rendrait la même réponse,
  /// plus chère. Il se remet à FAUX dès qu'une information neuve arrive — réponse humaine,
  /// événement, modification demandée : c'est la différence entre « il tourne en rond » et
  /// « on ne lui avait rien donné de nouveau ».
  replanRefus  String?
  replanBloque Boolean @default(false)

  artifacts    MissionArtifact[]
  participants MissionParticipant[]
  events       MissionEvent[]
  emails       EmailRecord[]
  intents      OutboundMailIntent[]
  steps        MissionStep[]
  milestones2  MissionMilestone[]
  inputs       MissionInput[]
  workerRuns   MissionWorkerRun[]
  approvals    MissionApproval[]
  commitments2 ExecutiveCommitment[] @relation("MissionCommitments")
  /// La SURVEILLANCE que cette mission porte (kind WATCH) — journal, porte d'attention, conduite : jamais un second système.
  watch        AdamWatch?            @relation("MissionWatch")

  @@index([ownerId, status])
  @@index([status, updatedAt])
  @@index([kind, status])
  @@index([parentMissionId])
  @@index([status, replanBloque])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UNE ÉTAPE — le nœud du DAG, ET le point de reprise.
///
/// Il n'y a pas de table de checkpoints : une étape TERMINÉE, avec son reçu, EST le checkpoint.
/// Au redémarrage on relit les étapes, et celles qui portent un reçu ne sont pas rejouées —
/// c'est ce qui empêche de renvoyer 72 e-mails après un crash à la 73ᵉ.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model MissionStep {
  id                  String            @id @default(cuid())
  missionId           String
  mission             Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// Le regroupement logique — sert à l'affichage ET au replan ciblé.
  workstream          String            @default("default")
  /// LE JALON auquel cette étape appartient. NULLABLE : une mission courte n'a pas de jalons,
  /// et tout le corpus antérieur continue de tourner. C'est cette colonne qui rend la
  /// replanification LOCALE : on recompile les étapes d'UN jalon sans toucher aux autres.
  milestoneId         String?
  milestone           MissionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  /// La clé STABLE dans le plan : c'est elle que les dépendances désignent, et c'est elle qui
  /// rend la compilation RÉ-ENTRANTE (recompiler ne duplique pas, il retrouve).
  key                 String
  title               String
  /// La capacité appelée. `null` pour un nœud de contrôle (attente, jonction).
  capability          String?
  /// CAPABILITY | WORKER | WAIT_EVENT | WAIT_INPUT | APPROVAL | QA | ARTIFACT | JOIN
  nodeType            String            @default("CAPABILITY")
  input               Json              @default("{}")
  /// PENDING | READY | RUNNING | DONE | FAILED | SKIPPED | WAITING | CANCELLED
  status              String            @default("PENDING")
  attempt             Int               @default(0)
  maxAttempts         Int               @default(3)
  /// LA CLÉ D'IDEMPOTENCE (§15) — unique en base, donc garantie par la base et non par la
  /// discipline de l'appelant.
  idempotencyKey      String?
  result              Json?
  receipt             String?
  /// LE REÇU STRUCTURÉ DE L'APPEL — ce que le code a CONSTATÉ, pas ce qu'un modèle en dit.
  ///
  /// Effet réellement porté, source interrogée, requête effective, horodatage, nombre de
  /// résultats, empreinte. C'est lui qui rend démontrables les deux énoncés qu'aucune prose ne
  /// peut prouver : « cette recherche a rendu zéro résultat » et « aucune écriture n'a eu lieu ».
  ///
  /// `resultCount: null` n'est PAS `0` : zéro est une affirmation, null est une absence de
  /// mesure. Les confondre fabriquerait de la preuve d'absence à partir d'un défaut de lecture.
  receiptData         Json?
  error               String?
  /// La CAUSE classée de l'échec (§75) : c'est elle qui choisit la stratégie de récupération.
  errorKind           String?
  /// Ce que l'étape attend quand elle attend : { type, from, entity, until }.
  waitFor             Json?
  /// L'EXPANSION EN ÉVENTAIL : { from, path, as }. Une propriété de l'ÉTAPE, pas de son payload —
  /// `input` est ce que l'humain approuve et ce que la capacité reçoit ; y glisser une directive
  /// de moteur rendrait le payload stocké différent du payload approuvé.
  forEach             Json?
  /// Décidé par le compilateur sur le plan APPROUVÉ, jamais recalculé à l'exécution.
  needsIdempotencyKey Boolean           @default(false)
  /// CE QUE L'ÉTAPE ATTEND — schéma de sortie d'un worker, condition d'achèvement, exigence de
  /// raisonnement, niveau d'accord proposé, format d'artefact. Séparé de `input` À DESSEIN :
  /// `input` est ce que l'humain approuve et ce que la capacité reçoit ; y glisser une directive
  /// de moteur rendrait le payload stocké différent du payload approuvé.
  spec                Json?
  /// L'HISTORIQUE DE RECOURS (§35) : stratégies tentées, greniers visités, journal compact.
  /// C'est lui qui rend la persévérance REPRENABLE après une panne — sans lui, le moteur
  /// redemanderait au Drive ce qu'il vient de lui demander.
  recovery            Json?
  planVersion         Int               @default(1)
  /// LE PLAN COURANT NE PORTE PLUS CETTE ÉTAPE — il a tourné autour.
  ///
  /// Non nul = l'étape appartient à l'HISTOIRE, plus aux obligations. Elle garde son statut, son
  /// erreur et son motif : c'est une pièce du dossier, et le juge doit pouvoir dire « ceci a été
  /// tenté sous le plan 1 et n'a pas abouti ». Mais elle ne décide plus de l'état de la mission.
  /// Sans cette distinction, une étape en échec d'un plan abandonné bloquait tous les suivants —
  /// mesuré sur un run réel où le plan v2 avait pourtant réussi.
  supersededAt        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  deps       MissionStepDep[]   @relation("StepDeps")
  dependents MissionStepDep[]   @relation("StepDependents")
  workerRuns MissionWorkerRun[]
  artifacts  MissionArtifact[]

  @@unique([missionId, key])
  @@unique([idempotencyKey])
  @@index([missionId, status])
  @@index([missionId, workstream])
  @@index([milestoneId])
  @@index([status])
}

/// Une ARÊTE du DAG. `dependsOn` doit être TERMINÉE pour que `step` devienne exécutable.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UNE FORME DE PLAN QUI A RÉUSSI (§64) — la mémoire STRUCTURELLE du planner.
///
/// On ne retient jamais le contenu d'une mission (destinataires, textes, chiffres) : uniquement
/// sa FORME — la suite des types d'étapes et de capacités — et le nombre de fois où cette forme
/// a conduit à un objectif jugé atteint. OBSERVED n'a aucune autorité ; VALIDATED (≥ 3 réussites
/// de missions distinctes) devient une INDICATION donnée au planner. Jamais un raccourci : le
/// compilateur et la politique d'approbation relisent chaque plan comme si la forme n'existait
/// pas — pas d'apprentissage silencieux (§12), une influence, pas une autorité.
model MissionPlanPattern {
  id               String   @id @default(cuid())
  /// L'empreinte de la forme (sha256 tronqué) — l'unicité est tenue par la base.
  signature        String   @unique
  /// SIMPLE | MOYEN | COMPLEXE — dérivé de la complexité (A/B/C) de la mission d'origine.
  profil           String
  /// La forme lisible : ["CAPABILITY(search_people)", "CAPABILITY(send_message)[éventail]", "QA"].
  forme            Json
  succes           Int      @default(1)
  /// OBSERVED (vu, aucune autorité) | VALIDATED (répété, devient une indication).
  statut           String   @default("OBSERVED")
  /// La dernière mission comptée — c'est elle qui rend l'enregistrement idempotent au rejeu.
  dernierMissionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([statut, succes])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UN JALON — l'unité de PLANIFICATION PARESSEUSE (§118.40).
///
/// Une mission de trois semaines n'est pas un DAG de trois cents étapes compilé le premier jour.
/// C'est un OBJECTIF DURABLE découpé en jalons, dont un seul (ou quelques-uns, quand ils sont
/// indépendants) est compilé en étapes à la fois. Les suivants existent comme INTENTION —
/// un titre et un résultat attendu — pas comme instructions.
///
/// Trois propriétés en découlent, et aucune n'est un effet de bord :
///
///   • La taille d'une mission cesse d'être bornée par la fenêtre du modèle. Le planificateur
///     ne voit jamais que le jalon courant plus le contour des autres.
///   • La replanification devient LOCALE : « finalement Amel à la place de Deepak » ne
///     recompile que les jalons qui dépendent de Deepak. Les autres gardent leurs étapes, leurs
///     reçus et leurs effets déjà produits.
///   • Le budget anti-boucle est LOCAL (`replans`, `dernierRefus`). Un plafond GLOBAL de
///     replans tuait une mission de vingt jalons parce qu'un seul d'entre eux s'y reprenait à
///     quatre fois. Ce qui compte n'est pas le NOMBRE d'essais mais le PROGRÈS : tant que le
///     refus CHANGE, le planificateur répare et mérite un tour (§118.18).
///
/// `dependsOn` porte les ORDRES (pas les ids) : un jalon se décrit avant que ses voisins
/// existent en base, et l'ordre est ce que la personne lit à l'écran.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model MissionMilestone {
  id           String    @id @default(cuid())
  missionId    String
  mission      Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// Rang 1-indexé — l'ordre dans lequel la personne le lit.
  ordre        Int
  titre        String
  /// CE QU'ON DOIT POUVOIR CONSTATER quand ce jalon est atteint. C'est ce que le contrôle
  /// d'issue compare au réel — jamais « les étapes ont tourné » (§118.10).
  resultat     String    @db.Text
  /// PENDING | ACTIVE | DONE | SKIPPED | BLOCKED | CANCELLED
  statut       String    @default("PENDING")
  /// 0 = pas encore compilé en sous-plan. C'est la marque de la compilation PARESSEUSE.
  planVersion  Int       @default(0)
  /// Les ORDRES des jalons dont celui-ci dépend. Vide = il peut partir dès que la mission part.
  dependsOn    Int[]     @default([])
  /// Le budget anti-boucle, LOCAL au jalon.
  replans      Int       @default(0)
  /// Le dernier refus rencontré ici. Tant qu'il CHANGE, le planificateur répare et mérite un
  /// tour ; dès qu'il REVIENT identique, il est bloqué (§118.18).
  dernierRefus String?   @db.Text
  /// TOUS les refus déjà rencontrés sur ce jalon. Ne comparer qu'au DERNIER laisse une
  /// oscillation A → B → A → B passer pour du progrès indéfiniment — mesuré en live : « le
  /// refus a changé (INVALID_SHAPE → OBJECTIF_NON_CONSTATE) » écrit DEUX fois pour le même
  /// jalon, cinq sous-plans, neuf versions, 1,10 $ (§118.67).
  refusVus     String[]  @default([])
  compiledAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  notes        Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  steps  MissionStep[]
  inputs MissionInput[]

  @@unique([missionId, ordre])
  @@index([missionId, statut])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UNE ENTRÉE DE MISSION ET SA FRAÎCHEUR (§118.41).
///
/// Une mission longue travaille sur des données qui CHANGENT sous elle. Le forecast lu le jour 1
/// n'est pas celui du jour 18 ; le responsable d'un dossier a pu partir ; un prix a été révisé.
/// Sans mémoire de ce qu'elle a lu, une mission conclut silencieusement sur une vérité périmée —
/// et c'est le faux succès le plus difficile à voir, parce que TOUTES les étapes sont vertes.
///
/// On garde donc, par donnée importante : d'où elle vient, sa version côté source, QUAND elle a
/// été lue, et son EMPREINTE. L'empreinte suffit à répondre « est-ce encore vrai ? » sans
/// stocker une copie de la donnée — ce qui ferait de cette table un second registre (§118.5).
///
/// `stepKey` dit QUELLE branche dépend de cette lecture : c'est ce lien, et lui seul, qui permet
/// d'invalider LOCALEMENT quand la source a bougé, au lieu de tout replanifier.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model MissionInput {
  id           String            @id @default(cuid())
  missionId    String
  mission      Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  milestoneId  String?
  milestone    MissionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  /// L'étape qui a lu cette donnée — pour savoir QUELLE branche devient obsolète.
  stepKey      String?
  /// Le nom métier de la donnée : « forecast:NIVOLEX-2027 », « responsable:REG-2026-9011 ».
  cle          String
  /// D'où elle vient : « ERP:RegulatoryDossier:REG-2026-9011 », « humain:Khaled Mansouri ».
  source       String
  /// La version de la source quand elle en a une (updatedAt, n° de révision, ETag).
  version      String?
  /// L'EMPREINTE de la valeur lue. C'est elle qui dit « ça a changé » sans stocker la donnée.
  empreinte    String
  /// Un digest lisible, borné — pour l'écran et le journal, jamais pour recalculer.
  apercu       String?
  /// TROUVE | DEDUIT | CANDIDAT | INCONNU (§118.9) — seul TROUVE autorise à agir.
  confiance    String            @default("TROUVE")
  retrievedAt  DateTime          @default(now())
  /// La date à laquelle la donnée est VRAIE, quand elle diffère de la date de lecture.
  effectiveAt  DateTime?
  /// Renseigné quand une lecture plus fraîche l'a remplacée : la branche qui en dépend est
  /// alors à réévaluer.
  supersededAt DateTime?
  createdAt    DateTime          @default(now())

  @@index([missionId, cle])
  @@index([missionId, supersededAt])
  @@index([stepKey])
}

model MissionStepDep {
  id          String      @id @default(cuid())
  stepId      String
  step        MissionStep @relation("StepDeps", fields: [stepId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   MissionStep @relation("StepDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([stepId, dependsOnId])
  @@index([dependsOnId])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UN WORKER ÉPHÉMÈRE — pas un agent qui discute (§9).
///
/// Il reçoit un objectif, des entrées et une liste FERMÉE de capacités ; il rend un résultat
/// structuré et se termine. Sa trace vit ici pour l'observabilité et la reprise — jamais pour
/// qu'un autre worker vienne lui parler.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model MissionWorkerRun {
  id        String       @id @default(cuid())
  missionId String
  mission   Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  stepId    String?
  step      MissionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  objective String       @db.Text
  /// Le RÔLE de modèle demandé, jamais un nom de modèle : la politique traduit, et elle peut
  /// changer sans toucher au métier (§11).
  modelRole String       @default("standard")
  modelUsed String?
  allowed   String[]     @default([])
  input     Json         @default("{}")
  output    Json?
  /// RUNNING | DONE | FAILED | TIMEOUT | CANCELLED
  status    String       @default("RUNNING")
  error     String?
  tokensIn  Int          @default(0)
  tokensOut Int          @default(0)
  /// NULL = tarif inconnu (jamais un zéro qui aurait l'air d'un prix).
  costUsd   Float?
  startedAt DateTime     @default(now())
  endedAt   DateTime?

  @@index([missionId, status])
  @@index([stepId])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UN FICHIER PRODUIT PAR UNE MISSION — et la preuve qu'il a été contrôlé (§20-22).
///
/// POURQUOI CE MODÈLE N'EST PAS `AssistantArtifact`. Celui-ci porte la spec d'un livrable de
/// CONVERSATION : un propriétaire, des formats, des fichiers déposés. Il ignore la mission,
/// l'étape et — surtout — le VERDICT du contrôle. Or c'est exactement ce verdict qui fait qu'un
/// artefact peut servir de preuve d'achèvement : un classeur qui ne s'ouvre pas, dont les totaux
/// ne se réconcilient pas ou dont un graphique pointe dans le vide ne prouve rien du tout.
///
/// `status` n'a donc pas de valeur « produit » : un fichier est BUILT (fabriqué) ou VERIFIED
/// (fabriqué ET contrôlé). Seul VERIFIED compte pour conclure.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model MissionArtifact {
  id          String       @id @default(cuid())
  missionId   String
  mission     Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  stepId      String?
  step        MissionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  /// La clé du livrable dans le plan — unique par mission, pour qu'une reprise REMPLACE.
  key         String
  title       String
  /// XLSX | DOCX | PDF | PPTX | CSV | ZIP
  format      String
  fileName    String
  byteSize    Int          @default(0)
  sha256      String?
  /// Le nœud Drive où le fichier a été déposé. `null` tant qu'il n'est pas rangé.
  driveNodeId String?
  /// La spec structurée qui l'a produit — re-générer repart toujours d'elle.
  spec        Json         @default("{}")
  /// Empreinte des DONNÉES AMONT dont ce livrable est issu. Deux livrables d'une même
  /// mission bâtis sur la même empreinte portent le même contenu : le second ne rappelle
  /// pas le modèle, il RE-REND le premier dans son format. C'est ce qui empêche un
  /// classeur et un deck du même jour d'annoncer deux chiffres (#88).
  inputsHash  String?
  /// PENDING | BUILT | VERIFIED | REJECTED
  status      String       @default("PENDING")
  /// Ce que le contrôle a réellement vérifié, point par point.
  qaReport    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([missionId, key])
  @@index([missionId, status])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// L'APPROBATION D'UN PÉRIMÈTRE — une confirmation pour toute une mission (§32).
///
/// `scopeHash` la rend IMMUABLE (§33) : si le périmètre change matériellement — destinataire,
/// montant, action externe ajoutée — le hash ne correspond plus et la partie modifiée redemande
/// son accord. On ne réutilise pas `AssistantActionIntent` : celui-ci autorise UNE action et
/// porte son reçu ; ceci autorise un ENSEMBLE décrit par un hash. Les confondre rendrait l'un
/// des deux faux.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model MissionApproval {
  id          String    @id @default(cuid())
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  scope       String
  summary     String    @db.Text
  scopeHash   String
  /// Les clés d'étapes couvertes : ce que l'approbation débloque, et rien d'autre.
  stepKeys    String[]  @default([])
  /// NORMAL | SENSITIVE | CRITICAL
  level       String    @default("NORMAL")
  /// PENDING | GRANTED | REFUSED | EXPIRED | SUPERSEDED
  status      String    @default("PENDING")
  decidedById String?
  decidedAt   DateTime?
  /// Un ÉCHANTILLON de ce qui sera fait — pour inspecter sans tout dérouler.
  sample      Json?
  createdAt   DateTime  @default(now())

  @@index([missionId, status])
  @@index([status])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UN MODÈLE OPÉRATIONNEL — le vrai fichier de l'entreprise, pas un format inventé (§81).
///
/// `state` empêche la promotion silencieuse (§82) : ce qu'Adam a OBSERVÉ n'est pas ce qu'un
/// humain a APPROUVÉ, et seul l'approuvé fait autorité. Un seul approuvé par type et par
/// propriétaire — c'est la règle qui empêche « trois formats historiques » de redevenir trois
/// vérités concurrentes.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model OperationalTemplate {
  id                  String    @id @default(cuid())
  ownerId             String
  owner               User      @relation("UserOperationalTemplates", fields: [ownerId], references: [id], onDelete: Cascade)
  /// PURCHASE_ORDER | INVOICE | QUOTATION | PAYMENT_REQUEST | REGULATORY_LETTER | CONTRACT | …
  type                String
  name                String
  /// OBSERVED | CANDIDATE | APPROVED | DEPRECATED
  state               String    @default("OBSERVED")
  /// Le fichier de référence dans le Drive — jamais une copie de son contenu ici.
  driveNodeId         String?
  fileName            String?
  fileHash            String?
  /// Ce que l'analyse a compris du fichier : champs, cellules, règles de numérotation.
  structure           Json      @default("{}")
  rules               Json      @default("{}")
  destinationFolderId String?
  approvedById        String?
  approvedAt          DateTime?
  usageCount          Int       @default(0)
  lastUsedAt          DateTime?
  note                String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([ownerId, type, state])
}

/// QUI est attendu dans une mission — interne (compte ERP) ou externe (adresse).
model MissionParticipant {
  id           String    @id @default(cuid())
  missionId    String
  mission      Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId       String?
  email        String?
  name         String?
  /// ASKED | RESPONDED | DECLINED | NUDGED — l'état de CETTE personne.
  state        String    @default("ASKED")
  /// Ce que cette personne a répondu, résumé.
  responseNote String?   @db.Text
  askedAt      DateTime?
  respondedAt  DateTime?
  nudgedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([missionId])
  @@index([userId])
}

/// LE JOURNAL D'UNE MISSION — ce qui s'est passé, dans l'ordre, avec sa provenance.
model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// CREATED | MAIL_PREPARED | MAIL_SENT | REPLY_RECEIVED | NUDGE_PREPARED |
  /// CONSOLIDATED | STATE_CHANGED | NOTE | CLOSED
  kind      String
  summary   String   @db.Text
  /// Détail structuré (identifiants de message, participant, ancien/nouvel état).
  detail    Json?
  actorId   String?
  at        DateTime @default(now())

  @@index([missionId, at])
}

/// ───────────────────────── ANNUAIRE INTERNE — l'identité des personnes ─────────────────────────
///
/// POURQUOI CE MODÈLE EXISTE. Adam savait dire « je n'ai pas son adresse » à propos de quelqu'un
/// qui travaille dans l'entreprise. L'ERP connaît pourtant `User.email` (le compte) et
/// `Employee.email` (la fiche RH) — mais une seule adresse chacun, sans provenance, sans variante,
/// sans alias. Or une personne réelle a une adresse Pharmagene ET une Gmail, un numéro et un
/// WhatsApp, et on l'appelle « Amine » plutôt que « Mohamed Amine Djouamaii ».
///
/// LA RÈGLE : ON NE DUPLIQUE PAS LA VÉRITÉ MÉTIER. Une entrée d'annuaire ne recopie ni le nom, ni
/// le poste, ni le département d'un salarié : elle POINTE vers son `User` / `Employee`, qui restent
/// la source. L'annuaire n'ajoute que ce qu'aucune de ces tables ne porte : les MOYENS DE JOINDRE
/// la personne, avec leur provenance.
model DirectoryEntry {
  id String @id @default(cuid())
  /// Référentiel R1 : la Personne réelle derrière cette fiche (nul tant que non rapprochée — reprise P2).
  personneId String?
  personne Personne? @relation(fields: [personneId], references: [id], onDelete: SetNull)

  /// LE SUJET CANONIQUE — au plus un lien par nature. C'est lui la vérité sur le nom, le poste et
  /// le rattachement ; l'entrée ne fait que s'y accrocher.
  userId     String?         @unique
  user       User?           @relation("UserDirectory", fields: [userId], references: [id], onDelete: Cascade)
  employeeId String?         @unique
  employee   Employee?       @relation("EmployeeDirectory", fields: [employeeId], references: [id], onDelete: Cascade)
  contactId  String?         @unique
  contact    CompanyContact? @relation("ContactDirectory", fields: [contactId], references: [id], onDelete: Cascade)

  /// Nom affiché — recopié pour la RECHERCHE uniquement (le sujet canonique fait foi quand il
  /// existe). Seul cas où il fait autorité : une personne externe sans fiche ERP.
  displayName String
  /// Les façons dont on la nomme réellement : « Amine », « AD », « M. Djouamaii ».
  aliases     String[] @default([])

  /// Ce que l'ERP ne porte pas toujours — renseigné seulement si utile, jamais pour doubler.
  jobTitle        String?
  location        String?
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Identifiant du contact Google correspondant, quand il a été rapproché.
  googleContactId String?
  notes           String?

  isActive Boolean @default(true)

  endpoints DirectoryEndpoint[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([displayName])
  @@index([isActive])
  @@index([companyId])
  @@index([personneId])
}

/// Le CANAL d'un moyen de contact — ce par quoi le message passe.
enum DirectoryChannel {
  EMAIL
  PHONE
  WHATSAPP
}

/// D'OÙ VIENT CETTE ADRESSE, et donc ce qu'elle vaut.
///
/// L'ordre n'est pas décoratif : il décide quelle adresse Adam retient pour écrire. Une adresse
/// saisie et vérifiée par l'assistante de direction bat une adresse aperçue dans un vieux fil.
enum EndpointConfidence {
  /// Saisie et vérifiée en interne (assistante de direction, RH) — la meilleure.
  VERIFIED_INTERNAL
  /// Confirmée par un fournisseur d'identité (compte ERP, Google Contacts).
  VERIFIED_PROVIDER
  /// Observée dans une correspondance réelle — plausible, non vérifiée.
  OBSERVED_HISTORY
  /// Déduite (règle de nommage, homonymie) — à confirmer avant tout usage sortant.
  INFERRED
}

/// UN MOYEN DE JOINDRE quelqu'un. Plusieurs par personne : c'est tout l'objet du modèle.
model DirectoryEndpoint {
  id      String         @id @default(cuid())
  entryId String
  entry   DirectoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  channel DirectoryChannel
  /// Normalisée pour la comparaison (adresse en minuscules, numéro sans espaces).
  value   String
  /// À quoi elle sert, en clair : « Pharmagene », « Gmail », « perso », « mobile ».
  label   String?

  confidence EndpointConfidence @default(INFERRED)
  /// L'adresse à privilégier pour ce canal. Une seule à la fois, tenue par la couche métier.
  isPrimary  Boolean            @default(false)
  isActive   Boolean            @default(true)

  /// D'où elle vient concrètement (« saisie manuelle », « compte ERP », « Google Contacts »…).
  source       String?
  verifiedById String?
  verifiedAt   DateTime?
  /// Dernière fois qu'on l'a VUE servir — utile pour les adresses observées.
  lastSeenAt   DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryId, channel, value])
  @@index([channel, value])
  @@index([entryId, channel, isPrimary])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// LA COUCHE DE CONNAISSANCE — « ingérer une fois, comprendre une fois, retrouver tout de suite ».
//
// Elle appartient à l'ERP, pas à Adam : la recherche du Drive, un écran métier ou l'assistant y
// puisent de la même façon. Quatre tables, et pas une de plus tant qu'une cinquième n'a pas fait
// la preuve qu'elle porte une question qu'aucune des quatre ne sait poser.
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// UNE UNITÉ DE CONNAISSANCE — un document, un mail, un enregistrement ERP, vus comme du savoir.
///
/// La clé d'idempotence est `(sourceType, sourceId)` : réingérer la même chose ne crée jamais un
/// second élément. Le `contentHash` tranche ensuite entre « rien n'a bougé » (on ne retraite pas)
/// et « nouvelle version » (on ouvre un maillon de plus dans la chaîne).
model KnowledgeItem {
  id         String @id @default(cuid())
  sourceType String
  sourceId   String

  /// SHA-256 du CONTENU (pas des métadonnées) : c'est lui qui dit si un retraitement est inutile.
  contentHash String

  title    String?
  docType  String?
  language String?

  /// Cloisonnement — repris de la source, jamais deviné. Null = non rattaché à une entité.
  companyId       String?
  /// public | internal | restricted. Le retrieval filtre dessus AVANT de rendre quoi que ce soit.
  confidentiality String?

  /// Le texte principal, replié pour la recherche (minuscules sans accents) dans `textFold`.
  text     String?
  textFold String?

  /// Métadonnées communes (voir `KnowledgeMeta`) — on ne stocke QUE ce qui est pertinent.
  meta Json?

  // ── Provenance (§23) : « d'où vient cette information ? » a toujours une réponse ────────
  extractedBy String?
  model       String?
  confidence  Float?

  // ── Temporalité (§16) : la situation d'aujourd'hui n'est pas celle de mars ──────────────
  documentDate  DateTime?
  effectiveDate DateTime?
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  isCurrent     Boolean   @default(true)

  // ── Versions (§5) : V1 → V2 → V3, l'histoire reste lisible ──────────────────────────────
  version      Int            @default(1)
  supersedesId String?        @unique
  supersedes   KnowledgeItem? @relation("KnowledgeVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy KnowledgeItem? @relation("KnowledgeVersion")

  /// RECEIVED | PARSED | CLASSIFIED | INDEXED | READY | ENRICHED | FAILED
  stage String  @default("RECEIVED")
  error String?

  chunks KnowledgeChunk[]
  jobs   KnowledgeJob[]
  links  KnowledgeLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([contentHash])
  @@index([stage])
  @@index([companyId, isCurrent])
  @@index([docType])
  @@index([documentDate])
  @@index([updatedAt])
}

/// UN MORCEAU STRUCTUREL — une section, une page, une diapositive, un tableau, un message.
///
/// Le découpage suit la STRUCTURE (§13), jamais « tous les 500 jetons » : un tableau coupé en
/// deux ne veut plus rien dire, et une citation sans page n'est pas opposable.
model KnowledgeChunk {
  id     String        @id @default(cuid())
  itemId String
  item   KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// section | page | slide | table | sheet | message | whole
  kind    String
  ord     Int
  label   String?
  /// Page, diapositive, index de message — ce qui permet de CITER précisément.
  locator String?

  text     String
  textFold String

  /// Vecteur 512d en JSONB. pgvector n'est PAS disponible sur cette infrastructure (vérifié) :
  /// le cosinus se fait en mémoire, comme pour le corpus CTD et l'index Drive. Le jour où
  /// l'extension existe, seule cette colonne et la requête de rapprochement changent.
  embedding Json?

  meta Json?

  createdAt DateTime @default(now())

  @@unique([itemId, ord])
  @@index([itemId, kind])
}

/// LA FILE DE TRAVAUX DE FOND — ce qui est lourd quitte le chemin de l'utilisateur.
///
/// Réclamation ATOMIQUE (QUEUED → RUNNING par `updateMany` conditionnel), réessai à attente
/// croissante, et boîte morte au bout : un travail qui échoue pour une mauvaise raison cesse d'y
/// revenir et se SIGNALE, au lieu de tourner indéfiniment.
model KnowledgeJob {
  id     String         @id @default(cuid())
  itemId String?
  item   KnowledgeItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// parse | vision | classify | entities | embed | enrich
  kind     String
  /// Plus petit = plus urgent. Ce qui rend RETROUVABLE passe avant ce qui rend mieux compris.
  priority Int    @default(50)

  payload Json?

  /// QUEUED | RUNNING | DONE | FAILED | DEAD
  status      String    @default("QUEUED")
  attempts    Int       @default(0)
  maxAttempts Int       @default(4)
  /// Pas avant cette date — c'est l'attente croissante entre deux essais.
  runAfter    DateTime  @default(now())
  claimedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?

  /// Empêche deux jobs identiques de coexister (§20 : rejouable sans doublon).
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter, priority])
  @@index([itemId, kind])
}

/// LE GRAPHE — des relations claires en PostgreSQL, pas une base graphe.
///
/// Le vocabulaire des prédicats est FERMÉ (voir `RelationPredicate`) : un graphe dont les arêtes
/// s'inventent au fil de l'eau devient impossible à interroger sans deviner. L'unicité empêche
/// qu'un job rejoué double une arête.
model KnowledgeLink {
  id     String        @id @default(cuid())
  itemId String
  item   KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  predicate String
  toType    String
  toId      String

  confidence Float   @default(1)
  /// Le fragment de texte qui a produit l'arête — pour pouvoir la contester.
  mention    String?

  createdAt DateTime @default(now())

  @@unique([itemId, predicate, toType, toId])
  @@index([toType, toId])
  @@index([predicate])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LE RÉFÉRENTIEL D'ENTITÉS — « de quoi parle-t-on, exactement ? »
///
/// UNE entité = une chose du monde réel dont l'entreprise parle : une personne, une société, un
/// fournisseur, un produit, une molécule. Elle porte un nom CANONIQUE et autant d'ALIAS que la
/// réalité en produit — raison sociale, nom commercial, DCI, référence, acronyme, faute de frappe.
///
/// D'OÙ VIENNENT LES ALIAS. De l'ERP lui-même, jamais d'un dictionnaire écrit à la main. Que
/// « Keytruda » soit du pembrolizumab, ce n'est pas une connaissance que ce code doit posséder :
/// c'est écrit dans `RegulatoryProduct` (`brandName` d'un côté, `dci` de l'autre), et la
/// projection se contente de le LIRE. Un dictionnaire codé en dur serait faux le lendemain, et
/// muet sur les produits d'Adventum — exactement ceux qui comptent.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model KnowledgeEntity {
  id String @id @default(cuid())

  /// La FAMILLE : person | company | supplier | product | molecule | organization.
  kind String

  /// LA CLÉ D'IDENTITÉ, déterministe — c'est elle qui rend la projection idempotente.
  /// Avec une fiche ERP : « kind:refType:refId ». Sans : « kind:name:<nom replié> ».
  /// Une contrainte d'unicité sur (kind, refType, refId) n'aurait PAS marché : Postgres tient
  /// deux NULL pour distincts, donc toute entité sans fiche se serait dupliquée à chaque passage.
  key String @unique

  /// La fiche ERP d'origine, quand il y en a une. Permet de rebondir de l'entité vers l'objet.
  refType String?
  refId   String?

  canonicalName String
  nameFold      String

  /// Cloisonnement : l'entité juridique à laquelle la chose appartient, quand c'est vrai.
  companyId String?

  isActive Boolean @default(true)

  aliases KnowledgeAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, nameFold])
  @@index([refType, refId])
  @@index([companyId])
}

/// UNE GRAPHIE d'une entité. La provenance (`source`) n'est pas décorative : sans elle, on ne
/// peut pas retirer un mauvais alias sans risquer d'en retirer un bon, et un alias DÉRIVÉ
/// (des initiales calculées) devient indiscernable d'une raison sociale lue en base.
model KnowledgeAlias {
  id       String          @id @default(cuid())
  entityId String
  entity   KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  alias     String
  aliasFold String

  /// « erp:<colonne> » = lu dans une vraie colonne ; « derived » = calculé ; « user » = saisi.
  source String
  /// Combien cette graphie identifie l'entité. Un acronyme dérivé pèse moins qu'un nom déposé.
  weight Float  @default(1)

  createdAt DateTime @default(now())

  @@unique([entityId, aliasFold])
  @@index([aliasFold])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LE PLANIFICATEUR PERSISTANT (§9) — « tous les dimanches, fais-moi le point Regulatory ».
///
/// ── CE QUE C'EST, ET CE QUE CE N'EST PAS ─────────────────────────────────────────────────
///
/// Un travail RÉCURRENT qui produit quelque chose : un rapport, une synthèse, un balayage. Ce
/// n'est PAS un rappel (`AssistantReminder`), qui notifie une personne à une échéance et n'exécute
/// rien. Les deux coexistent parce qu'ils répondent à deux besoins différents : « préviens-moi »
/// et « fais-le ».
///
/// ── LA GARDE QUI NE SE NÉGOCIE PAS ───────────────────────────────────────────────────────
///
/// Une planification NE PEUT PAS contourner une approbation. Elle exécute des traitements de
/// LECTURE et produit des livrables ; tout ce qui muterait l'ERP ou enverrait un e-mail passe par
/// le chemin canonique, avec sa confirmation humaine. C'est écrit dans le registre des
/// traitements (`scheduler/registry.ts`), et un test le gèle : une planification est un
/// déclencheur, jamais une dérogation.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model ScheduledWorkflow {
  id String @id @default(cuid())

  /// Ce que l'utilisateur lit dans la liste — « Point Regulatory du dimanche ».
  name    String
  /// LE TRAITEMENT à déclencher. Une clé du registre, jamais du code libre : une planification
  /// qui porterait son propre code serait une porte d'exécution arbitraire dans la base.
  kind    String
  /// Les paramètres du traitement (destinataire du rapport, périmètre…).
  payload Json?

  /// HOURLY | DAILY | WEEKLY | MONTHLY — et rien d'autre : une grammaire cron complète dans un
  /// champ texte est illisible par l'utilisateur qui la relit trois mois plus tard.
  recurrence String
  /// L'heure locale d'exécution (0-23), heure d'Alger. Ignorée pour HOURLY.
  hourLocal  Int    @default(7)
  /// Jour de la semaine (0 = dimanche) pour WEEKLY ; jour du mois pour MONTHLY.
  dayOfWeek  Int?
  dayOfMonth Int?

  /// ACTIVE | PAUSED. Une planification en pause garde son historique et sa prochaine échéance :
  /// la reprendre ne doit pas effacer ce qu'elle a déjà fait.
  status String @default("ACTIVE")

  /// La prochaine échéance, en UTC. C'est ELLE qu'on interroge — pas une expression à réévaluer
  /// à chaque passage, ce qui coûterait un calcul par planification et par minute.
  nextRunAt DateTime
  lastRunAt DateTime?
  /// Verrou d'exécution : un passage la prend, les autres passent leur chemin.
  claimedAt DateTime?

  /// Qui l'a créée, et pour qui elle tourne. Le propriétaire détermine le PÉRIMÈTRE de lecture :
  /// une planification ne voit jamais plus que la personne au nom de qui elle s'exécute.
  ownerId     String
  owner       User    @relation("ScheduledWorkflowOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdById String?

  runs WorkflowRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextRunAt])
  @@index([ownerId])
}

/// L'HISTORIQUE. Sans lui, « ça n'a pas tourné » et « ça a tourné et n'a rien trouvé » sont
/// indiscernables — et c'est exactement la question qu'on se pose quand un rapport n'arrive pas.
model WorkflowRun {
  id         String            @id @default(cuid())
  workflowId String
  workflow   ScheduledWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// OK | FAILED | SKIPPED
  status     String    @default("OK")
  /// Ce que le traitement a produit, en une ligne lisible.
  summary    String?
  error      String?
  /// Durée en millisecondes — pour voir une dérive avant qu'elle ne devienne une panne.
  ms         Int?

  @@index([workflowId, startedAt])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LE REGISTRE D'ÉVÉNEMENTS MÉTIER — la mémoire factuelle de l'entreprise.
///
/// ── POURQUOI IL EXISTE ─────────────────────────────────────────────────────────────────────
///
/// L'ERP savait déjà journaliser : `AuditLog` (qui a modifié quoi), `WorkflowStepEvent`,
/// `RegulatoryLifecycleEvent`, `PaymentRequestEvent`, `MissionEvent`… Chacun est juste, et
/// chacun ne connaît que son domaine. Aucun ne permet de répondre à « le contrat demandé
/// a-t-il été déposé ? » quand la demande vit dans Tâches et le dépôt dans Ad&Pro.
///
/// Ce registre est la couche TRANSVERSE : append-only, un fait par ligne, lisible sans
/// connaître le module qui l'a produit. Il ne remplace aucun journal existant — il les
/// TRAVERSE. C'est ce qui rend déterministes la réconciliation des tâches, la frise
/// chronologique d'un produit, et la compréhension causale, au lieu de les laisser à un modèle.
///
/// ── CE QU'IL N'EST PAS ─────────────────────────────────────────────────────────────────────
///
/// Pas un bus de messages, pas Kafka, pas une file. Une TABLE. Les consommateurs la lisent ;
/// le peu de réaction synchrone dont on a besoin passe par un appel de fonction ordinaire.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model BusinessEvent {
  id            String      @id @default(cuid())
  /// Le fait, en vocabulaire métier : CONTRACT_SIGNED, TENDER_AWARDED, PAYMENT_RECEIVED…
  /// Volontairement une chaîne et non un enum : un domaine peut nommer un fait sans migration,
  /// et les consommateurs n'écoutent que ce qu'ils connaissent.
  type          String
  /// QUAND le fait s'est produit — distinct de `createdAt`, qui dit quand on l'a inscrit.
  /// Un import rétroactif renseigne le premier sans mentir sur le second.
  occurredAt    DateTime    @default(now())
  actorId       String?
  actor         User?       @relation("BusinessEventActor", fields: [actorId], references: [id])
  /// Le domaine émetteur (ADPRO_CONSULTING, LEGAL, REGULATORY…) — le « d'où ça vient ».
  sourceDomain  String
  entityType    EntityType?
  entityId      String?
  /// Les autres entités concernées, en « TYPE:id ». Un dépôt de contrat touche le consultant,
  /// le document et la demande Ad&Pro : les trois doivent pouvoir retrouver ce fait.
  relatedRefs   String[]    @default([])
  /// Ce qui a changé, ou ce qu'il faut pour comprendre. JAMAIS le contenu d'un document ni
  /// un secret : ce registre se lit largement, il ne doit rien porter qui ne se lise pas.
  payload       Json?
  /// Ce qui relie les faits d'une même intention — une mission Adam, un circuit de validation.
  correlationId String?
  missionId     String?
  createdAt     DateTime    @default(now())

  @@index([type, occurredAt])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([occurredAt])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LE PRODUIT CANONIQUE — l'identité, et rien d'autre.
///
/// ── POURQUOI CE MODÈLE EXISTE ALORS QUE `RegulatoryProduct` EST DÉJÀ RICHE ────────────────
///
/// Une contrainte métier tranche : **un produit doit pouvoir exister AVANT son enregistrement**.
/// Un `BdProduct` en `sourcing: TO_STUDY` n'a légitimement aucun dossier — c'est d'ailleurs
/// pourquoi son `regulatoryProductId` est nullable depuis l'origine. Faire du dossier l'identité,
/// c'était refuser une identité à tout produit à l'étude, et donc rendre impossible de suivre un
/// produit depuis sa veille jusqu'à sa vente.
///
/// ── CE QU'IL PORTE, ET CE QU'IL NE PORTE PAS ─────────────────────────────────────────────
///
/// Le TUPLE D'IDENTITÉ seul (DCI, dosage, forme, conditionnement, canal, entité). Pas une copie
/// des quarante champs du dossier : deux sources pour la même donnée, c'est une divergence
/// programmée. Le dossier garde les siens — il porte ce qui a été DÉPOSÉ à l'ANPP, coquille
/// comprise, et cela ne se corrige plus une fois soumis. `Product` porte ce que l'entreprise
/// reconnaît comme LE produit. Les aligner de force obligerait un jour à falsifier l'un des deux.
///
/// ── LES PROFILS ──────────────────────────────────────────────────────────────────────────
///
/// `RegulatoryProduct`, `PromoProduct`, `BdProduct` deviennent des PROFILS : chacun garde sa vie,
/// ses champs et ses écrans, et gagne un `productId` NULLABLE. Aucun n'est détruit, aucun écran
/// ne change. Le lien se pose par backfill déterministe, et reste vide quand le rapprochement
/// n'est pas sûr.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model Product {
  id            String @id @default(cuid())
  /// Référence lisible — PRD-AAAA-NNN. C'est ce qu'on dicte, ce qu'on cite, ce qui résout en
  /// premier dans la résolution d'entité.
  code          String @unique
  /// Le nom sous lequel l'entreprise le connaît (« Nivolumab 100 mg »).
  canonicalName String

  // ── Le tuple d'identité ────────────────────────────────────────────────────────────────
  dci        String
  dosage     String?
  dosageUnit String?
  /// Forme galénique, normalisée par `market/galenic.ts` — le même vocabulaire que l'analyse
  /// de marché, pour qu'un produit et sa ligne IQVIA se rapprochent sans traduction.
  form       String?
  /// À dosage et forme identiques, c'est LUI qui distingue deux produits : une boîte de 28 et
  /// une boîte de 56 sont deux enregistrements distincts.
  packaging  String?

  /// LA CLÉ CANONIQUE calculée depuis le tuple (voir `src/lib/products/identity.ts`). Unique :
  /// c'est la base qui garantit qu'on ne crée pas deux fois le même produit, pas la vigilance
  /// de l'appelant.
  identityKey String @unique

  channel   ProductChannel @default(BOTH) // Ville / Hôpital / les deux
  companyId String?
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// Où en est le produit dans sa VIE — distinct du statut réglementaire du dossier.
  /// STUDY : à l'étude · REGISTERED : enregistré · MARKETED : commercialisé · DISCONTINUED.
  lifecycle String @default("STUDY")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases              ProductAlias[]
  regulatoryProfiles   RegulatoryProduct[]            @relation("ProductRegulatoryProfile")
  promoProfiles        PromoProduct[]                 @relation("ProductPromoProfile")
  bdProfiles           BdProduct[]                    @relation("ProductBdProfile")
  tenderLines          PchTenderLine[]                @relation("TenderLineProduct")
  contractLines        PchContractLine[]              @relation("ContractLineProduct")
  sales                Sale[]                         @relation("SaleProduct")
  visitLinks           MedicalVisitProduct[]
  /// LES MESSAGES PRÉ-DÉFINIS qui portent sur ce produit.
  promoMessages        PromoMessage[]                 @relation("PromoMessageProduct")
  adProAllocations     AdProProductAllocation[]
  assignments          ProductAssignment[]
  /// Le matériel promotionnel en stock pour ce produit (§118.164).
  promoStockItems      PromoStockItemProduct[]        @relation("PromoStockProduit")
  promoRequestItems    PromoRequestItemProduct[]      @relation("PromoDemandeProduit")
  /// LES STRATÉGIES DE SEGMENTATION où il est l'un des (au plus) trois produits classés.
  segmentationProduits SegmentationStrategieProduit[]
  /// SA CONSOMMATION HOSPITALIÈRE (Consumption Intelligence) et la façon d'en tirer son affinité.
  consommations        ConsommationLigne[]
  affiniteConfig       AffiniteConfig?
  /// SA PART des coûts partagés de ses BU (règle d'allocation, année par année).
  repartitionsCouts    CoutRepartitionBu[]
  /// SES PRIX SAISIS À LA MAIN (Produits 360) — ils l'emportent sur ceux de l'Explorateur produits.
  prixSaisis           ProductPrice[]
  /// VENTES PCH — ses postes PCH, ses lignes de vente des DR, ses réceptions PCH, ses fournisseurs « à nous ».
  postesPch            PchPoste[]                     @relation("PchPosteProduit")
  /// SES DÉCLARATIONS D'INFORMATION MÉDICALE (Réglementaire & qualité, Produits 360).
  declarationsInfoMed  MedicalInfoDeclaration[]       @relation("MedicalInfoDeclarationProduit")
  ventesPch            PchVenteLigne[]                @relation("PchVenteProduit")
  receptionsPch        PchReceptionLigne[]            @relation("PchReceptionProduit")
  fournisseursPch      PchFournisseurProduit[]        @relation("PchFournisseurProduit")

  @@index([dci])
  @@index([companyId])
  @@index([lifecycle])
}

/// UN PRIX D'UN PRODUIT, SAISI À LA MAIN (Direction, 07/10 : « les prix existent dans l'Explorateur de produits, mais
/// ils doivent être modifiables manuellement quand on veut »).
///
/// L'Explorateur donne le prix OBSERVÉ (IQVIA ville : valeur ÷ boîtes ; réceptions PCH : prix unitaire) ; une saisie
/// l'emporte à partir de sa date d'effet. Rien ne s'écrase : chaque saisie est une LIGNE (historique), et une ligne
/// sans montant rend la main à l'Explorateur. Le calcul du prix qui fait foi est `products/fiche-360.ts`.
model ProductPrice {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// PPA · SHP · TARIF_REFERENCE · PRIX_HOPITAL (`TYPES_PRIX`).
  kind      String
  /// En DZD. NUL = retour à la valeur de l'Explorateur à partir de `validFrom`.
  amountDzd Decimal? @db.Decimal(14, 2)
  validFrom DateTime
  note      String?
  /// Qui l'a saisi — l'identifiant seul : le nom se relit à l'affichage.
  setById   String?
  createdAt DateTime @default(now())

  @@index([productId, kind, validFrom])
}

/// LES AUTRES NOMS D'UN PRODUIT — « Nivo », « Opdivo », le nom du marché PCH, celui d'IQVIA.
///
/// Un alias est une DÉCISION HUMAINE, pas une mesure : c'est pour cela qu'il porte qui l'a posé.
/// La résolution le place au deuxième rang, juste après la référence explicite et AVANT tout
/// rapprochement calculé — quelqu'un a tranché, on ne recalcule pas par-dessus.
model ProductAlias {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Le libellé tel qu'il s'écrit — affiché tel quel.
  label       String
  /// Sa forme normalisée, qui sert d'index. Unique : deux produits ne peuvent pas revendiquer
  /// le même alias, et la base le refuse plutôt que de laisser une ambiguïté s'installer.
  key         String   @unique
  /// D'où il vient : MANUAL, PCH_TENDER, IQVIA, IMPORT…
  source      String   @default("MANUAL")
  createdById String?
  createdBy   User?    @relation("ProductAliasAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([productId])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// QUI PORTE QUEL PRODUIT — la relation principale de la force de vente.
///
/// Un délégué porte PLUSIEURS produits ; un produit est porté par PLUSIEURS personnes. La
/// relation est donc une table, avec ce qui la qualifie : depuis quand, sur quel territoire, et
/// pour quelle PART de son temps.
///
/// `allocationPct` est ce qui rend calculable le coût RH analytique par produit — sans lui, la
/// masse salariale reste un total qu'on ne sait pas ventiler, et « ce produit coûte-t-il plus
/// qu'il ne rapporte ? » n'a pas de réponse chiffrée.
///
/// La PÉRIODE (`startedAt` / `endedAt`) est indispensable : un portefeuille change, et un calcul
/// de coût sur l'année dernière doit utiliser l'affectation de l'année dernière, pas celle
/// d'aujourd'hui. Sans elle, l'historique se réécrit à chaque réaffectation.
model ProductAssignment {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("ProductAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  /// DELEGATE · PRODUCT_MANAGER · NATIONAL_SALES · SUPERVISOR. Une chaîne et non un enum :
  /// ajouter un rôle métier ne doit pas demander une migration de schéma.
  role      String  @default("DELEGATE")
  /// Wilaya, secteur, ou zone — le vocabulaire de la force de vente, pas une géographie imposée.
  territory String?

  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  /// Part du temps de cette personne consacrée à ce produit (0–100). Facultatif : beaucoup
  /// d'affectations n'ont pas de quotité, et en inventer une fausserait le coût analytique.
  allocationPct Decimal?  @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId, role, startedAt])
  @@index([userId])
  @@index([productId])
}

/// LES PRODUITS PRÉSENTÉS PENDANT UNE VISITE — plusieurs par visite, et c'est le cas normal.
///
/// `MedicalVisit.presentedProducts` (texte libre) est CONSERVÉ : il porte l'historique, et les
/// écrans le lisent. Cette table le double en relations pour ce qui doit se compter.
model MedicalVisitProduct {
  id        String       @id @default(cuid())
  visitId   String
  visit     MedicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([visitId, productId])
  @@index([productId])
}

/// LA PART D'UNE DÉPENSE AD&PRO IMPUTABLE À UN PRODUIT.
///
/// Un poste Ad&Pro sert souvent PLUSIEURS produits (un congrès, un stand). L'imputer entièrement
/// au premier produit cité fausserait tout calcul de contribution ; ne l'imputer à aucun le
/// rendrait impossible. D'où une répartition EXPLICITE, décidée par un humain.
///
/// `tenderLineId` rattache la dépense à une ligne d'AO quand elle en relève — c'est ce qui permet
/// de rapprocher un investissement promotionnel du marché qu'il visait.
model AdProProductAllocation {
  id        String    @id @default(cuid())
  itemId    String
  item      AdProItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// La part, en pourcentage (0–100). La somme des parts d'un poste DEVRAIT valoir 100 — mais
  /// la base ne l'impose pas : une saisie en cours doit pouvoir être incomplète sans être refusée.
  /// Le contrôle se fait à la lecture, où il peut se DIRE plutôt que bloquer.
  sharePct        Decimal? @db.Decimal(5, 2)
  /// Le montant imputé, quand il est saisi directement plutôt qu'en pourcentage.
  amountAllocated Decimal? @db.Decimal(14, 2)

  tenderLineId String?
  tenderLine   PchTenderLine? @relation(fields: [tenderLineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([itemId, productId])
  @@index([productId])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LIVE OFFICE — un document OUVERT dans le workspace d'Adam (§3).
///
/// Une session survit aux tours de conversation : « affiche-moi le contrat », puis « centre le
/// titre », puis « annule », puis « sauvegarde » visent tous LE MÊME document ouvert. Sans cette
/// ligne en base, chaque phrase repartirait de zéro et « annule » n'aurait rien à annuler.
///
/// ── CE QUE CETTE TABLE NE STOCKE PAS : LE DOCUMENT ─────────────────────────────────────
///
/// L'état courant est `baseVersion` du Drive PLUS les opérations non annulées du journal.
/// Rejouer coûte quelques millisecondes sur des adaptateurs déterministes, et cela évite
/// d'écrire un instantané par frappe — sur un PPTX de 8 Mo, vingt retouches feraient 160 Mo.
/// C'est aussi la reprise après panne (§80) : rien à reconstruire, tout est déjà écrit.
enum ArtifactSessionState {
  OPENING
  OPEN
  EDITING
  DIRTY
  SAVING
  SAVED
  FAILED
  CLOSED
}

model ArtifactSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ArtifactSessions", fields: [userId], references: [id], onDelete: Cascade)

  /// Le fil Adam où le workspace s'affiche — null quand la session vient du Drive.
  threadId String?
  /// §64 : le MÊME bloc de conversation est mis à jour, jamais un troisième s'empile.
  blockId  String

  /// Le fichier ouvert, dans le Drive.
  nodeId      String
  node        DriveNode @relation("ArtifactSessions", fields: [nodeId], references: [id], onDelete: Cascade)
  /// La version Drive sur laquelle les opérations sont rejouées.
  baseVersion Int
  name        String
  format      String

  state        ArtifactSessionState @default(OPENING)
  /// Incrémenté à chaque commande appliquée — c'est la « version » que voit le workspace (§64).
  revision     Int                  @default(0)
  dirty        Boolean              @default(false)
  /// Dernière version Drive écrite depuis cette session (null tant qu'on n'a pas sauvegardé).
  savedVersion Int?
  lastError    String?

  /// Working set (§4) : où la personne regarde. `activeSelection` porte les identifiants cliqués.
  activePage      Int?
  activeSlide     Int?
  activeSheet     String?
  activeSelection Json?

  openedAt  DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  operations ArtifactOperation[]

  @@index([userId, state, updatedAt])
  @@index([nodeId])
  @@index([threadId])
}

/// LE JOURNAL DES OPÉRATIONS (§18) — ce qui rend l'annulation réelle et la reprise gratuite.
///
/// `operationId` est fourni par l'appelant et rend l'application IDEMPOTENTE : un double clic,
/// un retry réseau ou un rejeu de file ne centre pas le titre deux fois.
model ArtifactOperation {
  id        String          @id @default(cuid())
  sessionId String
  session   ArtifactSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Clé d'idempotence. Deux appels de même clé sur la même session = une seule application.
  operationId   String
  seq           Int
  beforeVersion Int
  afterVersion  Int
  /// La commande IR appliquée — jamais de l'XML, jamais du texte libre.
  command       Json
  /// Ce que la personne lit : « ¶1 Contrat… → centré. »
  summary       String

  actorId    String
  actorLabel String
  /// Une opération annulée reste EN BASE : c'est ce qui permet de la rétablir (§18).
  undone     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([sessionId, operationId])
  @@index([sessionId, seq])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LA PROVENANCE D'UN TOUR — les faits qu'Adam a SERVIS, avec leur source (F8, mandat 4 §22).
///
/// Une ligne par tour de conversation : les faits lus (fiche, page, message, calcul) avec leur
/// famille, leur date propre, l'instant de lecture, la confiance, la fraîcheur et l'outil (donc
/// les droits) qui les a lus. C'est la matière de « D'où tu tiens ça ? » — relue par le code,
/// jamais paraphrasée par un modèle. `userId` cloisonne : la provenance d'une personne n'est
/// jamais servie à une autre. Un tour SANS lecture s'inscrit aussi (`nombre` = 0) : « je n'ai
/// rien lu » est une réponse, et la ligne vide empêche de citer un tour plus ancien à sa place.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model AssistantProvenance {
  id        String   @id @default(cuid())
  userId    String
  threadId  String?
  turnId    String?
  /// Les premiers caractères de la question — pour dire « au tour où vous demandiez… ».
  question  String?
  faits     Json
  nombre    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([threadId, createdAt])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// LA QUALITÉ DES DONNÉES — un CONSTAT par anomalie, à signature stable (mandat 4 §23).
///
/// Le moteur (`lib/quality/engine.ts`) balaie la base par règles ; chaque défaut trouvé devient
/// une ligne OPEN, ou compte une occurrence de plus s'il existait déjà. Une correction SÛRE
/// (AUTO) est appliquée et journalisée (`fixLog`, audit) ; une correction concrète (PROPOSE)
/// attend un clic ; une décision (HUMAIN) attend une personne. Un défaut disparu passe RESOLVED
/// de lui-même ; un défaut écarté par une personne reste DISMISSED avec son motif — il ne
/// revient pas la nuit suivante.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model DataQualityFinding {
  id           String    @id @default(cuid())
  regle        String
  famille      String
  criticite    String
  confiance    Float
  resolution   String
  entite       String
  entiteId     String
  /// Le module RBAC qui gouverne la visibilité du constat.
  module       String
  titre        String
  detail       String
  signature    String    @unique
  href         String?
  correction   Json?
  montant      Decimal?  @db.Decimal(14, 2)
  /// OPEN | FIXED | DISMISSED | RESOLVED
  status       String    @default("OPEN")
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  occurrences  Int       @default(1)
  reopenCount  Int       @default(0)
  resolvedAt   DateTime?
  /// « auto » (correction AUTO), « disparu » (défaut plus observé), ou l'identifiant de la personne.
  resolvedById String?
  resolvedBy   String?
  motif        String?
  fixLog       Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, criticite])
  @@index([regle, status])
  @@index([module, status])
  @@index([entite, entiteId])
}

/// Le journal des BALAYAGES : quand, quel mode (FULL la nuit, LIGHT toutes les heures pour le
/// risque financier immédiat), combien par règle, en combien de temps — l'observabilité du moteur.
model DataQualitySweep {
  id         String    @id @default(cuid())
  mode       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ms         Int?
  regles     Json?
  constats   Int       @default(0)
  nouveaux   Int       @default(0)
  corriges   Int       @default(0)
  resolus    Int       @default(0)
  erreurs    Int       @default(0)

  @@index([mode, startedAt])
}

/// LE JOURNAL DES DEMANDES D'ACHAT AUX MOYENS GÉNÉRAUX — pour le Super Admin, et lui seul.
///
/// La demande elle-même vit dans `AdministrativeRequest` : c'est elle qui circule, se valide,
/// se retire, et parfois SE SUPPRIME (`deletedAt`). Un journal qui la lirait en direct
/// disparaîtrait donc avec elle — et un journal qui s'efface n'est pas un journal.
///
/// Ici, chaque geste (dépôt, validation, refus, retrait) écrit UNE LIGNE de plus, avec la
/// COPIE COMPLÈTE de ce que la demande disait à cet instant (`snapshot` : intitulé, lignes,
/// quantités, prix estimés, motif, validateur, département imputé). Rien n'est mis à jour, rien
/// n'est supprimé : on ajoute. C'est ce qui permet de répondre, six mois plus tard, à « qui a
/// demandé quoi, quand, à combien, et qui a dit oui » — même si la demande a été retirée.
///
/// Ce n'est pas un second registre des demandes : personne ne travaille depuis ce journal, il
/// ne pilote rien. C'est la trace.
model PurchaseRequestLogEntry {
  id             String   @id @default(cuid())
  /// La demande d'origine. Identifiant BRUT, sans relation : la ligne doit survivre à la
  /// suppression de la demande — une clé étrangère la ferait disparaître avec elle.
  requestId      String
  reference      String
  /// SUBMITTED | APPROVED | REJECTED | WITHDRAWN | UPDATED
  event          String
  title          String
  /// Qui a demandé, et qui a posé ce geste-ci (ce n'est pas toujours la même personne).
  requesterId    String?
  requesterName  String
  actorId        String?
  actorName      String
  /// Le département auquel l'achat est imputé, au moment du geste (nom figé : un département
  /// renommé ou supprimé ne doit pas rendre la ligne illisible).
  departmentId   String?
  departmentName String?
  /// Total estimé au moment du geste, en DZD. Nul = la demande n'en portait pas.
  estimatedTotal Decimal? @db.Decimal(14, 2)
  /// Le mot du validateur, quand il y en a un.
  note           String?
  /// LA COPIE COMPLÈTE — tout ce que la demande portait à cet instant.
  snapshot       Json
  createdAt      DateTime @default(now())

  @@index([requestId])
  @@index([createdAt])
  @@index([requesterId])
}

// ═══════════════════════ SITE WEB ADVENTUM — contenus poussés par l'ERP (§118.158) ═══════════════════════
//
// L'ERP est la SOURCE DE VÉRITÉ des offres d'emploi et des articles du site public, et il les
// POUSSE : `PUT /api/v1/jobs/{externalId}`, `PUT /api/v1/posts/{externalId}` (contrat du site,
// `docs/ERP-INTEGRATION.md`). L'`externalId` est l'identifiant de l'objet ici — rejouer une
// requête ne crée jamais de doublon, et l'ERP n'a rien à stocker en retour, sinon l'adresse
// publique qu'il affiche.

/// UNE OFFRE D'EMPLOI destinée au site public (`/carrieres/<slug>`). Elle ne porte QUE ce que le
/// site affiche : la rémunération et la justification d'un recrutement restent sur la demande
/// interne, et le corps envoyé est construit champ par champ (`lib/site-web/contrat.ts`).
model JobPosting {
  id                   String              @id @default(cuid())
  /// Le recrutement dont l'offre découle, s'il y en a un. L'offre n'est publique que tant que ce
  /// poste est OUVERT : pourvu, clos, refusé ou annulé, elle part en brouillon.
  recruitmentRequestId String?             @unique
  recruitmentRequest   RecruitmentRequest? @relation(fields: [recruitmentRequestId], references: [id], onDelete: SetNull)
  title                String
  department           String?
  location             String?
  /// « CDI », « CDD », « Stage »… écrit comme le site le lit (CDD → TEMPORARY, Stage → INTERN).
  contractLabel        String?
  experience           String?
  summary              String?
  mission              String[]            @default([])
  profile              String[]            @default([])
  offer                String[]            @default([])
  /// Le choix de la personne. Publié ne veut pas dire « en ligne » : seul le site le confirme.
  published            Boolean             @default(false)
  createdById          String?
  createdBy            User?               @relation("JobPostingAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?               @relation("JobPostingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  /// Les candidatures déposées sur le site pour cette offre (§118.159).
  candidatures SiteCandidature[]
  /// L'offre reprise du site dont celle-ci est la version ERP (§118.160) — exemple livré avec le
  /// site, ou offre saisie dans son administration.
  reprise      SiteReprise?

  @@index([published])
}

/// UN ARTICLE DE BLOG destiné au site public (`/blog/<slug>`). Corps en Markdown structuré en `##`
/// (le site en tire le sommaire) — jamais de titre de niveau 1, que le titre fournit.
model BlogArticle {
  id               String       @id @default(cuid())
  title            String
  /// L'adresse voulue. Vide = le site la dérive du titre (le cas normal). Unique quand elle est donnée.
  slug             String?      @unique
  description      String?
  body             String
  category         String?
  tags             String[]     @default([])
  author           String?
  /// La date de publication affichée (datePublished). Posée à la première mise en ligne si
  /// l'auteur n'en fixe pas — et elle ne bouge plus à chaque correction.
  publishedOn      DateTime?
  /// La première demande de mise en ligne.
  firstPublishedAt DateTime?
  /// La dernière révision d'un article déjà publié (dateModified).
  revisedAt        DateTime?
  featured         Boolean      @default(false)
  published        Boolean      @default(false)
  createdById      String?
  createdBy        User?        @relation("BlogArticleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?        @relation("BlogArticleEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  /// L'article du DÉPÔT du site dont celui-ci est la version ERP (§118.160) : poussé avec
  /// `replacesFile`, il remplace le fichier sur le site public.
  reprise          SiteReprise?

  @@index([published])
}

/// CE QUE L'ERP A REPRIS DU SITE (§118.160) — les articles écrits dans le dépôt du site, ses offres
/// d'exemple, les offres saisies dans son administration. L'ERP en crée SES enregistrements, que l'on
/// modifie et supprime depuis le module « Site web » comme les autres.
///
/// La ligne SURVIT au contenu (`SetNull`) : un article repris puis supprimé dans l'ERP doit rester
/// caché sur le site — sans elle, le fichier du dépôt reviendrait au redémarrage suivant du site — et
/// un exemple supprimé ne doit pas être repris une seconde fois au rapprochement suivant.
model SiteReprise {
  id        String       @id @default(cuid())
  /// "ARTICLE_DEPOT" | "OFFRE_EXEMPLE" | "OFFRE_ADMIN"
  origine   String
  /// Ce qui l'identifie côté site : le slug du fichier, le slug de l'exemple, l'id de l'offre saisie.
  cleSite   String
  /// Son titre sur le site au moment de la reprise — pour la nommer même une fois supprimée.
  titre     String
  articleId String?      @unique
  article   BlogArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  jobId     String?      @unique
  job       JobPosting?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// Qui a lancé le rapprochement qui l'a reprise — nul quand c'est le battement.
  parId     String?
  createdAt DateTime     @default(now())

  @@unique([origine, cleSite])
}

enum SiteContentKind {
  JOB
  POST
}

enum SiteSyncState {
  PENDING
  DONE
  FAILED
}

/// L'ÉTAT DE CHAQUE CONTENU POUSSÉ VERS LE SITE — et, tel quel, la FILE D'ENVOI.
///
/// Une ligne par (nature, externalId), jamais une par envoi : seule la DERNIÈRE version d'un
/// contenu compte, puisque chaque PUT porte le document entier. Trois corrections rapides ne font
/// pas trois requêtes en file mais une ligne dont la `version` a monté — et la version protège de
/// la course : un envoi réussi ne marque « fait » que la version qu'il portait.
///
/// La ligne SURVIT à la suppression du contenu (opération DELETE) : c'est ce qui permet à la
/// réconciliation de SAVOIR qu'un contenu encore présent sur le site a été retiré de l'ERP, au
/// lieu de le deviner d'après une absence.
model SitePublication {
  id                 String            @id @default(cuid())
  kind               SiteContentKind
  externalId         String
  /// Le titre au moment de la mise en file — pour lire le journal sans la source, qui peut avoir été supprimée.
  label              String
  /// "PUT" | "DELETE"
  operation          String
  /// La chaîne JSON EXACTE à envoyer, sérialisée UNE fois : c'est elle qui est signée et envoyée.
  body               String?
  bodyHash           String?
  version            Int               @default(1)
  state              SiteSyncState     @default(PENDING)
  /// Les tentatives pour la version COURANTE (remis à zéro à chaque nouvelle version).
  attempts           Int               @default(0)
  nextAttemptAt      DateTime          @default(now())
  /// Le verrou de l'envoi en cours — une ligne prise n'est pas reprise par un autre passage.
  claimedAt          DateTime?
  lastStatus         Int?
  lastError          String?
  lastAttemptAt      DateTime?
  /// Ce que le site a CONFIRMÉ détenir (200/201) — l'empreinte et l'état de publication.
  confirmedHash      String?
  confirmedPublished Boolean?
  confirmedAt        DateTime?
  /// L'adresse publique rendue par le site (`/carrieres/…`, `/blog/…`).
  siteUrl            String?
  siteSlug           String?
  /// Qui a demandé l'envoi — prévenu si le site refuse le contenu.
  requestedById      String?
  /// Une seule alerte par incident, pas une par passage du battement.
  alertedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  attemptLog         SitePushAttempt[]

  @@unique([kind, externalId])
  @@index([state, nextAttemptAt])
}

/// LE JOURNAL DES REQUÊTES vers le site : externalId, code HTTP, corps de réponse (§7 du contrat).
/// Jamais la clé ni les en-têtes. Élagué aux dernières tentatives de chaque contenu.
model SitePushAttempt {
  id            String          @id @default(cuid())
  publicationId String
  publication   SitePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  kind          SiteContentKind
  externalId    String
  method        String
  path          String
  version       Int
  /// Nul = aucune réponse HTTP (réseau, délai dépassé, sortie refusée dans ce processus).
  status        Int?
  /// SUCCES | DEJA_ABSENT | REESSAYER | CORRIGER | BLOQUANT | LOCAL
  outcome       String
  responseBody  String?
  error         String?
  durationMs    Int             @default(0)
  createdAt     DateTime        @default(now())

  @@index([publicationId, createdAt])
  @@index([createdAt])
}

/// UNE RÉCONCILIATION avec le site (`GET /jobs`, `GET /posts`) — quotidienne, ou demandée.
model SiteReconciliation {
  id           String    @id @default(cuid())
  /// "AUTO" | "MANUEL"
  trigger      String
  byId         String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  ok           Boolean   @default(false)
  error        String?
  siteJobs     Int?
  sitePosts    Int?
  conformes    Int       @default(0)
  repousses    Int       @default(0)
  suppressions Int       @default(0)
  /// Écarts qu'on ne repousse PAS : le site a déjà refusé ce contenu tel quel (4xx).
  rejetes      Int       @default(0)
  /// [{ nature, externalId, titre, url }] — présents sur le site, inconnus de l'ERP. Jamais supprimés d'office.
  orphelins    Json?
  /// [{ externalId, libelle, slug, titreDuDepot }] — masqués par un article du dépôt du site.
  collisions   Json?
  /// [{ nature, externalId, libelle, raison }] — ce qui a été repoussé, et pourquoi.
  ecarts       Json?
  /// { jobs, posts } — saisis dans l'admin du site, sans externalId.
  manuels      Json?
  /// Les slugs des articles du DÉPÔT du site au moment du rapprochement — l'éditeur s'en sert pour
  /// prévenir d'une collision AVANT l'envoi.
  depotSlugs   String[]  @default([])
  /// La reprise des contenus du site (§118.160) : son dépôt a-t-il été LU à ce passage ? Faux tant
  /// que le site ne sait pas le rendre (ancienne version) — le battement repasse alors toutes les heures.
  repriseLue   Boolean   @default(false)
  /// Combien de contenus ont été repris à ce passage.
  repris       Int       @default(0)
  /// { repris: [{ origine, titre, id }], aCorriger: [{ origine, titre, raison }], conflits: [...], impossible?: string }
  reprise      Json?

  @@index([startedAt])
}

/// LES CLÉS DE LA LIAISON AVEC LE SITE, GÉNÉRÉES PAR L'ERP (§118.159).
///
/// Personne n'a plus à fabriquer une clé ni à la recopier des deux côtés : le Super Admin clique
/// « Générer », colle UN bloc dans l'environnement du site, et c'est tout. La clé naît EN ATTENTE ;
/// l'ERP la présente au site (`GET /health`) jusqu'à ce qu'il la reconnaisse, puis elle devient
/// ACTIVE et l'ancienne est retirée dans la même transaction — la rotation se fait sans coupure,
/// parce que l'ancienne clé sert tant que le site n'a pas la nouvelle.
///
/// SCELLÉES au repos (`secret-box`, AES-256-GCM), comme les jetons Google et Microsoft. Une clé EN
/// ATTENTE se remontre au Super Admin (elle ne publie encore rien) ; une clé ACTIVE ne se montre
/// plus jamais — on en génère une autre. Au plus une ACTIVE et une EN ATTENTE : un index partiel
/// l'impose (migration), pas une discipline de code.
model SiteWebCle {
  id                    String    @id @default(cuid())
  /// "ATTENTE" | "ACTIVE" | "RETIREE"
  etat                  String    @default("ATTENTE")
  /// `ERP_API_KEY` côté site — scellée.
  cle                   String
  /// `ERP_WEBHOOK_SECRET` côté site — scellé.
  secret                String
  /// Condensat tronqué de la clé : ce que l'écran et l'audit montrent — jamais un morceau de la clé.
  empreinte             String
  creeParId             String?
  creeLe                DateTime  @default(now())
  /// La prochaine présentation au site d'une clé en attente (rythme dégressif).
  prochaineVerification DateTime  @default(now())
  derniereVerification  DateTime?
  /// Ce que le site a répondu à la dernière présentation, en une phrase.
  dernierConstat        String?
  activeeLe             DateTime?
  retireeLe             DateTime?

  @@index([etat])
}

/// UNE CANDIDATURE DÉPOSÉE SUR LE SITE PUBLIC (§118.159).
///
/// La boîte d'ARRIVÉE, pas le pipeline : le pipeline vit dans `RecruitmentCandidate`. Une
/// candidature à une offre rattachée à un recrutement OUVERT y entre d'elle-même ; les autres —
/// spontanée, offre sans recrutement, poste déjà pourvu, offre inconnue de l'ERP — attendent ici
/// qu'une personne des RH la rattache à un poste ou la classe. Rien n'est perdu, rien n'est deviné.
model SiteCandidature {
  id           String                @id @default(cuid())
  /// L'identifiant que le SITE a donné au dépôt — la clé d'idempotence : un renvoi ne crée rien.
  siteId       String                @unique
  jobPostingId String?
  jobPosting   JobPosting?           @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  /// L'offre telle que le site l'a nommée au dépôt — lisible même si l'offre a disparu depuis.
  offreTitre   String?
  offreRef     String?
  nom          String
  email        String
  telephone    String?
  message      String?
  /// Le CV, dans le stockage chiffré (clé de fichier), avec de quoi le servir et le reconnaître.
  cvCle        String?
  cvNom        String?
  cvType       String?
  cvTaille     Int?
  cvEmpreinte  String?
  /// "NOUVELLE" | "RATTACHEE" | "CLASSEE"
  etat         String                @default("NOUVELLE")
  /// Pourquoi elle n'est pas entrée seule dans un recrutement — ou pourquoi elle a été classée.
  motif        String?
  candidateId  String?               @unique
  candidate    RecruitmentCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  consentement Boolean               @default(false)
  langue       String?
  soumiseLe    DateTime
  recueLe      DateTime              @default(now())
  traiteeParId String?
  traiteeLe    DateTime?

  @@index([etat, recueLe])
  @@index([jobPostingId])
}

/// UNE LIGNE DU POSTE « MATÉRIEL DU STOCK » D'UNE DEMANDE AD & PRO (§118.167).
///
/// DEMANDÉE (le demandeur liste l'article et la quantité ; rien ne bouge au magasin) → RÉSERVÉE (à
/// l'accord du poste, la quantité quitte le magasin : personne ne peut plus la doter ailleurs) →
/// CONFIRMÉE (après l'événement : remis, rendus, abîmés, perdus ; le reste revient au magasin par
/// la même écriture). Les quantités confirmées sont des FAITS déclarés une fois, jamais recalculés.
model AdProStockLine {
  id             String               @id @default(cuid())
  itemId         String
  item           AdProItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// L'article du magasin. RESTRICT : un article qui a servi à un événement ne s'efface pas.
  stockItemId    String
  stockItem      PromoStockItem       @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantite       Decimal              @db.Decimal(12, 3)
  statut         AdProStockLineStatut @default(DEMANDEE)
  reserveeLe     DateTime?
  reserveeParId  String?
  /// Consommable : remis pendant l'événement.
  utilisee       Decimal?             @db.Decimal(12, 3)
  /// Revenu au magasin (le reste d'un consommable, le durable rendu en état).
  rendue         Decimal?             @db.Decimal(12, 3)
  /// Durable : revenu abîmé (retiré du stock) ou perdu.
  abimee         Decimal?             @db.Decimal(12, 3)
  perdue         Decimal?             @db.Decimal(12, 3)
  confirmeeLe    DateTime?
  confirmeeParId String?
  note           String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  mouvements     PromoStockMovement[]

  @@unique([itemId, stockItemId])
  @@index([stockItemId])
  @@index([statut])
}

enum AdProStockLineStatut {
  DEMANDEE
  RESERVEE
  CONFIRMEE
}

/// UNE LECTURE DE PIÈCE COMMERCIALE (devis, BC, facture) — une PROPOSITION, jamais un prix de la société (lot D2,
/// §118.152 i). Une ligne par empreinte SHA-256 des octets et version du lecteur : la même pièce n'est lue — et payée —
/// qu'une fois, sous n'importe quel nom. On RÉSERVE avant de lire (`EN_COURS`), le gagnant lit, les autres attendent.
/// Le texte lu est SCELLÉ (`sealSecret`) : une pièce peut porter des coordonnées bancaires.
model LecturePiece {
  id               String                     @id @default(cuid())
  empreinte        String
  versionLecteur   Int
  /// EN_COURS | LUE | ECHOUEE — vocabulaire fermé côté code.
  etat             String                     @default("EN_COURS")
  extension        String
  taille           Int
  methode          String?
  moteur           String?
  confiance        Int?
  aRelire          Boolean                    @default(false)
  ocrTente         Boolean                    @default(false)
  ocrEchoue        Boolean                    @default(false)
  pagesLues        Int?
  pagesTotal       Int?
  caracteres       Int                        @default(0)
  tronque          Boolean                    @default(false)
  texteScelle      String?
  /// En-têtes et totaux repérés de façon DÉTERMINISTE (`pieces-lues/entetes.ts`), chacun avec son extrait.
  entetes          Json?
  /// Les lignes lues par le modèle, RELUES par `pieces-lues/structure.ts` — `null` tant qu'aucun modèle n'a lu.
  structure        Json?
  structureePar    String?
  /// Ce que le modèle a lu d'un DOCUMENT LÉGAL (nature, titre, dates, résumé), RELU par `pieces-lues/synthese-legale.ts`
  /// — `null` tant qu'aucun modèle ne l'a lu comme pièce Legal. Une fois par empreinte : la première fait foi.
  syntheseLegale   Json?
  synthesePar      String?
  /// Pourquoi il n'y a pas de lignes : DESACTIVEE, IA_COUPEE, NON_CONFIGUREE, CONFIDENTIELLE, OCR_ECHOUE, TEXTE_ILLISIBLE.
  raisonSansLignes String?
  creeParId        String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  confirmations    LecturePieceConfirmation[]

  @@unique([empreinte, versionLecteur])
  @@index([etat, updatedAt])
}

/// QUI A CONFIRMÉ QUOI — l'attestation qu'une personne a relu, ligne à ligne, ce qu'une lecture proposait, écrite DANS
/// la transaction de l'écriture métier (le devis, la facture, la pièce Legal). `cibleType` : PROMO_QUOTE,
/// PROMO_FACTURE, LEGAL_DOCUMENT (vocabulaire fermé côté code). `RESTRICT` : une lecture qu'une confirmation désigne
/// ne se purge pas.
model LecturePieceConfirmation {
  id             String       @id @default(cuid())
  lectureId      String
  lecture        LecturePiece @relation(fields: [lectureId], references: [id], onDelete: Restrict)
  cibleType      String
  cibleId        String
  confirmeeParId String
  confirmeeLe    DateTime     @default(now())
  /// Verdict par ligne : CONFIRMEE, CORRIGEE, AJOUTEE, ECARTEE (prix comparés au centime).
  lignes         Json
  controle       Json?

  @@index([cibleType, cibleId])
  @@index([lectureId])
}

/// Envoi DIRECT navigateur → bucket (S3/R2) d'un gros fichier, en plusieurs parties. Le serveur ne
/// voit jamais les octets : il ouvre, signe, puis finalise. La ligne survit à une coupure — c'est
/// elle qui permet de REPRENDRE (empreinte `fingerprint` = nom, taille, date du fichier) sans
/// renvoyer les parties que le bucket a déjà.
model DirectUpload {
  id          String   @id @default(cuid())
  userId      String
  purpose     String // "DRIVE"
  objectKey   String
  uploadId    String?
  fileName    String
  mimeType    String?
  totalBytes  BigInt
  partSize    Int
  fingerprint String
  target      Json // destination (dossier, catégorie, version d'un fichier…)
  status      String   @default("UPLOADING") // UPLOADING | COMPLETED | ABORTED
  resultId    String? // nœud Drive créé
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
}

/// ═════════════════════════════════════════════════════════════════════════════════════════════
/// SEGMENTATION STUDIO — la segmentation de la force de vente, NATIVE et reliée (Direction, 06/10).
///
/// Le classeur « Segmentation Finale » devient des objets : une STRATÉGIE par Business Unit, ses
/// (au plus) trois produits CANONIQUES classés, des RÈGLES versionnées, la place de chaque praticien
/// de l'annuaire (statut stratégique), son potentiel terrain HISTORISÉ et les dérogations posées à la
/// main. Le segment A/B/C/D n'est JAMAIS stocké comme une vérité : il se CALCULE (moteur déterministe,
/// `src/lib/segmentation/moteur.ts`) depuis ces faits et la version de règle — il s'explique donc
/// toujours, et changer un seuil ne réécrit pas le passé (une version publiée ne se modifie pas).
/// ═════════════════════════════════════════════════════════════════════════════════════════════
model SegmentationStrategie {
  id             String       @id @default(cuid())
  businessUnitId String
  /// RESTRICT : une BU qui porte une stratégie (et son historique) ne disparaît pas en silence.
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  nom            String
  /// ACTIVE · ARCHIVEE — une chaîne, comme les autres statuts métier récents.
  statut         String       @default("ACTIVE")
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  produits     SegmentationStrategieProduit[]
  regles       SegmentationRegle[]
  fiches       SegmentationFiche[]
  derogations  SegmentationDerogation[]
  imports      SegmentationImport[]
  observations HcpObservation[]
  cycles       SegmentationCycle[]

  @@index([businessUnitId])
}

/// UN PRODUIT CLASSÉ DANS LA STRATÉGIE — rang 1, 2 ou 3, sur une PÉRIODE. Le catalogue de la BU
/// peut compter dix produits ; la stratégie terrain en classe trois au plus. Changer le classement
/// ferme la ligne (`jusqua`) et en ouvre une autre : l'historique ne s'écrase pas.
model SegmentationStrategieProduit {
  id          String                @id @default(cuid())
  strategieId String
  strategie   SegmentationStrategie @relation(fields: [strategieId], references: [id], onDelete: Cascade)
  productId   String
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  rang        Int
  depuis      DateTime              @default(now())
  /// Nul = classement en vigueur.
  jusqua      DateTime?
  createdById String?
  createdAt   DateTime              @default(now())

  @@index([strategieId, jusqua])
  @@index([productId])
}

/// UNE VERSION DE RÈGLES — seuils par produit (potentiel, affinité, exceptions régionales), ciblage,
/// statut H, priorités et fréquences de visite. IMMUABLE une fois publiée : changer un seuil publie la
/// version suivante, après un aperçu de l'impact. Le contenu est validé par `lireRegles`.
model SegmentationRegle {
  id           String                @id @default(cuid())
  strategieId  String
  strategie    SegmentationStrategie @relation(fields: [strategieId], references: [id], onDelete: Cascade)
  version      Int
  contenu      Json
  note         String?
  publieeParId String?
  publieeLe    DateTime              @default(now())

  @@unique([strategieId, version])
}

/// LA PLACE D'UN PRATICIEN DANS UNE STRATÉGIE — le praticien est CELUI DE L'ANNUAIRE (jamais une
/// copie) ; ceci porte ce qui ne vaut que pour la stratégie : son statut stratégique (Décideur,
/// Influenceur, Référent, Prescripteur) et sa zone terrain (Centre, Est, Ouest…).
model SegmentationFiche {
  id          String                @id @default(cuid())
  strategieId String
  strategie   SegmentationStrategie @relation(fields: [strategieId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      MedicalDoctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  /// DECIDEUR · INFLUENCEUR · REFERENT · PRESCRIPTEUR — nul = non renseigné.
  statut      String?
  /// Zone libre héritée (« Centre », « Ouest ») — lue seulement par les règles d'avant les secteurs.
  zone        String?
  /// LE SECTEUR DE LA BU, posé à la main (Direction, 07/10). Nul = déduit de l'établissement / du service
  /// du praticien (le secteur qui le couvre, `clausePanelDuKam`). Secteur supprimé = retour au calcul.
  secteurId   String?
  secteur     SalesSector?          @relation(fields: [secteurId], references: [id], onDelete: SetNull)
  /// D'où vient la fiche : IMPORT (avec le lot et la ligne) ou MANUEL.
  source      String                @default("MANUEL")
  importId    String?
  ligneSource Int?
  /// Retiré du panel de la stratégie — la fiche reste pour l'historique.
  retireeLe   DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([strategieId, doctorId])
  @@index([doctorId])
  @@index([secteurId])
}

/// LE POTENTIEL TERRAIN D'UN PRATICIEN, HISTORISÉ — « 27 patients VIH / semaine », « 3 sur 10 sous
/// Raltégravir ». Une observation par relevé (import, visite, saisie) ; la plus récente fait foi, les
/// autres restent. Une valeur ABSENTE reste absente : elle ne devient jamais un D.
model HcpObservation {
  id                 String                 @id @default(cuid())
  doctorId           String
  doctor             MedicalDoctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  strategieId        String?
  strategie          SegmentationStrategie? @relation(fields: [strategieId], references: [id], onDelete: SetNull)
  /// Le produit visé par la question d'affinité (nul = potentiel de la pathologie, tous produits).
  productId          String?
  /// LE POTENTIEL (la métrique de la règle — ex. patients / semaine).
  potentiel          Decimal?               @db.Decimal(12, 2)
  /// L'AFFINITÉ DÉCLARÉE : sur 10 patients, combien sous le produit.
  prescriptionsSur10 Decimal?               @db.Decimal(6, 2)
  metrique           String?
  /// IMPORT · TERRAIN · MANUEL
  source             String                 @default("MANUEL")
  importId           String?
  ligneSource        Int?
  auteurId           String?
  observeLe          DateTime               @default(now())
  commentaire        String?
  createdAt          DateTime               @default(now())

  @@index([doctorId, observeLe])
  @@index([strategieId])
}

/// UNE DÉROGATION — le calcul propose, une personne tranche, et cela se voit : valeur calculée au
/// moment de la décision, valeur posée, auteur, motif, échéance. CIBLAGE (CIBLE / NON_CIBLE) ou
/// SEGMENT (A/B/C/D d'un produit). Levée = `leveeLe` ; jamais supprimée.
model SegmentationDerogation {
  id             String                @id @default(cuid())
  strategieId    String
  strategie      SegmentationStrategie @relation(fields: [strategieId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         MedicalDoctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  productId      String?
  nature         String
  valeur         String
  valeurCalculee String?
  motif          String
  source         String                @default("MANUEL")
  importId       String?
  auteurId       String?
  creeLe         DateTime              @default(now())
  expireLe       DateTime?
  leveeLe        DateTime?
  leveeParId     String?

  @@index([strategieId, doctorId])
  @@index([doctorId])
}

/// UN FICHIER DE SEGMENTATION IMPORTÉ — son empreinte (le même fichier ne s'importe pas deux fois
/// dans la même stratégie), son nom, et le rapport complet de ce qui a été rapproché, créé, mis à jour
/// ou laissé à trancher. Chaque fiche et chaque observation renvoient à leur lot et à leur ligne.
model SegmentationImport {
  id          String                @id @default(cuid())
  strategieId String
  strategie   SegmentationStrategie @relation(fields: [strategieId], references: [id], onDelete: Cascade)
  nomFichier  String
  empreinte   String
  taille      Int
  feuille     String?
  rapport     Json
  auteurId    String?
  createdAt   DateTime              @default(now())

  @@unique([strategieId, empreinte])
}

/// PRODUIT × BU → SPÉCIALITÉS VISÉES (cahier des charges §6). Une BU multi-spécialités ne veut pas dire que
/// tous ses produits visent toutes ses spécialités : le produit A vise la neurologie, le C la neurologie et
/// l'urologie. Porté par `PromoProduct` — la relation produit × BU qui existe déjà — et jamais déduit.
model PromoProductSpecialite {
  id             String           @id @default(cuid())
  promoProductId String
  promoProduct   PromoProduct     @relation(fields: [promoProductId], references: [id], onDelete: Cascade)
  specialtyId    String
  specialty      MedicalSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  createdById    String?
  createdAt      DateTime         @default(now())

  @@unique([promoProductId, specialtyId])
  @@index([specialtyId])
}

/// ═════════════════════════════════════════════════════════════════════════════════════════════
/// CONSUMPTION INTELLIGENCE — des fichiers de consommation hospitalière HÉTÉROGÈNES rendus fiables.
///
/// Un fichier importé (`ConsommationImport`) devient des lignes au FORMAT CANONIQUE (`ConsommationLigne`),
/// chacune rattachée à sa feuille et à sa ligne d'origine, avec la valeur source ET la valeur normalisée,
/// l'établissement et le produit RÉSOLUS (ou laissés « à revoir », jamais inventés), une confiance et un
/// statut. Seules les lignes d'un import VALIDÉ comptent. Les correspondances confirmées par une personne
/// s'apprennent (`ConsommationMemoire`). L'affinité se calcule à la demande (`AffiniteConfig`).
/// ═════════════════════════════════════════════════════════════════════════════════════════════
model ConsommationImport {
  id          String              @id @default(cuid())
  nomFichier  String
  /// Le même fichier ne s'importe pas deux fois.
  empreinte   String              @unique
  taille      Int
  /// EN_REVUE · VALIDE · ANNULE
  statut      String              @default("EN_REVUE")
  /// LE FICHIER ORIGINAL, gardé tel quel : chaque nombre reste traçable jusqu'à sa cellule (§27).
  fichier     Bytes?
  /// Feuilles lues : colonnes reconnues, confiance, format, période de feuille.
  analyse     Json
  rapport     Json?
  auteurId    String?
  valideLe    DateTime?
  valideParId String?
  createdAt   DateTime            @default(now())
  lignes      ConsommationLigne[]

  @@index([statut])
}

model ConsommationLigne {
  id                String              @id @default(cuid())
  importId          String
  import            ConsommationImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  feuille           String?
  ligneSource       Int
  periodeDebut      DateTime?
  periodeFin        DateTime?
  institutionId     String?
  institution       MedicalInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  etablissementBrut String?
  productId         String?
  product           Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  produitBrut       String?
  molecule          String?
  dosage            String?
  presentation      String?
  quantiteSource    Decimal?            @db.Decimal(16, 3)
  uniteSource       String?
  quantite          Decimal?            @db.Decimal(16, 3)
  unite             String?
  valeur            Decimal?            @db.Decimal(16, 2)
  devise            String?
  /// 0..100 — la confiance du rapprochement (établissement ET produit).
  confiance         Int                 @default(0)
  /// OK · A_REVOIR · DOUBLON · IGNOREE
  statut            String              @default("A_REVOIR")
  anomalies         Json?

  @@index([importId, statut])
  @@index([productId, periodeDebut])
  @@index([institutionId])
}

/// CE QU'UNE PERSONNE A CONFIRMÉ — « ETAB » est un établissement, « RAL 400MG » est ce produit. Réutilisé au
/// fichier suivant, toujours affiché comme tel, et jamais à la place d'une revue quand la valeur change.
model ConsommationMemoire {
  id            String   @id @default(cuid())
  /// COLONNE · ETABLISSEMENT · PRODUIT
  nature        String
  cle           String
  valeur        String
  confirmeParId String?
  utilisations  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([nature, cle])
}

/// COMMENT L'AFFINITÉ D'UN PRODUIT SE CALCULE : sa consommation ÷ celle d'un marché pertinent (un panier de
/// produits et/ou de molécules), sur une période (mois, glissante 3/6/12 mois, personnalisée). Rien par défaut.
model AffiniteConfig {
  id          String    @id @default(cuid())
  productId   String    @unique
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// { productIds: string[], molecules: string[] } — le dénominateur ; le produit étudié y est toujours inclus.
  panier      Json
  /// MOIS · ROLLING_3M · ROLLING_6M · ROLLING_12M · PERSONNALISEE
  periode     String
  debut       DateTime?
  fin         DateTime?
  updatedById String?
  updatedAt   DateTime  @updatedAt
}

/// UN CYCLE DE VISITES D'UNE STRATÉGIE (cahier des charges §49-55) — sa durée se règle (mois, 4 ou 6 semaines,
/// trimestre, personnalisée). À l'OUVERTURE, il FIGE tout ce qui le gouverne : produits classés, version de règles,
/// spécialités visées, affinités, résultat de chaque praticien (segments, priorité, visites requises) et le KAM qui
/// le couvre. Les changements ultérieurs ne le touchent pas ; à la CLÔTURE, les visites réalisées sont figées aussi.
///
/// Pourquoi pas `PromoCycle` : celui-ci est un MOIS CALENDAIRE unique (année, mois) qui porte les prévisions et les
/// affectations de toute la force de vente ; un cycle de segmentation appartient à UNE stratégie, a une durée
/// réglable, et porte un instantané. Il pointe le `PromoCycle` du mois de son début quand il existe.
model SegmentationCycle {
  id           String                @id @default(cuid())
  strategieId  String
  strategie    SegmentationStrategie @relation(fields: [strategieId], references: [id], onDelete: Cascade)
  libelle      String
  /// MOIS · QUATRE_SEMAINES · SIX_SEMAINES · TRIMESTRE · PERSONNALISE
  duree        String
  debut        DateTime
  fin          DateTime
  /// OUVERT · CLOS
  statut       String                @default("OUVERT")
  regleVersion Int
  /// Produits, règles, contexte, résultats par praticien, couverture KAM — figés à l'ouverture.
  instantane   Json
  /// Capacité par KAM (jours terrain, visites/jour, absences) — figée à l'ouverture, ajustable tant qu'il est ouvert.
  capacite     Json
  /// Visites réalisées par praticien, figées à la clôture.
  realise      Json?
  promoCycleId String?
  ouvertParId  String?
  createdAt    DateTime              @default(now())
  closLe       DateTime?
  closParId    String?

  @@index([strategieId, debut])
}

/// LA RÈGLE D'ALLOCATION DES COÛTS PARTAGÉS D'UNE BU (cahier des charges §15, §85) : pour une année, la part de chaque
/// produit dans les dépenses de la BU qui ne sont imputées à AUCUN produit (un stand, un congrès de spécialité). La
/// vue produit distingue toujours : coûts DIRECTS (imputés au seul produit), ALLOUÉS (part d'une dépense partagée),
/// et le NON ALLOUÉ de la BU — jamais mélangés. La somme des parts d'une BU et d'une année ne dépasse pas 100 %.
model CoutRepartitionBu {
  id             String       @id @default(cuid())
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  annee          Int
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  pct            Decimal      @db.Decimal(5, 2)
  updatedById    String?
  updatedAt      DateTime     @updatedAt

  @@unique([businessUnitId, annee, productId])
  @@index([productId])
}

/// QUI SUIT UN RECRUTEMENT — désigné(s) par le DG à la validation (Direction, 07/10) : ils voient la demande, sont prévenus de
/// chaque étape et participent au suivi avec les RH.
model RecruitmentFollower {
  id        String             @id @default(cuid())
  requestId String
  request   RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation("RecruitmentFollowerUser", fields: [userId], references: [id], onDelete: Cascade)
  addedById String?
  createdAt DateTime           @default(now())

  @@unique([requestId, userId])
  @@index([userId])
}

/// UNE DIFFUSION DE L'OFFRE SUR UN CANAL (Direction, 07/10) — site web, LinkedIn (post préparé selon l'entité), Emploitic
/// (quand l'API sera configurée), autre. Les RH choisissent le ou les canaux ; chaque canal garde son état.
model RecruitmentChannelPost {
  id            String             @id @default(cuid())
  requestId     String
  request       RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// SITE_WEB | LINKEDIN | EMPLOITIC | AUTRE
  channel       String
  /// PREPARE | PUBLIE | RETIRE | ECHEC
  status        String             @default("PREPARE")
  /// Le texte préparé (le post LinkedIn, l'annonce) — modifiable avant publication.
  content       String?
  url           String?
  error         String?
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?              @relation("RecruitmentChannelPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([requestId, channel])
}

/// L'AUDIENCE DU SITE PUBLIC (Direction, 07/10) — un événement par page vue ou par clic, envoyé par le site (adventumdz.com).
/// Sans cookie : `visitor` est une empreinte du JOUR (sel + IP + navigateur), qui compte les visiteurs uniques sans les suivre
/// d'un jour à l'autre ni les identifier.
model SiteAnalyticsEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// PAGEVIEW | CLICK | LEAVE
  type       String
  path       String
  title      String?
  /// L'hôte d'où vient le visiteur (google.com, linkedin.com…), sans le chemin.
  referrer   String?
  /// La source lue (utm_source, sinon déduite du référent) : Google, LinkedIn, Facebook, Direct, Emploitic…
  source     String?
  medium     String?
  campaign   String?
  visitor    String
  session    String?
  device     String?
  browser    String?
  os         String?
  country    String?
  /// Pour un CLIC : ce qu'on a cliqué (postuler, telephone, email, whatsapp, lien externe, cta…) et sa cible.
  label      String?
  target     String?
  /// Pour LEAVE : le temps passé sur la page.
  durationMs Int?

  @@index([at])
  @@index([type, at])
  @@index([path, at])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// VENTES PCH (Operations & Sales) — les fichiers de la PCH, notre SEUL client hospitalier.
///
/// Deux natures, chaque mois (parfois un fichier annuel) : les VENTES de chaque direction régionale (DR) aux
/// hôpitaux — tout le marché, molécule par molécule, demande non servie comprise — et les RÉCEPTIONS de la PCH
/// centrale (nos livraisons = notre sell-in ; tous les fournisseurs = les parts de marché). Un fichier plus récent
/// pour la même source (DR, ou réceptions) et le même mois REMPLACE ce mois ; le même fichier ne fait rien ; le
/// fichier original est gardé. Lecture pure `lib/ventes-pch/lecture.ts`, écriture `lib/ventes-pch/service.ts`,
/// requêtes `lib/ventes-pch/requetes.ts`.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model PchVenteImport {
  id             String              @id @default(cuid())
  /// VENTES_DR · RECEPTIONS
  nature         String
  nomFichier     String
  /// SHA-256 du fichier — le même fichier importé deux fois ne fait rien.
  empreinte      String              @unique
  taille         Int
  /// LE FICHIER ORIGINAL, gardé tel quel.
  fichier        Bytes
  /// Les sources qu'il porte : codes DR (« DRO ») pour des ventes, « RECEPTIONS » pour des réceptions.
  sources        String[]            @default([])
  /// Les mois couverts (« 2026-05 »).
  mois           String[]            @default([])
  annuel         Boolean             @default(false)
  /// LA PÉRIODE RETENUE (Direction, 10/2026) : l'année, et le mois (1..12 — nul quand le fichier est annuel). `periodeChoisie` :
  /// vrai quand la personne a posé le mois / l'année à l'import au lieu de ceux lus sur les dates du fichier.
  periodeAnnee   Int?
  periodeMois    Int?
  periodeChoisie Boolean             @default(false)
  lignes         Int                 @default(0)
  /// Les comptes de l'import (établissements, produits reconnus, non servis, retours…), figés à l'application.
  rapport        Json?
  /// REMPLACÉ par un fichier plus récent sur TOUTES ses tranches (source × mois) : gardé, il ne compte plus.
  remplaceParId  String?
  remplaceLe     DateTime?
  auteurId       String?
  createdAt      DateTime            @default(now())
  ventes         PchVenteLigne[]
  receptions     PchReceptionLigne[]

  @@index([nature, createdAt])
}

/// UNE LIGNE DE VENTE D'UNE DR À UN ÉTABLISSEMENT — servie, servie en partie, NON SERVIE (rupture) ou retour.
model PchVenteLigne {
  id            String              @id @default(cuid())
  importId      String
  import        PchVenteImport      @relation(fields: [importId], references: [id], onDelete: Cascade)
  ligneSource   Int
  /// Code de la direction régionale (« DRO ») — voir `PchDirectionRegionale`.
  dr            String
  /// Le mois (1er du mois) : celui de la facture, ou le mois du fichier pour une ligne non servie (sans facture).
  mois          DateTime            @db.Date
  famille       String?
  classe        String?
  /// Le CLIENT tel qu'écrit par la PCH, et sa clé normalisée (`cleClient`).
  client        String
  clientCle     String
  institutionId String?
  institution   MedicalInstitution? @relation("PchVenteEtablissement", fields: [institutionId], references: [id], onDelete: SetNull)
  /// Le code produit de la PCH — le même dans toutes les DR et dans les réceptions (`CODE_PRO`).
  poste         Int?
  /// La désignation telle qu'écrite (DCI + dosage + forme).
  dci           String
  /// Radical de la molécule et clé de présentation (`normalisation.ts`) — le marché de la molécule.
  molecule      String?
  cle           String?
  /// NOTRE produit, quand le poste lui est rattaché (`PchPoste`) ; null = donnée de marché.
  productId     String?
  product       Product?            @relation("PchVenteProduit", fields: [productId], references: [id], onDelete: SetNull)
  uc            String?
  lot           String?
  ddp           String?
  qteCommandee  Int                 @default(0)
  qteLivree     Int                 @default(0)
  coutAchat     Decimal?            @db.Decimal(14, 2)
  prixVente     Decimal?            @db.Decimal(14, 2)
  /// Quantité livrée × coût d'achat PCH (DZD).
  valeurAchat   Decimal?            @db.Decimal(16, 2)
  dateFacture   DateTime?           @db.Date
  /// SERVIE · PARTIELLE · NON_SERVIE · RETOUR · NULLE
  statut        String

  @@index([importId])
  @@index([dr, mois])
  @@index([mois])
  @@index([productId, mois])
  @@index([molecule, mois])
  @@index([institutionId, mois])
  @@index([clientCle])
  @@index([poste])
}

/// UNE RÉCEPTION DE LA PCH CENTRALE — FO fournisseur (notre sell-in quand c'est notre fournisseur), TR transfert
/// entre annexes, RC retour client, CO correction de stock.
model PchReceptionLigne {
  id              String         @id @default(cuid())
  importId        String
  import          PchVenteImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  ligneSource     Int
  mois            DateTime       @db.Date
  dateStockage    DateTime?      @db.Date
  gamme           String?
  classe          String?
  codeFour        Int?
  /// Le fournisseur tel qu'écrit, et sa clé (`cleFournisseur`).
  fournisseur     String
  fournisseurCle  String
  numBr           String?
  /// = le POSTE des ventes.
  codePro         Int?
  designation     String
  molecule        String?
  cle             String?
  productId       String?
  product         Product?       @relation("PchReceptionProduit", fields: [productId], references: [id], onDelete: SetNull)
  conditionnement String?
  qte             Int            @default(0)
  coutUnit        Decimal?       @db.Decimal(16, 2)
  /// DA · USD · EUR…
  devise          String?
  /// FO · TR · RC · CO
  type            String
  avoirNo         String?

  @@index([importId])
  @@index([mois])
  @@index([productId, mois])
  @@index([molecule, mois])
  @@index([codePro])
  @@index([fournisseurCle])
}

/// UN POSTE PCH (code produit de la PCH) ET NOTRE PRODUIT — la mémoire du rattachement : un rattachement fait à la
/// main (`manuel`) ne bouge plus ; un rattachement automatique se refait à chaque import.
model PchPoste {
  poste         Int      @id
  designation   String
  molecule      String?
  cle           String?
  productId     String?
  product       Product? @relation("PchPosteProduit", fields: [productId], references: [id], onDelete: SetNull)
  manuel        Boolean  @default(false)
  /// MEMOIRE · IDENTITE · AMBIGU · MOLECULE · MARCHE (`correspondance.ts`).
  statut        String   @default("MARCHE")
  confirmeParId String?
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@index([molecule])
}

/// « CE CLIENT DE LA PCH EST CET ÉTABLISSEMENT » — confirmé par une personne, réutilisé à chaque fichier.
model PchEtablissementMemoire {
  /// La clé normalisée du client (`cleClient`).
  cle           String   @id
  institutionId String
  confirmeParId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([institutionId])
}

/// UNE DIRECTION RÉGIONALE DE LA PCH — son libellé et ses wilayas (déduites de ses clients, corrigeables).
model PchDirectionRegionale {
  code      String   @id
  libelle   String
  wilayas   String[] @default([])
  updatedAt DateTime @updatedAt
}

/// LES FOURNISSEURS DE LA PCH QUI SONT « NOUS » POUR UN PRODUIT — leurs réceptions FO sont notre sell-in. Proposés
/// d'après les laboratoires des dossiers (`origine` AUTO), corrigeables (MANUEL, `actif`).
model PchFournisseurProduit {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation("PchFournisseurProduit", fields: [productId], references: [id], onDelete: Cascade)
  fournisseurCle String
  libelle        String
  /// AUTO · MANUEL
  origine        String   @default("AUTO")
  actif          Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, fournisseurCle])
  @@index([fournisseurCle])
}

// ─────────────────────────── KPI SANS CODE (Direction, 08/10) ───────────────────────────
// Un KPI n'est plus du code : c'est une DÉFINITION enregistrée ici, qui choisit une brique de mesure écrite une fois
// (`src/lib/kpi/briques.ts`), ses filtres, sa cible, ses seuils. Luna aide à l'écrire, la plateforme calcule. Les
// identifiants de personnes sont des identifiants sans relation (convention des marques de renvoi) : les tables KPI
// ne touchent pas au modèle User.

/// UNE VERSION D'UNE DÉFINITION DE KPI. Modifier un KPI crée une NOUVELLE ligne (version + 1) dans la même `famille`
/// et archive l'ancienne : une revue signée garde la version avec laquelle elle a été notée.
model KpiDefinition {
  id          String   @id @default(cuid())
  /// L'identifiant STABLE du KPI, partagé par toutes ses versions — c'est lui que les affectations visent.
  famille     String
  version     Int      @default(1)
  nom         String
  description String?
  /// CALCULE · RATIO · EVALUE · DECLARE · IMPORTE
  nature      String
  /// Les briques utilisées (numérateur, dénominateur) — la lecture rapide de `params`.
  briques     String[] @default([])
  /// `{ numerateur: { brique, lettres?, seuilN?, heures?, produitId?, buId? } | null, denominateur: … | null }`
  params      Json     @default("{}")
  /// POURCENT · NOMBRE · HEURES · NIVEAU
  unite       String
  /// PLUS_HAUT · PLUS_BAS
  sens        String   @default("PLUS_HAUT")
  cible       Float?
  seuilVert   Float?
  seuilOrange Float?
  /// La période à laquelle la cible se rapporte : MOIS · TRIMESTRE
  periode     String   @default("MOIS")
  /// La grille d'un KPI ÉVALUÉ : `[{ libelle, critere }]`, du plus faible au meilleur.
  grille      Json?
  /// ACTIF · ARCHIVE
  statut      String   @default("ACTIF")
  /// CATALOGUE (Super Admin, modèles par rôle) · EQUIPE (créé par un manager pour son équipe)
  portee      String   @default("EQUIPE")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values       KpiValue[]
  evaluations  KpiEvaluation[]
  declarations KpiDeclaration[]

  @@unique([famille, version])
  @@index([statut])
  @@index([createdById])
}

/// À QUI S'APPLIQUE UN KPI, et avec quel POIDS : un rôle (modèle par rôle), l'équipe d'un manager, ou une personne.
model KpiAssignment {
  id            String   @id @default(cuid())
  famille       String
  /// ROLE · EQUIPE · PERSONNE
  cible         String
  role          String?
  managerUserId String?
  userId        String?
  poids         Float    @default(10)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([famille])
  @@index([role])
  @@index([managerUserId])
  @@index([userId])
}

/// LA VALEUR CALCULÉE d'une version de KPI pour une personne et une période — le cache du calcul (« bilan en
/// continu » : recalculée tant que la période vit). `sourceManquante` dit pourquoi la valeur est nulle.
model KpiValue {
  id              String        @id @default(cuid())
  definitionId    String
  definition      KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  userId          String
  /// « 2026-10 », « 2026-T4 », « 2026-S2 »
  periode         String
  valeur          Float?
  numerateur      Float?
  denominateur    Float?
  detail          Json?
  sourceManquante String?
  /// IMPORTE : la valeur vient d'un fichier (KpiImport) et ne se recalcule pas.
  importId        String?
  calculeLe       DateTime      @default(now())

  @@unique([definitionId, userId, periode])
  @@index([userId, periode])
}

/// UN KPI ÉVALUÉ pour une personne et une période : la proposition de Luna (niveau + preuves citées), puis le niveau
/// VALIDÉ par le manager — seul ce dernier compte.
model KpiEvaluation {
  id                 String        @id @default(cuid())
  definitionId       String
  definition         KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  userId             String
  periode            String
  propositionNiveau  Int?
  propositionPreuves Json?
  justification      String?
  proposeLe          DateTime?
  niveau             Int?
  commentaire        String?
  valideParId        String?
  valideLe           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([definitionId, userId, periode])
  @@index([userId, periode])
}

/// UN KPI DÉCLARÉ : une valeur saisie par la personne avec sa pièce, validée (ou refusée) par son manager.
model KpiDeclaration {
  id           String        @id @default(cuid())
  definitionId String
  definition   KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  userId       String
  periode      String
  libelle      String
  valeur       Float
  pieceBlobId  String?
  pieceNom     String?
  pieceMime    String?
  /// A_VALIDER · VALIDEE · REFUSEE
  statut       String        @default("A_VALIDER")
  motif        String?
  valideParId  String?
  valideLe     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([definitionId, userId, periode])
  @@index([userId])
  @@index([statut])
}

/// UN IMPORT de KPI IMPORTÉ : le fichier, les colonnes choisies (personne, période, valeur), ce qui a été écarté.
model KpiImport {
  id              String   @id @default(cuid())
  famille         String
  definitionId    String
  nomFichier      String
  blobId          String?
  colonnePersonne String
  colonnePeriode  String
  colonneValeur   String
  lignes          Int      @default(0)
  rejets          Json?
  importeParId    String?
  createdAt       DateTime @default(now())

  @@index([famille])
}

/// LA REVUE d'une personne pour une période : le score pondéré, signé par le manager. Signée, elle FIGE ses lignes
/// (`detail` : version, valeur, note, poids de chaque KPI) — la règle du jour ne réécrit pas un mois déjà revu.
model KpiReview {
  id                 String    @id @default(cuid())
  userId             String
  periode            String
  frequence          String    @default("MENSUELLE")
  score              Float?
  kpiSansDonnee      Int       @default(0)
  detail             Json?
  /// BROUILLON · SIGNEE
  statut             String    @default("BROUILLON")
  signeeParId        String?
  signeeLe           DateTime?
  commentaireManager String?
  commentaireLuna    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, periode])
}

/// LA FRÉQUENCE DE REVUE choisie par un manager pour son équipe (Direction, 08/10 : « revue au choix du manager »).
model KpiReviewSetting {
  id            String   @id @default(cuid())
  managerUserId String   @unique
  /// MENSUELLE · TRIMESTRIELLE · SEMESTRIELLE
  frequence     String   @default("MENSUELLE")
  updatedAt     DateTime @updatedAt
}

/// LES MÉDECINS CONCERNÉS PAR UNE DEMANDE AD & PRO (Direction, 08/10) — le lien générique demande ↔ annuaire.
/// « Produits – médecins – dépenses connectés » : le cockpit marketing (Leaders d'opinion, Investissements) et la
/// fiche du praticien lisent ce lien ; le texte libre `doctor` des anciennes demandes ne sert plus que de repli.
/// `entityType` : SPONSORING, EVENT, CONGRESS_NATIONAL, CONGRESS_INTERNATIONAL, PROMO_MATERIAL, AD_PRO_OTHER.
model AdProMedecin {
  id          String        @id @default(cuid())
  entityType  String
  entityId    String
  doctorId    String
  doctor      MedicalDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  /// BENEFICIAIRE | ORATEUR | INVITE | AUTRE
  role        String        @default("BENEFICIAIRE")
  /// Montant attribuable à CE praticien (DZD), quand la demande le dit.
  montant     Decimal?      @db.Decimal(14, 2)
  createdById String
  createdAt   DateTime      @default(now())

  @@unique([entityType, entityId, doctorId])
  @@index([entityType, entityId])
  @@index([doctorId])
}

/// LE BESOIN ANNUEL D'UN SERVICE (Direction, 10/2026 — Marketing cockpit · terrain) : en marché d'appels d'offres, le
/// DÉCIDEUR (H) fixe les prévisions de son service, et ces prévisions fixent le volume de l'AO. Le KAM saisit le besoin
/// annoncé (en boîtes) à la visite du décideur ; la Direction Marketing et le chef de produit le corrigent au cockpit.
/// Une ligne par produit × établissement × service × année — `serviceId` nul = l'établissement entier (l'index unique
/// SQL est `NULLS NOT DISTINCT`). Identifiants SANS relation Prisma (la convention des marques de renvoi) : les clés
/// étrangères vivent dans la migration `20270117183000_besoins_services` (cascade sur produit, établissement, service ;
/// décideur retiré = `SET NULL`). La règle : `src/lib/besoins-services/regles.ts`.
model BesoinAnnuelService {
  id            String   @id @default(cuid())
  productId     String
  institutionId String
  serviceId     String?
  annee         Int
  /// En boîtes.
  quantite      Int
  /// Le praticien (décideur) qui l'a annoncé.
  decideurId    String?
  note          String?
  saisiParId    String
  saisiLe       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, institutionId, serviceId, annee])
  @@index([productId, annee])
  @@index([institutionId])
  @@index([decideurId])
}

/// LA VOIX DU TERRAIN, MISE EN CACHE POUR LA JOURNÉE (`src/lib/voix-terrain-luna.ts`) : le regroupement des rapports de
/// visite par Luna (ou son repli par mots-clés) se calcule une fois par jour et par périmètre — `cle` = périmètre +
/// fenêtre + jour. Une donnée de confort : la supprimer fait seulement recalculer.
model VoixTerrainCache {
  cle     String   @id
  jour    String
  contenu Json
  parLuna Boolean  @default(false)
  creeLe  DateTime @default(now())

  @@index([jour])
}

/// INTELLIGENCE TERRAIN (console d'administration, Super Admin seul — Direction, 10/2026) : UN LIEN D'INFLUENCE entre deux
/// praticiens. Sens : `fromDoctorId` INFLUENCE `toDoctorId`. Trois sources : STRUCTURE (hiérarchie du service, co-orateurs,
/// pharmacie — recalculée, toujours confirmée), LUNA (extrait d'un rapport, PROPOSÉ avec sa citation mot pour mot) et SAISIE.
/// Un lien rejeté reste (statut REJETEE) : Luna ne le reproposera pas. Identifiants SANS relation Prisma (convention des
/// marques de renvoi) : les clés étrangères (cascade) vivent dans la migration `20270118120000_intelligence_terrain`.
model PraticienRelation {
  id            String    @id @default(cuid())
  fromDoctorId  String
  toDoctorId    String
  /// HIERARCHIE · PHARMACIE_SERVICE · CO_ORATEUR · SUIT_AVIS · ELEVE_DE · COMITE · DECIDE (`src/lib/influence/relations.ts`)
  type          String
  /// STRUCTURE · LUNA · SAISIE
  source        String
  /// 0–1 (1 pour un lien structurel ou confirmé à la main).
  confidence    Float     @default(1)
  /// La citation, extrait EXACT du rapport.
  evidence      String?
  /// Le rapport source : identifiant de FieldReport, ou « visite:<id> » pour le compte rendu écrit d'une visite.
  reportId      String?
  /// SUR · A_VERIFIER — le rapprochement des noms écrits avec l'annuaire.
  rapprochement String?
  /// PROPOSEE · CONFIRMEE · REJETEE
  statut        String    @default("PROPOSEE")
  decideParId   String?
  decideLe      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([fromDoctorId, toDoctorId, type])
  @@index([toDoctorId])
  @@index([statut, source])
}

/// LE SCORE D'INFLUENCE EN CACHE (0–100) et ses raisons (points expliqués) — recalculé à chaque analyse et après chaque
/// décision sur un lien. Une donnée de confort : la supprimer fait seulement recalculer.
model InfluenceScore {
  doctorId   String   @id
  score      Int
  raisons    Json
  computedAt DateTime @default(now())

  @@index([score])
}

/// LE FILIGRANE D'UNE ANALYSE INCRÉMENTALE : jusqu'où les rapports ont été lus (`dernierLe` + `dernierId`), quand l'analyse a
/// tourné, et son bilan. `cle` = « influence:rapports », « influence:visites », « influence:execution ».
model AnalyseWatermark {
  cle               String    @id
  dernierLe         DateTime?
  dernierId         String?
  derniereExecution DateTime?
  bilan             Json?
  updatedAt         DateTime  @updatedAt
}
// ═══════════════════════════════════════════════════════════════════════════════════════════
// RÉFÉRENTIELS (refonte des données, palier P1) — `docs/architecture/refonte-donnees-et-monolithe-modulaire.md`
//
// Une chose réelle = une ligne, reconnue par ses identifiants, à laquelle tout le reste se rattache.
// Tables créées VIDES : le remplissage depuis l'existant est le palier P2. Les tables métier restent
// et gagnent une colonne de LIEN nullable (`personneId`, `organisationId`, `pieceId`), `ON DELETE SET NULL`.
//   R1 Personnes · R2 Organisations · R3 Adresses et coordonnées (Wilaya/Commune : autre lot) ·
//   R5 Pièces · R6 Coffre des données sensibles · E Moteur d'enrichissement (faits proposés → confirmés).
// Les utilisateurs (`creeParId`, `decideeParId`…) sont des identifiants SCALAIRES, comme ailleurs :
// `User` porte déjà 170 clés étrangères, le référentiel n'en ajoute pas.
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// R1 — UNE PERSONNE RÉELLE, une seule ligne, quel que soit le module qui la connaît (collaborateur,
/// médecin, bénéficiaire, voyageur, candidat, contact d'un tiers). Les fiches métier (`User`, `Employee`,
/// `MedicalDoctor`…) la désignent par `personneId`. Une fusion n'efface rien : la fiche absorbée garde sa
/// ligne et pointe la survivante par `fusionneeDansId` — proposée, jamais faite d'office.
model Personne {
  id                    String                 @id @default(cuid())
  /// M., Mme, Dr, Pr — telle que présentée ; vocabulaire tenu côté code.
  civilite              String?
  nom                   String
  prenoms               String?
  /// Nom + prénoms repliés (minuscules, sans accents ni ponctuation) : la clé de recherche et de rapprochement.
  nomReplie             String
  naissance             DateTime?              @db.Date
  /// Code pays ISO 3166-1 alpha-2 (« DZ »).
  nationalite           String?
  /// Codes ISO 639-1 (« fr », « ar », « en »).
  langues               String[]               @default([])
  /// Photo : `FileBlob.id` (scalaire — le blob reste compté par le Drive).
  photoBlobId           String?
  /// 0–100 : part des attributs attendus qui sont renseignés. Calculée, jamais saisie.
  completude            Int                    @default(0)
  fusionneeDansId       String?
  fusionneeDans         Personne?              @relation("PersonneFusion", fields: [fusionneeDansId], references: [id], onDelete: SetNull)
  fusionnees            Personne[]             @relation("PersonneFusion")
  creeParId             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  roles                 PersonneRole[]
  affiliations          Affiliation[]
  adresses              Adresse[]
  pointsDeContact       PointDeContact[]
  users                 User[]
  employees             Employee[]
  medicalDoctors        MedicalDoctor[]
  careBeneficiaries     CareBeneficiary[]
  adProVoyageurs        AdProVoyageur[]
  adProHebergements     AdProHebergement[]
  recruitmentCandidates RecruitmentCandidate[]
  directoryEntries      DirectoryEntry[]
  supplierUsers         SupplierUser[]
  doublonsCommeA        DoublonPersonne[]      @relation("DoublonPersonneA")
  doublonsCommeB        DoublonPersonne[]      @relation("DoublonPersonneB")

  @@index([nomReplie])
  @@index([fusionneeDansId])
}

/// Ce qu'une personne EST pour l'entreprise — plusieurs rôles à la fois, chacun daté.
enum RolePersonne {
  COLLABORATEUR
  PROFESSIONNEL_SANTE
  BENEFICIAIRE
  VOYAGEUR
  CANDIDAT
  CONTACT_TIERS
  INTERVENANT
}

/// R1 — Deux Personnes qui se ressemblent : un doublon PROPOSÉ (`referentiels/doublons.ts`), jamais fusionné
/// d'office. Une personne tranche : FUSIONNE (l'une absorbe l'autre, `Personne.fusionneeDansId`, les lignes
/// déplacées sont gardées dans `deplacees` pour le défaire) ou ECARTE (la paire ne revient plus). A < B.
model DoublonPersonne {
  id          String    @id @default(cuid())
  personneAId String
  personneA   Personne  @relation("DoublonPersonneA", fields: [personneAId], references: [id], onDelete: Cascade)
  personneBId String
  personneB   Personne  @relation("DoublonPersonneB", fields: [personneBId], references: [id], onDelete: Cascade)
  /// CERTAIN | PROBABLE | POSSIBLE
  niveau      String
  score       Int       @default(0)
  raisons     String[]  @default([])
  reserves    String[]  @default([])
  /// PROPOSE | FUSIONNE | ECARTE
  statut      String    @default("PROPOSE")
  /// La Personne gardée par la fusion.
  gardeeId    String?
  /// Les lignes (« Employee:ck… ») déplacées vers la Personne gardée — de quoi défaire la fusion.
  deplacees   String[]  @default([])
  decideParId String?
  decideLe    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([personneAId, personneBId])
  @@index([statut, niveau])
  @@index([personneBId])
}

/// R1 — Un rôle d'une personne, de `depuis` à `jusquA` (nul = en cours).
model PersonneRole {
  id         String       @id @default(cuid())
  personneId String
  personne   Personne     @relation(fields: [personneId], references: [id], onDelete: Cascade)
  role       RolePersonne
  depuis     DateTime?    @db.Date
  jusquA     DateTime?    @db.Date
  creeParId  String?
  createdAt  DateTime     @default(now())

  @@index([personneId])
  @@index([role])
}

/// R2 — UNE ORGANISATION RÉELLE (société du groupe, fournisseur, établissement, société savante, autorité…),
/// reconnue par ses identifiants (`OrganisationIdentifiant`). `Company`, `Supplier`, `MedicalInstitution`,
/// `CompanyContact` et les demandes la désignent par `organisationId`. Fusion tracée par `fusionneeDansId`.
model Organisation {
  id                     String                    @id @default(cuid())
  raisonSociale          String
  nomCourt               String?
  /// Raison sociale repliée (minuscules, sans accents, sans forme juridique) : recherche et rapprochement.
  nomReplie              String
  formeJuridique         String?
  capital                Decimal?                  @db.Decimal(14, 2)
  /// Code pays ISO 3166-1 alpha-2.
  pays                   String                    @default("DZ")
  /// ACTIVE | CESSEE | INCONNU — vocabulaire tenu côté code.
  statut                 String                    @default("ACTIVE")
  siteWeb                String?
  /// Logo : `FileBlob.id` (scalaire).
  logoBlobId             String?
  /// 0–100, calculée.
  completude             Int                       @default(0)
  fusionneeDansId        String?
  fusionneeDans          Organisation?             @relation("OrganisationFusion", fields: [fusionneeDansId], references: [id], onDelete: SetNull)
  fusionnees             Organisation[]            @relation("OrganisationFusion")
  creeParId              String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  roles                  OrganisationRole[]
  identifiants           OrganisationIdentifiant[]
  affiliations           Affiliation[]
  adresses               Adresse[]
  pointsDeContact        PointDeContact[]
  companies              Company[]
  companyContacts        CompanyContact[]
  suppliers              Supplier[]
  medicalInstitutions    MedicalInstitution[]
  sponsoringRequests     SponsoringRequest[]
  congressNationals      CongressNational[]
  congressInternationals CongressInternational[]
  doublonsA              PropositionDoublonOrganisation[] @relation("DoublonA")
  doublonsB              PropositionDoublonOrganisation[] @relation("DoublonB")

  @@index([nomReplie])
  @@index([fusionneeDansId])
}

/// Ce qu'une organisation EST pour l'entreprise — plusieurs rôles à la fois.
enum RoleOrganisation {
  SOCIETE_DU_GROUPE
  FOURNISSEUR
  CLIENT
  ETABLISSEMENT_SANTE
  SOCIETE_SAVANTE
  AUTORITE
  LABORATOIRE
  AGENCE
  BANQUE
  TRANSPORTEUR
  AUTRE
}

/// R2 — Un rôle d'une organisation, daté.
model OrganisationRole {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           RoleOrganisation
  depuis         DateTime?        @db.Date
  jusquA         DateTime?        @db.Date
  creeParId      String?
  createdAt      DateTime         @default(now())

  @@unique([organisationId, role])
  @@index([role])
}

/// Les identifiants officiels d'une organisation algérienne (et le code de la PCH).
enum TypeIdentifiantOrganisation {
  NIF
  NIS
  RC
  AI
  AGREMENT
  CODE_PCH
}

/// R2 — UN IDENTIFIANT OFFICIEL : deux organisations ne partagent jamais (type, valeur normalisée). C'est
/// la clé de rapprochement d'un tiers (« le NIF lu sur un devis désigne CETTE organisation »).
model OrganisationIdentifiant {
  id               String                      @id @default(cuid())
  organisationId   String
  organisation     Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type             TypeIdentifiantOrganisation
  /// Telle que lue ou saisie.
  valeur           String
  /// Chiffres et lettres seuls, majuscules : la forme comparée.
  valeurNormalisee String
  /// Pièce d'où il a été lu (nul : saisie).
  pieceId          String?
  verifieLe        DateTime?
  creeParId        String?
  createdAt        DateTime                    @default(now())

  @@unique([type, valeurNormalisee])
  @@index([organisationId])
}

/// R2 — DEUX ORGANISATIONS QUI SONT PEUT-ÊTRE LA MÊME : le système PROPOSE (`referentiels/doublons.ts`), une
/// personne TRANCHE. `organisationAId` < `organisationBId` (paire ordonnée, unique). Rien n'est fusionné d'office :
/// FUSIONNEE pose `Organisation.fusionneeDansId` sur l'absorbée (geste du Super Admin, audité), ECARTEE garde les deux.
model PropositionDoublonOrganisation {
  id              String       @id @default(cuid())
  organisationAId String
  organisationA   Organisation @relation("DoublonA", fields: [organisationAId], references: [id], onDelete: Cascade)
  organisationBId String
  organisationB   Organisation @relation("DoublonB", fields: [organisationBId], references: [id], onDelete: Cascade)
  /// CERTAIN | PROBABLE | POSSIBLE (`NiveauDoublon`).
  niveau          String
  score           Int          @default(0)
  raisons         String[]     @default([])
  reserves        String[]     @default([])
  /// PROPOSEE | FUSIONNEE | ECARTEE — vocabulaire tenu côté code.
  statut          String       @default("PROPOSEE")
  decideeParId    String?
  decideeLe       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organisationAId, organisationBId])
  @@index([statut, niveau])
  @@index([organisationBId])
}

/// R2 — PERSONNE ↔ ORGANISATION : remplace les champs texte `institution`. Une personne a au plus une
/// affiliation `principale` vivante (tenu côté code).
model Affiliation {
  id             String       @id @default(cuid())
  personneId     String
  personne       Personne     @relation(fields: [personneId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fonction       String?
  service        String?
  depuis         DateTime?    @db.Date
  jusquA         DateTime?    @db.Date
  principale     Boolean      @default(false)
  creeParId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([personneId])
  @@index([organisationId])
}

enum TypeAdresse {
  SIEGE
  LIVRAISON
  DOMICILE
  AUTRE
}

/// R3 — UNE ADRESSE, d'une personne OU d'une organisation (exactement un titulaire, contrainte en base).
/// `wilayaCode` / `communeCode` sont des codes officiels SCALAIRES : le référentiel Wilaya/Commune est
/// chargé par un autre lot, la clé étrangère viendra avec lui.
model Adresse {
  id             String        @id @default(cuid())
  personneId     String?
  personne       Personne?     @relation(fields: [personneId], references: [id], onDelete: Cascade)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type           TypeAdresse   @default(AUTRE)
  ligne1         String
  ligne2         String?
  /// Code wilaya officiel (« 16 » = Alger).
  wilayaCode     String?
  wilaya         Wilaya?       @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  /// Code commune officiel.
  communeCode    String?
  commune        Commune?      @relation(fields: [communeCode], references: [code], onDelete: SetNull)
  codePostal     String?
  /// Code pays ISO 3166-1 alpha-2.
  pays           String        @default("DZ")
  lat            Float?
  lng            Float?
  principale     Boolean       @default(false)
  /// Pièce d'où elle a été lue, ou SAISIE / IMPORT.
  source         String?
  verifieeLe     DateTime?
  creeParId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([personneId])
  @@index([organisationId])
  @@index([wilayaCode, communeCode])
}

enum TypePointDeContact {
  TELEPHONE
  EMAIL
  SITE
}

/// R3 — UN MOYEN DE JOINDRE une personne OU une organisation (exactement un titulaire, contrainte en base).
/// `valeurNormalisee` : E.164 pour un téléphone, minuscules pour un e-mail, hôte pour un site.
model PointDeContact {
  id               String             @id @default(cuid())
  personneId       String?
  personne         Personne?          @relation(fields: [personneId], references: [id], onDelete: Cascade)
  organisationId   String?
  organisation     Organisation?      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type             TypePointDeContact
  valeur           String
  valeurNormalisee String
  libelle          String?
  principal        Boolean            @default(false)
  verifieLe        DateTime?
  /// `Piece.id` d'où il a été lu, ou SAISIE / IMPORT.
  source           String?
  creeParId        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([personneId])
  @@index([organisationId])
  @@index([type, valeurNormalisee])
}

/// D'où une pièce est entrée dans l'ERP.
enum SourcePiece {
  DRIVE
  CONVERSATION
  EMAIL
  PORTAIL
  AD_PRO
  RH
  LEGAL
  AUTRE
}

/// R5 — LE FICHIER, une fois pour toutes : son contenu (`blobId`, empreinte), sa nature classée et sa
/// confidentialité. `Document` et `DriveNode` restent le stockage et les vues de l'écran et la désignent par
/// `pieceId` ; la pièce se rattache à PLUSIEURS sujets par `PieceLien`.
model Piece {
  id               String           @id @default(cuid())
  /// `FileBlob.id` (scalaire — le compte de références du blob reste tenu par le Drive).
  blobId           String?
  /// SHA-256 du contenu en clair — la même empreinte que `FileBlob.sha256` et `LecturePiece.empreinte`.
  empreinte        String
  nom              String
  mime             String?
  taille           Float?
  pages            Int?
  /// Code ISO 639-1 de la langue dominante.
  langue           String?
  /// Une valeur de `NATURES_PIECE` (`src/lib/enrichissement/types.ts`) ; nulle tant que non classée.
  nature           String?
  natureConfiance  Float?
  confidentiality  Confidentiality  @default(INTERNAL)
  source           SourcePiece      @default(AUTRE)
  deposeeParId     String?
  deposeeLe        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  liens            PieceLien[]
  extractions      Extraction[]
  donneesSensibles DonneeSensible[]
  faitsConfirmes   FaitConfirme[]
  documents        Document[]
  driveNodes       DriveNode[]
  /// J1 — sa fiche de bibliothèque (lecture, passages, clés d'accès) : née à l'inscription (`inscrirePiece`).
  fiche            BibliothequeFiche?

  @@index([empreinte])
  @@index([nature])
  @@index([blobId])
}

/// À quoi une pièce est rattachée : une PERSONNE, une ORGANISATION ou une ENTITÉ métier (poste, demande…).
enum TypeSujetPiece {
  PERSONNE
  ORGANISATION
  ENTITE
}

/// R5 — UNE PIÈCE ↔ UN SUJET, avec un rôle (« passeport de », « devis du », « pièce de »). Le même passeport
/// est lié à la personne, au poste et à la demande — trois liens, un seul fichier.
model PieceLien {
  id         String         @id @default(cuid())
  pieceId    String
  piece      Piece          @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  sujetType  TypeSujetPiece
  sujetId    String
  /// Pour une ENTITE : le type métier, libre (« AD_PRO_ITEM », « SPONSORING_REQUEST »…). Nul sinon.
  entityType String?
  /// TITULAIRE, EMETTEUR, DESTINATAIRE, JUSTIFICATIF… — vocabulaire tenu côté code.
  role       String
  creeParId  String?
  createdAt  DateTime       @default(now())

  @@unique([pieceId, sujetType, sujetId, role])
  @@index([sujetType, sujetId])
}

/// Le titulaire d'une donnée du coffre.
enum TypeTitulaire {
  PERSONNE
  ORGANISATION
}

/// R6 — LE COFFRE : une donnée sensible (NIN, passeport, RIB/IBAN, salaire), CHIFFRÉE avec une clé dédiée
/// (AES-256-GCM : `valeurChiffree` + `iv` + `tag`), recherchable par `empreinteHmac` sans être déchiffrée.
/// Seuls `derniersCaracteres` s'affichent. Lecture réservée : RH (salaires, NIN), Finances (RIB, IBAN), le
/// titulaire pour les siennes — chaque lecture écrit un `AccesDonneeSensible`. Jamais à un modèle.
model DonneeSensible {
  id                 String                @id @default(cuid())
  /// Le titulaire du référentiel (Personne / Organisation) — nul tant que la fiche n'existe pas : la copie
  /// d'une colonne reste alors tenue par son ORIGINE, et la reprise rejouée la rattache (V2-E).
  titulaireType      TypeTitulaire?
  titulaireId        String?
  /// La nature du coffre (`src/lib/coffre/natures.ts`) : IBAN, RIB, NIN, PASSEPORT_NUMERO, SALAIRE…
  nature             String
  valeurChiffree     Bytes
  iv                 Bytes
  tag                Bytes
  /// Version du FORMAT de chiffrement (`c1` → 1).
  cleVersion         Int                   @default(1)
  /// Identifiant public de la clé maîtresse qui a chiffré (`src/lib/coffre/cle.ts`) : rotation, refus explicite.
  cleId              String?
  /// HMAC-SHA-256 de la valeur normalisée (clé distincte) : retrouver un doublon sans déchiffrer.
  empreinteHmac      String
  derniersCaracteres String?
  pieceId            String?
  piece              Piece?                @relation(fields: [pieceId], references: [id], onDelete: SetNull)
  valideDu           DateTime?             @db.Date
  valideAu           DateTime?             @db.Date
  creeParId          String?
  createdAt          DateTime              @default(now())
  /// LA COLONNE DONT C'EST LA COPIE (V2-E) : `Employee` / `iban`… — reprise rejouable, double écriture exacte.
  /// Une seule copie COURANTE par origine (unicité partielle `DonneeSensible_origine_courante_key`, en SQL).
  origineModele      String?
  origineId          String?
  origineChamp       String?
  /// Remplacée par une nouvelle valeur (ou la colonne vidée) : la copie est gardée, datée, plus lue.
  remplaceeLe        DateTime?
  acces              AccesDonneeSensible[]
  faitsProposes      FaitPropose[]
  faitsConfirmes     FaitConfirme[]

  @@index([titulaireType, titulaireId])
  @@index([empreinteHmac])
  @@index([origineModele, origineId])
}

/// R6 — QUI A LU QUOI, QUAND, POUR QUEL GESTE. Le journal survit à la donnée : la nature et le titulaire
/// sont recopiés, la clé passe à nul si la donnée est un jour effacée (accord exprès, palier P5).
model AccesDonneeSensible {
  id               String          @id @default(cuid())
  donneeSensibleId String?
  donneeSensible   DonneeSensible? @relation(fields: [donneeSensibleId], references: [id], onDelete: SetNull)
  titulaireType    TypeTitulaire?
  titulaireId      String?
  /// La colonne lue (V2-E) — renseignée aussi quand la lecture a eu lieu avant que la copie existe.
  origineModele    String?
  origineId        String?
  origineChamp     String?
  nature           String
  /// Le compte qui a lu ; nul pour un modèle d'IA (refusé, `lecteurNom`).
  userId           String?
  lecteurNom       String?
  /// Le geste, en clair : « Fiche employé — consultation », « Bon de commande BC-2026-014 — impression »…
  geste            String
  /// Accordé ou refusé : un refus se journalise aussi.
  autorise         Boolean         @default(true)
  /// Le motif de la politique (`src/lib/coffre/politique.ts`) : RH, FINANCES, TITULAIRE, HORS_PERIMETRE…
  motif            String?
  createdAt        DateTime        @default(now())

  @@index([donneeSensibleId])
  @@index([userId, createdAt])
  @@index([titulaireType, titulaireId])
  @@index([createdAt])
  @@index([origineModele, origineId])
}

enum StatutExtraction {
  EN_COURS
  TERMINEE
  ECHOUEE
}

/// E — UN PASSAGE D'UN EXTRACTEUR SUR UNE PIÈCE (`ResultatExtraction`) : quel moteur, local ou non, ce qu'il
/// n'a pas pu lire (`notes`, jamais un silence), sa durée et son coût.
model Extraction {
  id        String           @id @default(cuid())
  pieceId   String
  piece     Piece            @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  /// La nature retenue pour cette extraction (`NATURES_PIECE`).
  nature    String?
  /// « mrz-local/1 », « pieces-lues/3 », « regles-cv/1 »…
  moteur    String
  /// Vrai : rien n'est sorti du serveur.
  local     Boolean
  statut    StatutExtraction @default(EN_COURS)
  notes     String[]         @default([])
  dureeMs   Int?
  coutUsd   Decimal?         @db.Decimal(12, 6)
  creeParId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  faits     FaitPropose[]

  @@index([pieceId])
  @@index([statut, createdAt])
}

/// Le type de sujet d'un fait (`TypeSujet` du contrat).
enum TypeSujetFait {
  PERSONNE
  ORGANISATION
  PRODUIT
}

/// Le rôle du sujet DANS la pièce (`RoleSujet` du contrat).
enum RoleSujetFait {
  TITULAIRE
  EMETTEUR
  DESTINATAIRE
  SIGNATAIRE
  PARTIE
  ORGANISATEUR
  MENTIONNE
}

/// Le sort d'un fait proposé (`DecisionFait` du contrat, plus l'attente et le rejet humain).
enum DecisionFaitPropose {
  EN_ATTENTE
  CONFIRME_D_OFFICE
  CONFIRME
  REJETE
  CONFLIT
  COFFRE
  IGNORE
}

/// E — UN FAIT LU SUR UNE PIÈCE : une PROPOSITION, jamais une écriture (`FaitExtrait`). `sujetRef` groupe les
/// faits d'un même sujet de la pièce ; `sujetId` se remplit une fois le sujet résolu. Un fait SENSIBLE ne
/// garde ni `valeur` ni `valeurNormalisee` (contrainte en base) : sa valeur est au coffre (`donneeSensibleId`).
model FaitPropose {
  id               String              @id @default(cuid())
  extractionId     String
  extraction       Extraction          @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  sujetRef         String
  sujetType        TypeSujetFait
  sujetId          String?
  role             RoleSujetFait
  /// Une clé de `ATTRIBUTS` (« personne.nom », « organisation.nif »).
  attribut         String
  valeur           String?
  valeurNormalisee String?
  /// 0 à 1.
  confiance        Float
  /// `{ page, extrait }` — l'extrait d'un fait sensible est masqué avant écriture.
  preuve           Json
  sensible         Boolean             @default(false)
  donneeSensibleId String?
  donneeSensible   DonneeSensible?     @relation(fields: [donneeSensibleId], references: [id], onDelete: SetNull)
  decision         DecisionFaitPropose @default(EN_ATTENTE)
  raisonDecision   String?
  decideeParId     String?
  decideeLe        DateTime?
  createdAt        DateTime            @default(now())
  confirmations    FaitConfirme[]
  conflits         ConflitDeFait[]

  @@index([extractionId])
  @@index([sujetType, sujetId])
  @@index([decision, createdAt])
  @@index([attribut, valeurNormalisee])
}

/// D'où vient un fait confirmé.
enum SourceFaitConfirme {
  PIECE
  SAISIE
  IMPORT
}

/// E — CE QUE LA FICHE TIENT POUR VRAI, avec son historique : chaque valeur garde sa source, qui l'a confirmée
/// et sa période de validité. Une valeur remplacée passe `actif = false` et prend un `valideAu` — jamais
/// effacée. Un fait sensible n'a pas de valeur en clair (contrainte en base) : il pointe le coffre.
model FaitConfirme {
  id               String             @id @default(cuid())
  sujetType        TypeSujetFait
  sujetId          String
  attribut         String
  valeur           String?
  valeurNormalisee String?
  sensible         Boolean            @default(false)
  donneeSensibleId String?
  donneeSensible   DonneeSensible?    @relation(fields: [donneeSensibleId], references: [id], onDelete: SetNull)
  source           SourceFaitConfirme
  pieceId          String?
  piece            Piece?             @relation(fields: [pieceId], references: [id], onDelete: SetNull)
  faitProposeId    String?
  faitPropose      FaitPropose?       @relation(fields: [faitProposeId], references: [id], onDelete: SetNull)
  confirmeParId    String?
  confirmeLe       DateTime           @default(now())
  valideDu         DateTime?
  valideAu         DateTime?
  actif            Boolean            @default(true)
  conflits         ConflitDeFait[]

  @@index([sujetType, sujetId, attribut, actif])
  @@index([attribut, valeurNormalisee])
  @@index([pieceId])
}

enum StatutConflitDeFait {
  OUVERT
  GARDE_ACTUELLE
  REMPLACEE
  ABANDONNE
}

/// E — UN DÉSACCORD entre ce que la fiche tient (`faitConfirme`) et ce qu'une pièce propose (`faitPropose`) :
/// jamais un écrasement, une file de décision. Les valeurs sont recopiées pour la lecture (nulles si sensibles).
model ConflitDeFait {
  id             String              @id @default(cuid())
  sujetType      TypeSujetFait
  sujetId        String
  attribut       String
  faitConfirmeId String?
  faitConfirme   FaitConfirme?       @relation(fields: [faitConfirmeId], references: [id], onDelete: SetNull)
  faitProposeId  String
  faitPropose    FaitPropose         @relation(fields: [faitProposeId], references: [id], onDelete: Cascade)
  valeurActuelle String?
  valeurProposee String?
  statut         StatutConflitDeFait @default(OUVERT)
  resoluParId    String?
  resoluLe       DateTime?
  commentaire    String?
  createdAt      DateTime            @default(now())

  @@index([sujetType, sujetId])
  @@index([statut, createdAt])
  @@index([faitProposeId])
  @@index([faitConfirmeId])
}

enum StatutTacheEnrichissement {
  A_FAIRE
  EN_COURS
  FAITE
  ECHEC
  IGNOREE
}

/// E — LA FILE PERSISTANTE DE L'ENRICHISSEMENT (outbox). Une ligne par (empreinte, rattachement) — `cle`,
/// la clé d'idempotence de `PIECE_DEPOSEE` (`empreinte|TYPE:id|rôle`) : un même fichier redéposé au même
/// endroit ne crée rien, déposé ailleurs crée un lien de plus. Posée au dépôt (`signalerDepot`), prise par
/// `traiterLaFile` (verrou `verrouilleLe`, reprise après échec à `prochainEssaiLe`, plafond par passage).
/// Un dépôt direct au bucket entre SANS empreinte (`cle` = `direct:<blobId>|…`) : elle se calcule au passage.
/// Jamais de contenu ici : le blob, son nom (réduit à l'extension s'il est confidentiel), sa source.
model TacheEnrichissement {
  id               String                    @id @default(cuid())
  cle              String                    @unique
  /// SHA-256 du contenu ; nul tant qu'un dépôt direct n'a pas été relu.
  empreinte        String?
  blobId           String
  nomFichier       String
  mime             String
  taille           Float
  /// Une valeur de `SOURCES_DEPOT` (`src/lib/enrichissement/depot.ts`).
  source           String
  confidentiality  Confidentiality           @default(INTERNAL)
  rattachementType String
  rattachementId   String
  role             String
  deposeParId      String?
  deposeLe         DateTime                  @default(now())
  statut           StatutTacheEnrichissement @default(A_FAIRE)
  tentatives       Int                       @default(0)
  prochainEssaiLe  DateTime                  @default(now())
  verrouilleLe     DateTime?
  derniereErreur   String?
  pieceId          String?
  /// Ce que le passage a produit (nature, faits proposés, confirmés, conflits, coffre) — des comptes, jamais des valeurs.
  bilan            Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt

  @@index([statut, prochainEssaiLe])
  @@index([empreinte])
  @@index([pieceId])
}

/// R3 — LIEUX DE RÉFÉRENCE (refonte des données). LE DÉCOUPAGE ADMINISTRATIF OFFICIEL, chargé par migration
/// (`20270130110000_lieux_reference`) depuis le Journal officiel, jamais saisi à l'écran. 69 wilayas depuis la loi
/// n° 26-06 du 4 avril 2026 (JO n° 25) ; numéros 59 à 69 attribués par le décret présidentiel n° 26-206 du
/// 25 mai 2026 (JO n° 40). Les 11 nouvelles entrent en fonction le 1er janvier 2027 : d'ici là, `active` = faux et
/// leur wilaya mère les gère. Les colonnes texte libres (`wilaya`, `city`…) se rattachent par
/// `src/lib/lieux/normaliser.ts`.
model Wilaya {
  /// Le numéro officiel sur deux chiffres — « 16 » pour Alger, « 68 » pour Bou Saâda.
  code           String    @id
  nom            String
  /// Nom arabe — rempli seulement quand un texte officiel lisible le donne (aujourd'hui : 59 à 69).
  nomAr          String?
  /// Date du texte qui a CRÉÉ la wilaya (loi 84-09, 19-12 ou 26-06). Nulle pour 01 à 31 : antérieures à 1984.
  creeeLe        DateTime? @db.Date
  /// Le texte de création (ou, pour 01 à 31, le texte qui fixe leur nom et chef-lieu actuels).
  texteCreation  String?
  /// Entrée en fonction effective, quand elle diffère de la création (1er janvier 2027 pour 59 à 69).
  enFonctionLe   DateTime? @db.Date
  /// La wilaya dont elle a été détachée.
  wilayaMereCode String?
  /// Faux tant que la wilaya n'exerce pas encore (nouvelles wilayas avant leur entrée en fonction).
  active         Boolean   @default(true)
  communes       Commune[]
  adresses       Adresse[]
  medicalDoctors MedicalDoctor[]
  medicalInstitutions MedicalInstitution[]
  companyContacts CompanyContact[]
  suppliers      Supplier[]
  salesSectors   SalesSector[]

  @@index([wilayaMereCode])
}

/// UNE COMMUNE DU DÉCOUPAGE OFFICIEL. Table créée VIDE : aucune source officielle complète et à jour (1541 communes,
/// codes ONS, rattachements de 2026) n'a pu être chargée — on n'en invente pas.
model Commune {
  /// Code officiel de la commune (quatre chiffres : wilaya + rang).
  code       String  @id
  nom        String
  nomAr      String?
  wilayaCode String
  wilaya     Wilaya  @relation(fields: [wilayaCode], references: [code])
  adresses   Adresse[]

  @@index([wilayaCode])
}

/// Où en est une TÂCHE DE FOND (lot V2-F) — une ligne par tâche de `TACHES_PLANIFIEES` (`src/lib/scheduled.ts`).
///
/// Deux rôles dans la même ligne. Le BAIL : un seul exécutant (processus web ou worker) tient la tâche à la fois ;
/// un bail non renouvelé (`bailJusqua` dépassé) appartient à un processus mort et se reprend — c'est la reprise
/// après plantage. Le SIGNAL DE SANTÉ : dernier passage, durée, issue, lus par `/api/health/worker` et le
/// Diagnostic. La ligne naît au premier passage de la tâche ; la règle vit dans `src/lib/taches-de-fond/bail.ts`.
model TacheDeFond {
  /// Clé stable de la tâche (« rappels.reunions », « missions.balayage »).
  cle             String             @id
  /// Identité du processus qui tient le bail (`<executeur>@<hôte>#<pid>-<aléa>`) ; nulle quand personne ne la tient.
  detenteur       String?
  /// « web » ou « worker » : quel point d'entrée a fait le dernier passage.
  executeur       String?
  /// Fin du bail. Dépassée sans renouvellement : le détenteur est mort, la tâche se reprend.
  bailJusqua      DateTime?
  dernierDebutA   DateTime?
  dernierFinA     DateTime?
  derniereDureeMs Int?
  dernierStatut   StatutTacheDeFond?
  /// Message du dernier passage : l'erreur tronquée (ECHEC) ou la raison (IGNOREE). Jamais exposé hors Super Admin.
  dernierMessage  String?
  executions      Int                @default(0)
  echecs          Int                @default(0)
  updatedAt       DateTime           @updatedAt
}

/// LES INCIDENTS RÉPÉTÉS (lot V3-E « Fiabilité ») — une ligne par événement du journal unique
/// (`src/lib/journal.ts`) qui a échoué au moins une fois. Chaque processus y verse ses compteurs à
/// chaque passage des tâches de fond ; la tâche `observabilite.incidents` prévient le Super Admin
/// quand un événement dépasse le seuil dans la fenêtre — UNE notification agrégée, puis le silence
/// jusqu'au rappel. Diagnostic (Super Admin) seulement : le message est tronqué, jamais une pile.
model IncidentRepete {
  /// Nom de l'événement (`centre-adpro.visas`, `tache.echec:rappels.reunions`).
  evenement      String    @id
  /// Cumul depuis la première erreur connue.
  total          Int       @default(0)
  /// Début de la fenêtre courante ; une fenêtre échue repart de zéro au versement suivant.
  fenetreDebut   DateTime  @default(now())
  compteFenetre  Int       @default(0)
  premierA       DateTime  @default(now())
  dernierA       DateTime  @default(now())
  dernierMessage String?
  /// Dernière alerte envoyée au Super Admin pour cet événement (null : jamais).
  notifieA       DateTime?
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([dernierA])
}

enum StatutTacheDeFond {
  EN_COURS
  OK
  ECHEC
  /// La tâche a déclaré n'avoir rien à faire pour une raison durable (débrayée, pas encore livrée).
  IGNOREE
}

/// J1 — Où en est la lecture d'une pièce par la bibliothèque (`src/modules/bibliotheque/`).
enum StatutIngestionPiece {
  A_FAIRE
  EN_COURS
  FAITE
  ECHEC
  /// Rien à lire, pour une raison durable (format sans texte, trop volumineux) — dite dans `derniereErreur`.
  IGNOREE
}

/// J1 — LA BIBLIOTHÈQUE : une fiche par `Piece` (le registre R5 reste le seul registre). Elle porte ce que la
/// recherche filtre (format, source, date, confidentialité, sensibilité, CLÉS D'ACCÈS des sources) et l'état de
/// l'ingestion (file sous bail : statut, tentatives, prochain essai). Le texte vit dans ses passages.
///
/// `cles` : une clé « FAMILLE:id » par source où la pièce est rangée (`DRIVE_NODE:…`, `DOCUMENT:…`) — la même règle
/// que l'ouverture du fichier la juge (`src/modules/bibliotheque/infra/acces.ts`). `familles` en est la projection,
/// pour écarter en SQL ce qu'une personne ne peut ouvrir d'aucune façon. Index GIN et trigrammes : SQL seulement
/// (migration `20270207100000_bibliotheque`).
model BibliothequeFiche {
  pieceId          String               @id
  piece            Piece                @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  blobId           String
  titre            String
  /// Le titre REPLIÉ (minuscules sans accents) — la colonne des trigrammes.
  titrePlie        String
  /// pdf, texte, traitement-texte, tableur, presentation, image, audio, video, archive, autre.
  format           String
  mime             String?
  taille           Float?
  /// Une valeur de `NATURES_PIECE` (classement LOCAL de l'enrichissement), posée à l'ingestion.
  nature           String?
  source           SourcePiece          @default(AUTRE)
  confidentiality  Confidentiality      @default(INTERNAL)
  /// Pièce du coffre (identité, paie, RIB…) reconnue par le classement local, ou annoncée par son nom.
  sensible         Boolean              @default(false)
  cles             String[]
  familles         String[]
  auteurId         String?
  dateDocument     DateTime             @default(now())
  statut           StatutIngestionPiece @default(A_FAIRE)
  tentatives       Int                  @default(0)
  prochainEssaiLe  DateTime             @default(now())
  verrouilleLe     DateTime?
  derniereErreur   String?
  /// texte, ocr, transcription, aucune.
  methode          String?
  caracteres       Int?
  nbPassages       Int                  @default(0)
  /// Version des règles d'ingestion (découpage, lecteurs) qui ont produit les passages.
  versionIngestion Int                  @default(0)
  ingereLe         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  passages         BibliothequePassage[]

  @@index([statut, prochainEssaiLe])
  @@index([dateDocument])
  @@index([blobId])
}

/// J1 — UN PASSAGE (~800 jetons, avec chevauchement) du texte d'une pièce. Colonnes SQL seulement : `recherche`
/// (tsvector français replié, GIN) et, si l'extension pgvector est installée, `vecteur` (vector(512), HNSW).
model BibliothequePassage {
  id          String            @id @default(cuid())
  pieceId     String
  fiche       BibliothequeFiche @relation(fields: [pieceId], references: [pieceId], onDelete: Cascade)
  rang        Int
  texte       String
  /// Position du passage dans le texte complet de la pièce (caractères).
  debut       Int
  jetons      Int
  vectoriseLe DateTime?
  createdAt   DateTime          @default(now())

  @@unique([pieceId, rang])
  @@index([vectoriseLe])
}
