# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (keep .env.example tracked)
.env
.env*.local

# uploaded files (local storage adapter)
/uploads

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/*.db
/prisma/migrations/dev.db*

# local postgres data (used only for in-container testing)
/pgdata

# pre-downloaded prisma engines (container-specific, fetched at setup)
/.prisma-engines
/.devenv.sh

# graphify — incremental cache & local state (keep graph.json/html/report tracked)
/graphify-out/cache
/graphify-out/.graphify_root
/graphify-out/manifest.json
# `src/graphify-out` est le RÉPERTOIRE DE TRAVAIL de `graphify:refresh` : le CLI écrit dans
# `<cible>/graphify-out/`, le script replace les sorties à la racine puis l'efface (ligne 25).
# Il n'existe donc que pendant le rafraîchissement — mais un `git add -A` lancé PENDANT y ramasse
# le cache d'AST, et c'est arrivé. Un répertoire temporaire visible d'un ajout global doit être
# ignoré, même s'il se nettoie tout seul.
/src/graphify-out
.ocr-cache/

# auto-testeur — rapports générés (régénérables via `npm run autotest`)
/auto-test-report.md
/auto-test-report.json

# Playwright (artefacts E2E locaux)
/test-results/
/playwright-report/
e2e-screenshots/

# Sorties du banc de connaissance (fichiers d'essai régénérables à la demande)
scripts/bench/tmp/
.e2e-office.json

# Le PASSE-PLAT du banc d'horizon long : la phase 1 y écrit l'identifiant de la mission et
# l'état qu'elle a mesuré, la phase 2 le relit depuis un PROCESSUS NEUF. C'est un artefact de
# mesure, propre à une machine et à un instant — le versionner ferait relire à la phase 2 la
# mission de quelqu'un d'autre.
.horizon-long.json

# Sorties du crawler d'audit UI (rapport, captures, journal serveur) — regénérées à chaque passe
ui-audit-out/

# Sorties du banc Adam (jeu semé localement, mesures) — régénérables
bench-out/
__pycache__/
