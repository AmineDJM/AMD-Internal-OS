{
  "extends": "next/core-web-vitals",
  "rules": {
    "@next/next/no-assign-module-variable": "off",
    "react/no-unescaped-entities": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/modules/*/domaine",
              "@/modules/*/domaine/*",
              "@/modules/*/infra",
              "@/modules/*/infra/*",
              "**/modules/*/domaine/*",
              "**/modules/*/infra/*"
            ],
            "message": "Un module s'importe par sa porte : @/modules/<module>/api (serveur) ou /partage (pur) — voir docs/architecture/MODULES.md."
          },
          {
            "group": [
              "@/modules/*/ecrans",
              "@/modules/*/ecrans/*",
              "**/modules/*/ecrans/*"
            ],
            "message": "Un écran de module ne s'importe que depuis une page de src/app/ — voir docs/architecture/MODULES.md."
          },
          {
            "group": [
              "@/lib/coffre",
              "@/lib/coffre/*",
              "@/lib/lieux",
              "@/lib/lieux/*",
              "@/lib/referentiels",
              "@/lib/referentiels/*",
              "@/lib/actions/coffre-actions",
            "@/lib/actions/consommation-actions",
            "@/lib/actions/organisation-actions",
            "@/lib/actions/personnes-actions",
            "@/lib/actions/refonte-reprise-actions",
            "@/lib/actions/actualisation-soldes-actions",
            "@/lib/actions/expense-actions",
            "@/lib/actions/finance-actions",
            "@/lib/actions/payment-centre-actions",
            "@/lib/actions/payment-centre-seat-actions",
            "@/lib/actions/payment-request-actions",
            "@/lib/actions/relance-paiement-actions",
            "@/lib/expense-orders",
            "@/lib/finance",
            "@/lib/finance/*",
            "@/lib/finances",
            "@/lib/finances/*",
            "@/lib/payments",
            "@/lib/payments/*",
            "@/lib/queries/centre-paiement",
            "@/lib/queries/compta",
            "@/lib/queries/demande-paiement-suppression",
            "@/lib/queries/finance",
            "@/lib/queries/my-payment-requests",
            "@/lib/queries/paiements-a-faire"
            ],
            "message": "Ce fichier a déménagé dans src/modules/ (coffre, lieux, referentiels, finances) : importer la porte du module (/api, /api-lecture, /partage ou /actions). L'ancien chemin n'est qu'une adresse de réexpédition (tsconfig.json) pour les autres branches."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/app/**",
        "src/modules/*/ecrans/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/*/domaine",
                  "@/modules/*/domaine/*",
                  "@/modules/*/infra",
                  "@/modules/*/infra/*",
                  "**/modules/*/domaine/*",
                  "**/modules/*/infra/*"
                ],
                "message": "Un module s'importe par sa porte : @/modules/<module>/api (serveur) ou /partage (pur) — voir docs/architecture/MODULES.md."
              },
              {
                "group": [
                  "@/lib/coffre",
                  "@/lib/coffre/*",
                  "@/lib/lieux",
                  "@/lib/lieux/*",
                  "@/lib/referentiels",
                  "@/lib/referentiels/*",
                  "@/lib/actions/coffre-actions",
            "@/lib/actions/consommation-actions",
            "@/lib/actions/organisation-actions",
            "@/lib/actions/personnes-actions",
            "@/lib/actions/refonte-reprise-actions",
            "@/lib/actions/actualisation-soldes-actions",
            "@/lib/actions/expense-actions",
            "@/lib/actions/finance-actions",
            "@/lib/actions/payment-centre-actions",
            "@/lib/actions/payment-centre-seat-actions",
            "@/lib/actions/payment-request-actions",
            "@/lib/actions/relance-paiement-actions",
            "@/lib/expense-orders",
            "@/lib/finance",
            "@/lib/finance/*",
            "@/lib/finances",
            "@/lib/finances/*",
            "@/lib/payments",
            "@/lib/payments/*",
            "@/lib/queries/centre-paiement",
            "@/lib/queries/compta",
            "@/lib/queries/demande-paiement-suppression",
            "@/lib/queries/finance",
            "@/lib/queries/my-payment-requests",
            "@/lib/queries/paiements-a-faire"
                ],
                "message": "Ce fichier a déménagé dans src/modules/ (coffre, lieux, referentiels, finances) : importer la porte du module (/api, /api-lecture, /partage ou /actions). L'ancien chemin n'est qu'une adresse de réexpédition (tsconfig.json) pour les autres branches."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/modules/*/domaine/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/lib/prisma",
                "message": "domaine/ est pur : la base se lit dans infra/."
              },
              {
                "name": "xlsx",
                "message": "domaine/ est pur : les fichiers se lisent dans infra/."
              }
            ],
            "patterns": [
              {
                "group": [
                  "next",
                  "next/*",
                  "react",
                  "react-dom",
                  "node:*",
                  "../infra/*",
                  "../../infra/*",
                  "../ecrans/*",
                  "../../ecrans/*",
                  "../api",
                  "../../api",
                  "../api-*",
                  "../../api-*",
                  "../actions",
                  "../../actions",
                  "@/modules/*/api",
                  "@/modules/*/api-*",
                  "@/modules/*/actions"
                ],
                "message": "domaine/ est pur : ni Next, ni React, ni Node, ni infra/, ni écrans, ni porte serveur — un autre module se lit par sa porte pure /partage."
              },
              {
                "group": [
                  "@/modules/*/domaine",
                  "@/modules/*/domaine/*",
                  "@/modules/*/infra",
                  "@/modules/*/infra/*",
                  "**/modules/*/domaine/*",
                  "**/modules/*/infra/*"
                ],
                "message": "Un module s'importe par sa porte : @/modules/<module>/api (serveur) ou /partage (pur) — voir docs/architecture/MODULES.md."
              },
              {
                "group": [
                  "@/modules/*/ecrans",
                  "@/modules/*/ecrans/*",
                  "**/modules/*/ecrans/*"
                ],
                "message": "Un écran de module ne s'importe que depuis une page de src/app/ — voir docs/architecture/MODULES.md."
              },
              {
                "group": [
                  "@/lib/coffre",
                  "@/lib/coffre/*",
                  "@/lib/lieux",
                  "@/lib/lieux/*",
                  "@/lib/referentiels",
                  "@/lib/referentiels/*",
                  "@/lib/actions/coffre-actions",
            "@/lib/actions/consommation-actions",
            "@/lib/actions/organisation-actions",
            "@/lib/actions/personnes-actions",
            "@/lib/actions/refonte-reprise-actions",
            "@/lib/actions/actualisation-soldes-actions",
            "@/lib/actions/expense-actions",
            "@/lib/actions/finance-actions",
            "@/lib/actions/payment-centre-actions",
            "@/lib/actions/payment-centre-seat-actions",
            "@/lib/actions/payment-request-actions",
            "@/lib/actions/relance-paiement-actions",
            "@/lib/expense-orders",
            "@/lib/finance",
            "@/lib/finance/*",
            "@/lib/finances",
            "@/lib/finances/*",
            "@/lib/payments",
            "@/lib/payments/*",
            "@/lib/queries/centre-paiement",
            "@/lib/queries/compta",
            "@/lib/queries/demande-paiement-suppression",
            "@/lib/queries/finance",
            "@/lib/queries/my-payment-requests",
            "@/lib/queries/paiements-a-faire"
                ],
                "message": "Ce fichier a déménagé dans src/modules/ (coffre, lieux, referentiels, finances) : importer la porte du module (/api, /api-lecture, /partage ou /actions). L'ancien chemin n'est qu'une adresse de réexpédition (tsconfig.json) pour les autres branches."
              }
            ]
          }
        ]
      }
    }
  ]
}
