              "@/lib/attestation-travail-luna",
              "@/lib/hr-demande-traitee",
              "@/lib/hr-drive-mirror",
              "@/lib/hr-request-flow",
              "@/lib/hr/absences",
              "@/lib/hr/attestation-travail/modele",
              "@/lib/hr/attestation-travail/regles",
              "@/lib/hr/conge-escalade",
              "@/lib/hr/decision-sur-soi",
              "@/lib/hr/depart",
              "@/lib/hr/document-visibility",
              "@/lib/hr/expense-claim",
              "@/lib/hr/file-conges",
              "@/lib/hr/leave-core",
              "@/lib/hr/leave-form-context",
              "@/lib/hr/leave-sheet",
