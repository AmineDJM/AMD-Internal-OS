{
  "extends": "next/core-web-vitals",
  "rules": {
    "@next/next/no-assign-module-variable": "off",
    "react/no-unescaped-entities": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/modules/*/domaine",
              "@/modules/*/domaine/*",
              "@/modules/*/infra",
              "@/modules/*/infra/*",
              "**/modules/*/domaine/*",
              "**/modules/*/infra/*"
            ],
            "message": "Un module s'importe par sa porte : @/modules/<module>/api (serveur) ou /partage (pur) — voir docs/architecture/MODULES.md."
          },
          {
            "group": [
              "@/modules/*/ecrans",
              "@/modules/*/ecrans/*",
              "**/modules/*/ecrans/*"
            ],
            "message": "Un écran de module ne s'importe que depuis une page de src/app/ — voir docs/architecture/MODULES.md."
          },
          {
            "group": [
              "@/lib/coffre",
              "@/lib/coffre/*",
              "@/lib/lieux",
              "@/lib/lieux/*",
              "@/lib/referentiels",
              "@/lib/referentiels/*",
              "@/lib/actions/coffre-actions",
              "@/lib/actions/consommation-actions",
              "@/lib/actions/organisation-actions",
              "@/lib/actions/personnes-actions",
              "@/lib/actions/refonte-reprise-actions"
            ],
            "message": "Ce fichier a déménagé dans src/modules/ (coffre, lieux, referentiels) : importer la porte du module (/api, /api-lecture, /partage ou /actions). L'ancien chemin n'est qu'une adresse de réexpédition (tsconfig.json) pour les autres branches."
          },
          {
            "group": [
              "@/components/shared/hr-meeting-controls",
              "@/components/shared/hr-request-thread",
              "@/lib/actions/conge-discussion-actions",
              "@/lib/actions/hr-actions",
