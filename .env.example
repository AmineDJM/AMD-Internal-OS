# ─────────────────────────────────────────────────────────────
# AMD Internal OS — Environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/amd_internal_os
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amd_internal_os?schema=public"

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stockage objet S3-compatible (Cloudflare R2 / AWS S3 / Supabase / Backblaze).
# Sans lui, les fichiers vont en base et ceux de plus de MAX_DB_UPLOAD_MB sont REFUSÉS.
# Avec lui, les gros fichiers (dossiers CTD de plusieurs Go) partent directement du navigateur
# au bucket. Guide pas à pas (bucket, règle CORS, test) : docs/stockage-gros-fichiers.md
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="amd-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Sans bucket, au-delà de cette taille (Mo), un fichier est refusé au lieu d'être écrit en base.
MAX_DB_UPLOAD_MB="100"

# Max upload size in MB (server-enforced).
MAX_UPLOAD_MB="25"

# Optional SMTP for email notifications (internal notifications work without it).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AMD Internal OS <no-reply@adventum.local>"

# Éditeur Office auto-hébergé (OnlyOffice Document Server). Optionnel.
# L'éditeur reste INERTE tant que ces deux variables ne sont pas définies.
# ONLYOFFICE_URL doit être l'URL PUBLIQUE du Document Server (le navigateur y charge api.js) —
# un Private Service Render ne suffit pas. APP_URL = URL publique de cette app (callback serveur-à-serveur).
ONLYOFFICE_URL=""
ONLYOFFICE_JWT_SECRET=""
APP_URL=""

# Publication vers le site public Adventum (offres d'emploi + articles de blog) — optionnel.
# La file d'envoi et la réconciliation quotidienne restent INERTES tant que ces deux variables
# ne sont pas définies. ADVENTUM_API_KEY = la MÊME valeur que ERP_API_KEY côté site
# (openssl rand -hex 32). Ne jamais la committer : Render → Environment uniquement.
ADVENTUM_BASE_URL=""
ADVENTUM_API_KEY=""
# Facultatif : signature HMAC-SHA256 des corps (même valeur que ERP_WEBHOOK_SECRET côté site).
ADVENTUM_WEBHOOK_SECRET=""
# Débrayer la réconciliation quotidienne : SITE_WEB_RECONCILIATION=off

# Assistant IA (Mastra sur MiMo, src/lib/agent/) — la clé n'est lue QUE sous ce nom (l'ancien
# « mimo » en minuscules est ignoré, avec un avertissement au démarrage).
MIMO_API_KEY=""
# Facultatifs : modèle, adresse, délai d'un tour (ms).
# MIMO_MODEL="mimo-v2.6-flash"
# MIMO_BASE_URL="https://token-plan-ams.xiaomimimo.com/v1"
# MIMO_TIMEOUT_MS="45000"
# Tarif de MiMo en dollars par MILLION de jetons (entrée, sortie) — pour le coût ESTIMÉ de l'écran
# Consommation IA. Absent : le coût est affiché « inconnu », jamais deviné. Les plafonds, eux, se
# comptent en jetons et tiennent sans tarif (réglage Super Admin, Administration › Consommation IA).
# MIMO_PRICE_IN=""
# MIMO_PRICE_OUT=""
